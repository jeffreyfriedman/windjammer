fn main() {
    let mut bytes = Vec::new()
    let mut x: u64 = 88172645463325252
    for i in 0..5000000 {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        bytes.push((x % 256) as u8)
    }
    let mut h: u64 = 1469598103934665603
    for round in 0..10 {
        for i in 0..bytes.len() {
            h = (h ^ (bytes[i] as u64)).wrapping_mul(1099511628211)
        }
    }
    println!("{}", h)
}

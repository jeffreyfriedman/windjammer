fn build(words: Vec<string>) -> string {
    let mut out = ""
    for w in words {
        out = out + w + ","
    }
    out
}

fn main() {
    let mut words = Vec::new()
    for i in 0..40000 {
        words.push(i.to_string())
    }
    let s = build(words)
    let mut h: u64 = 1469598103934665603
    for b in s.bytes() {
        h = (h ^ (b as u64)).wrapping_mul(1099511628211)
    }
    println!("{} {}", s.len(), h)
}

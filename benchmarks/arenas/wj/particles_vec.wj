// Windjammer particle frame loop with a fresh Vec per frame (baseline for particles_arena.wj).
struct Particle {
    x: float,
    y: float,
    vx: float,
    vy: float,
    life: float,
}

fn main() {
    let mut sum = 0.0
    for frame in 0..60 {
        let mut pool = Vec::new()
        for i in 0..20000 {
            let f = float(i * 7 + frame * 13)
            pool.push(Particle { x: f * 0.01, y: f * 0.02, vx: float(i % 5) - 2.0, vy: float(i % 3), life: 1.0 + float(i % 4) })
        }
        for step in 0..4 {
            for p in pool.iter_mut() {
                p.vy = p.vy - 0.98
                p.x = p.x + p.vx * 0.016
                p.y = p.y + p.vy * 0.016
                p.life = p.life - 0.016
            }
        }
        for p in pool.iter() {
            sum = sum + p.x + p.y + p.life
        }
    }
    println("${sum}")
}

// Windjammer particle frame loop on std::arena (compare: particles_vec.wj). Same checksum.
use std::arena::Arena

struct Particle {
    x: float,
    y: float,
    vx: float,
    vy: float,
    life: float,
}

fn main() {
    let mut pool = Arena::new()
    let mut sum: float = 0.0
    let frames: int = 60
    let count: int = 20000
    for frame in 0..frames {
        pool.reset()
        for i in 0..count {
            let f = (i * 7 + frame * 13) as float
            pool.alloc(Particle { x: f * 0.01, y: f * 0.02, vx: (i % 5) as float - 2.0, vy: (i % 3) as float, life: 1.0 + (i % 4) as float })
        }
        for step in 0..4 {
            for p in pool.iter_mut() {
                p.vy = p.vy - 0.98
                p.x = p.x + p.vx * 0.016
                p.y = p.y + p.vy * 0.016
                p.life = p.life - 0.016
            }
        }
        for p in pool.iter() {
            sum = sum + p.x + p.y + p.life
        }
    }
    println("${sum}")
}

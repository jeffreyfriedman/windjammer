use std::collections::HashMap
use std::rc::Rc
fn work(n: int) -> int {
    let mut total = 0
    let mut i = 0
    while i < n {
        let m: HashMap<int, int> = HashMap::new()
        let r = Rc::new(i)
        total += m.len() + i % 7
        i += 1
    }
    total
}
fn main() { println("${work(400000)}") }

// Struct method calls on a small Copy struct.
@derive(Copy, Clone)
struct V2 {
    x: int,
    y: int,
}

impl V2 {
    fn add(self, o: V2) -> V2 {
        V2 { x: self.x + o.x, y: self.y + o.y }
    }
    fn dot(self, o: V2) -> int {
        self.x * o.x + self.y * o.y
    }
}

fn main() {
    let mut acc = V2 { x: 0, y: 0 }
    let mut s = 0
    let mut i = 0
    while i < 300000 {
        let v = V2 { x: i % 13, y: i % 7 }
        acc = acc.add(v)
        s += acc.dot(v) % 1000
        i += 1
    }
    println("${acc.x} ${acc.y} ${s}")
}

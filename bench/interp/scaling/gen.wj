// Scaling-set generator (ADR-0020 rung 2): sizes.toml + templates/<kernel>.{wj.tmpl,mjs,py} (the Windjammer templates carry `@n@` placeholders: not programs, so not `.wj`) -> gen/<label>/<kernel>.<ext>.
// Deterministic: no clock, no randomness, sections in file order; running it twice writes the same bytes.
// Usage (from the repository root):
//   wj run --interpret --allow 'fs.read=bench/interp/scaling/**' --allow 'fs.write=**' \
//       bench/interp/scaling/gen.wj [dir]
// (a narrower write grant is denied: the capability check sees script-relative paths; the generator writes only under <dir>/gen.)
// `dir` defaults to bench/interp/scaling. A template placeholder `@name@` is replaced by the section's `name = value`
// (the value text as written); a placeholder left over is an error (exit 1), never a silently wrong program.
use std::env
use std::fs
use std::process
use std::strings

fn fail(msg: string) {
    println("scaling gen: ${msg}")
    process.exit(1)
}

/// A kernel or size label is only letters and digits: it becomes a path component.
/// wj-taint: sanitizer
fn safe_name(s: string) -> string {
    if s.len() == 0 {
        fail("empty name in sizes.toml")
    }
    for c in s.chars() {
        if !c.is_alphanumeric() {
            fail("bad name ${s} in sizes.toml")
        }
    }
    s
}

fn expand(template: string, names: Vec<string>, values: Vec<string>) -> string {
    let mut out = template
    let mut i = 0
    while i < names.len() {
        out = strings.replace(out, "@" + names[i] + "@", values[i])
        i += 1
    }
    out
}

fn main() {
    let args = env::args()
    let root = if args.len() > 1 { args[1] } else { "bench/interp/scaling" }
    let manifest = match fs.read_to_string(root + "/sizes.toml") {
        Ok(s) => s,
        Err(e) => {
            fail("cannot read ${root}/sizes.toml: ${e}")
            ""
        },
    }
    let mut kernels: Vec<string> = Vec::new()
    let mut labels: Vec<string> = Vec::new()
    let mut names: Vec<Vec<string>> = Vec::new()
    let mut values: Vec<Vec<string>> = Vec::new()
    for raw in strings.split_lines(manifest) {
        let line = strings.trim(raw)
        if line.len() == 0 || line.starts_with("#") {
            continue
        }
        if line.starts_with("[") {
            let parts = strings.split(strings.replace(strings.replace(line, "[", ""), "]", ""), ".")
            if parts.len() != 2 {
                fail("bad section ${line}")
            }
            kernels.push(safe_name(parts[0]))
            labels.push(safe_name(parts[1]))
            names.push(Vec::new())
            values.push(Vec::new())
            continue
        }
        let kv = strings.split(line, "=")
        if kv.len() != 2 || names.len() == 0 {
            fail("bad line ${line}")
        }
        let last = names.len() - 1
        names[last].push(strings.trim(kv[0]))
        values[last].push(strings.trim(kv[1]))
    }
    let mut written = 0
    let mut s = 0
    while s < kernels.len() {
        let dir = root + "/gen/" + labels[s]
        fs.create_dir_all(dir)
        for ext in ["wj", "mjs", "py"] {
            let template = match fs.read_to_string(root + "/templates/" + kernels[s] + "." + ext + (if ext == "wj" { ".tmpl" } else { "" })) {
                Ok(t) => t,
                Err(e) => {
                    fail("no template for ${kernels[s]}.${ext}: ${e}")
                    ""
                },
            }
            let body = expand(template, names[s], values[s])
            if strings.contains(body, "@") {
                // `@` appears in no template except as a placeholder
                fail("unreplaced placeholder in ${kernels[s]}.${ext} at ${labels[s]}")
            }
            let comment = if ext == "py" { "# " } else { "// " }
            let header = comment + "GENERATED by bench/interp/scaling/gen.wj from sizes.toml [" + kernels[s] + "." + labels[s] + "]: do not edit\n"
            fs.write(dir + "/" + kernels[s] + "." + ext, header + body)
            written += 1
        }
        s += 1
    }
    println("scaling gen: wrote ${written} programs for ${kernels.len()} sections")
}

// Closure-heavy iterator chains: map / filter / sum over a Vec, repeated.
use std::time
fn main() {
    let t0 = time::now_unix_nano()
    let mut v: Vec<int> = Vec::new()
    let mut k = 0
    while k < @len@ {
        v.push(k)
        k += 1
    }
    let mut total = 0
    let mut r = 0
    while r < @rounds@ {
        let s: int = v.map(|x| x * r).filter(|x| x % 3 == 0).map(|x| x / 3).sum()
        total += s % 100000
        r += 1
    }
    eprintln("STEADY_NS ${time::now_unix_nano() - t0}")
    println("${total}")
}

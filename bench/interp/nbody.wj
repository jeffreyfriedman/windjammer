// n-body (5 bodies): float arithmetic over a Vec of structs mutated in place.
struct Body {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    m: f64,
}

fn advance(bodies: Vec<Body>, dt: f64) {
    let n = bodies.len()
    let mut i = 0
    while i < n {
        let mut j = i + 1
        while j < n {
            let dx = bodies[i].x - bodies[j].x
            let dy = bodies[i].y - bodies[j].y
            let dz = bodies[i].z - bodies[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * d2.sqrt())
            let mj = bodies[j].m
            let mi = bodies[i].m
            bodies[i].vx -= dx * mj * mag
            bodies[i].vy -= dy * mj * mag
            bodies[i].vz -= dz * mj * mag
            bodies[j].vx += dx * mi * mag
            bodies[j].vy += dy * mi * mag
            bodies[j].vz += dz * mi * mag
            j += 1
        }
        i += 1
    }
    let mut k = 0
    while k < n {
        bodies[k].x += dt * bodies[k].vx
        bodies[k].y += dt * bodies[k].vy
        bodies[k].z += dt * bodies[k].vz
        k += 1
    }
}

fn energy(bodies: Vec<Body>) -> f64 {
    let mut e = 0.0
    let n = bodies.len()
    let mut i = 0
    while i < n {
        let b = bodies[i]
        e += 0.5 * b.m * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        let mut j = i + 1
        while j < n {
            let dx = b.x - bodies[j].x
            let dy = b.y - bodies[j].y
            let dz = b.z - bodies[j].z
            e -= b.m * bodies[j].m / (dx * dx + dy * dy + dz * dz).sqrt()
            j += 1
        }
        i += 1
    }
    e
}

fn main() {
    let mut bodies: Vec<Body> = Vec::new()
    bodies.push(Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, m: 39.47 })
    bodies.push(Body { x: 4.84, y: -1.16, z: -0.10, vx: 0.60, vy: 2.81, vz: -0.02, m: 0.037 })
    bodies.push(Body { x: 8.34, y: 4.12, z: -0.40, vx: -1.01, vy: 1.82, vz: 0.008, m: 0.011 })
    bodies.push(Body { x: 12.89, y: -15.11, z: -0.22, vx: 1.08, vy: 0.86, vz: -0.01, m: 0.0017 })
    bodies.push(Body { x: 15.37, y: -25.91, z: 0.17, vx: 0.97, vy: 0.59, vz: -0.03, m: 0.002 })
    let before = energy(bodies)
    let mut step = 0
    while step < 20000 {
        advance(bodies, 0.01)
        step += 1
    }
    let after = energy(bodies)
    println("${(before * 1000000.0) as i64} ${(after * 1000000.0) as i64}")
}

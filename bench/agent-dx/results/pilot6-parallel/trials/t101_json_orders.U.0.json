 "final_source": "use std::json\nuse std::fs\nuse std::collections::HashMap\n\nstruct Item {\n    sku: string,\n    qty: int,\n    price: float,\n}\n\nstruct Order {\n    id: int,\n    customer: string,\n    items: Vec<Item>,\n    note: Option<string>,\n}\n\nfn main() {\n    let text = fs::read_to_string(\"/dev/stdin\").unwrap_or(\"\")\n    let r = json.parse_string::<Vec<Order>>(text)\n    match r {\n        Ok(orders) => {\n            let mut totals: HashMap<string, float> = HashMap::new()\n            for o in orders {\n                let mut t = 0.0\n                for it in o.items {\n                    t += (it.qty as float) * it.price\n                }\n                let cur = totals.get(o.customer).unwrap_or(0.0)\n                totals.insert(o.customer, cur + t)\n            }\n            let mut keys: Vec<string> = []\n            for k in totals.keys() { keys.push(k) }\n            keys.sort()\n            for k in keys {\n                let v = totals.get(k).unwrap_or(0.0)\n                println(\"${k} ${v:.2}\")\n            }\n        }\n        Err(_) => {\n            println(\"invalid input\")\n            std::process::exit(1)\n        }\n    }\n}\n",

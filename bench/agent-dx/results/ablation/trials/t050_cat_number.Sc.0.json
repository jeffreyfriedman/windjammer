 "final_source": "use std::env\nuse std::fs\nuse std::io\n\nfn emit(text: string, number: bool, counter: int) -> int {\n    let mut n = counter\n    if !number {\n        print(text)\n        return n\n    }\n    let mut cur = \"\"\n    for c in text.chars() {\n        if c == '\\n' {\n            n += 1\n            println(\"${n:>6}\\t${cur}\")\n            cur = \"\"\n        } else {\n            cur.push(c)\n        }\n    }\n    if cur.len() > 0 {\n        n += 1\n        println(\"${n:>6}\\t${cur}\")\n    }\n    n\n}\n\nfn main() {\n    let args = env::args()\n    let mut number = false\n    let mut names: Vec<string> = []\n    let mut first = true\n    for a in args {\n        if first {\n            first = false\n        } else if a == \"-n\" {\n            number = true\n        } else {\n            names.push(a)\n        }\n    }\n    let mut counter = 0\n    let mut failed = false\n    if names.len() == 0 {\n        let r = io::read_to_string(io::stdin())\n        match r {\n            Ok(t) => { counter = emit(t, number, counter) }\n            Err(_) => {}\n        }\n    } else {\n        for name in names {\n            match fs::read_to_string(name) {\n                Ok(t) => { counter = emit(t, number, counter) }\n                Err(_) => {\n                    println(\"cat: ${name}: No such file\")\n                    failed = true\n                }\n            }\n        }\n    }\n    if failed {\n        std::process::exit(1)\n    }\n}\n",

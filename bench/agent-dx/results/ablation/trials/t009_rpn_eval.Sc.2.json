 "final_source": "use std::io\n\nfn eval(line: string) -> string {\n    let mut st: Vec<int> = []\n    for tok in line.split_whitespace() {\n        if tok == \"+\" || tok == \"-\" || tok == \"*\" || tok == \"/\" {\n            if st.len() < 2 {\n                return \"error: underflow\"\n            }\n            let b = st.pop() ?? 0\n            let a = st.pop() ?? 0\n            if tok == \"+\" {\n                st.push(a + b)\n            } else if tok == \"-\" {\n                st.push(a - b)\n            } else if tok == \"*\" {\n                st.push(a * b)\n            } else {\n                if b == 0 {\n                    return \"error: divzero\"\n                }\n                st.push(a / b)\n            }\n        } else {\n            match tok.parse::<int>() {\n                Ok(v) => st.push(v),\n                Err(_) => return \"error: token\",\n            }\n        }\n    }\n    if st.len() != 1 {\n        return \"error: leftover\"\n    }\n    \"${st[0]}\"\n}\n\nfn main() {\n    let text = io::read_to_string(io::stdin()) ?? \"\"\n    for line in text.lines() {\n        if line.trim() == \"\" {\n            continue\n        }\n        println(eval(line))\n    }\n}\n",

 "final_source": "use std::io\n\nfn main() {\n    let mut text = \"\"\n    match io::read_to_string(io::stdin()) {\n        Ok(s) => { text = s }\n        Err(_) => {}\n    }\n    let limit = 200001\n    let mut comp: Vec<bool> = []\n    let mut count: Vec<int> = []\n    let mut last: Vec<int> = []\n    for i in 0..limit {\n        comp.push(false)\n        count.push(0)\n        last.push(0)\n    }\n    let mut i = 2\n    while i * i < limit {\n        if !comp[i] {\n            let mut j = i * i\n            while j < limit {\n                comp[j] = true\n                j += i\n            }\n        }\n        i += 1\n    }\n    let mut c = 0\n    let mut l = 0\n    let mut k = 2\n    while k < limit {\n        if !comp[k] {\n            c += 1\n            l = k\n        }\n        count[k] = c\n        last[k] = l\n        k += 1\n    }\n    let toks: Vec<string> = text.split_whitespace().collect()\n    let t: int = toks[0].parse() ?? 0\n    let mut out = \"\"\n    for q in 0..t {\n        let n: int = toks[q + 1].parse() ?? 0\n        if n < 2 {\n            out = out + \"0 none\\n\"\n        } else {\n            out = out + \"${count[n]} ${last[n]}\\n\"\n        }\n    }\n    print(out)\n}\n",

 "final_source": "use std::fs\nuse std::strings\n\nfn digit_val(c: char) -> int {\n    let n = c as int\n    if n >= 48 && n <= 57 { n - 48 } else if n >= 65 && n <= 90 { n - 55 } else { n - 87 }\n}\n\nfn main() {\n    let input = fs::read_to_string(\"/dev/stdin\") ?? \"\"\n    for line in input.lines() {\n        let parts = strings::split(line.trim(), \" \")\n        if parts.len() < 3 { continue }\n        let from: int = parts[1].parse() ?? 10\n        let to: int = parts[2].parse() ?? 10\n        let mut v: int = 0\n        for c in parts[0].chars() { v = v * from + digit_val(c) }\n        if v == 0 { println(\"0\"); continue }\n        let digits = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n        let mut out: Vec<char> = []\n        while v > 0 {\n            let d = (v % to) as usize\n            out.push(digits.chars().nth(d) ?? '0')\n            v = v / to\n        }\n        let mut s = \"\"\n        let mut i = out.len()\n        while i > 0 { i -= 1; s = s + out[i].to_string() }\n        println(s)\n    }\n}\n",

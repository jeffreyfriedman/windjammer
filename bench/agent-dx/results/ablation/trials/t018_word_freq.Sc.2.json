 "final_source": "use std::io\n\nstruct Entry {\n    word: string,\n    count: int,\n}\n\nfn main() {\n    let s = io::read_to_string(io::stdin()) ?? \"\"\n    let mut k: int = 0\n    let mut tokens: Vec<string> = []\n    let mut cur = \"\"\n    let mut in_header = true\n    let mut header = \"\"\n    for c in s.chars() {\n        if in_header {\n            if c == '\\n' {\n                in_header = false\n                k = header.trim().parse::<int>() ?? 0\n            } else {\n                header = header + c.to_string()\n            }\n        } else if c.is_ascii_alphanumeric() {\n            cur = cur + c.to_ascii_lowercase().to_string()\n        } else if cur.len() > 0 {\n            tokens.push(cur)\n            cur = \"\"\n        }\n    }\n    if in_header {\n        k = header.trim().parse::<int>() ?? 0\n    }\n    if cur.len() > 0 {\n        tokens.push(cur)\n    }\n    tokens.sort()\n    let mut entries: Vec<Entry> = []\n    let mut prev = \"\"\n    let mut n: int = 0\n    for t in tokens {\n        if t == prev {\n            n += 1\n        } else {\n            if n > 0 {\n                entries.push(Entry { word: prev, count: n })\n            }\n            prev = t\n            n = 1\n        }\n    }\n    if n > 0 {\n        entries.push(Entry { word: prev, count: n })\n    }\n    entries.sort_by_key(|e| 0 - e.count)\n    let mut i: int = 0\n    for e in entries {\n        if i >= k {\n            break\n        }\n        println(\"${e.word} ${e.count}\")\n        i += 1\n    }\n}\n",

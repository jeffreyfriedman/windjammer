 "final_source": "use std::fs\n\nfn parse(line: string) -> Vec<string> {\n    let cs: Vec<char> = line.chars().collect()\n    let n: int = cs.len() as int\n    let mut fields: Vec<string> = []\n    let mut cur = \"\"\n    let mut inq = false\n    let mut i: int = 0\n    while i < n {\n        let c = cs[i as usize]\n        if inq {\n            if c == '\"' {\n                if i + 1 < n && cs[(i + 1) as usize] == '\"' {\n                    cur.push('\"')\n                    i += 1\n                } else {\n                    inq = false\n                }\n            } else {\n                cur.push(c)\n            }\n        } else if c == '\"' {\n            inq = true\n        } else if c == ',' {\n            fields.push(cur)\n            cur = \"\"\n        } else {\n            cur.push(c)\n        }\n        i += 1\n    }\n    fields.push(cur)\n    fields\n}\n\nfn main() {\n    let s = fs::read_to_string(\"/dev/stdin\").unwrap_or(\"\")\n    for l in s.lines() {\n        let f = parse(l)\n        let mut out = \"${f.len()}: \"\n        let mut first = true\n        for x in f {\n            if !first { out.push('|') }\n            first = false\n            out.push('[')\n            out.push_str(x)\n            out.push(']')\n        }\n        println(out)\n    }\n}\n",

 "final_source": "use std::io\n\ntrait Shape {\n    fn name(self) -> string\n    fn corners(self) -> int\n    fn double_area(self) -> int\n}\n\nstruct Square { s: int }\nstruct Rect { w: int, h: int }\nstruct RTri { a: int, b: int }\nstruct Trap { a: int, b: int, h: int }\n\nimpl Shape for Square {\n    fn name(self) -> string { \"square\" }\n    fn corners(self) -> int { 4 }\n    fn double_area(self) -> int { 2 * self.s * self.s }\n}\n\nimpl Shape for Rect {\n    fn name(self) -> string { \"rect\" }\n    fn corners(self) -> int { 4 }\n    fn double_area(self) -> int { 2 * self.w * self.h }\n}\n\nimpl Shape for RTri {\n    fn name(self) -> string { \"rtri\" }\n    fn corners(self) -> int { 3 }\n    fn double_area(self) -> int { self.a * self.b }\n}\n\nimpl Shape for Trap {\n    fn name(self) -> string { \"trap\" }\n    fn corners(self) -> int { 4 }\n    fn double_area(self) -> int { (self.a + self.b) * self.h }\n}\n\nfn num(s: string) -> int {\n    s.parse::<int>().unwrap_or(0)\n}\n\nfn main() {\n    let mut shapes: Vec<Box<dyn Shape>> = []\n    loop {\n        let r = io::read_line()\n        match r {\n            Ok(line) => {\n                let w: Vec<string> = line.split_whitespace().collect()\n                if w.len() == 0 { break }\n                let k = w[0]\n                if k == \"square\" {\n                    shapes.push(Box::new(Square { s: num(w[1]) }))\n                } else if k == \"rect\" {\n                    shapes.push(Box::new(Rect { w: num(w[1]), h: num(w[2]) }))\n                } else if k == \"rtri\" {\n                    shapes.push(Box::new(RTri { a: num(w[1]), b: num(w[2]) }))\n                } else if k == \"trap\" {\n                    shapes.push(Box::new(Trap { a: num(w[1]), b: num(w[2]), h: num(w[3]) }))\n                }\n            }\n            Err(_) => { break }\n        }\n    }\n    let mut total = 0\n    let mut best = -1\n    let mut best_name = \"none\"\n    for s in shapes {\n        let d = s.double_area()\n        println(\"${s.name()} corners=${s.corners()} area2=${d}\")\n        total += d\n        if d > best {\n            best = d\n            best_name = s.name()\n        }\n    }\n    println(\"total area2=${total}\")\n    if best < 0 {\n        println(\"largest=none\")\n    } else {\n        println(\"largest=${best_name} area2=${best}\")\n    }\n}\n",

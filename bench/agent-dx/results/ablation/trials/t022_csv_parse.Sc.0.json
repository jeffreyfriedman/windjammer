 "final_source": "use std::io\n\nfn parse(line: string) -> string {\n    let cs: Vec<char> = line.chars().collect()\n    let n: int = cs.len() as int\n    let mut fields: Vec<string> = []\n    let mut cur = \"\"\n    let mut i: int = 0\n    let mut inq = false\n    while i < n {\n        let c = cs[i as usize]\n        if inq {\n            if c == '\"' {\n                if i + 1 < n && cs[(i + 1) as usize] == '\"' {\n                    cur = cur + \"\\\"\"\n                    i += 1\n                } else {\n                    inq = false\n                }\n            } else {\n                cur = cur + c.to_string()\n            }\n        } else if c == '\"' {\n            inq = true\n        } else if c == ',' {\n            fields.push(cur)\n            cur = \"\"\n        } else {\n            cur = cur + c.to_string()\n        }\n        i += 1\n    }\n    fields.push(cur)\n    let mut out = \"${fields.len()}: \"\n    let mut k: int = 0\n    for f in fields {\n        if k > 0 {\n            out = out + \"|\"\n        }\n        out = out + \"[\" + f + \"]\"\n        k += 1\n    }\n    out\n}\n\nfn main() {\n    let text = match io::read_to_string(io::stdin()) {\n        Ok(t) => t,\n        Err(_) => \"\"\n    }\n    for l in text.lines() {\n        println(parse(l))\n    }\n}\n",

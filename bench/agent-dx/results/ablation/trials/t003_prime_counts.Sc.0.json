 "final_source": "use std::fs\n\nfn main() {\n    let data = fs::read_to_string(\"/dev/stdin\").unwrap_or(\"\")\n    let n = 200001\n    let mut sieve = []\n    let mut cnt = []\n    let mut last = []\n    let mut i = 0\n    while i < n {\n        sieve.push(true)\n        cnt.push(0)\n        last.push(-1)\n        i += 1\n    }\n    let mut p = 2\n    while p < n {\n        if sieve[p] && p < 1000 {\n            let mut q = p * p\n            while q < n {\n                sieve[q] = false\n                q += p\n            }\n        }\n        p += 1\n    }\n    let mut c = 0\n    let mut l = -1\n    let mut k = 0\n    while k < n {\n        if k >= 2 && sieve[k] {\n            c += 1\n            l = k\n        }\n        cnt[k] = c\n        last[k] = l\n        k += 1\n    }\n    let mut first = true\n    for tok in data.split_whitespace() {\n        if first {\n            first = false\n            continue\n        }\n        let v: int = tok.parse().unwrap_or(0)\n        if last[v] < 0 {\n            println(\"${cnt[v]} none\")\n        } else {\n            println(\"${cnt[v]} ${last[v]}\")\n        }\n    }\n}\n",

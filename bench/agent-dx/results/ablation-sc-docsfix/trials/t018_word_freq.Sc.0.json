 "final_source": "use std::collections::HashMap\nuse std::fs\n\nfn bump(counts: HashMap<string, int>, w: string) {\n    if counts.contains_key(w) {\n        let n = counts[w]\n        counts.insert(w, n + 1)\n    } else {\n        counts.insert(w, 1)\n    }\n}\n\nfn main() {\n    let text = fs::read_to_string(\"/dev/stdin\").unwrap_or(\"\")\n    let mut k: int = 0\n    let mut counts: HashMap<string, int> = HashMap::new()\n    let mut cur = \"\"\n    let mut in_first = true\n    let mut first = \"\"\n    for c in text.chars() {\n        if in_first {\n            if c == '\\n' {\n                in_first = false\n                k = first.trim().parse::<int>().unwrap_or(0)\n            } else {\n                first = first + c.to_string()\n            }\n            continue\n        }\n        if c.is_ascii_alphanumeric() {\n            cur = cur + c.to_ascii_lowercase().to_string()\n        } else if cur.len() > 0 {\n            bump(counts, cur)\n            cur = \"\"\n        }\n    }\n    if in_first {\n        k = first.trim().parse::<int>().unwrap_or(0)\n    }\n    if cur.len() > 0 {\n        bump(counts, cur)\n    }\n    let mut items: Vec<(string, int)> = []\n    for key in counts.keys() {\n        items.push((key, counts[key]))\n    }\n    items.sort_by(|a, b| {\n        if a.1 != b.1 {\n            return b.1.cmp(a.1)\n        }\n        a.0.cmp(b.0)\n    })\n    let mut i = 0\n    for it in items {\n        if i >= k { break }\n        println(\"${it.0} ${it.1}\")\n        i += 1\n    }\n}\n",

use std::fs
use std::collections::HashMap

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut acts: HashMap<string, int> = HashMap::new()
    let mut malformed = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split(" ").map(|s| s.to_string()).collect()
        if parts.len() != 3 {
            malformed += 1
            continue
        }
        let user = parts[0]
        let action = parts[1]
        let secs = parts[2]
        let mut ok = secs.len() > 0
        for c in secs.chars() {
            if c < '0' || c > '9' {
                ok = false
            }
        }
        if !ok {
            malformed += 1
            continue
        }
        let n: int = secs.parse::<int>().unwrap_or(-1)
        if n < 0 {
            malformed += 1
            continue
        }
        counts.insert(user, counts.get(user).unwrap_or(0) + 1)
        totals.insert(user, totals.get(user).unwrap_or(0) + n)
        let key = "${user}\t${action}"
        acts.insert(key, acts.get(key).unwrap_or(0) + 1)
    }
    let mut users: Vec<string> = []
    for k in counts.keys() {
        users.push(k)
    }
    users.sort_by(|a, b| {
        let ta = totals.get(a).unwrap_or(0)
        let tb = totals.get(b).unwrap_or(0)
        if ta != tb {
            tb.cmp(ta)
        } else {
            a.cmp(b)
        }
    })
    for u in users {
        let mut best = ""
        let mut bc = 0
        for k in acts.keys() {
            let parts: Vec<string> = k.split("\t").map(|s| s.to_string()).collect()
            if parts[0] == u {
                let c = acts.get(k).unwrap_or(0)
                if c > bc || (c == bc && parts[1] < best) {
                    bc = c
                    best = parts[1]
                }
            }
        }
        println("${u} ${counts.get(u).unwrap_or(0)} ${totals.get(u).unwrap_or(0)} ${best}")
    }
    println("malformed: ${malformed}")
}

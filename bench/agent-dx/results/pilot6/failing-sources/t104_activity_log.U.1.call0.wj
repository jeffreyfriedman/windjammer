use std::fs
use std::collections::HashMap

fn all_digits(s: string) -> bool {
    if s.len() == 0 { return false }
    for c in s.chars() {
        if c < '0' || c > '9' { return false }
    }
    true
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut acts: HashMap<string, int> = HashMap::new()
    let mut users: Vec<string> = []
    let mut bad = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split(" ").collect()
        if parts.len() != 3 || !all_digits(parts[2]) {
            bad += 1
            continue
        }
        let u = parts[0]
        let a = parts[1]
        let s: int = parts[2].parse::<int>().unwrap_or(0)
        if !counts.contains_key(u) {
            users.push(u)
            counts.insert(u, 0)
            totals.insert(u, 0)
        }
        counts.insert(u, counts.get(u).unwrap_or(0) + 1)
        totals.insert(u, totals.get(u).unwrap_or(0) + s)
        let key = "${u} ${a}"
        acts.insert(key, acts.get(key).unwrap_or(0) + 1)
    }
    // sort users
    let n: int = users.len() as int
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n - 1 - i {
            let a = users[j]
            let b = users[j + 1]
            let ta = totals.get(a).unwrap_or(0)
            let tb = totals.get(b).unwrap_or(0)
            if ta < tb || (ta == tb && a > b) {
                users[j] = b
                users[j + 1] = a
            }
            j += 1
        }
        i += 1
    }
    // collect actions per user
    let mut keys: Vec<string> = []
    for k in acts.keys() { keys.push(k) }
    for u in users {
        let mut best = ""
        let mut bc = 0
        for k in keys {
            let prefix = "${u} "
            if k.starts_with(prefix) {
                let act = k[prefix.len()..k.len()]
                let c = acts.get(k).unwrap_or(0)
                if c > bc || (c == bc && act < best) {
                    bc = c
                    best = act
                }
            }
        }
        println("${u} ${counts.get(u).unwrap_or(0)} ${totals.get(u).unwrap_or(0)} ${best}")
    }
    println("malformed: ${bad}")
}

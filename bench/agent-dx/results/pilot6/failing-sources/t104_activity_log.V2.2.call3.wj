use std::fs
use std::collections::HashMap

fn all_digits(s: string) -> bool {
    if s.len() == 0 {
        return false
    }
    for c in s.chars() {
        if c < '0' || c > '9' {
            return false
        }
    }
    true
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut pairs: HashMap<string, int> = HashMap::new()
    let mut pair_keys: Vec<string> = []
    let mut user_order: Vec<string> = []
    let mut bad = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split_whitespace().collect()
        if parts.len() != 3 || !all_digits(parts[2]) {
            bad += 1
            continue
        }
        let u = parts[0]
        let secs: int = parts[2].parse::<int>().unwrap_or(0)
        let c = counts.get(u).unwrap_or(0)
        if c == 0 {
            user_order.push(u)
        }
        counts.insert(u, c + 1)
        let t = totals.get(u).unwrap_or(0)
        totals.insert(u, t + secs)
        let key = "${parts[0]} ${parts[1]}"
        let a = pairs.get(key).unwrap_or(0)
        if a == 0 {
            pair_keys.push(key)
        }
        pairs.insert(key, a + 1)
    }
    let mut users: Vec<string> = []
    for k in user_order {
        users.push(k)
    }
    let n: int = users.len() as int
    let mut i = 1
    while i < n {
        let mut j = i
        while j > 0 {
            let a = users[j - 1]
            let b = users[j]
            let ta = totals.get(a).unwrap_or(0)
            let tb = totals.get(b).unwrap_or(0)
            let swap = tb > ta || (tb == ta && b < a)
            if !swap {
                break
            }
            users[j - 1] = b
            users[j] = a
            j -= 1
        }
        i += 1
    }
    let mut best: HashMap<string, string> = HashMap::new()
    let mut bestc: HashMap<string, int> = HashMap::new()
    for key in pair_keys {
        let ps: Vec<string> = key.split_whitespace().collect()
        let u = ps[0]
        let act = ps[1]
        let v = pairs.get(key).unwrap_or(0)
        let bc = bestc.get(u).unwrap_or(0)
        let cur = best.get(u).unwrap_or("")
        if v > bc || (v == bc && act < cur) {
            best.insert(u, act)
            bestc.insert(u, v)
        }
    }
    for u in users {
        println("${u} ${counts.get(u).unwrap_or(0)} ${totals.get(u).unwrap_or(0)} ${best.get(u).unwrap_or("")}")
    }
    println("malformed: ${bad}")
}

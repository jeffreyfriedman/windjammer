use std::fs
use std::collections::HashMap

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut k: int = 0
    let mut first = true
    let mut counts: HashMap<string, int> = HashMap::new()
    for line in text.lines() {
        if first {
            first = false
            k = line.trim().parse::<int>().unwrap_or(0)
            continue
        }
        let mut cur = ""
        for c in line.chars() {
            if c.is_ascii_alphanumeric() {
                cur = cur + c.to_ascii_lowercase().to_string()
            } else {
                if cur.len() > 0 {
                    let n = counts.get(&cur).cloned().unwrap_or(0)
                    counts.insert(cur.clone(), n + 1)
                    cur = ""
                }
            }
        }
        if cur.len() > 0 {
            let n = counts.get(&cur).cloned().unwrap_or(0)
            counts.insert(cur.clone(), n + 1)
        }
    }
    let mut items: Vec<(string, int)> = []
    for (w, c) in counts.iter() {
        items.push((w.clone(), *c))
    }
    items.sort_by(|a, b| {
        if a.1 != b.1 {
            b.1.cmp(&a.1)
        } else {
            a.0.cmp(&b.0)
        }
    })
    let mut i: int = 0
    for item in items.iter() {
        if i >= k {
            break
        }
        println("{} {}", item.0, item.1)
        i = i + 1
    }
}

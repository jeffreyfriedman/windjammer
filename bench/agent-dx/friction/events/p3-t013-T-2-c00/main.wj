use std::fs

struct Tree {
    keys: Vec<int>,
    left: Vec<int>,
    right: Vec<int>,
    root: int,
    out: Vec<int>,
    found: bool,
}

impl Tree {
    fn has(self, x: int) -> bool {
        let mut n = self.root
        while n != -1 {
            let k = self.keys[n as usize]
            if k == x {
                return true
            }
            if x < k {
                n = self.left[n as usize]
            } else {
                n = self.right[n as usize]
            }
        }
        false
    }

    fn add(self, x: int) {
        self.keys.push(x)
        self.left.push(-1)
        self.right.push(-1)
        let id: int = self.keys.len() as int - 1
        if self.root == -1 {
            self.root = id
            return
        }
        let mut n = self.root
        loop {
            if x < self.keys[n as usize] {
                let l = self.left[n as usize]
                if l == -1 {
                    self.left[n as usize] = id
                    return
                }
                n = l
            } else {
                let r = self.right[n as usize]
                if r == -1 {
                    self.right[n as usize] = id
                    return
                }
                n = r
            }
        }
    }

    fn remove_min(self, n: int) -> int {
        if self.left[n as usize] == -1 {
            return self.right[n as usize]
        }
        let l = self.left[n as usize]
        let nl = self.remove_min(l)
        self.left[n as usize] = nl
        n
    }

    fn leftmost(self, n: int) -> int {
        let mut c = n
        while self.left[c as usize] != -1 {
            c = self.left[c as usize]
        }
        c
    }

    fn del(self, n: int, x: int) -> int {
        if n == -1 {
            return -1
        }
        let k = self.keys[n as usize]
        if x < k {
            let l = self.left[n as usize]
            let nl = self.del(l, x)
            self.left[n as usize] = nl
            return n
        }
        if x > k {
            let r = self.right[n as usize]
            let nr = self.del(r, x)
            self.right[n as usize] = nr
            return n
        }
        self.found = true
        let l = self.left[n as usize]
        let r = self.right[n as usize]
        if l == -1 {
            return r
        }
        if r == -1 {
            return l
        }
        let s = self.leftmost(r)
        let nr = self.remove_min(r)
        self.right[s as usize] = nr
        self.left[s as usize] = l
        s
    }

    fn walk(self, n: int) {
        if n == -1 {
            return
        }
        let l = self.left[n as usize]
        self.walk(l)
        self.out.push(self.keys[n as usize])
        let r = self.right[n as usize]
        self.walk(r)
    }

    fn height(self, n: int) -> int {
        if n == -1 {
            return 0
        }
        let a = self.height(self.left[n as usize])
        let b = self.height(self.right[n as usize])
        if a > b { a + 1 } else { b + 1 }
    }
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut t = Tree { keys: [], left: [], right: [], root: -1, out: [], found: false }
    for line in text.lines() {
        let parts: Vec<string> = line.trim().split(" ").collect()
        if parts.len() == 0 {
            continue
        }
        let cmd = parts[0]
        if cmd == "insert" {
            let x: int = parts[1].parse().unwrap_or(0)
            if t.has(x) {
                println("dup")
            } else {
                t.add(x)
                println("ok")
            }
        } else if cmd == "contains" {
            let x: int = parts[1].parse().unwrap_or(0)
            if t.has(x) { println("yes") } else { println("no") }
        } else if cmd == "delete" {
            let x: int = parts[1].parse().unwrap_or(0)
            t.found = false
            let r = t.root
            let nr = t.del(r, x)
            t.root = nr
            if t.found { println("ok") } else { println("missing") }
        } else if cmd == "inorder" {
            t.out = []
            let r = t.root
            t.walk(r)
            if t.out.len() == 0 {
                println("<empty>")
            } else {
                let mut s = ""
                let mut first = true
                for v in t.out {
                    if !first {
                        s = s + " "
                    }
                    first = false
                    s = s + "${v}"
                }
                println(s)
            }
        } else if cmd == "height" {
            let r = t.root
            println("${t.height(r)}")
        } else if cmd == "min" {
            if t.root == -1 {
                println("empty")
            } else {
                let r = t.root
                println("${t.keys[t.leftmost(r) as usize]}")
            }
        } else if cmd == "max" {
            if t.root == -1 {
                println("empty")
            } else {
                let mut c = t.root
                while t.right[c as usize] != -1 {
                    c = t.right[c as usize]
                }
                println("${t.keys[c as usize]}")
            }
        }
    }
}

use std::fs
use std::collections::HashMap

fn all_digits(s: string) -> bool {
    if s.len() == 0 {
        return false
    }
    for c in s.chars() {
        if c < '0' || c > '9' {
            return false
        }
    }
    true
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut acts: HashMap<string, int> = HashMap::new()
    let mut bad = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split_whitespace().map(|p| p.to_string()).collect()
        if parts.len() != 3 || !all_digits(parts[2]) {
            bad += 1
            continue
        }
        let r = parts[2].parse::<int>()
        if r.is_err() {
            bad += 1
            continue
        }
        let secs: int = r.unwrap_or(0)
        let u = parts[0]
        let key = "${u}\t${parts[1]}"
        counts.insert(u, counts.get(u).unwrap_or(0) + 1)
        totals.insert(u, totals.get(u).unwrap_or(0) + secs)
        acts.insert(key, acts.get(key).unwrap_or(0) + 1)
    }
    let mut users: Vec<string> = []
    for k in counts.keys() {
        users.push(k)
    }
    users.sort_by(|a, b| {
        let ta = totals.get(a).unwrap_or(0)
        let tb = totals.get(b).unwrap_or(0)
        if ta != tb {
            tb.cmp(ta)
        } else {
            a.cmp(b)
        }
    })
    for u in users {
        let mut best = ""
        let mut bc = 0
        for k in acts.keys() {
            let ps: Vec<string> = k.split("\t").map(|p| p.to_string()).collect()
            if ps[0] == u {
                let c = acts.get(k).unwrap_or(0)
                if c > bc || (c == bc && ps[1] < best) {
                    bc = c
                    best = ps[1]
                }
            }
        }
        println("${u} ${counts.get(u).unwrap_or(0)} ${totals.get(u).unwrap_or(0)} ${best}")
    }
    println("malformed: ${bad}")
}

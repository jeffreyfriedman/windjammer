use std::fs
use std::env
use std::process

fn emit(text: string, number: bool, counter: int) -> int {
    let mut c = counter
    if !number {
        print(text)
        return c
    }
    let parts: Vec<string> = text.split("\n").collect()
    let n: int = parts.len() as int
    let mut i = 0
    while i < n {
        let last = i == n - 1
        if last && parts[i as usize] == "" {
            break
        }
        c += 1
        println("${c:>6}\t${parts[i as usize]}")
        i += 1
    }
    c
}

fn main() {
    let mut number = false
    let mut names: Vec<string> = []
    let mut first = true
    for a in env::args() {
        if first {
            first = false
            continue
        }
        if a == "-n" {
            number = true
        } else {
            names.push(a)
        }
    }
    let mut counter = 0
    let mut failed = false
    if names.len() == 0 {
        let text = fs::read_to_string("/dev/stdin").unwrap_or("")
        counter = emit(text, number, counter)
    } else {
        for name in names {
            match fs::read_to_string(name) {
                Ok(t) => {
                    counter = emit(t, number, counter)
                }
                Err(_) => {
                    println("cat: ${name}: No such file")
                    failed = true
                }
            }
        }
    }
    if failed {
        process::exit(1)
    }
}

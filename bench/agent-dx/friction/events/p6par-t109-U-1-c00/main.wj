use std::fs

fn fail() {
    println("error")
    std::process::exit(1)
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let lines: Vec<string> = text.lines().collect()
    if lines.len() == 0 {
        fail()
        return
    }
    let mut dims: Vec<int> = []
    for tok in lines[0].split_whitespace() {
        match tok.parse::<int>() {
            Ok(v) => dims.push(v),
            Err(_) => {
                fail()
                return
            }
        }
    }
    if dims.len() != 2 || dims[0] < 1 || dims[1] < 1 {
        fail()
        return
    }
    let r = dims[0]
    let c = dims[1]
    if (lines.len() as int) < r + 1 {
        fail()
        return
    }
    let mut grid: Vec<Vec<int>> = []
    let mut i: int = 0
    while i < r {
        let mut row: Vec<int> = []
        for tok in lines[(i + 1) as usize].split_whitespace() {
            match tok.parse::<int>() {
                Ok(v) => row.push(v),
                Err(_) => {
                    fail()
                    return
                }
            }
        }
        if (row.len() as int) != c {
            fail()
            return
        }
        grid.push(row)
        i += 1
    }
    let mut out: Vec<string> = []
    let mut top: int = 0
    let mut bot: int = r - 1
    let mut left: int = 0
    let mut right: int = c - 1
    while top <= bot && left <= right {
        let mut j = left
        while j <= right {
            out.push("${grid[top as usize][j as usize]}")
            j += 1
        }
        top += 1
        let mut k = top
        while k <= bot {
            out.push("${grid[k as usize][right as usize]}")
            k += 1
        }
        right -= 1
        if top <= bot {
            let mut j2 = right
            while j2 >= left {
                out.push("${grid[bot as usize][j2 as usize]}")
                j2 -= 1
            }
            bot -= 1
        }
        if left <= right {
            let mut k2 = bot
            while k2 >= top {
                out.push("${grid[k2 as usize][left as usize]}")
                k2 -= 1
            }
            left += 1
        }
    }
    println(out.join(" "))
}

use std::fs

fn is_int(t: string) -> bool {
    let cs: Vec<char> = t.chars().collect()
    let n: int = cs.len() as int
    if n == 0 {
        return false
    }
    let mut i: int = 0
    if cs[0] == '-' {
        i = 1
        if n == 1 {
            return false
        }
    }
    while i < n {
        let c = cs[i as usize]
        if c < '0' || c > '9' {
            return false
        }
        i = i + 1
    }
    true
}

fn to_int(t: string) -> int {
    let cs: Vec<char> = t.chars().collect()
    let n: int = cs.len() as int
    let mut neg = false
    let mut i: int = 0
    if cs[0] == '-' {
        neg = true
        i = 1
    }
    let mut v: int = 0
    while i < n {
        let d: int = (cs[i as usize] as int) - 48
        v = v * 10 + d
        i = i + 1
    }
    if neg {
        -v
    } else {
        v
    }
}

fn eval(line: string) -> string {
    let mut st: Vec<int> = Vec::new()
    for t in line.split(" ") {
        if t == "" {
            continue
        }
        if t == "+" || t == "-" || t == "*" || t == "/" {
            if st.len() < 2 {
                return "error: underflow"
            }
            let b = st.pop().unwrap()
            let a = st.pop().unwrap()
            if t == "+" {
                st.push(a + b)
            } else if t == "-" {
                st.push(a - b)
            } else if t == "*" {
                st.push(a * b)
            } else {
                if b == 0 {
                    return "error: divzero"
                }
                st.push(a / b)
            }
        } else if is_int(t) {
            st.push(to_int(t))
        } else {
            return "error: token"
        }
    }
    if st.len() != 1 {
        return "error: leftover"
    }
    format!("{}", st[0])
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    for line in text.lines() {
        if line.trim() == "" {
            continue
        }
        println!("{}", eval(line.trim()))
    }
}

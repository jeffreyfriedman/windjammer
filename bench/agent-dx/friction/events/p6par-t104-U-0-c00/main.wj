use std::fs
use std::collections::HashMap

fn all_digits(s: string) -> bool {
    if s.len() == 0 {
        return false
    }
    for c in s.chars() {
        if c < '0' || c > '9' {
            return false
        }
    }
    true
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut acts: HashMap<string, int> = HashMap::new()
    let mut users: Vec<string> = []
    let mut bad = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split(" ").collect()
        if parts.len() != 3 || !all_digits(parts[2]) {
            bad += 1
            continue
        }
        let u = parts[0]
        let a = parts[1]
        let secs: int = parts[2].parse::<int>().unwrap_or(0)
        if !counts.contains_key(u) {
            users.push(u)
            counts.insert(u, 0)
            totals.insert(u, 0)
        }
        counts.insert(u, counts.get(u).unwrap_or(0) + 1)
        totals.insert(u, totals.get(u).unwrap_or(0) + secs)
        let key = "${u} ${a}"
        acts.insert(key, acts.get(key).unwrap_or(0) + 1)
    }
    users.sort_by(|x, y| {
        let tx = totals.get(x).unwrap_or(0)
        let ty = totals.get(y).unwrap_or(0)
        if tx != ty {
            ty.cmp(tx)
        } else {
            x.cmp(y)
        }
    })
    for u in users {
        let mut best = ""
        let mut bc = 0
        for line in text.lines() {
            let parts: Vec<string> = line.split(" ").collect()
            if parts.len() != 3 || !all_digits(parts[2]) || parts[0] != u {
                continue
            }
            let c = acts.get("${u} ${parts[1]}").unwrap_or(0)
            if c > bc || (c == bc && parts[1] < best) {
                bc = c
                best = parts[1]
            }
        }
        println("${u} ${counts.get(u).unwrap_or(0)} ${totals.get(u).unwrap_or(0)} ${best}")
    }
    println("malformed: ${bad}")
}

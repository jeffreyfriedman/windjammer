use std::fs

fn is_leap(y: int) -> bool {
    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn days_in_month(y: int, m: int) -> int {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 || m == 6 || m == 9 || m == 11 {
        30
    } else {
        31
    }
}

// returns days since 1970-01-01, or -1000000 if invalid
fn parse_date(s: string) -> int {
    let cs: Vec<char> = s.chars().collect()
    if cs.len() != 10 {
        return -1000000
    }
    let mut vals: Vec<int> = []
    let mut i = 0
    while i < 10 {
        let c = cs[i]
        if i == 4 || i == 7 {
            if c != '-' {
                return -1000000
            }
        } else {
            if c < '0' || c > '9' {
                return -1000000
            }
            vals.push((c as int) - 48)
        }
        i += 1
    }
    let y = vals[0] * 1000 + vals[1] * 100 + vals[2] * 10 + vals[3]
    let m = vals[4] * 10 + vals[5]
    let d = vals[6] * 10 + vals[7]
    if y < 1900 || y > 2100 || m < 1 || m > 12 || d < 1 || d > days_in_month(y, m) {
        return -1000000
    }
    let yy = if m <= 2 { y - 1 } else { y }
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = (m + 9) % 12
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    for line in text.lines() {
        let parts: Vec<string> = line.split_whitespace().map(|p| p.to_string()).collect()
        if parts.len() == 0 {
            continue
        }
        if parts.len() != 2 {
            println("invalid")
            continue
        }
        let a = parse_date(parts[0])
        let b = parse_date(parts[1])
        if a == -1000000 || b == -1000000 {
            println("invalid")
            continue
        }
        let lo = if a < b { a } else { b }
        let diff = if a < b { b - a } else { a - b }
        let wd = ((lo + 4) % 7 + 7) % 7
        println("${diff} ${names[wd as usize]}")
    }
}

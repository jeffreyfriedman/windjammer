use std::fs
use std::collections::HashMap

fn all_digits(s: string) -> bool {
    if s.len() == 0 {
        return false
    }
    for c in s.chars() {
        if c < '0' || c > '9' {
            return false
        }
    }
    true
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut actions: HashMap<string, int> = HashMap::new()
    let mut users: Vec<string> = []
    let mut bad = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split(" ").map(|p| p.to_string()).collect()
        if parts.len() != 3 || !all_digits(parts[2]) {
            bad += 1
            continue
        }
        let u = parts[0]
        let secs: int = parts[2].parse::<int>().unwrap_or(0)
        if !counts.contains_key(u) {
            users.push(u)
            counts.insert(u, 0)
            totals.insert(u, 0)
        }
        counts.insert(u, counts.get(u).unwrap_or(0) + 1)
        totals.insert(u, totals.get(u).unwrap_or(0) + secs)
        let key = "${u} ${parts[1]}"
        actions.insert(key, actions.get(key).unwrap_or(0) + 1)
    }
    let n: int = users.len() as int
    let mut i = 1
    while i < n {
        let mut j = i
        while j > 0 {
            let a = users[j - 1]
            let b = users[j]
            let ta = totals.get(a).unwrap_or(0)
            let tb = totals.get(b).unwrap_or(0)
            if tb > ta || (tb == ta && b < a) {
                users[j - 1] = b
                users[j] = a
                j -= 1
            } else {
                break
            }
        }
        i += 1
    }
    // best action per user
    let mut best: HashMap<string, string> = HashMap::new()
    let mut bestc: HashMap<string, int> = HashMap::new()
    let mut keys: Vec<string> = []
    for k in actions.keys() {
        keys.push(k)
    }
    for k in keys {
        let idx = k.find(" ").unwrap_or(0)
        let u = k[0..idx]
        let act = k[idx + 1..k.len()]
        let c = actions.get(k).unwrap_or(0)
        let bc = bestc.get(u).unwrap_or(0)
        let ba = best.get(u).unwrap_or("")
        if c > bc || (c == bc && act < ba) {
            bestc.insert(u, c)
            best.insert(u, act)
        }
    }
    for u in users {
        println("${u} ${counts.get(u).unwrap_or(0)} ${totals.get(u).unwrap_or(0)} ${best.get(u).unwrap_or("")}")
    }
    println("malformed: ${bad}")
}

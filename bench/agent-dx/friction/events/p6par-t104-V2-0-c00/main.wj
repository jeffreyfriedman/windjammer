use std::fs
use std::collections::HashMap

fn all_digits(s: string) -> bool {
    if s.len() == 0 {
        return false
    }
    for c in s.chars() {
        if c < '0' || c > '9' {
            return false
        }
    }
    true
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut pairs: HashMap<string, int> = HashMap::new()
    let mut bad = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split(" ").collect()
        if parts.len() != 3 || !all_digits(parts[2]) {
            bad += 1
            continue
        }
        let user = parts[0]
        let secs: int = parts[2].parse::<int>().unwrap_or(0)
        counts.insert(user, counts.get(user).unwrap_or(0) + 1)
        totals.insert(user, totals.get(user).unwrap_or(0) + secs)
        let key = "${user}\t${parts[1]}"
        pairs.insert(key, pairs.get(key).unwrap_or(0) + 1)
    }
    let mut users: Vec<string> = []
    for u in counts.keys() {
        users.push(u)
    }
    users.sort_by(|a, b| {
        let ta = totals.get(a).unwrap_or(0)
        let tb = totals.get(b).unwrap_or(0)
        if ta != tb {
            tb.cmp(ta)
        } else {
            a.cmp(b)
        }
    })
    for u in users {
        let mut best = ""
        let mut bestn = 0
        for k in pairs.keys() {
            let kp: Vec<string> = k.split("\t").collect()
            if kp[0] == u {
                let n = pairs.get(k).unwrap_or(0)
                if n > bestn || (n == bestn && kp[1] < best) {
                    bestn = n
                    best = kp[1]
                }
            }
        }
        println("${u} ${counts.get(u).unwrap_or(0)} ${totals.get(u).unwrap_or(0)} ${best}")
    }
    println("malformed: ${bad}")
}

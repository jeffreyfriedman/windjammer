use std::fs

fn main() {
    let digits = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    for line in text.lines() {
        let parts: Vec<string> = line.split_whitespace().collect()
        if parts.len() < 3 {
            continue
        }
        let from: int = parts[1].parse().unwrap_or(10)
        let to: int = parts[2].parse().unwrap_or(10)
        let mut v: int = 0
        for c in parts[0].chars() {
            let mut d: int = 0
            let mut i: int = 0
            for dc in digits.chars() {
                if dc == c {
                    d = i
                }
                i = i + 1
            }
            v = v * from + d
        }
        if v == 0 {
            println("0")
            continue
        }
        let mut out = ""
        while v > 0 {
            let r: int = v % to
            let ri: usize = r as usize
            out = digits.as_str()[ri..ri + 1] + out
            v = v / to
        }
        println("${out}")
    }
}

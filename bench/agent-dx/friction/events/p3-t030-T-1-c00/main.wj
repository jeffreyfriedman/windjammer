use std::fs
use std::collections::HashMap

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut acc: HashMap<string, int> = HashMap::new()
    for line in text.lines() {
        let p: Vec<string> = line.split_whitespace().map(|x| x.to_string()).collect()
        if p.len() == 0 {
            continue
        }
        let cmd = p[0].clone()
        if cmd == "balance" {
            let n = p[1].clone()
            if acc.contains_key(n) {
                println("${acc.get(n).unwrap_or(0)}")
            } else {
                println("error: unknown account ${n}")
            }
        } else if cmd == "open" {
            let n = p[1].clone()
            let a: int = p[2].parse::<int>().unwrap_or(0)
            if a < 0 {
                println("error: invalid amount")
            } else if acc.contains_key(n) {
                println("error: duplicate account")
            } else {
                acc.insert(n, a)
                println("ok")
            }
        } else if cmd == "deposit" || cmd == "withdraw" {
            let n = p[1].clone()
            let a: int = p[2].parse::<int>().unwrap_or(0)
            if a <= 0 {
                println("error: invalid amount")
            } else if !acc.contains_key(n) {
                println("error: unknown account ${n}")
            } else {
                let b = acc.get(n).unwrap_or(0)
                if cmd == "deposit" {
                    acc.insert(n, b + a)
                    println("ok")
                } else if b < a {
                    println("error: insufficient funds")
                } else {
                    acc.insert(n, b - a)
                    println("ok")
                }
            }
        } else if cmd == "transfer" {
            let f = p[1].clone()
            let t = p[2].clone()
            let a: int = p[3].parse::<int>().unwrap_or(0)
            if a <= 0 {
                println("error: invalid amount")
            } else if !acc.contains_key(f) {
                println("error: unknown account ${f}")
            } else if !acc.contains_key(t) {
                println("error: unknown account ${t}")
            } else if f == t {
                println("error: same account")
            } else {
                let fb = acc.get(f).unwrap_or(0)
                if fb < a {
                    println("error: insufficient funds")
                } else {
                    let tb = acc.get(t).unwrap_or(0)
                    acc.insert(f, fb - a)
                    acc.insert(t, tb + a)
                    println("ok")
                }
            }
        }
    }
    let mut keys: Vec<string> = acc.keys().map(|k| k.to_string()).collect()
    keys.sort()
    for k in keys {
        println("${k} ${acc.get(k).unwrap_or(0)}")
    }
}

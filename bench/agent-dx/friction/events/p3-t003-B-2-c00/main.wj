use std::fs

fn main() {
    let limit = 200001
    let mut sieve: Vec<bool> = [true; 200001]
    let mut counts: Vec<int> = [0; 200001]
    let mut largest: Vec<int> = [0; 200001]
    let mut c = 0
    let mut last = 0
    let mut i = 0
    while i < limit {
        if i < 2 {
            sieve[i] = false
        } else if sieve[i] {
            c += 1
            last = i
            let mut j = i * i
            while j < limit {
                sieve[j] = false
                j += i
            }
        }
        counts[i] = c
        largest[i] = last
        i += 1
    }
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut tokens: Vec<string> = []
    for t in text.split_whitespace() {
        tokens.push(t)
    }
    if tokens.len() == 0 {
        return
    }
    let t: int = tokens[0].parse::<int>().unwrap_or(0)
    let mut k = 1
    while k <= t && k < tokens.len() {
        let n: int = tokens[k].parse::<int>().unwrap_or(0)
        if largest[n] == 0 {
            println("0 none")
        } else {
            println("${counts[n]} ${largest[n]}")
        }
        k += 1
    }
}

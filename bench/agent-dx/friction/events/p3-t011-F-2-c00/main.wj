use std::fs

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut cap: int = 0
    let mut first = true
    let mut ks: Vec<int> = []
    let mut vs: Vec<int> = []
    for line in text.lines() {
        let parts = line.split_whitespace().collect::<Vec<string>>()
        if parts.len() == 0 {
            continue
        }
        if first {
            cap = parts[0].parse::<int>().unwrap_or(1)
            first = false
            continue
        }
        let cmd = parts[0]
        if cmd == "put" {
            let k = parts[1].parse::<int>().unwrap_or(0)
            let v = parts[2].parse::<int>().unwrap_or(0)
            let mut nk: Vec<int> = []
            let mut nv: Vec<int> = []
            let n: int = ks.len() as int
            let mut i: int = 0
            while i < n {
                if ks[i as usize] != k {
                    nk.push(ks[i as usize])
                    nv.push(vs[i as usize])
                }
                i += 1
            }
            nk.push(k)
            nv.push(v)
            if nk.len() as int > cap {
                println("evict ${nk[0]}")
                let mut ak: Vec<int> = []
                let mut av: Vec<int> = []
                let mut j: int = 1
                while j < nk.len() as int {
                    ak.push(nk[j as usize])
                    av.push(nv[j as usize])
                    j += 1
                }
                nk = ak
                nv = av
            }
            ks = nk
            vs = nv
        } else if cmd == "get" {
            let k = parts[1].parse::<int>().unwrap_or(0)
            let n: int = ks.len() as int
            let mut found: int = -1
            let mut res: int = -1
            let mut nk: Vec<int> = []
            let mut nv: Vec<int> = []
            let mut i: int = 0
            while i < n {
                if ks[i as usize] == k {
                    found = 1
                    res = vs[i as usize]
                } else {
                    nk.push(ks[i as usize])
                    nv.push(vs[i as usize])
                }
                i += 1
            }
            if found == 1 {
                nk.push(k)
                nv.push(res)
                ks = nk
                vs = nv
            }
            println("${res}")
        } else if cmd == "keys" {
            if ks.len() == 0 {
                println("<empty>")
            } else {
                let mut out = ""
                let mut i: int = ks.len() as int - 1
                while i >= 0 {
                    if out != "" {
                        out = out + " "
                    }
                    out = out + "${ks[i as usize]}"
                    i -= 1
                }
                println(out)
            }
        }
    }
}

use std::fs

fn is_int(t: string) -> bool {
    let cs: Vec<char> = t.chars().collect()
    let n: int = cs.len() as int
    if n == 0 {
        return false
    }
    let mut i: int = 0
    if cs[0] == '-' {
        i = 1
        if n == 1 {
            return false
        }
    }
    while i < n {
        let c = cs[i as usize]
        if c < '0' || c > '9' {
            return false
        }
        i += 1
    }
    true
}

fn eval(line: string) -> string {
    let mut st: Vec<int> = []
    for t in line.split(" ") {
        if t == "+" || t == "-" || t == "*" || t == "/" {
            if st.len() < 2 {
                return "error: underflow"
            }
            let b = st.pop().unwrap()
            let a = st.pop().unwrap()
            if t == "+" {
                st.push(a + b)
            } else if t == "-" {
                st.push(a - b)
            } else if t == "*" {
                st.push(a * b)
            } else {
                if b == 0 {
                    return "error: divzero"
                }
                st.push(a / b)
            }
        } else if is_int(t) {
            st.push(t.parse::<int>().unwrap())
        } else {
            return "error: token"
        }
    }
    if st.len() != 1 {
        return "error: leftover"
    }
    st[0].to_string()
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    for line in text.lines() {
        let l = line.trim()
        if l.len() == 0 {
            continue
        }
        println("{}", eval(l))
    }
}

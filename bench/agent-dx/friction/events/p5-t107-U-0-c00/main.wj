use std::fs

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut first = true
    let mut width: int = 0
    let mut ok = true
    let mut rest = ""
    let mut idx = 0
    for line in text.lines() {
        if idx == 0 {
            let t = line.trim()
            match t.parse::<int>() {
                Ok(n) => {
                    if n > 0 { width = n } else { ok = false }
                }
                Err(_) => { ok = false }
            }
        }
        idx += 1
    }
    if idx == 0 { ok = false }
    if !ok {
        println("error: bad width")
        std::process::exit(1)
    }
    let mut cur = ""
    let mut curlen: int = 0
    let mut i = 0
    for line in text.lines() {
        if i > 0 {
            for w in line.split_whitespace() {
                let wl: int = w.len() as int
                if curlen == 0 {
                    cur = w
                    curlen = wl
                } else if curlen + 1 + wl <= width {
                    cur = "${cur} ${w}"
                    curlen = curlen + 1 + wl
                } else {
                    println("${cur}")
                    cur = w
                    curlen = wl
                }
            }
        }
        i += 1
    }
    if curlen > 0 {
        println("${cur}")
    }
}

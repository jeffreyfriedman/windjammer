use std::fs
use std::collections::HashMap

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut k: int = 0
    let mut first = true
    let mut cur = ""
    for line in text.lines() {
        if first {
            first = false
            k = line.trim().parse::<int>().unwrap_or(0)
            continue
        }
        let l = line.to_lowercase() + " "
        for c in l.chars() {
            if c.is_ascii_alphanumeric() {
                cur = cur + c.to_string()
            } else if cur.len() > 0 {
                let n = counts.get(cur).unwrap_or(0)
                counts.insert(cur, n + 1)
                cur = ""
            }
        }
    }
    let mut items: Vec<(string, int)> = []
    for (w, c) in counts {
        items.push((w, c))
    }
    items.sort_by(|a, b| {
        if a.1 != b.1 {
            b.1.cmp(a.1)
        } else {
            a.0.cmp(b.0)
        }
    })
    let mut i: int = 0
    for it in items {
        if i >= k {
            break
        }
        println("${it.0} ${it.1}")
        i += 1
    }
}

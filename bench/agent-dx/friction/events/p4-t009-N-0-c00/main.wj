use std::fs

fn parse_num(t: string) -> Option<int> {
    let mut neg = false
    let mut val: int = 0
    let mut count: int = 0
    for c in t.chars() {
        if count == 0 && c == '-' {
            neg = true
        } else if c >= '0' && c <= '9' {
            val = val * 10 + ((c as int) - 48)
            count += 1
        } else {
            return None
        }
    }
    if count == 0 {
        return None
    }
    if neg {
        Some(0 - val)
    } else {
        Some(val)
    }
}

fn eval(line: string) -> string {
    let mut st: Vec<int> = []
    for t in line.split(" ") {
        if t == "+" || t == "-" || t == "*" || t == "/" {
            if st.len() < 2 {
                return "error: underflow"
            }
            let b = st.pop().unwrap()
            let a = st.pop().unwrap()
            if t == "+" {
                st.push(a + b)
            } else if t == "-" {
                st.push(a - b)
            } else if t == "*" {
                st.push(a * b)
            } else {
                if b == 0 {
                    return "error: divzero"
                }
                st.push(a / b)
            }
        } else {
            match parse_num(t) {
                Some(v) => st.push(v),
                None => return "error: token",
            }
        }
    }
    if st.len() != 1 {
        return "error: leftover"
    }
    st[0].to_string()
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    for line in text.lines() {
        let l = line.trim()
        if l.len() == 0 {
            continue
        }
        println(eval(l))
    }
}

use std::fs

trait Pricing {
    fn total(self, qty: int, unit: int) -> int
}

struct Plain {}
struct Bulk {}
struct Member {}

impl Pricing for Plain {
    fn total(self, qty: int, unit: int) -> int {
        qty * unit
    }
}

impl Pricing for Bulk {
    fn total(self, qty: int, unit: int) -> int {
        let base = qty * unit
        if qty >= 10 {
            base - base / 10
        } else {
            base
        }
    }
}

impl Pricing for Member {
    fn total(self, qty: int, unit: int) -> int {
        let base = qty * unit
        let mut t = base - base * 5 / 100
        if qty >= 3 {
            t = t - 100
        }
        if t < 0 {
            t = 0
        }
        t
    }
}

fn fmt(c: int) -> string {
    let d = c / 100
    let r = c % 100
    let body = if r < 10 { "${d}.0${r}" } else { "${d}.${r}" }
    "$" + body
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut sum = 0
    for line in text.lines() {
        let parts: Vec<string> = line.split_whitespace().collect()
        if parts.len() < 4 {
            continue
        }
        let name = parts[0]
        let qty: int = parts[1].parse().unwrap_or(0)
        let unit: int = parts[2].parse().unwrap_or(0)
        let kind = parts[3]
        let mut t = -1
        if kind == "plain" {
            t = Plain {}.total(qty, unit)
        } else if kind == "bulk" {
            t = Bulk {}.total(qty, unit)
        } else if kind == "member" {
            t = Member {}.total(qty, unit)
        }
        if t < 0 {
            println("${name} invalid kind")
        } else {
            sum += t
            println("${name} ${fmt(t)}")
        }
    }
    println("total ${fmt(sum)}")
}

use std::fs

fn all_digits(s: string) -> bool {
    for c in s.chars() {
        if c < '0' || c > '9' {
            return false
        }
    }
    true
}

fn is_leap(y: int) -> bool {
    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn days_to_epoch(y0: int, m: int, d: int) -> int {
    let y = if m <= 2 { y0 - 1 } else { y0 }
    let era = y / 400
    let yoe = y - era * 400
    let mp = (m + 9) % 12
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

// returns days since epoch or -1000000 if invalid
fn parse_date(s: string) -> int {
    let bad = -1000000
    if s.len() != 10 {
        return bad
    }
    if s[4..5] != "-" || s[7..8] != "-" {
        return bad
    }
    let ys = s[0..4]
    let ms = s[5..7]
    let ds = s[8..10]
    if !all_digits(ys) || !all_digits(ms) || !all_digits(ds) {
        return bad
    }
    let y: int = ys.parse::<int>().unwrap_or(0)
    let m: int = ms.parse::<int>().unwrap_or(0)
    let d: int = ds.parse::<int>().unwrap_or(0)
    if m < 1 || m > 12 || d < 1 {
        return bad
    }
    let mut dim = 31
    if m == 4 || m == 6 || m == 9 || m == 11 {
        dim = 30
    } else if m == 2 {
        dim = if is_leap(y) { 29 } else { 28 }
    }
    if d > dim {
        return bad
    }
    days_to_epoch(y, m, d)
}

fn main() {
    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    for line in text.lines() {
        let t = line.trim()
        if t.len() == 0 {
            continue
        }
        let mut parts: Vec<string> = []
        for p in t.split_whitespace() {
            parts.push(p)
        }
        if parts.len() != 2 {
            println("invalid")
            continue
        }
        let a = parse_date(parts[0])
        let b = parse_date(parts[1])
        if a == -1000000 || b == -1000000 {
            println("invalid")
            continue
        }
        let lo = if a < b { a } else { b }
        let diff = if a < b { b - a } else { a - b }
        let wd = ((lo + 4) % 7 + 7) % 7
        println("${diff} ${names[wd as usize]}")
    }
}

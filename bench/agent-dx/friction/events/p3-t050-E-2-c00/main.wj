use std::fs
use std::env
use std::process

fn emit(text: string, number: bool, counter: int) -> int {
    if !number {
        print(text)
        return counter
    }
    let mut c = counter
    for line in text.lines() {
        c = c + 1
        let mut s = "${c}"
        while s.len() < 6 {
            s = " " + s
        }
        println(s + "\t" + line)
    }
    c
}

fn main() {
    let mut number = false
    let mut files: Vec<string> = []
    for a in env::args().skip(1) {
        if a == "-n" {
            number = true
        } else {
            files.push(a)
        }
    }
    let mut counter = 0
    let mut status = 0
    if files.len() == 0 {
        let text = fs::read_to_string("/dev/stdin").unwrap_or("")
        counter = emit(text, number, counter)
    } else {
        for f in files {
            match fs::read_to_string(f) {
                Ok(t) => {
                    counter = emit(t, number, counter)
                }
                Err(_) => {
                    println("cat: ${f}: No such file")
                    status = 1
                }
            }
        }
    }
    if status != 0 {
        process::exit(status)
    }
}

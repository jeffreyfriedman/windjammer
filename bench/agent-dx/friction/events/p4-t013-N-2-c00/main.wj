use std::fs

fn has(keys: &Vec<int>, l: &Vec<int>, r: &Vec<int>, root: int, x: int) -> bool {
    let mut cur = root
    while cur >= 0 {
        let k = keys[cur as usize]
        if x == k {
            return true
        }
        if x < k {
            cur = l[cur as usize]
        } else {
            cur = r[cur as usize]
        }
    }
    false
}

fn del(keys: &mut Vec<int>, l: &mut Vec<int>, r: &mut Vec<int>, node: int, x: int) -> int {
    if node < 0 {
        return -1
    }
    let n = node as usize
    if x < keys[n] {
        let c = l[n]
        let v = del(keys, l, r, c, x)
        l[n] = v
        return node
    }
    if x > keys[n] {
        let c = r[n]
        let v = del(keys, l, r, c, x)
        r[n] = v
        return node
    }
    if l[n] < 0 {
        return r[n]
    }
    if r[n] < 0 {
        return l[n]
    }
    let mut s = r[n]
    while l[s as usize] >= 0 {
        s = l[s as usize]
    }
    let sk = keys[s as usize]
    keys[n] = sk
    let c = r[n]
    let v = del(keys, l, r, c, sk)
    r[n] = v
    node
}

fn walk(keys: &Vec<int>, l: &Vec<int>, r: &Vec<int>, node: int, out: &mut Vec<string>) {
    if node < 0 {
        return
    }
    let n = node as usize
    walk(keys, l, r, l[n], out)
    out.push(keys[n].to_string())
    walk(keys, l, r, r[n], out)
}

fn height(l: &Vec<int>, r: &Vec<int>, node: int) -> int {
    if node < 0 {
        return 0
    }
    let a = height(l, r, l[node as usize])
    let b = height(l, r, r[node as usize])
    if a > b {
        return a + 1
    }
    b + 1
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut keys: Vec<int> = []
    let mut l: Vec<int> = []
    let mut r: Vec<int> = []
    let mut root: int = -1
    for line in text.lines() {
        let parts: Vec<string> = line.split_whitespace().map(|p| p.to_string()).collect()
        if parts.len() == 0 {
            continue
        }
        let cmd = parts[0].clone()
        if cmd == "insert" {
            let x: int = parts[1].parse().unwrap_or(0)
            if has(&keys, &l, &r, root, x) {
                println("dup")
            } else {
                let idx = keys.len() as int
                keys.push(x)
                l.push(-1)
                r.push(-1)
                if root < 0 {
                    root = idx
                } else {
                    let mut cur = root
                    let mut going = true
                    while going {
                        let c = cur as usize
                        if x < keys[c] {
                            if l[c] < 0 {
                                l[c] = idx
                                going = false
                            } else {
                                cur = l[c]
                            }
                        } else {
                            if r[c] < 0 {
                                r[c] = idx
                                going = false
                            } else {
                                cur = r[c]
                            }
                        }
                    }
                }
                println("ok")
            }
        } else if cmd == "contains" {
            let x: int = parts[1].parse().unwrap_or(0)
            if has(&keys, &l, &r, root, x) {
                println("yes")
            } else {
                println("no")
            }
        } else if cmd == "delete" {
            let x: int = parts[1].parse().unwrap_or(0)
            if has(&keys, &l, &r, root, x) {
                root = del(&mut keys, &mut l, &mut r, root, x)
                println("ok")
            } else {
                println("missing")
            }
        } else if cmd == "inorder" {
            let mut out: Vec<string> = []
            walk(&keys, &l, &r, root, &mut out)
            if out.len() == 0 {
                println("<empty>")
            } else {
                println(out.join(" "))
            }
        } else if cmd == "height" {
            println(height(&l, &r, root).to_string())
        } else if cmd == "min" {
            if root < 0 {
                println("empty")
            } else {
                let mut c = root
                while l[c as usize] >= 0 {
                    c = l[c as usize]
                }
                println(keys[c as usize].to_string())
            }
        } else if cmd == "max" {
            if root < 0 {
                println("empty")
            } else {
                let mut c = root
                while r[c as usize] >= 0 {
                    c = r[c as usize]
                }
                println(keys[c as usize].to_string())
            }
        }
    }
}

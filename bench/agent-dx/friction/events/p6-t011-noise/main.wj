use std::fs

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut cap: int = 1
    let mut first = true
    // keys ordered least -> most recently used
    let mut keys: Vec<int> = []
    let mut vals: Vec<int> = []
    for line in text.lines() {
        let parts: Vec<string> = line.split_whitespace().collect()
        if parts.len() == 0 { continue }
        if first {
            cap = parts[0].parse::<int>().unwrap_or(1)
            first = false
            continue
        }
        let cmd = parts[0]
        if cmd == "put" {
            let k = parts[1].parse::<int>().unwrap_or(0)
            let v = parts[2].parse::<int>().unwrap_or(0)
            let mut nk: Vec<int> = []
            let mut nv: Vec<int> = []
            let n: int = keys.len() as int
            let mut i: int = 0
            while i < n {
                if keys[i as usize] != k {
                    nk.push(keys[i as usize])
                    nv.push(vals[i as usize])
                }
                i += 1
            }
            nk.push(k)
            nv.push(v)
            if (nk.len() as int) > cap {
                println("evict ${nk[0]}")
                let mut ak: Vec<int> = []
                let mut av: Vec<int> = []
                let m: int = nk.len() as int
                let mut j: int = 1
                while j < m {
                    ak.push(nk[j as usize])
                    av.push(nv[j as usize])
                    j += 1
                }
                nk = ak
                nv = av
            }
            keys = nk
            vals = nv
        } else if cmd == "get" {
            let k = parts[1].parse::<int>().unwrap_or(0)
            let n: int = keys.len() as int
            let mut found: int = -1
            let mut res: int = -1
            let mut nk: Vec<int> = []
            let mut nv: Vec<int> = []
            let mut i: int = 0
            while i < n {
                if keys[i as usize] == k {
                    found = i
                    res = vals[i as usize]
                } else {
                    nk.push(keys[i as usize])
                    nv.push(vals[i as usize])
                }
                i += 1
            }
            if found >= 0 {
                nk.push(k)
                nv.push(res)
                keys = nk
                vals = nv
            }
            println("${res}")
        } else if cmd == "keys" {
            let n: int = keys.len() as int
            if n == 0 {
                println("<empty>")
            } else {
                let mut out = ""
                let mut i: int = n - 1
                while i >= 0 {
                    if out != "" { out = out + " " }
                    out = out + "${keys[i as usize]}"
                    i -= 1
                }
                println("${out}")
            }
        }
    }
}

use std::fs

fn main() {
    let m = 200000
    let mut sieve: Vec<bool> = []
    let mut cnt: Vec<int> = []
    let mut last: Vec<int> = []
    for i in 0..(m + 1) {
        sieve.push(true)
        cnt.push(0)
        last.push(0)
    }
    let mut i = 2
    while i * i <= m {
        if sieve[i] {
            let mut j = i * i
            while j <= m {
                sieve[j] = false
                j += i
            }
        }
        i += 1
    }
    let mut c = 0
    let mut l = 0
    for k in 2..(m + 1) {
        if sieve[k] {
            c += 1
            l = k
        }
        cnt[k] = c
        last[k] = l
    }
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut first = true
    for line in text.lines() {
        if first {
            first = false
            continue
        }
        let s = line.trim()
        if s.len() == 0 {
            continue
        }
        let n: int = s.parse::<int>().unwrap_or(0)
        if last[n] == 0 {
            println("0 none")
        } else {
            println("${cnt[n]} ${last[n]}")
        }
    }
}

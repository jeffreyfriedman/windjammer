use std::fs

fn prec(op: string) -> int {
    if op == "^" { 3 } else if op == "*" || op == "/" { 2 } else { 1 }
}

fn is_op(t: string) -> bool {
    t == "+" || t == "-" || t == "*" || t == "/" || t == "^"
}

fn is_num(t: string) -> bool {
    if t.len() == 0 { return false }
    for c in t.chars() {
        if c < '0' || c > '9' { return false }
    }
    true
}

fn tokenize(line: string) -> Option<Vec<string>> {
    let cs: Vec<char> = line.chars().collect()
    let mut toks: Vec<string> = []
    let mut i = 0
    while i < cs.len() {
        let c = cs[i]
        if c == ' ' {
            i += 1
        } else if c >= '0' && c <= '9' {
            let mut s = ""
            while i < cs.len() && cs[i] >= '0' && cs[i] <= '9' {
                s = s + cs[i].to_string()
                i += 1
            }
            toks.push(s)
        } else if c == '+' || c == '-' || c == '*' || c == '/' || c == '^' || c == '(' || c == ')' {
            toks.push(c.to_string())
            i += 1
        } else {
            return None
        }
    }
    Some(toks)
}

fn to_rpn(toks: Vec<string>) -> Option<string> {
    if toks.len() == 0 { return None }
    let mut out: Vec<string> = []
    let mut st: Vec<string> = []
    let mut want_operand = true
    for t in toks {
        if is_num(t) {
            if !want_operand { return None }
            out.push(t)
            want_operand = false
        } else if t == "(" {
            if !want_operand { return None }
            st.push(t)
        } else if t == ")" {
            if want_operand { return None }
            while st.len() > 0 && st[st.len() - 1] != "(" {
                out.push(st.pop().unwrap_or(""))
            }
            if st.len() == 0 { return None }
            let _ = st.pop()
        } else {
            if want_operand { return None }
            while st.len() > 0 && st[st.len() - 1] != "(" && (prec(st[st.len() - 1]) > prec(t) || (prec(st[st.len() - 1]) == prec(t) && t != "^")) {
                out.push(st.pop().unwrap_or(""))
            }
            st.push(t)
            want_operand = true
        }
    }
    if want_operand { return None }
    while st.len() > 0 {
        let top = st.pop().unwrap_or("")
        if top == "(" { return None }
        out.push(top)
    }
    Some(out.join(" "))
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    for line in text.lines() {
        if line.trim().len() == 0 { continue }
        match tokenize(line) {
            Some(toks) => {
                match to_rpn(toks) {
                    Some(s) => { println("${s}") }
                    None => { println("error") }
                }
            }
            None => { println("error") }
        }
    }
}

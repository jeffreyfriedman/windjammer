use std::fs

struct Job {
    name: string,
    prio: int,
    seq: int,
}

fn is_int(s: string) -> bool {
    let cs: Vec<char> = s.chars().collect()
    if cs.len() == 0 { return false }
    let mut i = 0
    if cs[0] == '-' { i = 1 }
    if i >= cs.len() { return false }
    while i < cs.len() {
        if cs[i] < '0' || cs[i] > '9' { return false }
        i += 1
    }
    true
}

fn best(q: Vec<Job>) -> int {
    let mut b = 0
    let mut i = 1
    while i < q.len() {
        if q[i].prio > q[b].prio || (q[i].prio == q[b].prio && q[i].seq < q[b].seq) {
            b = i
        }
        i += 1
    }
    b
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut q: Vec<Job> = []
    let mut n = 0
    for line in text.lines() {
        let p: Vec<string> = line.split(" ").collect()
        if p[0] == "add" && p.len() == 3 && is_int(p[2]) {
            q.push(Job { name: p[1], prio: p[2].parse::<int>().unwrap_or(0), seq: n })
            n += 1
        } else if p.len() == 1 && p[0] == "pop" {
            if q.len() == 0 {
                println("empty")
            } else {
                let b = best(q)
                println("${q[b].name}")
                q.remove(b)
            }
        } else if p.len() == 1 && p[0] == "peek" {
            if q.len() == 0 {
                println("empty")
            } else {
                let b = best(q)
                println("${q[b].name}")
            }
        } else if p.len() == 1 && p[0] == "size" {
            println("${q.len()}")
        } else {
            println("error")
        }
    }
    println("left:")
    while q.len() > 0 {
        let b = best(q)
        println("${q[b].name} ${q[b].prio}")
        q.remove(b)
    }
}

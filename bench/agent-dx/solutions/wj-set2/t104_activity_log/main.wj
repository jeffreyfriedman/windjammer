use std::fs
use std::collections::HashMap

fn is_number(s: string) -> bool {
    if s.len() == 0 { return false }
    for c in s.chars() {
        if c < '0' || c > '9' { return false }
    }
    true
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut counts: HashMap<string, int> = HashMap::new()
    let mut totals: HashMap<string, int> = HashMap::new()
    let mut acts: HashMap<string, int> = HashMap::new()
    let mut bad = 0
    for line in text.lines() {
        let p: Vec<string> = line.split(" ").collect()
        if p.len() != 3 || !is_number(p[2]) {
            bad += 1
            continue
        }
        let secs = p[2].parse::<int>().unwrap_or(0)
        counts.insert(p[0], counts.get(p[0]).unwrap_or(0) + 1)
        totals.insert(p[0], totals.get(p[0]).unwrap_or(0) + secs)
        let key = "${p[0]} ${p[1]}"
        acts.insert(key, acts.get(key).unwrap_or(0) + 1)
    }
    let mut names: Vec<string> = []
    let mut sums: Vec<int> = []
    for k in counts.keys() {
        names.push(k.clone())
        sums.push(totals.get(k).unwrap_or(0))
    }
    // insertion sort: total descending, then name ascending
    let mut i = 1
    while i < names.len() {
        let mut j = i
        while j > 0 && (sums[j] > sums[j - 1] || (sums[j] == sums[j - 1] && names[j] < names[j - 1])) {
            let tn = names[j].clone()
            names[j] = names[j - 1].clone()
            names[j - 1] = tn
            let ts = sums[j]
            sums[j] = sums[j - 1]
            sums[j - 1] = ts
            j -= 1
        }
        i += 1
    }
    for n in names {
        let mut top = ""
        let mut top_n = 0
        let mut keys: Vec<string> = []
        for k in acts.keys() {
            keys.push(k.clone())
        }
        keys.sort()
        for k in keys {
            let parts: Vec<string> = k.split(" ").collect()
            if parts[0] == n && acts[k] > top_n {
                top_n = acts[k]
                top = parts[1]
            }
        }
        println("${n} ${counts.get(n).unwrap_or(0)} ${totals.get(n).unwrap_or(0)} ${top}")
    }
    println("malformed: ${bad}")
}

use std::fs

struct Edge {
    a: int,
    b: int,
    w: int,
}

fn is_weight(s: string) -> bool {
    if s.len() == 0 || s.len() > 12 { return false }
    for c in s.chars() {
        if c < '0' || c > '9' { return false }
    }
    let v = s.parse::<int>().unwrap_or(0)
    v >= 1 && v <= 1000000
}

fn index_of(names: Vec<string>, n: string) -> int {
    let mut i = 0
    while i < names.len() {
        if names[i] == n { return i }
        i += 1
    }
    -1
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut names: Vec<string> = []
    let mut edges: Vec<Edge> = []
    for line in text.lines() {
        if line.len() == 0 { continue }
        let p: Vec<string> = line.split(" ").collect()
        let mut named = true
        for t in p {
            if t.len() == 0 { named = false }
        }
        if named && p.len() == 4 && p[0] == "edge" && is_weight(p[3]) {
            let w = p[3].parse::<int>().unwrap_or(0)
            let mut ia = index_of(names, p[1])
            if ia < 0 {
                names.push(p[1])
                ia = names.len() as int - 1
            }
            let mut ib = index_of(names, p[2])
            if ib < 0 {
                names.push(p[2])
                ib = names.len() as int - 1
            }
            let mut found = false
            let mut k = 0
            while k < edges.len() {
                if edges[k].a == ia && edges[k].b == ib {
                    found = true
                    if w < edges[k].w { edges[k].w = w }
                }
                k += 1
            }
            if !found { edges.push(Edge { a: ia, b: ib, w: w }) }
        } else if named && p.len() == 3 && p[0] == "path" {
            let ia = index_of(names, p[1])
            let ib = index_of(names, p[2])
            if ia < 0 {
                println("unknown node ${p[1]}")
            } else if ib < 0 {
                println("unknown node ${p[2]}")
            } else if ia == ib {
                println("0 ${p[1]}")
            } else {
                // distance of every node to the target (edges followed backwards), Bellman-Ford style relaxation
                let n = names.len() as int
                let mut dist: Vec<int> = []
                let mut i = 0
                while i < n {
                    dist.push(-1)
                    i += 1
                }
                dist[ib] = 0
                let mut changed = true
                while changed {
                    changed = false
                    for e in edges {
                        if dist[e.b] >= 0 && (dist[e.a] < 0 || dist[e.b] + e.w < dist[e.a]) {
                            dist[e.a] = dist[e.b] + e.w
                            changed = true
                        }
                    }
                }
                if dist[ia] < 0 {
                    println("unreachable")
                } else {
                    let mut route = p[1]
                    let mut cur = ia
                    while cur != ib {
                        let mut best = -1
                        for e in edges {
                            if e.a == cur && dist[e.b] >= 0 && e.w + dist[e.b] == dist[cur] {
                                if best < 0 || names[e.b] < names[best] { best = e.b }
                            }
                        }
                        route = "${route}>${names[best]}"
                        cur = best
                    }
                    println("${dist[ia]} ${route}")
                }
            }
        } else {
            println("bad command: ${line}")
        }
    }
}

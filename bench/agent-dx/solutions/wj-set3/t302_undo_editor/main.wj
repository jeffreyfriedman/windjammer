use std::fs
use std::process

// kind: 0 insert, 1 delete, 2 replace, 3 swap
struct Edit {
    kind: int,
    at: int,
    other: int,
    old: string,
    text: string,
}

fn index_of(s: string) -> int {
    if s.len() == 0 || s.len() > 6 { return -1 }
    for c in s.chars() {
        if c < '0' || c > '9' { return -1 }
    }
    s.parse::<int>().unwrap_or(-1)
}

fn apply(buf: Vec<string>, e: Edit) -> Vec<string> {
    let mut b = buf
    if e.kind == 0 {
        b.insert(e.at, e.text)
    } else if e.kind == 1 {
        b.remove(e.at)
    } else if e.kind == 2 {
        b[e.at] = e.text
    } else {
        let t = b[e.at]
        b[e.at] = b[e.other]
        b[e.other] = t
    }
    b
}

fn revert(buf: Vec<string>, e: Edit) -> Vec<string> {
    let mut b = buf
    if e.kind == 0 {
        b.remove(e.at)
    } else if e.kind == 1 {
        b.insert(e.at, e.old)
    } else if e.kind == 2 {
        b[e.at] = e.old
    } else {
        let t = b[e.at]
        b[e.at] = b[e.other]
        b[e.other] = t
    }
    b
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut buf: Vec<string> = []
    let mut undo: Vec<Edit> = []
    let mut redo: Vec<Edit> = []
    let mut errors = 0
    for line in text.lines() {
        if line.len() == 0 { continue }
        let w: Vec<string> = line.split(" ").collect()
        let cmd = w[0]
        let mut err = ""
        let mut edit = Edit { kind: -1, at: 0, other: 0, old: "", text: "" }
        if cmd == "insert" || cmd == "replace" {
            let p: Vec<string> = line.splitn(3, " ").collect()
            if p.len() != 3 || p[2].len() == 0 || index_of(p[1]) < 0 {
                err = "bad arguments"
            } else {
                let n = index_of(p[1])
                if cmd == "insert" {
                    if n > buf.len() as int { err = "bad index" } else { edit = Edit { kind: 0, at: n, other: 0, old: "", text: p[2] } }
                } else {
                    if n >= buf.len() as int { err = "bad index" } else { edit = Edit { kind: 2, at: n, other: 0, old: buf[n], text: p[2] } }
                }
            }
        } else if cmd == "delete" {
            if w.len() != 2 || index_of(w[1]) < 0 {
                err = "bad arguments"
            } else {
                let n = index_of(w[1])
                if n >= buf.len() as int { err = "bad index" } else { edit = Edit { kind: 1, at: n, other: 0, old: buf[n], text: "" } }
            }
        } else if cmd == "swap" {
            if w.len() != 3 || index_of(w[1]) < 0 || index_of(w[2]) < 0 {
                err = "bad arguments"
            } else {
                let a = index_of(w[1])
                let b = index_of(w[2])
                if a >= buf.len() as int || b >= buf.len() as int { err = "bad index" } else { edit = Edit { kind: 3, at: a, other: b, old: "", text: "" } }
            }
        } else if cmd == "undo" || cmd == "redo" || cmd == "print" {
            if w.len() != 1 {
                err = "bad arguments"
            } else if cmd == "print" {
                if buf.len() == 0 { println("(empty)") }
                let mut i = 0
                while i < buf.len() {
                    println("${i}: ${buf[i]}")
                    i += 1
                }
            } else if cmd == "undo" {
                if undo.len() == 0 {
                    err = "nothing to undo"
                } else {
                    let e = undo.remove(undo.len() - 1)
                    buf = revert(buf, e)
                    redo.push(e)
                }
            } else {
                if redo.len() == 0 {
                    err = "nothing to redo"
                } else {
                    let e = redo.remove(redo.len() - 1)
                    buf = apply(buf, e)
                    undo.push(e)
                }
            }
        } else {
            err = "unknown command"
        }
        if err.len() > 0 {
            println("error: ${err}")
            errors += 1
        } else if edit.kind >= 0 {
            buf = apply(buf, edit)
            undo.push(edit)
            if undo.len() > 5 { undo.remove(0) }
            redo = []
        }
    }
    if errors > 0 { process::exit(1) }
}

use std::fs
use std::process

struct DepLine {
    owner: int,
    dep: string,
    op: string,
    v: int,
}

fn number(s: string) -> int {
    if s.len() == 0 || s.len() > 6 { return -1 }
    for c in s.chars() {
        if c < '0' || c > '9' { return -1 }
    }
    s.parse::<int>().unwrap_or(-1)
}

fn find(names: Vec<string>, n: string) -> int {
    let mut i = 0
    while i < names.len() {
        if names[i] == n { return i }
        i += 1
    }
    -1
}

fn holds(op: string, have: int, want: int) -> bool {
    if op == ">=" { return have >= want }
    if op == "<=" { return have <= want }
    if op == "=" { return have == want }
    if op == ">" { return have > want }
    have < want
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut errors: Vec<string> = []
    let mut names: Vec<string> = []
    let mut vers: Vec<int> = []
    let mut raw_deps: Vec<string> = []
    let mut targets: Vec<string> = []
    let mut ln = 0
    for line in text.lines() {
        ln += 1
        if line.len() == 0 { continue }
        let p: Vec<string> = line.split(" ").collect()
        let mut named = true
        for t in p {
            if t.len() == 0 { named = false }
        }
        let mut ok = false
        if named && p[0] == "pkg" && p.len() == 3 && number(p[2]) >= 0 {
            ok = true
            if find(names, p[1]) >= 0 {
                errors.push("error: duplicate package ${p[1]}")
            } else {
                names.push(p[1])
                vers.push(number(p[2]))
            }
        } else if named && p[0] == "dep" && p.len() == 5 && number(p[4]) >= 0 {
            let o = p[3]
            if o == ">=" || o == "<=" || o == "=" || o == ">" || o == "<" {
                raw_deps.push(line)
                ok = true
            }
        } else if named && p[0] == "install" && p.len() == 2 {
            targets.push(p[1])
            ok = true
        }
        if !ok { errors.push("error: bad line ${ln}") }
    }
    // second phase: attach dep lines to packages
    let mut deps: Vec<DepLine> = []
    for line in raw_deps {
        let p: Vec<string> = line.split(" ").collect()
        let owner = find(names, p[1])
        if owner < 0 {
            errors.push("error: dep for unknown package ${p[1]}")
        } else {
            deps.push(DepLine { owner: owner, dep: p[2], op: p[3], v: number(p[4]) })
        }
    }
    // sorted distinct dependency names per package
    let mut dn: Vec<Vec<string>> = []
    let mut k = 0
    while k < names.len() {
        let mut list: Vec<string> = []
        for d in deps {
            if d.owner == k {
                let mut seen = false
                for x in list {
                    if x == d.dep { seen = true }
                }
                if !seen { list.push(d.dep) }
            }
        }
        list.sort()
        dn.push(list)
        k += 1
    }
    let mut state: Vec<int> = []
    k = 0
    while k < names.len() {
        state.push(0)
        k += 1
    }
    let mut order: Vec<int> = []
    for t in targets {
        let id = find(names, t)
        if id < 0 {
            errors.push("error: unknown package ${t}")
            continue
        }
        if state[id] != 0 { continue }
        let mut sn: Vec<int> = [id]
        let mut sp: Vec<int> = [0]
        state[id] = 1
        while sn.len() > 0 {
            let top = sn.len() - 1
            let u = sn[top]
            let i = sp[top]
            if i >= dn[u].len() {
                sn.remove(top)
                sp.remove(top)
                state[u] = 2
                order.push(u)
                continue
            }
            sp[top] = i + 1
            let dname = dn[u][i]
            let did = find(names, dname)
            if did < 0 {
                errors.push("error: missing dependency ${dname} of ${names[u]}")
                continue
            }
            for d in deps {
                if d.owner == u && d.dep == dname && !holds(d.op, vers[did], d.v) {
                    errors.push("error: ${names[u]} needs ${dname} ${d.op} ${d.v} but found ${vers[did]}")
                }
            }
            if state[did] == 1 {
                let mut at = 0
                let mut j = 0
                while j < sn.len() {
                    if sn[j] == did { at = j }
                    j += 1
                }
                let mut cyc = ""
                j = at
                while j < sn.len() {
                    cyc = "${cyc}${names[sn[j]]} -> "
                    j += 1
                }
                errors.push("error: cycle ${cyc}${dname}")
            } else if state[did] == 0 {
                state[did] = 1
                sn.push(did)
                sp.push(0)
            }
        }
    }
    if errors.len() > 0 {
        for e in errors {
            println(e)
        }
        process::exit(1)
    }
    for u in order {
        println("install ${names[u]} ${vers[u]}")
    }
}

use std::fs
use std::process

struct Item {
    name: string,
    weight: int,
    cap: int,
    is_box: bool,
    open: bool,
    kind: int,
    at: string,
}

struct Exit {
    from: string,
    dir: string,
    to: string,
    key: string,
    locked: bool,
}

struct W {
    rooms: Vec<string>,
    exits: Vec<Exit>,
    items: Vec<Item>,
    has_player: bool,
    room: string,
    limit: int,
    out: Vec<string>,
    errors: int,
}

fn number(s: string) -> int {
    if s.len() == 0 || s.len() > 6 { return -1 }
    for c in s.chars() {
        if c < '0' || c > '9' { return -1 }
    }
    s.parse::<int>().unwrap_or(-1)
}

fn has(list: Vec<string>, s: string) -> bool {
    for x in list {
        if x == s { return true }
    }
    false
}

fn join(list: Vec<string>, sep: string) -> string {
    let mut r = ""
    let mut i = 0
    while i < list.len() {
        if i > 0 { r = "${r}${sep}" }
        r = "${r}${list[i]}"
        i += 1
    }
    r
}

fn valid_dir(d: string) -> bool {
    d == "n" || d == "s" || d == "e" || d == "w" || d == "u" || d == "d"
}

impl W {
    fn err(self, m: string) {
        self.errors += 1
        self.out.push("error: ${m}")
    }

    fn idx(self, name: string) -> int {
        let mut i = 0
        while i < self.items.len() {
            if self.items[i].name == name { return i as int }
            i += 1
        }
        -1
    }

    fn exit_idx(self, from: string, dir: string) -> int {
        let mut i = 0
        while i < self.exits.len() {
            if self.exits[i].from == from && self.exits[i].dir == dir { return i as int }
            i += 1
        }
        -1
    }

    // location: kind 0 room, 1 in box, 2 player; returns -1 for kind when invalid
    fn parse_loc(self, s: string) -> int {
        if s.len() > 3 && s[0..3] == "in:" {
            let b = s[3..s.len()]
            let i = self.idx(b)
            if i >= 0 && self.items[i].is_box { return 1 }
            return -1
        }
        if has(self.rooms, s) { return 0 }
        -1
    }

    fn world_line(self, line: string) -> bool {
        let p: Vec<string> = line.split(" ").collect()
        for t in p {
            if t.len() == 0 { return false }
        }
        let n = p.len()
        if p[0] == "room" && n == 2 {
            if has(self.rooms, p[1]) { return false }
            self.rooms.push(p[1])
            return true
        }
        if p[0] == "exit" && (n == 4 || n == 5) {
            if !valid_dir(p[2]) || !has(self.rooms, p[1]) || !has(self.rooms, p[3]) { return false }
            if self.exit_idx(p[1], p[2]) >= 0 { return false }
            let key = if n == 5 { p[4] } else { "" }
            self.exits.push(Exit { from: p[1], dir: p[2], to: p[3], key: key, locked: n == 5 })
            return true
        }
        if (p[0] == "thing" && n == 4) || (p[0] == "box" && (n == 5 || n == 6)) {
            let is_box = p[0] == "box"
            if self.idx(p[1]) >= 0 { return false }
            let w = number(p[2])
            if w < 0 { return false }
            let mut cap = 0
            let mut loc_s = p[3]
            if is_box {
                cap = number(p[3])
                if cap < 0 { return false }
                loc_s = p[4]
            }
            let mut open = false
            if is_box && n == 6 {
                if p[5] != "open" { return false }
                open = true
            }
            let kind = self.parse_loc(loc_s)
            if kind < 0 { return false }
            let at = if kind == 1 { loc_s[3..loc_s.len()] } else { loc_s }
            self.items.push(Item { name: p[1], weight: w, cap: cap, is_box: is_box, open: open, kind: kind, at: at })
            return true
        }
        if p[0] == "player" && n == 3 {
            if self.has_player || !has(self.rooms, p[1]) { return false }
            let l = number(p[2])
            if l < 0 { return false }
            self.has_player = true
            self.room = p[1]
            self.limit = l
            return true
        }
        false
    }

    fn children(self, b: string) -> Vec<string> {
        let mut r: Vec<string> = []
        for it in self.items {
            if it.kind == 1 && it.at == b { r.push(it.name) }
        }
        r.sort()
        r
    }

    fn total(self, n: string) -> int {
        let mut t = self.items[self.idx(n)].weight
        for c in self.children(n) {
            t += self.total(c)
        }
        t
    }

    fn in_room(self) -> Vec<string> {
        let mut r: Vec<string> = []
        for it in self.items {
            if it.kind == 0 && it.at == self.room { r.push(it.name) }
        }
        r.sort()
        r
    }

    fn held(self) -> Vec<string> {
        let mut r: Vec<string> = []
        for it in self.items {
            if it.kind == 2 { r.push(it.name) }
        }
        r.sort()
        r
    }

    fn carried(self) -> int {
        let mut t = 0
        for n in self.held() {
            t += self.total(n)
        }
        t
    }

    fn visible(self, n: string) -> bool {
        let i = self.idx(n)
        if i < 0 { return false }
        self.items[i].kind == 2 || (self.items[i].kind == 0 && self.items[i].at == self.room)
    }

    fn render(self, n: string) -> string {
        let i = self.idx(n)
        if !self.items[i].is_box { return n }
        if !self.items[i].open { return "${n}\{closed}" }
        let mut parts: Vec<string> = []
        for c in self.children(n) {
            parts.push(self.render(c))
        }
        "${n}\{${join(parts, ", ")}}"
    }

    fn render_list(self, names: Vec<string>) -> string {
        let mut parts: Vec<string> = []
        for n in names {
            parts.push(self.render(n))
        }
        join(parts, ", ")
    }

    // is a equal to b or inside it
    fn inside(self, a: string, b: string) -> bool {
        let mut cur = a
        while true {
            if cur == b { return true }
            let i = self.idx(cur)
            if self.items[i].kind != 1 { return false }
            cur = self.items[i].at
        }
        false
    }

    fn put(self, x: string, b: string) {
        if !self.visible(x) { self.err("no ${x} here") return }
        if !self.visible(b) { self.err("no ${b} here") return }
        let bi = self.idx(b)
        let xi = self.idx(x)
        if !self.items[bi].is_box { self.err("${b} is not a box") return }
        if self.inside(b, x) { self.err("cannot put ${x} in itself") return }
        if !self.items[bi].open { self.err("${b} is closed") return }
        let mut content = 0
        for c in self.children(b) {
            content += self.total(c)
        }
        if content + self.total(x) > self.items[bi].cap { self.err("${b} is full") return }
        if self.items[bi].kind == 2 && self.items[xi].kind != 2 && self.carried() + self.total(x) > self.limit {
            self.err("too heavy")
            return
        }
        self.items[xi].kind = 1
        self.items[xi].at = b
        self.out.push("put ${x} in ${b}")
    }

    fn command(self, line: string) {
        let p: Vec<string> = line.split(" ").collect()
        let n = p.len()
        let c = p[0]
        if c == "look" && n == 1 {
            let mut ex: Vec<string> = []
            for d in ["n", "s", "e", "w", "u", "d"] {
                let e = self.exit_idx(self.room, d)
                if e >= 0 {
                    ex.push(if self.exits[e].locked { "${d}(locked)" } else { d })
                }
            }
            let here = self.in_room()
            self.out.push("== ${self.room} ==")
            self.out.push("exits: ${if ex.len() == 0 { "none" } else { join(ex, " ") }}")
            self.out.push("items: ${if here.len() == 0 { "nothing" } else { self.render_list(here) }}")
        } else if c == "inv" && n == 1 {
            let h = self.held()
            let s = if h.len() == 0 { "nothing" } else { self.render_list(h) }
            self.out.push("carrying: ${s} (${self.carried()}/${self.limit})")
        } else if c == "go" && n == 2 {
            let e = self.exit_idx(self.room, p[1])
            if e < 0 {
                self.err("no exit ${p[1]}")
            } else if self.exits[e].locked {
                self.err("door ${p[1]} is locked")
            } else {
                self.room = self.exits[e].to
                self.out.push("-> ${self.room}")
            }
        } else if c == "take" && n == 2 {
            let x = p[1]
            let i = self.idx(x)
            if i < 0 || self.items[i].kind != 0 || self.items[i].at != self.room {
                self.err("no ${x} here")
            } else if self.carried() + self.total(x) > self.limit {
                self.err("too heavy")
            } else {
                self.items[i].kind = 2
                self.items[i].at = ""
                self.out.push("taken ${x}")
            }
        } else if c == "drop" && n == 2 {
            let x = p[1]
            let i = self.idx(x)
            if i < 0 || self.items[i].kind != 2 {
                self.err("not carrying ${x}")
            } else {
                self.items[i].kind = 0
                self.items[i].at = self.room
                self.out.push("dropped ${x}")
            }
        } else if c == "put" && n == 4 && p[2] == "in" {
            self.put(p[1], p[3])
        } else if c == "take" && n == 4 && p[2] == "from" {
            let x = p[1]
            let b = p[3]
            if !self.visible(b) {
                self.err("no ${b} here")
            } else {
                let bi = self.idx(b)
                let xi = self.idx(x)
                if !self.items[bi].is_box {
                    self.err("${b} is not a box")
                } else if !self.items[bi].open {
                    self.err("${b} is closed")
                } else if xi < 0 || self.items[xi].kind != 1 || self.items[xi].at != b {
                    self.err("${x} is not in ${b}")
                } else if self.items[bi].kind != 2 && self.carried() + self.total(x) > self.limit {
                    self.err("too heavy")
                } else {
                    self.items[xi].kind = 2
                    self.items[xi].at = ""
                    self.out.push("taken ${x} from ${b}")
                }
            }
        } else if (c == "open" || c == "close") && n == 2 {
            let b = p[1]
            let want = c == "open"
            if !self.visible(b) {
                self.err("no ${b} here")
            } else {
                let bi = self.idx(b)
                if !self.items[bi].is_box {
                    self.err("${b} is not a box")
                } else if self.items[bi].open == want {
                    self.err("${b} is already ${if want { "open" } else { "closed" }}")
                } else {
                    self.items[bi].open = want
                    self.out.push("${if want { "opened" } else { "closed" }} ${b}")
                }
            }
        } else if c == "unlock" && n == 2 {
            let e = self.exit_idx(self.room, p[1])
            if e < 0 {
                self.err("no exit ${p[1]}")
            } else if !self.exits[e].locked {
                self.err("${p[1]} is not locked")
            } else {
                let key = self.exits[e].key
                let mut ok = false
                if self.idx(key) >= 0 {
                    for h in self.held() {
                        if self.inside(key, h) { ok = true }
                    }
                }
                if !ok {
                    self.err("need ${key}")
                } else {
                    self.exits[e].locked = false
                    self.out.push("unlocked ${p[1]}")
                }
            }
        } else {
            self.err("bad command")
        }
    }
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let lines: Vec<string> = text.lines().collect()
    let mut split = -1
    let mut i = 0
    while i < lines.len() {
        if lines[i] == "---" && split < 0 { split = i as int }
        i += 1
    }
    let mut w = W { rooms: [], exits: [], items: [], has_player: false, room: "", limit: 0, out: [], errors: 0 }
    let wend = if split >= 0 { split as usize } else { lines.len() }
    i = 0
    while i < wend {
        if lines[i].len() > 0 && !w.world_line(lines[i]) {
            w.err("bad world line ${i + 1}")
        }
        i += 1
    }
    if !w.has_player {
        w.err("no player")
    } else if split >= 0 {
        i = (split + 1) as usize
        while i < lines.len() {
            if lines[i].len() > 0 { w.command(lines[i]) }
            i += 1
        }
    }
    for l in w.out {
        println(l)
    }
    if w.errors > 0 { process::exit(1) }
}

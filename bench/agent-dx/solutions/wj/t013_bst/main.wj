use std::fs

// Arena-based BST: nodes stored in a Vec, children are indices (-1 = none)
struct Tree {
    keys: Vec<i64>,
    left: Vec<i64>,
    right: Vec<i64>,
    root: i64,
}

impl Tree {
    fn new() -> Tree {
        Tree { keys: Vec::new(), left: Vec::new(), right: Vec::new(), root: -1 }
    }

    fn contains(self, k: i64) -> bool {
        let mut cur = self.root
        while cur >= 0 {
            let key = self.keys[cur as usize]
            if k == key { return true }
            if k < key { cur = self.left[cur as usize] } else { cur = self.right[cur as usize] }
        }
        false
    }

    fn insert(self, k: i64) -> bool {
        if self.contains(k) { return false }
        let id = self.keys.len() as i64
        self.keys.push(k)
        self.left.push(-1)
        self.right.push(-1)
        if self.root < 0 {
            self.root = id
            return true
        }
        let mut cur = self.root
        loop {
            let key = self.keys[cur as usize]
            if k < key {
                if self.left[cur as usize] < 0 {
                    self.left[cur as usize] = id
                    break
                }
                cur = self.left[cur as usize]
            } else {
                if self.right[cur as usize] < 0 {
                    self.right[cur as usize] = id
                    break
                }
                cur = self.right[cur as usize]
            }
        }
        true
    }

    fn min_node(self, start: i64) -> i64 {
        let mut cur = start
        while self.left[cur as usize] >= 0 {
            cur = self.left[cur as usize]
        }
        cur
    }

    fn remove_at(self, node: i64, k: i64) -> i64 {
        if node < 0 { return -1 }
        let n = node as usize
        if k < self.keys[n] {
            self.left[n] = self.remove_at(self.left[n], k)
            return node
        }
        if k > self.keys[n] {
            self.right[n] = self.remove_at(self.right[n], k)
            return node
        }
        if self.left[n] < 0 { return self.right[n] }
        if self.right[n] < 0 { return self.left[n] }
        let s = self.min_node(self.right[n])
        let sk = self.keys[s as usize]
        self.keys[n] = sk
        self.right[n] = self.remove_at(self.right[n], sk)
        node
    }

    fn delete(self, k: i64) -> bool {
        if !self.contains(k) { return false }
        self.root = self.remove_at(self.root, k)
        true
    }

    fn collect(self, node: i64, out: Vec<i64>) {
        if node < 0 { return }
        self.collect(self.left[node as usize], out)
        out.push(self.keys[node as usize])
        self.collect(self.right[node as usize], out)
    }

    fn height_of(self, node: i64) -> i64 {
        if node < 0 { return 0 }
        let a = self.height_of(self.left[node as usize])
        let b = self.height_of(self.right[node as usize])
        if a > b { 1 + a } else { 1 + b }
    }
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut t = Tree::new()
    for line in text.lines() {
        let p: Vec<string> = line.split_whitespace().map(|s| s.to_string()).collect()
        if p.len() == 0 { continue }
        let cmd = p[0].clone()
        if cmd == "insert" {
            let k = p[1].parse::<i64>().unwrap_or(0)
            if t.insert(k) { println("ok") } else { println("dup") }
        } else if cmd == "contains" {
            let k = p[1].parse::<i64>().unwrap_or(0)
            if t.contains(k) { println("yes") } else { println("no") }
        } else if cmd == "delete" {
            let k = p[1].parse::<i64>().unwrap_or(0)
            if t.delete(k) { println("ok") } else { println("missing") }
        } else if cmd == "height" {
            println("${t.height_of(t.root)}")
        } else {
            let mut items: Vec<i64> = Vec::new()
            t.collect(t.root, items)
            if cmd == "inorder" {
                if items.len() == 0 {
                    println("<empty>")
                } else {
                    let strs: Vec<string> = items.iter().map(|x| x.to_string()).collect()
                    println(strs.join(" "))
                }
            } else if items.len() == 0 {
                println("empty")
            } else if cmd == "min" {
                println("${items[0]}")
            } else {
                println("${items[items.len() - 1]}")
            }
        }
    }
}

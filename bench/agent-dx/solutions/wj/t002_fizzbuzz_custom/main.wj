use std::fs

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let parts: Vec<string> = text.split_whitespace().map(|s| s.to_string()).collect()
    let n = parts[0].parse::<i64>().unwrap_or(0)
    let a = parts[1].parse::<i64>().unwrap_or(1)
    let b = parts[2].parse::<i64>().unwrap_or(1)
    let mut i: i64 = 1
    while i <= n {
        if i % a == 0 && i % b == 0 {
            println("FizzBuzz")
        } else if i % a == 0 {
            println("Fizz")
        } else if i % b == 0 {
            println("Buzz")
        } else {
            println("${i}")
        }
        i += 1
    }
}

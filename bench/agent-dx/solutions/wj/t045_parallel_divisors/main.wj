use std::fs
use std::thread

fn divisor_count(n: i64) -> i64 {
    let mut c: i64 = 0
    let mut i: i64 = 1
    while i * i <= n {
        if n % i == 0 {
            if i * i == n { c += 1 } else { c += 2 }
        }
        i += 1
    }
    c
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut nums: Vec<i64> = Vec::new()
    for w in text.split_whitespace() {
        nums.push(w.parse::<i64>().unwrap_or(0))
    }
    let workers = nums[0] as usize
    let n = nums[1] as usize
    let values: Vec<i64> = nums[2..2 + n].to_vec()
    let mut handles = Vec::new()
    let mut w: usize = 0
    while w < workers {
        let vals = values.clone()
        let handle = thread::spawn(move || {
            let mut out: Vec<(usize, i64)> = Vec::new()
            let mut i = w
            while i < vals.len() {
                out.push((i, divisor_count(vals[i])))
                i += workers
            }
            out
        })
        handles.push(handle)
        w += 1
    }
    let mut results: Vec<i64> = Vec::new()
    let mut k: usize = 0
    while k < n {
        results.push(0)
        k += 1
    }
    for handle in handles {
        let part = handle.join().unwrap_or(Vec::new())
        for (i, c) in part {
            results[i] = c
        }
    }
    let mut j: usize = 0
    while j < n {
        println("${values[j]} ${results[j]}")
        j += 1
    }
}

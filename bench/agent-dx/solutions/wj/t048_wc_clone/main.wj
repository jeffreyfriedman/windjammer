use std::env
use std::fs
use std::process

fn count(s: string) -> (i64, i64, i64) {
    let mut lines: i64 = 0
    for c in s.chars() {
        if c == '\n' { lines += 1 }
    }
    let words = s.split_whitespace().count() as i64
    (lines, words, s.len() as i64)
}

fn main() {
    let args: Vec<string> = env::args().collect()
    let files: Vec<string> = args[1..].to_vec()
    if files.len() == 0 {
        let text = fs::read_to_string("/dev/stdin").unwrap_or("")
        let (l, w, b) = count(text)
        println("${l} ${w} ${b}")
        return
    }
    let mut tl: i64 = 0
    let mut tw: i64 = 0
    let mut tb: i64 = 0
    let mut failed = false
    for f in files.iter() {
        match fs::read_to_string(f.as_str()) {
            Ok(text) => {
                let (l, w, b) = count(text)
                tl += l
                tw += w
                tb += b
                println("${l} ${w} ${b} ${f}")
            }
            Err(_) => {
                println("wc: ${f}: No such file")
                failed = true
            }
        }
    }
    if files.len() > 1 {
        println("${tl} ${tw} ${tb} total")
    }
    if failed {
        process::exit(1)
    }
}

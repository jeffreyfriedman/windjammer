use std::env
use std::fs
use std::process

fn count(s: string) -> (i64, i64, i64) {
    let mut lines: i64 = 0
    for c in s.chars() {
        if c == '\n' { lines += 1 }
    }
    let words = s.split_whitespace().count() as i64
    (lines, words, s.len() as i64)
}

fn rest_lines(v: Vec<string>, from: usize) -> Vec<string> {
    let mut out: Vec<string> = Vec::new()
    let mut i = from
    while i < v.len() {
        out.push(v[i].clone())
        i += 1
    }
    out
}

fn main() {
    let mut args: Vec<string> = Vec::new()
    for a0 in env::args() {
        args.push(a0)
    }
    let files: Vec<string> = rest_lines(args.clone(), 1)
    if files.len() == 0 {
        let text = fs::read_to_string("/dev/stdin").unwrap_or("")
        let (l, w, b) = count(text)
        println("${l} ${w} ${b}")
        return
    }
    let mut tl: i64 = 0
    let mut tw: i64 = 0
    let mut tb: i64 = 0
    let mut failed = false
    for f in files {
        match fs::read_to_string(f) {
            Ok(text) => {
                let (l, w, b) = count(text)
                tl += l
                tw += w
                tb += b
                println("${l} ${w} ${b} ${f}")
            }
            Err(_) => {
                println("wc: ${f}: No such file")
                failed = true
            }
        }
    }
    if files.len() > 1 {
        println("${tl} ${tw} ${tb} total")
    }
    if failed {
        process::exit(1)
    }
}

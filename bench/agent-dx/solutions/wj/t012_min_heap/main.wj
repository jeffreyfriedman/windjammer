use std::fs

struct Entry {
    prio: i64,
    seq: i64,
    label: string,
}

fn less(a: Entry, b: Entry) -> bool {
    if a.prio != b.prio {
        a.prio < b.prio
    } else {
        a.seq < b.seq
    }
}

struct Heap {
    data: Vec<Entry>,
}

impl Heap {
    fn push(self, e: Entry) {
        self.data.push(e)
        let mut i = self.data.len() - 1
        while i > 0 {
            let parent = (i - 1) / 2
            if less(self.data[i].clone(), self.data[parent].clone()) {
                self.data.swap(i, parent)
                i = parent
            } else {
                break
            }
        }
    }

    fn pop(self) -> Option<Entry> {
        if self.data.len() == 0 {
            return None
        }
        let last = self.data.len() - 1
        self.data.swap(0, last)
        let top = self.data.pop()
        let n = self.data.len()
        let mut i: usize = 0
        loop {
            let l = 2 * i + 1
            let r = 2 * i + 2
            let mut m = i
            if l < n && less(self.data[l].clone(), self.data[m].clone()) { m = l }
            if r < n && less(self.data[r].clone(), self.data[m].clone()) { m = r }
            if m == i { break }
            self.data.swap(i, m)
            i = m
        }
        top
    }
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut heap = Heap { data: Vec::new() }
    let mut seq: i64 = 0
    for line in text.lines() {
        let p: Vec<string> = line.split_whitespace().map(|s| s.to_string()).collect()
        if p.len() == 0 { continue }
        if p[0] == "push" {
            let pr = p[1].parse::<i64>().unwrap_or(0)
            heap.push(Entry { prio: pr, seq: seq, label: p[2].clone() })
            seq += 1
        } else if p[0] == "pop" {
            match heap.pop() {
                Some(e) => { println("${e.prio} ${e.label}") }
                None => { println("empty") }
            }
        } else if p[0] == "peek" {
            if heap.data.len() == 0 {
                println("empty")
            } else {
                println("${heap.data[0].prio} ${heap.data[0].label}")
            }
        } else {
            println("${heap.data.len()}")
        }
    }
}

use std::fs

fn find(parent: Vec<usize>, x: usize) -> usize {
    let mut cur = x
    while parent[cur] != cur {
        cur = parent[cur]
    }
    cur
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut lines = text.lines()
    let n = lines.next().unwrap_or("1").trim().parse::<usize>().unwrap_or(1)
    let mut parent: Vec<usize> = Vec::new()
    let mut size: Vec<i64> = Vec::new()
    let mut i: usize = 0
    while i < n {
        parent.push(i)
        size.push(1)
        i += 1
    }
    for line in lines {
        let p: Vec<string> = line.split_whitespace().map(|s| s.to_string()).collect()
        if p.len() == 0 { continue }
        let a = p[1].parse::<usize>().unwrap_or(0)
        if p[0] == "union" {
            let b = p[2].parse::<usize>().unwrap_or(0)
            let ra = find(parent.clone(), a)
            let rb = find(parent.clone(), b)
            if ra == rb {
                println("same")
            } else {
                parent[ra] = rb
                size[rb] = size[rb] + size[ra]
                println("merged")
            }
        } else if p[0] == "find" {
            let b = p[2].parse::<usize>().unwrap_or(0)
            if find(parent.clone(), a) == find(parent.clone(), b) { println("yes") } else { println("no") }
        } else {
            let r = find(parent.clone(), a)
            println("${size[r]}")
        }
    }
    let mut comps = 0
    let mut j: usize = 0
    while j < n {
        if parent[j] == j { comps += 1 }
        j += 1
    }
    println("components ${comps}")
}

use std::fs
use std::collections::HashMap

fn is_word_char(c: char) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut lines = text.lines()
    let k = lines.next().unwrap_or("0").trim().parse::<usize>().unwrap_or(0)
    let mut counts: HashMap<string, i64> = HashMap::new()
    for raw in lines {
        let line = raw.to_lowercase()
        let mut cur = ""
        for c in line.chars() {
            if is_word_char(c) {
                cur = cur + c.to_string()
            } else {
                if cur.len() > 0 {
                    *counts.entry(cur.clone()).or_insert(0) += 1
                    cur = ""
                }
            }
        }
        if cur.len() > 0 {
            *counts.entry(cur.clone()).or_insert(0) += 1
        }
    }
    let mut items: Vec<(string, i64)> = Vec::new()
    for (w, n) in counts {
        items.push((w, n))
    }
    items.sort_by(|a, b| {
        if a.1 != b.1 {
            b.1.cmp(a.1)
        } else {
            a.0.cmp(b.0)
        }
    })
    let mut i: usize = 0
    while i < items.len() && i < k {
        println("${items[i].0} ${items[i].1}")
        i += 1
    }
}

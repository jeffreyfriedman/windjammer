use std::fs
use std::collections::HashMap

fn is_word_char(c: char) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
}

fn line_at(v: Vec<string>, i: usize) -> string {
    if i < v.len() { v[i].clone() } else { "" }
}

fn rest_lines(v: Vec<string>, from: usize) -> Vec<string> {
    let mut out: Vec<string> = Vec::new()
    let mut i = from
    while i < v.len() {
        out.push(v[i].clone())
        i += 1
    }
    out
}

fn pair_before(a: (string, i64), b: (string, i64)) -> bool {
    if a.1 != b.1 { a.1 > b.1 } else { a.0 < b.0 }
}

fn sort_pairs(items: Vec<(string, i64)>) -> Vec<(string, i64)> {
    let mut v = items
    let mut i: usize = 1
    while i < v.len() {
        let mut j = i
        while j > 0 && pair_before(v[j].clone(), v[j - 1].clone()) {
            v.swap(j, j - 1)
            j -= 1
        }
        i += 1
    }
    v
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let all: Vec<string> = text.lines().map(|s| s.to_string()).collect()
    let mut cursor: usize = 0
    let k = line_at(all.clone(), cursor).trim().parse::<usize>().unwrap_or(0)
    cursor += 1
    let mut counts: HashMap<string, i64> = HashMap::new()
    for raw in rest_lines(all.clone(), cursor) {
        let line = raw.to_lowercase()
        let mut cur = ""
        for c in line.chars() {
            if is_word_char(c) {
                cur = cur + c.to_string()
            } else {
                if cur.len() > 0 {
                    *counts.entry(cur.clone()).or_insert(0) += 1
                    cur = ""
                }
            }
        }
        if cur.len() > 0 {
            *counts.entry(cur.clone()).or_insert(0) += 1
        }
    }
    let mut items: Vec<(string, i64)> = Vec::new()
    for (w, n) in counts {
        items.push((w, n))
    }
    items = sort_pairs(items)
    let mut i: usize = 0
    while i < items.len() && i < k {
        println("${items[i].0} ${items[i].1}")
        i += 1
    }
}

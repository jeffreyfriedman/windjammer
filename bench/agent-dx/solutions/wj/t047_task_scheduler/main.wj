use std::fs
use std::collections::HashMap

struct Task {
    id: i64,
    duration: i64,
    deps: Vec<i64>,
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut lines = text.lines()
    let head: Vec<i64> = lines.next().unwrap_or("0 0").split_whitespace().map(|s| s.parse::<i64>().unwrap_or(0)).collect()
    let workers = head[0] as usize
    let n = head[1] as usize
    let mut tasks: Vec<Task> = Vec::new()
    for l in lines {
        let p: Vec<i64> = l.split_whitespace().map(|s| s.parse::<i64>().unwrap_or(0)).collect()
        if p.len() < 2 { continue }
        tasks.push(Task { id: p[0], duration: p[1], deps: p[2..].to_vec() })
    }
    tasks.sort_by(|a, b| a.id.cmp(b.id))
    let mut start: HashMap<i64, i64> = HashMap::new()
    let mut end: HashMap<i64, i64> = HashMap::new()
    let mut running: Vec<(i64, i64)> = Vec::new()
    let mut time: i64 = 0
    while end.len() < n {
        let mut still: Vec<(i64, i64)> = Vec::new()
        for r in running.iter() {
            if r.0 <= time {
                end.insert(r.1, r.0)
            } else {
                still.push(*r)
            }
        }
        running = still
        for t in tasks.iter() {
            if start.contains_key(&t.id) { continue }
            if running.len() >= workers { break }
            let mut ready = true
            for d in t.deps.iter() {
                match end.get(d) {
                    Some(e) => { if *e > time { ready = false } }
                    None => { ready = false }
                }
            }
            if ready {
                start.insert(t.id, time)
                running.push((time + t.duration, t.id))
            }
        }
        if end.len() >= n { break }
        if running.len() == 0 { break }
        let mut next = running[0].0
        for r in running.iter() {
            if r.0 < next { next = r.0 }
        }
        time = next
    }
    let mut makespan: i64 = 0
    for t in tasks.iter() {
        let s = start.get(&t.id).unwrap_or(&0)
        let e = end.get(&t.id).unwrap_or(&0)
        println("${t.id} ${s} ${e}")
        if *e > makespan { makespan = *e }
    }
    println("makespan ${makespan}")
}

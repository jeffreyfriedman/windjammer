use std::fs
use std::collections::HashMap

fn is_ident(c: char) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn render(tpl: string, defs: HashMap<string, string>) -> string {
    let chars: Vec<char> = tpl.chars().collect()
    let n = chars.len()
    let mut out = ""
    let mut i: usize = 0
    while i < n {
        if i + 1 < n && chars[i] == '{' && chars[i + 1] == '{' {
            let mut j = i + 2
            while j < n && chars[j] == ' ' { j += 1 }
            let start = j
            while j < n && is_ident(chars[j]) { j += 1 }
            let end = j
            while j < n && chars[j] == ' ' { j += 1 }
            if end > start && j + 1 < n && chars[j] == '}' && chars[j + 1] == '}' {
                let mut name = ""
                let mut k = start
                while k < end {
                    name = name + chars[k].to_string()
                    k += 1
                }
                match defs.get(name.as_str()) {
                    Some(v) => { out = out + v }
                    None => { out = out + "<missing:" + name + ">" }
                }
                i = j + 2
                continue
            }
        }
        out = out + chars[i].to_string()
        i += 1
    }
    out
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut lines = text.split("\n")
    let k = lines.next().unwrap_or("0").trim().parse::<usize>().unwrap_or(0)
    let mut defs: HashMap<string, string> = HashMap::new()
    let mut i: usize = 0
    while i < k {
        let l = lines.next().unwrap_or("")
        match l.find("=") {
            Some(p) => { defs.insert(l.as_str()[0..p].to_string(), l.as_str()[p + 1..].to_string()) }
            None => {}
        }
        i += 1
    }
    let mut rest: Vec<string> = Vec::new()
    for l in lines {
        rest.push(l.to_string())
    }
    print(render(rest.join("\n"), defs))
}

use std::env
use std::process

fn fail(msg: string) {
    println(msg)
    process::exit(2)
}

fn all_digits(s: string) -> bool {
    if s.len() == 0 { return false }
    for c in s.chars() {
        if c < '0' || c > '9' { return false }
    }
    true
}

fn main() {
    let args: Vec<string> = env::args().collect()
    let mut name = "anonymous".to_string()
    let mut count: i64 = 1
    let mut verbosity: i64 = 0
    let mut dry = false
    let mut positional: Vec<string> = Vec::new()
    let mut rest = false
    let mut i: usize = 1
    while i < args.len() {
        let a = args[i].clone()
        i += 1
        if rest || a == "-" || !a.starts_with("-") {
            positional.push(a)
        } else if a == "--" {
            rest = true
        } else if a == "--dry-run" {
            dry = true
        } else if a == "--name" {
            if i >= args.len() { fail("error: missing value for --name") }
            name = args[i].clone()
            i += 1
        } else if a.starts_with("--name=") {
            name = a.as_str()[7..].to_string()
        } else if a == "--count" || a.starts_with("--count=") {
            let mut v = "".to_string()
            if a == "--count" {
                if i >= args.len() { fail("error: missing value for --count") }
                v = args[i].clone()
                i += 1
            } else {
                v = a.as_str()[8..].to_string()
            }
            if !all_digits(v.clone()) { fail("error: invalid count ${v}") }
            count = v.parse::<i64>().unwrap_or(0)
        } else if !a.starts_with("--") && a.as_str()[1..].chars().all(|c| c == 'v') {
            verbosity += (a.len() as i64) - 1
        } else {
            fail("error: unknown option ${a}")
        }
    }
    println("name: ${name}")
    println("count: ${count}")
    println("verbosity: ${verbosity}")
    println("dry-run: ${dry}")
    println("positional: ${positional.join(" ")}")
}

use std::fs

struct Ring {
    items: Vec<i64>,
    cap: usize,
}

impl Ring {
    fn new(cap: usize) -> Ring {
        Ring { items: Vec::new(), cap: cap }
    }

    fn push(self, x: i64) -> bool {
        if self.items.len() >= self.cap {
            return false
        }
        self.items.push(x)
        true
    }

    fn pop(self) -> Option<i64> {
        if self.items.len() == 0 {
            return None
        }
        Some(self.items.remove(0))
    }
}

fn join_ints(v: Vec<i64>) -> string {
    let mut out = ""
    let mut first = true
    for x in v {
        if !first { out = out + " " }
        out = out + "${x}"
        first = false
    }
    out
}

fn line_at(v: Vec<string>, i: usize) -> string {
    if i < v.len() { v[i].clone() } else { "" }
}

fn rest_lines(v: Vec<string>, from: usize) -> Vec<string> {
    let mut out: Vec<string> = Vec::new()
    let mut i = from
    while i < v.len() {
        out.push(v[i].clone())
        i += 1
    }
    out
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let all: Vec<string> = text.lines().map(|s| s.to_string()).collect()
    let mut cursor: usize = 0
    let cap = line_at(all.clone(), cursor).trim().parse::<usize>().unwrap_or(1)
    cursor += 1
    let mut ring = Ring::new(cap)
    for line in rest_lines(all.clone(), cursor) {
        let parts: Vec<string> = line.split_whitespace().map(|s| s.to_string()).collect()
        if parts.len() == 0 { continue }
        if parts[0] == "push" {
            let x = parts[1].parse::<i64>().unwrap_or(0)
            if ring.push(x) { println("ok") } else { println("full") }
        } else if parts[0] == "pop" {
            match ring.pop() {
                Some(v) => { println("${v}") }
                None => { println("empty") }
            }
        } else if parts[0] == "peek" {
            if ring.items.len() == 0 { println("empty") } else { println("${ring.items[0]}") }
        } else if parts[0] == "size" {
            println("${ring.items.len()}")
        } else {
            if ring.items.len() == 0 {
                println("<empty>")
            } else {
                let strs = join_ints(ring.items.clone())
                println(strs)
            }
        }
    }
}

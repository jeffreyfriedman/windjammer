use std::fs

struct Interval {
    lo: i64,
    hi: i64,
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut nums: Vec<i64> = Vec::new()
    for w in text.split_whitespace() {
        nums.push(w.parse::<i64>().unwrap_or(0))
    }
    let n = nums[0] as usize
    let mut ivs: Vec<Interval> = Vec::new()
    let mut i: usize = 0
    while i < n {
        ivs.push(Interval { lo: nums[1 + 2 * i], hi: nums[2 + 2 * i] })
        i += 1
    }
    ivs.sort_by(|a, b| a.lo.cmp(b.lo))
    let mut merged: Vec<Interval> = Vec::new()
    for iv in ivs {
        let m = merged.len()
        if m > 0 && iv.lo <= merged[m - 1].hi {
            if iv.hi > merged[m - 1].hi {
                merged[m - 1].hi = iv.hi
            }
        } else {
            merged.push(iv)
        }
    }
    for iv in merged {
        println("${iv.lo} ${iv.hi}")
    }
}

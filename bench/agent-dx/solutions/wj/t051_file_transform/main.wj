use std::env
use std::fs
use std::process

fn main() {
    let args: Vec<string> = env::args().collect()
    if args.len() != 4 {
        println("usage: transform INPUT OUTPUT MODE")
        process::exit(2)
    }
    let input = args[1].clone()
    let output = args[2].clone()
    let mode = args[3].clone()
    let text = match fs::read_to_string(input.as_str()) {
        Ok(t) => t,
        Err(_) => {
            println("error: cannot read ${input}")
            process::exit(1)
            "".to_string()
        }
    }
    let known = mode == "upper" || mode == "reverse" || mode == "sort" || mode == "dedupe" || mode == "trim" || mode == "number"
    if !known {
        println("error: unknown mode ${mode}")
        process::exit(2)
    }
    let mut lines: Vec<string> = text.lines().map(|s| s.to_string()).collect()
    if mode == "upper" {
        lines = lines.iter().map(|l| l.to_uppercase()).collect()
    } else if mode == "reverse" {
        lines.reverse()
    } else if mode == "sort" {
        lines.sort()
    } else if mode == "dedupe" {
        let mut out: Vec<string> = Vec::new()
        for l in lines.iter() {
            if !out.contains(l) { out.push(l.clone()) }
        }
        lines = out
    } else if mode == "trim" {
        lines = lines.iter().map(|l| l.trim_matches(' ').to_string()).collect()
    } else {
        let mut out: Vec<string> = Vec::new()
        let mut i: usize = 0
        while i < lines.len() {
            out.push("${i + 1}:${lines[i]}")
            i += 1
        }
        lines = out
    }
    let mut body = ""
    for l in lines.iter() {
        body = body + l + "\n"
    }
    match fs::write(output.as_str(), body.as_str()) {
        Ok(_) => {}
        Err(_) => {
            println("error: cannot write ${output}")
            process::exit(1)
        }
    }
    println("wrote ${lines.len()} lines to ${output}")
    let back = fs::read_to_string(output.as_str()).unwrap_or("")
    print(back)
}

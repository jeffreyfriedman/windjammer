use std::fs

struct Rec {
    name: string,
    age: i64,
    city: string,
}

fn compare_by(a: Rec, b: Rec, field: string) -> i64 {
    if field == "age" {
        if a.age < b.age { -1 } else if a.age > b.age { 1 } else { 0 }
    } else if field == "name" {
        if a.name < b.name { -1 } else if a.name > b.name { 1 } else { 0 }
    } else {
        if a.city < b.city { -1 } else if a.city > b.city { 1 } else { 0 }
    }
}

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut lines = text.lines()
    let spec = lines.next().unwrap_or("")
    let mut fields: Vec<string> = Vec::new()
    let mut descs: Vec<bool> = Vec::new()
    for part in spec.split(",") {
        let kv: Vec<string> = part.split(":").map(|s| s.to_string()).collect()
        fields.push(kv[0].clone())
        descs.push(kv[1] == "desc")
    }
    let mut recs: Vec<Rec> = Vec::new()
    for l in lines {
        let p: Vec<string> = l.split_whitespace().map(|s| s.to_string()).collect()
        if p.len() < 3 { continue }
        recs.push(Rec { name: p[0].clone(), age: p[1].parse::<i64>().unwrap_or(0), city: p[2].clone() })
    }
    // stable insertion sort
    let n = recs.len()
    let mut i: usize = 1
    while i < n {
        let mut j = i
        while j > 0 {
            let mut c: i64 = 0
            let mut k: usize = 0
            while k < fields.len() && c == 0 {
                c = compare_by(recs[j - 1].clone(), recs[j].clone(), fields[k].clone())
                if descs[k] { c = 0 - c }
                k += 1
            }
            if c > 0 {
                recs.swap(j - 1, j)
                j -= 1
            } else {
                break
            }
        }
        i += 1
    }
    for r in recs {
        println("${r.name} ${r.age} ${r.city}")
    }
}

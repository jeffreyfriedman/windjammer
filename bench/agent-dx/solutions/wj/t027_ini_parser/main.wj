use std::fs
use std::collections::HashMap

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut values: HashMap<string, string> = HashMap::new()
    let mut section = ""
    let mut in_queries = false
    for raw in text.lines() {
        if in_queries {
            let q = raw.to_string()
            let key = match q.find(".") {
                Some(p) => q,
                None => "." + q,
            }
            match values.get(key.as_str()) {
                Some(v) => { println(v) }
                None => { println("<none>") }
            }
            continue
        }
        let t = raw.trim()
        if t == "---" && raw == "---" {
            in_queries = true
            continue
        }
        if t.len() == 0 || t.starts_with(";") || t.starts_with("#") {
            continue
        }
        if t.starts_with("[") && t.ends_with("]") {
            section = t.as_str()[1..t.len() - 1].to_string()
        } else {
            match t.find("=") {
                Some(p) => {
                    let k = t.as_str()[0..p].trim().to_string()
                    let v = t.as_str()[p + 1..].trim().to_string()
                    values.insert(section.clone() + "." + k, v)
                }
                None => {}
            }
        }
    }
}

use std::fs
use std::sync::mpsc
use std::sync::{Arc, Mutex}
use std::thread
use std::thread::JoinHandle

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let p: Vec<usize> = text.split_whitespace().map(|s| s.parse::<usize>().unwrap_or(0)).collect()
    let producers = p[0]
    let per = p[1]
    let consumers = p[2]
    let (tx, rx) = mpsc::sync_channel(4)
    let shared_rx = Arc::new(Mutex::new(rx))
    let collected = Arc::new(Mutex::new(Vec::new()))
    let mut prod_handles: Vec<JoinHandle<()>> = Vec::new()
    let mut a: usize = 0
    while a < producers {
        let t = tx.clone()
        prod_handles.push(thread::spawn(move || {
            let mut j: usize = 1
            while j <= per {
                t.send("p${a}-${j}")
                j += 1
            }
        }))
        a += 1
    }
    drop(tx)
    let mut cons_handles: Vec<JoinHandle<i64>> = Vec::new()
    let mut c: usize = 0
    while c < consumers {
        let r = shared_rx.clone()
        let out = collected.clone()
        cons_handles.push(thread::spawn(move || {
            let mut mine: i64 = 0
            loop {
                let item = match r.lock() {
                    Ok(guard) => guard.recv(),
                    Err(_) => { break }
                }
                match item {
                    Ok(s) => {
                        match out.lock() {
                            Ok(mut g) => { g.push(s) }
                            Err(_) => {}
                        }
                        mine += 1
                    }
                    Err(_) => { break }
                }
            }
            return mine
        }))
        c += 1
    }
    for h in prod_handles { h.join() }
    let mut total: i64 = 0
    for h in cons_handles { total += h.join().unwrap_or(0) }
    let mut items: Vec<string> = match collected.lock() {
        Ok(g) => g.clone(),
        Err(_) => Vec::new(),
    }
    items.sort()
    let mut chars: usize = 0
    for s in items { chars += s.len() }
    println("items: ${items.len()}")
    println("chars: ${chars}")
    let mut i: usize = 0
    while i < 3 && i < items.len() {
        println("first: ${items[i]}")
        i += 1
    }
    println("consumers_total: ${total}")
}

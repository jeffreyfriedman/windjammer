use std::fs

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut lines = text.lines()
    let head: Vec<i64> = lines.next().unwrap_or("1 1 0").split_whitespace().map(|s| s.parse::<i64>().unwrap_or(0)).collect()
    let w = head[0]
    let h = head[1]
    let gens = head[2]
    let mut grid: Vec<bool> = Vec::new()
    for l in lines {
        for c in l.chars() {
            grid.push(c == '#')
        }
    }
    let mut g: i64 = 0
    while g < gens {
        let mut next: Vec<bool> = Vec::new()
        let mut y: i64 = 0
        while y < h {
            let mut x: i64 = 0
            while x < w {
                let mut n = 0
                let mut dy: i64 = -1
                while dy <= 1 {
                    let mut dx: i64 = -1
                    while dx <= 1 {
                        if dy != 0 || dx != 0 {
                            let yy = (y + dy + h) % h
                            let xx = (x + dx + w) % w
                            if grid[(yy * w + xx) as usize] { n += 1 }
                        }
                        dx += 1
                    }
                    dy += 1
                }
                let alive = grid[(y * w + x) as usize]
                next.push(n == 3 || (alive && n == 2))
                x += 1
            }
            y += 1
        }
        grid = next
        g += 1
    }
    let mut alive_count = 0
    let mut y: i64 = 0
    while y < h {
        let mut row = ""
        let mut x: i64 = 0
        while x < w {
            if grid[(y * w + x) as usize] {
                row = row + "#"
                alive_count += 1
            } else {
                row = row + "."
            }
            x += 1
        }
        println(row)
        y += 1
    }
    println("alive: ${alive_count}")
}

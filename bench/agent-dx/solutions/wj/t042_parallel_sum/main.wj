use std::fs
use std::thread

fn main() {
    let text = fs::read_to_string("/dev/stdin").unwrap_or("")
    let mut nums: Vec<i64> = Vec::new()
    for w in text.split_whitespace() {
        nums.push(w.parse::<i64>().unwrap_or(0))
    }
    let workers = nums[0] as usize
    let n = nums[1] as usize
    let q = n / workers
    let r = n % workers
    let mut handles = Vec::new()
    let mut pos: usize = 2
    let mut i: usize = 0
    while i < workers {
        let len = if i < r { q + 1 } else { q }
        let chunk: Vec<i64> = nums[pos..pos + len].to_vec()
        pos += len
        let h = thread::spawn(move || {
            let mut s: i64 = 0
            for x in chunk {
                s += x
            }
            s
        })
        handles.push(h)
        i += 1
    }
    let mut total: i64 = 0
    let mut idx: usize = 0
    for h in handles {
        let s = h.join().unwrap_or(0)
        println("chunk ${idx}: ${s}")
        total += s
        idx += 1
    }
    println("total: ${total}")
}

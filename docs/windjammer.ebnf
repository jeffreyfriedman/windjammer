(* The normative, machine-checked grammar of the language specification is docs/spec/grammar.ebnf. *)
(* Windjammer Formal Grammar — v0.50.0 *)
(* This EBNF grammar is a reference for constrained-decoding harnesses and *)
(* code-generation agents. It was reconciled with src/parser and src/lexer on 2026-10-10. *)
(* Constructs marked (* NOT PARSED *) are proposed in RFCs but rejected or unreachable today. *)

program         = { item } ;

item            = use_decl
                | struct_decl
                | enum_decl
                | trait_decl
                | impl_block
                | function_decl
                | const_decl
                | type_alias
                | static_decl
                | mod_decl
                | extern_decl
                | bound_alias
                | decorator item ;

(* ── Declarations ── *)

use_decl        = "use" use_path [ "::" "{" ident_list "}" | "as" IDENT ] ;
use_path        = IDENT { "::" IDENT } ;

struct_decl     = [ visibility ] "struct" IDENT [ generic_params ]
                  "{" { field_decl [ "," ] } "}" ;
field_decl      = [ visibility ] IDENT ":" type_expr ;

enum_decl       = [ visibility ] "enum" IDENT [ generic_params ]
                  "{" { variant_decl [ "," ] } "}" ;
variant_decl    = IDENT [ "(" type_list ")" | "{" { field_decl [ "," ] } "}" ] ;

trait_decl      = [ visibility ] "trait" IDENT [ generic_params ]
                  [ ":" type_expr { "+" type_expr } ] "{" { trait_item } "}" ;
trait_item      = function_sig | type_alias ;

impl_block      = "impl" [ generic_params ] type_expr
                  [ "for" type_expr ] "{" { function_decl } "}" ;

function_decl   = [ visibility ] [ "async" ] "fn" IDENT
                  [ generic_params ] "(" param_list ")"
                  [ "->" type_expr ] [ where_clause ] block ;
function_sig    = [ visibility ] [ "async" ] "fn" IDENT
                  [ generic_params ] "(" param_list ")"
                  [ "->" type_expr ] [ where_clause ] ;

const_decl      = "const" IDENT ":" type_expr "=" expression ;     (* the type is required *)
static_decl     = "static" [ "mut" ] IDENT ":" type_expr "=" expression ;

mod_decl        = [ visibility ] "mod" IDENT [ "{" { item } "}" ] ;   (* no body: external file module *)

extern_decl     = [ visibility ] "extern" ( "fn" IDENT [ generic_params ] "(" param_list ")" [ "->" type_expr ]
                                          | "struct" IDENT [ generic_params ] "{" { field_decl [ "," ] } "}"
                                          | "impl" type_expr "{" { function_sig } "}"
                                          | "let" IDENT ":" type_expr ) ;

(* soft keyword: "bound" is special only at item position, followed by IDENT and "=" *)
bound_alias     = [ visibility ] "bound" IDENT "=" type_expr { "+" type_expr } ;

where_clause    = "where" where_pred { "," where_pred } ;
where_pred      = type_expr ":" type_expr { "+" type_expr } ;
type_alias      = "type" IDENT "=" type_expr ;           (* no generic parameters *)

decorator       = "@" IDENT [ "(" arg_list ")" ] ;

(* ── Parameters ── *)

param_list      = [ param { "," param } [ "," ] ] ;
param           = [ "mut" ] IDENT ":" type_expr [ "=" expression ] ;

(* ── Types ── *)

type_expr       = base_type
                | generic_type
                | array_type
                | tuple_type
                | fn_type
                | optional_type
                | dyn_type ;

base_type       = IDENT ;
generic_type    = IDENT "<" type_list ">" ;
array_type      = "[" type_expr "]" ;
tuple_type      = "(" type_list ")" ;
fn_type         = "fn" "(" type_list ")" "->" type_expr ;
optional_type   = "Option" "<" type_expr ">" ;
dyn_type        = "dyn" type_expr ;

type_list       = type_expr { "," type_expr } ;
generic_params  = "<" generic_param { "," generic_param } ">" ;
generic_param   = IDENT [ ":" type_expr { "+" type_expr } ] ;

(* ── Statements ── *)

statement       = let_stmt
                | assignment_stmt
                | return_stmt
                | expression_stmt
                | if_stmt
                | match_stmt
                | for_stmt
                | while_stmt
                | loop_stmt
                | break_stmt
                | continue_stmt
                | defer_stmt
                | thread_stmt
                | async_stmt
                | static_decl
                | const_decl ;

defer_stmt      = "defer" statement ;
thread_stmt     = "thread" block ;              (* statement only when followed by "{" *)
async_stmt      = "async" block ;               (* statement only when followed by "{" *)

let_stmt        = "let" [ "mut" ] IDENT [ ":" type_expr ] "=" expression ;
assignment_stmt = lvalue assign_op expression ;
lvalue          = postfix ;
assign_op       = "=" | "+=" | "-=" | "*=" | "/=" | "%="
                | "<<=" | ">>=" | "&=" | "|=" | "^=" ;
return_stmt     = "return" [ expression ] ;
expression_stmt = expression ;

if_stmt         = "if" expression block { "else" "if" expression block } [ "else" block ] ;
if_let_stmt     = "if" "let" pattern "=" expression block [ "else" block ] ;

match_stmt      = "match" expression "{" { match_arm } "}" ;
match_arm       = pattern [ "if" expression ] "=>" ( expression | block ) [ "," ] ;

label           = LIFETIME ":" ;                (* 'outer: *)
for_stmt        = [ label ] "for" pattern "in" expression block ;
while_stmt      = [ label ] "while" expression block ;
loop_stmt       = [ label ] "loop" block ;      (* also an expression: its value is the `break` value *)
break_stmt      = "break" [ LIFETIME ] [ expression ] ;   (* value only when on the same line *)
continue_stmt   = "continue" [ LIFETIME ] ;

block           = "{" { statement } [ expression ] "}" ;

(* ── Patterns ── *)

pattern         = "_"
                | IDENT
                | literal
                | tuple_pattern
                | struct_pattern
                | enum_pattern
                | range_pattern
                | or_pattern ;

tuple_pattern   = "(" pattern { "," pattern } ")" ;
struct_pattern  = IDENT "{" { field_pattern [ "," ] } [ ".." ] "}" ;
field_pattern   = IDENT [ ":" pattern ] ;
enum_pattern    = path "::" IDENT [ "(" pattern_list ")" ] ;
range_pattern   = range_bound ".." [ range_bound ] | range_bound "..=" range_bound
                | ".." range_bound | "..=" range_bound ;
range_bound     = [ "-" ] ( INT_LIT | FLOAT_LIT ) | CHAR_LIT ;
or_pattern      = pattern "|" pattern ;
pattern_list    = pattern { "," pattern } ;

(* ── Expressions ── *)

expression      = assignment_expr ;

assignment_expr = pipe_expr [ "<-" expression ] ;   (* "ch <- v" sends on a channel; assignment itself is a statement *)
pipe_expr       = or_expr { "|>" pipe_stage } ;      (* pipe operator: x |> f(a)  ==  f(x, a); binds looser than every other operator *)
or_expr         = and_expr { "||" and_expr } ;
pipe_stage      = path | path "(" arg_list ")" | "." IDENT "(" arg_list ")" | closure ;   (* anything else is an error *)
and_expr        = comparison { "&&" comparison } ;
comparison      = bitor { cmp_op bitor } ;
cmp_op          = "==" | "!=" | "<" | ">" | "<=" | ">=" ;
bitor           = bitxor { "|" bitxor } ;
bitxor          = bitand { "^" bitand } ;
bitand          = shift { "&" shift } ;
shift           = additive { ( "<<" | ">>" ) additive } ;
additive        = multiplicative { ( "+" | "-" ) multiplicative } ;
multiplicative  = cast { ( "*" | "/" | "%" ) cast } ;
cast            = unary { "as" type_expr } ;            (* numeric cast: x as u8 *)
unary           = ( "-" | "!" | "~" | "<-" ) unary | postfix ;     (* "<-ch" receives from a channel *)
postfix         = primary { postfix_op } ;

postfix_op      = "." IDENT                     (* field access *)
                | "." IDENT "(" arg_list ")"    (* method call *)
                | "(" arg_list ")"              (* function call *)
                | "[" expression "]"            (* index *)
                | "." "await"                   (* await a future *)
                | "?" ;                         (* try operator *)

primary         = literal
                | IDENT
                | "self"
                | path "::" IDENT
                | "(" expression ")"
                | array_literal
                | struct_literal
                | closure
                | if_expr
                | match_expr
                | block
                | unsafe_block ;

unsafe_block    = "unsafe" block ;

(* NOT PARSED: caller-controlled "async expr" / "spawn expr" (RFC WJ-CONC-01).            *)
(* The AST has AsyncCall/SpawnCall variants but no parser path constructs them (ADR-0004). *)
(* async_expr  = "async" expression ;                                                      *)
(* spawn_expr  = "spawn" expression ;                                                      *)

(* NOT PARSED: ternary "c ? a : b" was removed; use if_expr. "?" is only the postfix try operator. *)

if_expr         = "if" expression block [ "else" block ] ;
match_expr      = "match" expression "{" { match_arm } "}" ;

closure         = "|" param_list "|" ( expression | block ) ;

array_literal   = "[" [ expression { "," expression } [ "," ] ] "]" ;
struct_literal  = IDENT "{" { field_init [ "," ] } "}" ;
field_init      = IDENT [ ":" expression ] ;

literal         = INT_LIT | FLOAT_LIT | STRING_LIT | CHAR_LIT
                | "true" | "false" | "None" ;

(* ── Argument lists ── *)

arg_list        = [ arg { "," arg } [ "," ] ] ;
arg             = [ IDENT ":" ] expression ;

(* ── Paths / Identifiers ── *)

path            = IDENT { "::" IDENT } ;
ident_list      = IDENT { "," IDENT } ;
visibility      = "pub" ;                      (* pub(crate) is not parsed *)

(* ── Lexical tokens (informative) ── *)

IDENT           = LETTER { LETTER | DIGIT | "_" } ;
INT_LIT         = ( DIGIT { DIGIT | "_" } | "0x" HEX { HEX | "_" } | "0b" BIN { BIN | "_" } | "0o" OCT { OCT | "_" } ) [ int_suffix ] ;
LIFETIME        = "'" LETTER { LETTER | DIGIT | "_" } ;
int_suffix      = "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" | "usize" ;
FLOAT_LIT       = DIGIT { DIGIT } "." DIGIT { DIGIT } [ float_suffix ] ;
float_suffix    = "f32" | "f64" ;
STRING_LIT      = '"' { CHAR - '"' - "$" | escape | interpolation } '"' ;
interpolation   = "${" expression "}" ;               (* string interpolation, e.g. "Hello, ${name}!" *)
CHAR_LIT        = "'" ( CHAR - "'" | escape ) "'" ;
escape          = "\\" ( "n" | "r" | "t" | "\\" | "'" | '"' | "0" | "x" HEX HEX ) ;
LETTER          = "a"…"z" | "A"…"Z" | "_" ;
DIGIT           = "0"…"9" ;
BIN             = "0" | "1" ;
OCT             = "0"…"7" ;
HEX             = DIGIT | "a"…"f" | "A"…"F" ;

(* ── Comments ── *)

line_comment    = "//" { CHAR } NEWLINE ;
block_comment   = "/*" { CHAR | block_comment } "*/" ;

(* ── Whitespace ── *)

WHITESPACE      = " " | "\t" | "\r" | "\n" ;

(* Character classes used by the lexical rules above (informative). *)
CHAR            = "any character" ;
NEWLINE         = "\n" ;

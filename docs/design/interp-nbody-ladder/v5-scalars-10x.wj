// VARIANT v5-scalars: the 35 body fields as scalar locals, the 10 pairs and 5 position updates unrolled by hand (no vector access at all: the machine-code floor of today's Cranelift lowering for the arithmetic, the loop and the register traffic).
// n-body (5 bodies): float arithmetic over a Vec of structs mutated in place.
use std::time
struct Body {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    m: f64,
}

fn energy(bodies: Vec<Body>) -> f64 {
    let mut e = 0.0
    let n = bodies.len()
    let mut i = 0
    while i < n {
        let b = bodies[i]
        e += 0.5 * b.m * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        let mut j = i + 1
        while j < n {
            let dx = b.x - bodies[j].x
            let dy = b.y - bodies[j].y
            let dz = b.z - bodies[j].z
            e -= b.m * bodies[j].m / (dx * dx + dy * dy + dz * dz).sqrt()
            j += 1
        }
        i += 1
    }
    e
}

fn main() {
    let mut x0 = 0.0
    let mut y0 = 0.0
    let mut z0 = 0.0
    let mut vx0 = 0.0
    let mut vy0 = 0.0
    let mut vz0 = 0.0
    let m0 = 39.47
    let mut x1 = 4.84
    let mut y1 = -1.16
    let mut z1 = -0.10
    let mut vx1 = 0.60
    let mut vy1 = 2.81
    let mut vz1 = -0.02
    let m1 = 0.037
    let mut x2 = 8.34
    let mut y2 = 4.12
    let mut z2 = -0.40
    let mut vx2 = -1.01
    let mut vy2 = 1.82
    let mut vz2 = 0.008
    let m2 = 0.011
    let mut x3 = 12.89
    let mut y3 = -15.11
    let mut z3 = -0.22
    let mut vx3 = 1.08
    let mut vy3 = 0.86
    let mut vz3 = -0.01
    let m3 = 0.0017
    let mut x4 = 15.37
    let mut y4 = -25.91
    let mut z4 = 0.17
    let mut vx4 = 0.97
    let mut vy4 = 0.59
    let mut vz4 = -0.03
    let m4 = 0.002
    let mut bodies: Vec<Body> = Vec::new()
    bodies.push(Body { x: x0, y: y0, z: z0, vx: vx0, vy: vy0, vz: vz0, m: m0 })
    bodies.push(Body { x: x1, y: y1, z: z1, vx: vx1, vy: vy1, vz: vz1, m: m1 })
    bodies.push(Body { x: x2, y: y2, z: z2, vx: vx2, vy: vy2, vz: vz2, m: m2 })
    bodies.push(Body { x: x3, y: y3, z: z3, vx: vx3, vy: vy3, vz: vz3, m: m3 })
    bodies.push(Body { x: x4, y: y4, z: z4, vx: vx4, vy: vy4, vz: vz4, m: m4 })
    let t0 = time::now_unix_nano()
    let before = energy(bodies)
    let mut step = 0
    while step < 200000 {
        let dt = 0.01
        let dx0 = x0 - x1
        let dy0 = y0 - y1
        let dz0 = z0 - z1
        let d20 = dx0 * dx0 + dy0 * dy0 + dz0 * dz0
        let mag0 = dt / (d20 * d20.sqrt())
        vx0 -= dx0 * m1 * mag0
        vy0 -= dy0 * m1 * mag0
        vz0 -= dz0 * m1 * mag0
        vx1 += dx0 * m0 * mag0
        vy1 += dy0 * m0 * mag0
        vz1 += dz0 * m0 * mag0
        let dx1 = x0 - x2
        let dy1 = y0 - y2
        let dz1 = z0 - z2
        let d21 = dx1 * dx1 + dy1 * dy1 + dz1 * dz1
        let mag1 = dt / (d21 * d21.sqrt())
        vx0 -= dx1 * m2 * mag1
        vy0 -= dy1 * m2 * mag1
        vz0 -= dz1 * m2 * mag1
        vx2 += dx1 * m0 * mag1
        vy2 += dy1 * m0 * mag1
        vz2 += dz1 * m0 * mag1
        let dx2 = x0 - x3
        let dy2 = y0 - y3
        let dz2 = z0 - z3
        let d22 = dx2 * dx2 + dy2 * dy2 + dz2 * dz2
        let mag2 = dt / (d22 * d22.sqrt())
        vx0 -= dx2 * m3 * mag2
        vy0 -= dy2 * m3 * mag2
        vz0 -= dz2 * m3 * mag2
        vx3 += dx2 * m0 * mag2
        vy3 += dy2 * m0 * mag2
        vz3 += dz2 * m0 * mag2
        let dx3 = x0 - x4
        let dy3 = y0 - y4
        let dz3 = z0 - z4
        let d23 = dx3 * dx3 + dy3 * dy3 + dz3 * dz3
        let mag3 = dt / (d23 * d23.sqrt())
        vx0 -= dx3 * m4 * mag3
        vy0 -= dy3 * m4 * mag3
        vz0 -= dz3 * m4 * mag3
        vx4 += dx3 * m0 * mag3
        vy4 += dy3 * m0 * mag3
        vz4 += dz3 * m0 * mag3
        let dx4 = x1 - x2
        let dy4 = y1 - y2
        let dz4 = z1 - z2
        let d24 = dx4 * dx4 + dy4 * dy4 + dz4 * dz4
        let mag4 = dt / (d24 * d24.sqrt())
        vx1 -= dx4 * m2 * mag4
        vy1 -= dy4 * m2 * mag4
        vz1 -= dz4 * m2 * mag4
        vx2 += dx4 * m1 * mag4
        vy2 += dy4 * m1 * mag4
        vz2 += dz4 * m1 * mag4
        let dx5 = x1 - x3
        let dy5 = y1 - y3
        let dz5 = z1 - z3
        let d25 = dx5 * dx5 + dy5 * dy5 + dz5 * dz5
        let mag5 = dt / (d25 * d25.sqrt())
        vx1 -= dx5 * m3 * mag5
        vy1 -= dy5 * m3 * mag5
        vz1 -= dz5 * m3 * mag5
        vx3 += dx5 * m1 * mag5
        vy3 += dy5 * m1 * mag5
        vz3 += dz5 * m1 * mag5
        let dx6 = x1 - x4
        let dy6 = y1 - y4
        let dz6 = z1 - z4
        let d26 = dx6 * dx6 + dy6 * dy6 + dz6 * dz6
        let mag6 = dt / (d26 * d26.sqrt())
        vx1 -= dx6 * m4 * mag6
        vy1 -= dy6 * m4 * mag6
        vz1 -= dz6 * m4 * mag6
        vx4 += dx6 * m1 * mag6
        vy4 += dy6 * m1 * mag6
        vz4 += dz6 * m1 * mag6
        let dx7 = x2 - x3
        let dy7 = y2 - y3
        let dz7 = z2 - z3
        let d27 = dx7 * dx7 + dy7 * dy7 + dz7 * dz7
        let mag7 = dt / (d27 * d27.sqrt())
        vx2 -= dx7 * m3 * mag7
        vy2 -= dy7 * m3 * mag7
        vz2 -= dz7 * m3 * mag7
        vx3 += dx7 * m2 * mag7
        vy3 += dy7 * m2 * mag7
        vz3 += dz7 * m2 * mag7
        let dx8 = x2 - x4
        let dy8 = y2 - y4
        let dz8 = z2 - z4
        let d28 = dx8 * dx8 + dy8 * dy8 + dz8 * dz8
        let mag8 = dt / (d28 * d28.sqrt())
        vx2 -= dx8 * m4 * mag8
        vy2 -= dy8 * m4 * mag8
        vz2 -= dz8 * m4 * mag8
        vx4 += dx8 * m2 * mag8
        vy4 += dy8 * m2 * mag8
        vz4 += dz8 * m2 * mag8
        let dx9 = x3 - x4
        let dy9 = y3 - y4
        let dz9 = z3 - z4
        let d29 = dx9 * dx9 + dy9 * dy9 + dz9 * dz9
        let mag9 = dt / (d29 * d29.sqrt())
        vx3 -= dx9 * m4 * mag9
        vy3 -= dy9 * m4 * mag9
        vz3 -= dz9 * m4 * mag9
        vx4 += dx9 * m3 * mag9
        vy4 += dy9 * m3 * mag9
        vz4 += dz9 * m3 * mag9
        x0 += dt * vx0
        y0 += dt * vy0
        z0 += dt * vz0
        x1 += dt * vx1
        y1 += dt * vy1
        z1 += dt * vz1
        x2 += dt * vx2
        y2 += dt * vy2
        z2 += dt * vz2
        x3 += dt * vx3
        y3 += dt * vy3
        z3 += dt * vz3
        x4 += dt * vx4
        y4 += dt * vy4
        z4 += dt * vz4
        step += 1
    }
    let mut after_bodies: Vec<Body> = Vec::new()
    after_bodies.push(Body { x: x0, y: y0, z: z0, vx: vx0, vy: vy0, vz: vz0, m: m0 })
    after_bodies.push(Body { x: x1, y: y1, z: z1, vx: vx1, vy: vy1, vz: vz1, m: m1 })
    after_bodies.push(Body { x: x2, y: y2, z: z2, vx: vx2, vy: vy2, vz: vz2, m: m2 })
    after_bodies.push(Body { x: x3, y: y3, z: z3, vx: vx3, vy: vy3, vz: vz3, m: m3 })
    after_bodies.push(Body { x: x4, y: y4, z: z4, vx: vx4, vy: vy4, vz: vz4, m: m4 })
    let after = energy(after_bodies)
    eprintln("STEADY_NS ${time::now_unix_nano() - t0}")
    println("${(before * 1000000.0) as i64} ${(after * 1000000.0) as i64}")
}

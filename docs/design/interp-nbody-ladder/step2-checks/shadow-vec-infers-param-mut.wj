// FOUND 2026-11-24 (wj-rc3head ff6e39555): `wj check` reports WJ0051 "`b` is changed but is not declared mut" at
// the call: the push on the shadowing `let mut ps` is attributed to the parameter. Expected: 0 errors, output 0.
struct P {
    x: f64,
}

fn f2(ps: Vec<P>) {
    let mut ps: Vec<P> = Vec::new()
    ps.push(P { x: 1.0 })
}

fn main() {
    let b: Vec<P> = Vec::new()
    f2(b)
    println("${b.len()}")
}

// Step 2 check A1 (interp-call-unit.md section 10): recursion through a unit-returning function with a
// loop (a function-unit callee, so a native-call candidate once step 2 lands). Pins the depth FLOOR, never
// the exact overflow depth: 3 hot rounds of a 50,000-deep self-recursion must succeed under both engines.
// Run: wj run --interpret a1-depth.wj ; wj run --interpret --engine walker a1-depth.wj ; outputs must match.
// Expected output: 150003 then 2000
struct P {
    x: f64,
}

fn walk(ps: Vec<P>, d: int) {
    let mut i = 0
    while i < ps.len() {
        ps[i].x += 1.0
        i += 1
    }
    if d > 0 {
        walk(ps, d - 1)
    }
}

fn bump(ps: Vec<P>) {
    let mut i = 0
    while i < ps.len() {
        ps[i].x += 1.0
        i += 1
    }
}

fn main() {
    let mut ps: Vec<P> = Vec::new()
    ps.push(P { x: 0.0 })
    let mut r = 0
    while r < 3 {
        walk(ps, 50000)
        r += 1
    }
    println("${ps[0].x as i64}")
    // a hot caller loop with a native-call candidate, so the caller unit compiles before the deep calls below
    let mut qs: Vec<P> = Vec::new()
    qs.push(P { x: 0.0 })
    let mut s = 0
    while s < 2000 {
        bump(qs)
        s += 1
    }
    println("${qs[0].x as i64}")
}

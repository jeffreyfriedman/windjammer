// FOUND 2026-11-24 (wj-rc3head ff6e39555): `wj check` reports WJ0003 "f2 (3_i64) needs &i64": the mutation of the
// shadowing `let mut n` is attributed to the parameter `n`. Expected: 0 errors, output 7.
fn f2(n: int) {
    let mut n = n * 2
    n += 1
    println("${n}")
}

fn main() {
    f2(3)
}

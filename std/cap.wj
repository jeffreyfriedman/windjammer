        Err("cap::Fs requires the Windjammer runtime")
    }

    fn read(self, path: string) -> Result<Vec<u8>, string> {
        Err("cap::Fs requires the Windjammer runtime")
    }

    fn exists(self, path: string) -> bool {
        false
    }

    fn write(self, path: string, contents: string) -> Result<(), string> {
        Err("cap::Fs requires the Windjammer runtime")
    }

    fn create_dir_all(self, path: string) -> Result<(), string> {
        Err("cap::Fs requires the Windjammer runtime")
    }

    fn remove_file(self, path: string) -> Result<(), string> {
        Err("cap::Fs requires the Windjammer runtime")
    }

// std/cap - capability values (ADR-0021)
// Implementation: windjammer_runtime::cap (checked against the grant it was minted from)
//
// A capability value is an unforgeable handle: the only way to get one is to mint it from the
// program's own grant (`cap::net()`, `cap::fs()`, ...), and narrowing (`only`, `under`, `read_only`)
// can only shrink what it allows. A function that is handed a value needs no grant of its own.

// PUBLIC API - Users interact with these types and functions only

struct Net {
    // Private: a narrowed grant (net.connect)
}

struct Fs {
    // Private: a narrowed grant (fs.read / fs.write)
}

struct Env {
    // Private: a narrowed grant (env.read)
}

struct Process {
    // Private: a narrowed grant (process)
}

struct Clock {
    // Private: the right to read the time
}

struct Rng {
    // Private: the right to draw random numbers
}

// Minting (checked against the running program's grant)

fn net() -> Net {
    Net {}
}

fn fs() -> Fs {
    Fs {}
}

fn env() -> Env {
    Env {}
}

fn process() -> Process {
    Process {}
}

fn clock() -> Clock {
    Clock {}
}

fn rng() -> Rng {
    Rng {}
}

impl Net {
    fn only(self, hosts: Vec<string>) -> Net {
        Net {}
    }

    fn get(self, url: string) -> Result<Response, string> {
        Err("cap::Net requires the Windjammer runtime")
    }

    fn post(self, url: string, body: string) -> Result<Response, string> {
        Err("cap::Net requires the Windjammer runtime")
    }

    fn put(self, url: string, body: string) -> Result<Response, string> {
        Err("cap::Net requires the Windjammer runtime")
    }

    fn delete(self, url: string) -> Result<Response, string> {
        Err("cap::Net requires the Windjammer runtime")
    }

    fn head(self, url: string) -> Result<Response, string> {
        Err("cap::Net requires the Windjammer runtime")
    }
}


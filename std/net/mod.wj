// ============================================================================
// HTTP SERVER API
// ============================================================================

/// HTTP Server Request (received by server)
pub struct ServerRequest {
    pub method: HttpMethod,
    pub path: string,
    pub headers: Vec<(string, string)>,
    pub body: string,
}

/// HTTP Server Response (sent by server)
pub struct ServerResponse {
    pub status: int,
    pub headers: Vec<(string, string)>,
    pub body: string,
}

impl ServerResponse {
    /// Create a new response
    pub fn new(status: int, body: string) -> ServerResponse {
        ServerResponse {
            status: status,
            headers: vec![],
            body: body,
        }
    }
    
    /// Create an HTML response
    pub fn html(body: string) -> ServerResponse {
        ServerResponse {
            status: 200,
            headers: vec![("Content-Type", "text/html")],
            body: body,
        }
    }
    
    /// Create a JSON response
    pub fn json(body: string) -> ServerResponse {
        ServerResponse {
            status: 200,
            headers: vec![("Content-Type", "application/json")],
            body: body,
        }
    }
    
    /// Create an error response
    pub fn error(status: int, message: string) -> ServerResponse {
        ServerResponse {
            status: status,
            headers: vec![("Content-Type", "text/plain")],
            body: message,
        }
    }
    
    /// Add a header
    pub fn header(mut self, key: string, value: string) -> ServerResponse {
        self.headers.push((key, value))
        self
    }
}

/// HTTP Server
pub struct Server {
    pub address: string,
    pub port: int,
}

impl Server {
    /// Create a new server
    pub fn new(address: string, port: int) -> Server {
        Server {
            address: address,
            port: port,
        }
    }
    
    /// Start the server with a request handler
    /// The handler is called for each incoming request
    pub fn serve<F>(self, handler: F) -> NetResult<()>
    where
        F: Fn(ServerRequest) -> ServerResponse
    {
        // Compiler will generate platform-specific code
        // Native: Use std::net::TcpListener
        // Browser: Not supported (servers can't run in browsers)
        Err("Not implemented")
    }
}


// ============================================================================
// RAW SOCKETS (ADR-0032)
// ============================================================================
// Bytes are Vec<u8>; errors are strings from a fixed vocabulary ("connection refused", "timed out",
// "connection reset", "broken pipe", "address in use", "unexpected end of stream", "invalid address: ADDR").
// Grants: `net.connect` on `host:port` for connect and every UDP send_to; `net.listen` for bind.

/// A TCP connection. Closes when dropped; the peer then reads end of stream.
pub struct TcpStream {
    // Internal implementation hidden
}

impl TcpStream {
    /// Connect to `host:port`.
    pub fn connect(addr: string) -> NetResult<TcpStream> {
        Err("Not implemented")
    }

    /// Connect, giving up after `timeout_ms` milliseconds (0: no limit).
    pub fn connect_timeout(addr: string, timeout_ms: int) -> NetResult<TcpStream> {
        Err("Not implemented")
    }

    /// Up to `max` bytes as soon as any are available; an empty vector means the peer closed its write half.
    pub fn read(&mut self, max: int) -> NetResult<Vec<u8>> {
        Err("Not implemented")
    }

    /// Exactly `n` bytes, or Err("unexpected end of stream").
    pub fn read_exact(&mut self, n: int) -> NetResult<Vec<u8>> {
        Err("Not implemented")
    }

    /// Through the next newline (kept); "" at end of stream.
    pub fn read_line(&mut self) -> NetResult<string> {
        Err("Not implemented")
    }

    /// Write every byte.
    pub fn write_all(&mut self, data: Vec<u8>) -> NetResult<()> {
        Err("Not implemented")
    }

    /// Write the UTF-8 bytes of `text`.
    pub fn write_str(&mut self, text: string) -> NetResult<()> {
        Err("Not implemented")
    }

    pub fn flush(&mut self) -> NetResult<()> {
        Err("Not implemented")
    }

    /// Half close: the peer reads end of stream, this end can still read.
    pub fn shutdown_write(&mut self) -> NetResult<()> {
        Err("Not implemented")
    }

    /// Close both halves.
    pub fn shutdown(&mut self) -> NetResult<()> {
        Err("Not implemented")
    }

    /// Read and write timeouts in milliseconds (0: none). A read past its timeout is Err("timed out").
    pub fn set_timeouts(&mut self, read_ms: int, write_ms: int) -> NetResult<()> {
        Err("Not implemented")
    }

    /// The peer's `ip:port`.
    pub fn peer_addr(&self) -> string {
        ""
    }

    /// This end's `ip:port`.
    pub fn local_addr(&self) -> string {
        ""
    }
}


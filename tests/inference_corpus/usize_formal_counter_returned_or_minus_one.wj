// A counter passed to a `usize` formal and also returned from an `-> int` function, with `-1` as the
// not-found tail: the counter's class has two exact widths, so the solver must not publish one (the
// negative literal must never become `usize`).
fn at(xs: Vec<int>, i: usize) -> int {
    xs[i]
}

fn find(xs: Vec<int>, needle: int) -> int {
    let mut i = 0
    let n = xs.len()
    while i < n {
        if at(xs, i) == needle {
            return i
        }
        i = i + 1
    }
    -1
}

fn main() {
    println("${find([4, 5, 6], 5)} ${find([4], 9)}")
}

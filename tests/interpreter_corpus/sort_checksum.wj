// seeds: 1 2 3 77
// Generate 200 pseudo-random values, sort, print extremes and a position-weighted checksum.
fn main() {
    let mut state: u64 = __SEED__
    let mut v: Vec<i64> = Vec::new()
    let mut i = 0
    while i < 200 {
        state = (state * 48271 + 11) % 1000003
        v.push((state as i64) - 500000)
        i += 1
    }
    v.sort()
    println("{} {}", v[0], v[199])
    let mut sum: i64 = 0
    let mut idx: i64 = 0
    for x in v.clone() {
        idx += 1
        sum += idx * x
    }
    println("{}", sum)
    let mut dup = v.clone()
    dup.dedup()
    println("{}", dup.len())
}

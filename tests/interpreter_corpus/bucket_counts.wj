// seeds: 1 2 3 5
// Counting into buckets chosen by a pseudo-random sequence; indexed Vec updates in a loop.
fn main() {
    let names = vec!["alpha", "beta", "delta", "eps", "gamma"]
    let mut counts: Vec<int> = vec![0, 0, 0, 0, 0]
    let mut state: u64 = __SEED__
    let mut i = 0
    while i < 300 {
        state = (state * 1103515245 + 12345) % 2147483648
        let idx = (state / 65536 % 5) as usize
        counts[idx] += 1
        i += 1
    }
    let mut j = 0
    while j < 5 {
        println("{} {}", names[j], counts[j])
        j += 1
    }
}

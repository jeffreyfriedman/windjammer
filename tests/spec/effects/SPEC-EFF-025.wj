// spec: SPEC-EFF-025
// mode: check-error
// xfail: Q-032
// expect-error: WJ0047: durable fn `consume` receives from a channel
use std::sync
durable fn consume(rx: sync::Receiver<int>) -> int {
    rx.recv()
}
fn main() {
    let (tx, rx) = sync::channel()
    tx.send(1)
    println("${consume(rx)}")
}

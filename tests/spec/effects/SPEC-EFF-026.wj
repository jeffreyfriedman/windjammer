// spec: SPEC-EFF-026
// mode: check-error
// expect-error: WJ0048: iteration over `HashMap` has no stable order
use std::collections::HashMap
durable fn first_key(m: HashMap<string, int>) -> string {
    let mut out = ""
    for (k, v) in m {
        if out == "" { out = k }
    }
    out
}
fn main() {
    let mut m = HashMap::new()
    m.insert("a", 1)
    println(first_key(m))
}

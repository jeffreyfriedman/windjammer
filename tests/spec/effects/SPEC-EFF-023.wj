// spec: SPEC-EFF-023
// mode: check-error
// expect-error: WJ0045: step result of type `fn() -> int` cannot be journaled
use std::random
fn make_counter() -> fn() -> int {
    let n = random::range(0, 9)
    move || n
}
durable fn pick() -> int {
    let c = make_counter()
    c()
}
fn main() {
    println("${pick()}")
}

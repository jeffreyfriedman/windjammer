// spec: SPEC-CLOS-009
// expect: 6 15
// expect: 12
// expect: 3
// expect: 3
// expect: 11 1000
// expect: A-B-C
fn make_adder(n: int) -> Box<dyn Fn(int) -> int> {
    Box::new(move |x| x + n)
}

fn apply_twice(f: fn(int) -> int, x: int) -> int {
    f(f(x))
}

fn double(x: int) -> int {
    x * 2
}

fn main() {
    let add5 = make_adder(5)
    println("${add5(1)} ${add5(10)}")
    println("${apply_twice(double, 3)}")
    let mut counter = 0
    let mut inc = || {
        counter += 1
        counter
    }
    inc()
    inc()
    println("${inc()}")
    println("${counter}")
    let base = 10
    let f = |x: int| x + base
    let base = 1000
    println("${f(1)} ${base}")
    let names = vec!["b", "a", "c"]
    let mut sorted = names.clone()
    sorted.sort()
    let joined = sorted.iter().map(|s| s.to_uppercase()).collect::<Vec<string>>().join("-")
    println(joined)
}

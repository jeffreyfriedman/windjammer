// spec: SPEC-NUM-022
// expect: -3 -1 -3 1 3 -1
// expect: -4 1 -3 1
// expect: 7 -1 0
// expect: 3 3
fn main() {
    let a: int = -7
    let b: int = 2
    let c: int = 7
    let d: int = -2
    println("${a / b} ${a % b} ${c / d} ${c % d} ${a / d} ${a % d}")
    println("${a.div_euclid(b)} ${a.rem_euclid(b)} ${c.div_euclid(d)} ${c.rem_euclid(d)}")
    let z: int = 0
    println("${a.abs()} ${a.signum()} ${z.signum()}")
    let ten: int = 10
    println("${c.abs_diff(ten)} ${ten.abs_diff(c)}")
}

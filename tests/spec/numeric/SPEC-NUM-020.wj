// spec: SPEC-NUM-020
// expect: 4611686018427387904 -4 -1 2147483648 31
// expect: -2147483648 -2147483648
// expect: 98 11 1 191 78 78
// expect: 1 7 6 -6 251
// expect: 4 0 0
fn main() {
    println("${1 << 62} ${-8 >> 1} ${-1 >> 63} ${1u32 << 31} ${255u8 >> 3}")
    let x: i32 = 1
    println("${x << 31} ${(x << 30) << 1}")
    let u: u8 = 0b1011_0001
    println("${u << 1} ${u >> 4} ${u & 0x0F} ${u | 0x0F} ${u ^ 0xFF} ${!u}")
    println("${5 & 3} ${5 | 3} ${5 ^ 3} ${!5} ${-5 & 0xFF}")
    println("${u.count_ones()} ${u.leading_zeros()} ${u.trailing_zeros()}")
}

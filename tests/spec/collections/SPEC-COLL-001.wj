// spec: SPEC-COLL-001
// expect: 0: 2 9
// expect: 1: 3 12
// expect: 2: 2 7
fn main() {
    let xs = [1, 2, 3, 4, 5, 6, 7]
    let g = xs.group_by(|x| x % 3)
    let mut keys: Vec<int> = g.keys().cloned().collect()
    keys.sort()
    for k in keys {
        let sum: int = g[&k].sum()
        println("${k}: ${g[&k].len()} ${sum}")
    }
}

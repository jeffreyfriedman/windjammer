// spec: SPEC-COLL-009
// expect: 123 3
// expect: bac
// expect: 9 2
fn main() {
    let xs = [3, 1, 2]
    let s = xs.sorted()
    println("${s[0]}${s[1]}${s[2]} ${xs[0]}")
    let pairs = [(1, "a"), (2, "b"), (1, "c")]
    let d = pairs.sorted_by_key_desc(|p| p.0)
    println("${d[0].1}${d[1].1}${d[2].1}")
    let mut m = [2, 9, 4]
    m.sort_by_key_desc(|x| x)
    println("${m[0]} ${m[2]}")
}

// spec: SPEC-TRT-001
// expect: shape 4 circle 3
trait Shape {
    fn area(self) -> float
    fn name(self) -> string { "shape" }
}
struct Sq { s: float }
struct Ci { r: float }
impl Shape for Sq {
    fn area(self) -> float { self.s * self.s }
}
impl Shape for Ci {
    fn area(self) -> float { 3.0 * self.r * self.r }
    fn name(self) -> string { "circle" }
}
fn main() {
    let a = Sq { s: 2.0 }
    let b = Ci { r: 1.0 }
    println("${a.name()} ${a.area()} ${b.name()} ${b.area()}")
}

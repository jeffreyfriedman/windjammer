// spec: SPEC-TRT-004
// expect: 11 22 true
struct V { x: int, y: int }
impl V {
    fn add(self, o: V) -> V { V { x: self.x + o.x, y: self.y + o.y } }
    fn eq(self, o: V) -> bool { self.x == o.x && self.y == o.y }
}
fn main() {
    let a = V { x: 1, y: 2 }
    let b = V { x: 10, y: 20 }
    let c = a + b
    println("${c.x} ${c.y} ${c == V { x: 11, y: 22 }}")
}

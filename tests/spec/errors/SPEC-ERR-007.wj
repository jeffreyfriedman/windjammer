// spec: SPEC-ERR-007
// expect: ok 42
// expect: parse error: bad number: x
// expect: negative -4
// expect: 12 -1
// expect: 4 true
// expect: 7 true
enum AppErr {
    Parse(string),
    Neg(int),
}

fn parse(s: string) -> Result<int, string> {
    match s.parse::<int>() {
        Ok(n) => Ok(n),
        Err(_) => Err("bad number: ${s}"),
    }
}

fn check(n: int) -> Result<int, AppErr> {
    if n < 0 {
        return Err(AppErr::Neg(n))
    }
    Ok(n)
}

impl From<string> for AppErr {
    fn from(s: string) -> AppErr {
        AppErr::Parse(s)
    }
}

fn run(s: string) -> Result<int, AppErr> {
    let n = parse(s)?
    let m = check(n)?
    Ok(m * 2)
}

fn show(r: Result<int, AppErr>) -> string {
    match r {
        Ok(v) => "ok ${v}",
        Err(AppErr::Parse(m)) => "parse error: ${m}",
        Err(AppErr::Neg(n)) => "negative ${n}",
    }
}

fn first_even(v: Vec<int>) -> Option<int> {
    for x in v {
        if x % 2 == 0 {
            return Some(x)
        }
    }
    None
}

fn double_first_even(v: Vec<int>) -> Option<int> {
    let e = first_even(v)?
    Some(e * 2)
}

fn main() {
    println(show(run("21")))
    println(show(run("x")))
    println(show(run("-4")))
    println("${double_first_even(vec![1, 3, 6]).unwrap_or(-1)} ${double_first_even(vec![1, 3]).unwrap_or(-1)}")
    let r: Result<int, string> = Ok(3)
    println("${r.map(|v| v + 1).unwrap_or(0)} ${r.is_ok()}")
    let e: Result<int, string> = Err("boom")
    println("${e.unwrap_or(7)} ${e.is_err()}")
}

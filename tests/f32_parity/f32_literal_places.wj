struct P {
    x: f32,
    y: f32,
}

const K: f32 = 0.1
const SUM: f32 = 0.1 + 0.2

fn takes(a: f32) -> f32 {
    a
}

fn ret_sum() -> f32 {
    0.1 + 0.2
}

fn ret_lit() -> f32 {
    0.1
}

fn show32(tag: string, v: f32) {
    println("${tag} ${v.to_bits():08x}")
}

fn show64(tag: string, v: f64) {
    println("${tag} ${v.to_bits():016x}")
}

fn main() {
    let mut y: f32 = 1.0
    y = 0.1
    show32("assign", y)
    show64("assign64", y as f64)
    let mut p = P { x: 1.0, y: 2.0 }
    p.x = 0.1
    show64("field", p.x as f64)
    let q = P { x: 0.1, y: 0.2 }
    show64("structlit", q.y as f64)
    let mut v: Vec<f32> = Vec::new()
    v.push(0.1)
    show64("push", v[0] as f64)
    v[0] = 0.3
    show64("vecstore", v[0] as f64)
    show64("arg", takes(0.1) as f64)
    show64("ret", ret_lit() as f64)
    show64("const", K as f64)
    let big: f32 = 16777217.0
    show64("bigfloat", big as f64)
    let mut z: f32 = 0.0
    z = 16777217.0
    show64("assignbig", z as f64)
    let s: f32 = 16777217 as f32
    show64("suffix", s as f64)
    let t: f32 = 0.1 as f32
    show64("fsuffix", t as f64)
    let mut o: Option<f32> = Some(1.0)
    o = Some(0.1)
    match o {
        Some(x) => show64("option", x as f64),
        None => println("none"),
    }
    let arr: [f32; 2] = [0.1, 0.2]
    show64("array", arr[1] as f64)
    let tup: (f32, f32) = (0.1, 0.2)
    show64("tuple", tup.1 as f64)
    let mut acc: f32 = 0.0
    acc += 0.1
    show64("compound", acc as f64)
    let mut m: f32 = 0.0
    m = y + 0.1
    show64("expr", m as f64)
    // L6
    let a: f32 = 0.1 + 0.2
    show32("L6a", a)
    let b: f32 = 16777216.0 + 1.0
    show32("L6b", b)
    let c: f32 = 1.0 / 3.0
    show32("L6c", c)
    let d: f32 = 0.1 * 3.0
    show32("L6d", d)
    show32("L6const", SUM)
    let pp = P { x: 0.1 + 0.2, y: 0.1 * 3.0 }
    show32("L6field", pp.x)
    show32("L6field2", pp.y)
    show32("L6arg", takes(0.1 + 0.2))
    show32("L6ret", ret_sum())
    show32("L6cast", (0.1 + 0.2) as f32)
    show32("L6cast2", (16777216.0 + 1.0) as f32)
    let mut e: f32 = 0.0
    e = 0.1 + 0.2
    show32("L6assign", e)
    let g: f32 = 16777216.0 + 1.0 + 1.0
    show32("L6g", g)
    let h: f32 = (0.1 + 0.2) * 3.0
    show32("L6h", h)
    let k: f32 = -0.1 - 0.2
    show32("L6k", k)
}

fn show(tag: string, v: f32) {
    println("${tag} ${v.to_bits():08x}")
}

fn u(b: u32) -> u32 {
    b
}

fn pass(x: f32) -> f32 {
    x
}

struct S {
    v: f32,
}

fn main() {
    let snan = f32::from_bits(u(0x7f800001))
    show("snan", snan)
    let qnan = f32::from_bits(u(0x7fc00001))
    show("qnan", qnan)
    let neg = f32::from_bits(u(0xff800123))
    show("negsnan", neg)
    show("inf", f32::from_bits(u(0x7f800000)))
    show("sub", f32::from_bits(u(0x00000001)))
    show("pass", pass(snan))
    let s = S { v: snan }
    show("field", s.v)
    let mut v: Vec<f32> = Vec::new()
    v.push(snan)
    show("vec", v[0])
    let w = snan
    show("copy", w)
    println("${snan.is_nan()}")
    show("neg", -snan)
    show("abs", snan.abs())
    let bytes = snan.to_le_bytes()
    println("${bytes[0]} ${bytes[1]} ${bytes[2]} ${bytes[3]}")
    show("frombytes", f32::from_le_bytes(bytes))
    let mut arr: [f32; 2] = [0.0, 0.0]
    arr[1] = snan
    show("array", arr[1])
    let mut z: f32 = 0.0
    z = snan
    show("assign", z)
}

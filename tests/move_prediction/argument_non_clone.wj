// WJ0007: passing `inbox` to `drain` gives it away; `inbox` holds a channel end and cannot be copied.
use std::sync::mpsc

struct Inbox {
    rx: mpsc::Receiver<int>,
    seen: int,
}

fn drain(inbox: Inbox) -> int {
    let r = inbox.rx
    inbox.seen
}

fn main() {
    let pair = mpsc::channel()
    let inbox = Inbox { rx: pair.1, seen: 0 }
    let n = drain(inbox)
    println("${n} ${inbox.seen}")
}

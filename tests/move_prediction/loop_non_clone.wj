// WJ0007: inside the loop, passing `inbox` to `drain` gives it away in every iteration; it cannot be copied.
use std::sync::mpsc

struct Inbox {
    rx: mpsc::Receiver<int>,
    seen: int,
}

fn drain(inbox: Inbox) -> int {
    let r = inbox.rx
    inbox.seen
}

fn main() {
    let pair = mpsc::channel()
    let inbox = Inbox { rx: pair.1, seen: 0 }
    let mut total = 0
    let mut i = 0
    while i < 2 {
        total = total + drain(inbox)
        i = i + 1
    }
    println("${total}")
}

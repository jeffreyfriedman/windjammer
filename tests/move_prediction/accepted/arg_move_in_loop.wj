// Not reported: `xs` is moved into an owning parameter inside a loop and needed again next iteration;
// the compiler copies it at the move (C6, ir::liveness read_after), so the build succeeds.
struct Bag {
    items: Vec<int>,
}

fn wrap(items: Vec<int>) -> Bag {
    Bag { items: items }
}

fn main() {
    let xs = [1, 2, 3]
    let mut total = 0
    let mut i = 0
    while i < 3 {
        let b = wrap(xs)
        total += b.items.len()
        i += 1
    }
    println("${total}")
}

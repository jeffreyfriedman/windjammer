// A flow carried from one iteration to the next, five loops deep: the command used at the top of the innermost body was read
// at the bottom of the previous iteration. Loops nested more than three deep are not walked twice, so the analysis gives every
// variable they assign TOP first; the flow must still be found.
use std::fs
use std::process

fn main() {
    let items = ["a", "b"]
    let mut cmd = "ls"
    for a in items {
        for b in items {
            for c in items {
                for d in items {
                    for e in items {
                        let out = process::run(cmd) //~ WJ0173
                        println("${out} ${a}${b}${c}${d}${e}")
                        cmd = fs::read_to_string("next.txt").unwrap_or("")
                    }
                }
            }
        }
    }
}

// oracle: check
// A helper passes its parameter to a command: reported where the tainted value is handed over.
use std::fs
use std::process

fn execute(command: string) -> string {
    process::run(command).unwrap_or("")
}

fn main() {
    let name = fs::read_to_string("job.txt").unwrap_or("")
    let out = execute(name) //~ WJ0173
//~@15+7 ERROR WJ0173 data from file contents
    println("${out}")
}

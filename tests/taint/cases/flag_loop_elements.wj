// oracle: check
// Lines of a file are commands.
use std::fs
use std::process

fn main() {
    let text = fs::read_to_string("jobs.txt").unwrap_or("")
    for line in text.split("\n") {
        let out = process::run(line) //~ WJ0173
//~@28+3 ERROR WJ0173 data from file contents
        println("${out}")
    }
}

// oracle: check
// Every method of `trait Char` and `trait String` that the portable emitters lower, with a local, a literal and an expression
// operand. tests/golden/char_string_rows_probe.{js,go}.txt hold the JavaScript and Go this program emitted before the Char and
// String rows moved into std/rust_core.wji (docs/design/table-driven-std-surface.md, stage 3); the output must stay byte-identical.
// (The removed spellings the emitters also accepted, ADR-0039: to_owned, as_str, push_str, substring, as_bytes, ..., are not
// in the probe: no program of the conformance corpus reaches them.)
struct Holder {
    name: string,
    letter: char,
}

fn probe_char(c: char, d: char, n: u32) {
    println("${c.is_alphabetic()}")
    println("${'x'.is_alphabetic()}")
    println("${(d).is_alphabetic()}")
    println("${"ab".chars().next().unwrap().is_alphabetic()}")
//~@36+6 ERROR W0002 explicit
    println("${c.is_alphanumeric()}")
    println("${'x'.is_alphanumeric()}")
    println("${(d).is_alphanumeric()}")
    println("${"ab".chars().next().unwrap().is_alphanumeric()}")
//~@36+6 ERROR W0002 explicit
    println("${c.is_whitespace()}")
    println("${'x'.is_whitespace()}")
    println("${(d).is_whitespace()}")
    println("${"ab".chars().next().unwrap().is_whitespace()}")
//~@36+6 ERROR W0002 explicit
    println("${c.is_uppercase()}")
    println("${'x'.is_uppercase()}")
    println("${(d).is_uppercase()}")
    println("${"ab".chars().next().unwrap().is_uppercase()}")
//~@36+6 ERROR W0002 explicit
    println("${c.is_lowercase()}")
    println("${'x'.is_lowercase()}")
    println("${(d).is_lowercase()}")
    println("${"ab".chars().next().unwrap().is_lowercase()}")
//~@36+6 ERROR W0002 explicit
    println("${c.is_ascii()}")
    println("${'x'.is_ascii()}")
    println("${(d).is_ascii()}")
    println("${"ab".chars().next().unwrap().is_ascii()}")
//~@36+6 ERROR W0002 explicit
    println("${c.to_uppercase()}")
    println("${'x'.to_uppercase()}")
    println("${(d).to_uppercase()}")
    println("${"ab".chars().next().unwrap().to_uppercase()}")
//~@36+6 ERROR W0002 explicit
    println("${c.to_lowercase()}")
    println("${'x'.to_lowercase()}")
    println("${(d).to_lowercase()}")
    println("${"ab".chars().next().unwrap().to_lowercase()}")
//~@36+6 ERROR W0002 explicit
    println("${c.to_string()}")
    println("${'x'.to_string()}")
    println("${(d).to_string()}")
    println("${"ab".chars().next().unwrap().to_string()}")
//~@36+6 ERROR W0002 explicit
    println("${c.to_digit(10).unwrap_or(n)}")
    println("${c.to_digit(n).unwrap_or(n)}")
    println("${'7'.to_digit(10).unwrap_or(n)}")
    println("${d.to_digit(16).unwrap_or(n)}")
    println("${"7a".chars().next().unwrap().to_digit(n).unwrap_or(n)}")
//~@36+6 ERROR W0002 explicit
}

fn probe_str(s: string, t: string, c: char, n: usize) {
    println("${s.len()}")
    println("${"literal".len()}")
    println("${(s + t).len()}")
    println("${s.is_empty()}")
    println("${"".is_empty()}")
    println("${s.to_uppercase()}")
    println("${"mIx".to_uppercase()}")
    println("${(s + t).to_uppercase()}")
    println("${s.to_lowercase()}")
    println("${"mIx".to_lowercase()}")
    println("${s.trim()}")
    println("${"  pad ".trim()}")
    println("${s.trim_start()}")
    println("${"  pad ".trim_start()}")
    println("${s.trim_end()}")
    println("${"  pad ".trim_end()}")
    println("${s.contains(t)}")
    println("${s.contains("lo")}")
    println("${s.contains(c)}")
    println("${s.contains('l')}")
    println("${(s + t).contains(t)}")
    println("${s.starts_with(t)}")
    println("${s.starts_with("he")}")
    println("${s.starts_with(c)}")
    println("${s.starts_with('h')}")
    println("${s.ends_with(t)}")
    println("${s.ends_with("lo")}")
    println("${s.ends_with(c)}")
    println("${s.ends_with('o')}")
    println("${s.replace(t, t)}")
    println("${s.replace("l", "L")}")
    println("${s.replace(c, c)}")
    println("${s.replace('l', 'L')}")
    println("${(s + t).replace(t, "-")}")
    println("${s.split(t).count()}")
    println("${s.split(",").count()}")
    println("${s.split(c).count()}")
    println("${s.split(' ').count()}")
    println("${s.chars().count()}")
    println("${"héllo".chars().count()}")
    println("${s.bytes().count()}")
    println("${"héllo".bytes().count()}")
    println("${s.lines().count()}")
    println("${"a\nb".lines().count()}")
    println("${s.split_whitespace().count()}")
    println("${"a b  c".split_whitespace().count()}")
    println("${s.char_indices().count()}")
    println("${"héllo".char_indices().count()}")
    println("${s.find(t).unwrap_or(n)}")
    println("${s.find("l").unwrap_or(n)}")
    println("${s.find(c).unwrap_or(n)}")
    println("${s.find('l').unwrap_or(n)}")
    println("${s.repeat(n)}")
    println("${s.repeat(2)}")
    println("${"ab".repeat(3)}")
    println("${s.to_string()}")
    println("${"lit".to_string()}")
//~@22+9 ERROR W0006 string literal is forbidden
    println("${s.clone()}")
//~@18+5 WARN W0005 explicit
    println("${s.parse::<i32>().unwrap_or(0)}")
    println("${s.parse::<i8>().unwrap_or(0)}")
    println("${s.parse::<u8>().unwrap_or(0)}")
    println("${s.parse::<i64>().unwrap_or(0)}")
    println("${s.parse::<u64>().unwrap_or(0)}")
    println("${s.parse::<usize>().unwrap_or(0)}")
    println("${s.parse::<f64>().unwrap_or(0.0)}")
    println("${s.parse::<f32>().unwrap_or(0.0)}")
    println("${s.parse::<bool>().unwrap_or(false)}")
    println("${"42".parse::<i32>().unwrap_or(0)}")
    println("${(s + t).parse::<u16>().unwrap_or(0)}")
    let parsed: Result<i32, string> = s.parse()
    println("${parsed.is_ok()}")
    let mut m = s.clone()
    m.push(c)
    m.push('!')
    println("${m}")
    m.clear()
    println("${m}")
    let mut h = Holder { name: s.clone(), letter: c }
//~@34+5 WARN W0005 explicit
    h.name.push(h.letter)
    h.name.push('?')
    println("${h.name}")
    h.name.clear()
    println("${h.name}")
}

fn main() {
    probe_char('a', 'F', 16)
    probe_str("hello", " world", 'l', 9)
    probe_str("123", "4", '2', 9)
}

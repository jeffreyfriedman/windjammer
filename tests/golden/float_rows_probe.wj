// Every method of `trait Float<T>` on an f64 and on an f32 receiver, with a literal, a local and an expression operand.
// tests/golden/float_rows_probe.{js,go}.txt hold the JavaScript and Go this program emitted before the Float rows moved
// into std/rust_core.wji (docs/design/table-driven-std-surface.md, stage 1); the output must stay byte-identical.
fn probe64(x: f64, y: f64, z: f64) {
    println("${x.sqrt()}")
    println("${x.abs()}")
    println("${x.floor()}")
    println("${x.ceil()}")
    println("${x.round()}")
    println("${x.trunc()}")
    println("${x.fract()}")
    println("${x.sin()}")
    println("${x.cos()}")
    println("${x.tan()}")
    println("${x.asin()}")
    println("${x.acos()}")
    println("${x.atan()}")
    println("${x.exp()}")
    println("${x.cbrt()}")
    println("${x.ln()}")
    println("${x.log10()}")
    println("${x.log2()}")
    println("${x.signum()}")
    println("${x.to_degrees()}")
    println("${x.to_radians()}")
    println("${x.is_nan()}")
    println("${x.is_infinite()}")
    println("${x.is_finite()}")
    println("${x.is_sign_negative()}")
    println("${x.is_sign_positive()}")
    println("${x.powi(3)}")
    println("${x.powf(y)}")
    println("${x.min(y)}")
    println("${x.max(y)}")
    println("${x.atan2(y)}")
    println("${x.hypot(y)}")
    println("${x.clamp(z, y)}")
    println("${x.mul_add(y, z)}")
    let s = x.to_string()
    println("${s}")
    println("${(x + y).sqrt()}")
    println("${x.max(2.0)}")
    println("${x.clamp(0.0, 1.0)}")
    println("${x.powf(0.5)}")
}

fn probe32(x: f32, y: f32, z: f32) {
    println("${x.sqrt()}")
    println("${x.abs()}")
    println("${x.floor()}")
    println("${x.ceil()}")
    println("${x.round()}")
    println("${x.trunc()}")
    println("${x.fract()}")
    println("${x.sin()}")
    println("${x.cos()}")
    println("${x.tan()}")
    println("${x.asin()}")
    println("${x.acos()}")
    println("${x.atan()}")
    println("${x.exp()}")
    println("${x.cbrt()}")
    println("${x.ln()}")
    println("${x.log10()}")
    println("${x.log2()}")
    println("${x.signum()}")
    println("${x.to_degrees()}")
    println("${x.to_radians()}")
    println("${x.is_nan()}")
    println("${x.is_infinite()}")
    println("${x.is_finite()}")
    println("${x.is_sign_negative()}")
    println("${x.is_sign_positive()}")
    println("${x.powi(3)}")
    println("${x.powf(y)}")
    println("${x.min(y)}")
    println("${x.max(y)}")
    println("${x.atan2(y)}")
    println("${x.hypot(y)}")
    println("${x.clamp(z, y)}")
    println("${x.mul_add(y, z)}")
    let s = x.to_string()
    println("${s}")
    println("${(x + y).sqrt()}")
    println("${x.max(2.0)}")
    println("${x.clamp(0.0, 1.0)}")
    println("${x.powf(0.5)}")
}

fn main() {
    probe64(2.5, 1.5, 0.5)
    probe32(2.5, 1.5, 0.5)
}

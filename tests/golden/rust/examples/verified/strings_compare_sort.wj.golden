fn main() {
    let lt = "apple" < "banana";
    let eq = "abc" == "abd";
    println!("{}", lt);
    println!("{}", eq);
    let mut fruits = vec!["cherry".to_string(), "apple".to_string(), "banana".to_string()];
    fruits.sort();
    println!("[{}]", fruits.join(", "));
    fruits.reverse();
    println!("[{}]", fruits.join(", "));
}


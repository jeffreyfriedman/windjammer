fn main() {
    let a = 3_i32;
    let b = 7_i32;
    let bigger = {
        if a > b {
            a
        } else {
            b
        }
    };
    println!("{}", bigger);
    for n in [4, 5] {
        let kind: String = {
            if n % 2_i64 == 0_i64 {
                String::from("even")
            } else {
                String::from("odd")
            }
        };
        println!("{}", kind);
    }
}


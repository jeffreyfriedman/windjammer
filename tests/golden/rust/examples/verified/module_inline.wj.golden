use self::geometry::rect_area;
mod geometry {
    #[inline]
pub fn rect_area(w: i64, h: i64) -> i64 {
        w * h
}    #[inline]
pub fn perimeter(w: i64, h: i64) -> i64 {
        2_i64 * (w + h)
}    pub mod circle {
        #[inline]
pub fn half(r: f64) -> f64 {
            r / 2.0_f64
}    }
}

fn main() {
    println!("{}", rect_area(3_i64, 4_i64));
    println!("{}", geometry::perimeter(2_i64, 1_i64) + 1_i64);
    println!("{}", geometry::circle::half(6.0_f64));
}


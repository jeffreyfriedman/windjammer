fn main() {
    let parts: Vec<String> = "a,b,c".split(",").map(|p| p.to_string()).collect::<Vec<String>>();
    println!("{}", parts.len());
    println!("{}", parts.join("|"));
    let letters = vec!["x".to_string(), "y".to_string(), "z".to_string()];
    println!("[{}]", letters.join(", "));
    let words: Vec<String> = "one two  three   four".split_whitespace().map(|w| w.to_string()).collect::<Vec<String>>();
    println!("{}", words.len());
    println!("{}", words.join(" "));
}


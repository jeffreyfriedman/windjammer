fn main() {
    let s: String = String::from("Hello World");
    println!("{}", s.len());
    println!("{}", s.to_uppercase());
    println!("{}", s.to_lowercase());
    let has_world = s.contains("World");
    let has_prefix = s.starts_with("Hello");
    println!("{}", has_world);
    println!("{}", has_prefix);
    println!("{}", s.to_lowercase().replace(" ", "_"));
    let padded: String = String::from("  padded  ");
    println!("[{}]", padded.trim());
}


#[inline]
fn describe(n: i64) -> String {
    match n {
        0 => String::from("zero"),
        x if x < 10_i64 && x % 2_i64 == 0_i64 => String::from("small even"),
        1 | 3 | 5 | 7 | 9 => String::from("small odd"),
        x if x >= 10_i64 && x < 100_i64 => String::from("medium"),
        _ => String::from("large"),
    }
}

fn main() {
    for n in [0_i64, 4_i64, 7_i64, 50_i64, 500_i64] {
        println!("{}", describe(n));
    }
}


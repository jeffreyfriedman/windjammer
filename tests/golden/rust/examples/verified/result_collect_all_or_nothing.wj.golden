#[inline]
fn parse_all(items: &Vec<String>) -> Result<Vec<i64>, String> {
    { items.as_ref().iter().map(|s| { s.parse::<i64>().map_err(move |_| format!("bad: {}", s)) }) }.collect::<Vec<_>>()
}

fn main() {
    println!("{:?}", parse_all(&vec!["1".to_string(), "2".to_string(), "3".to_string()]));
    println!("{:?}", parse_all(&vec!["1".to_string(), "x".to_string(), "3".to_string()]));
}


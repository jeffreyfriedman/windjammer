fn main() {
    let name: String = String::from("Ada");
    let age = 36_i64;
    let price = 4.5_f64;
    let n = 42_i64;
    println!("{} is {} years old", name, age);
    println!("next year: {}", age + 1_i64);
    println!("price: {:.2}", price);
    println!("padded: [{:>5}]", n);
    println!("left:   [{:<5}]", n);
    println!("zero:   [{:05}]", n);
}


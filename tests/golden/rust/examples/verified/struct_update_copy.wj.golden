#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]

struct Pair {
    a: i64,
    b: i64,
}










fn main() {
    let orig = Pair { a: 1_i64, b: 2_i64 };
    let mut copy = orig;
    println!("{} {}", orig.a, orig.b);
    copy.a = 9_i64;
    println!("{} {}", copy.a, copy.b);
    println!("{} {}", orig.a, orig.b);
}


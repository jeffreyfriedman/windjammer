fn main() {
    println!("{:?}", Some(3_i64).filter(|x| *x > 5));
    println!("{:?}", Some(8_i64).filter(|x| *x > 5));
    let z = Some(1_i64).zip(Some(String::from("a")));
    println!("{:?}", z);
    let o: Option<i64> = None;
    println!("{:?}", o.or(Some(3_i64)));
    let nested = Some(Some(9_i64));
    println!("{}", nested.flatten().unwrap_or(0));
}


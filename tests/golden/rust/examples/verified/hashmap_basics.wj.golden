use std::collections::HashMap;
fn main() {
    let mut m: HashMap<String, i64> = HashMap::new();
    m.insert(String::from("a"), 10_i64);
    m.insert(String::from("b"), 20_i64);
    println!("{}", m.len());
    println!("{:?}", m.get("a"));
    println!("{:?}", m.get("z"));
    println!("{}", m.contains_key("b"));
    println!("{}", m["b"]);
}


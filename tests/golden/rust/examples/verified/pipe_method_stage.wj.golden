fn main() {
    let total = [1_i64, 2_i64, 3_i64, 4_i64].iter().map(|x| x * 3_i64).sum::<i64>();
    println!("{}", total);
    let doubled: Vec<i64> = [1_i64, 2_i64, 3_i64].iter().map(|x| x * 2_i64).collect::<Vec<i64>>();
    println!("{:?}", doubled);
    let s = "  abc  ".trim().to_string();
    println!("{}", s);
}


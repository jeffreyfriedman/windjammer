#[inline]
fn roman(n: i64) -> String {
    let table = vec![(1000_i64, "M"), (900_i64, "CM"), (500_i64, "D"), (400_i64, "CD"), (100_i64, "C"), (90_i64, "XC"), (50_i64, "L"), (40_i64, "XL"), (10_i64, "X"), (9_i64, "IX"), (5_i64, "V"), (4_i64, "IV"), (1_i64, "I")];
    let mut left = n;
    let mut out = String::new();
    for (value, symbol) in table {
        while left >= value {
            out = out + &symbol;
            left -= value;
        }
    }
    out
}

fn main() {
    for n in [4_i64, 9_i64, 14_i64, 1994_i64, 2024_i64] {
        println!("{} = {}", n, roman(n));
    }
}


#[inline]
fn largest<T: Clone + PartialOrd>(items: Vec<T>) -> T {
    let mut best = items[0].clone();
    for i in items {
        if i > best {
            best = i;
        }
    }
    best
}

#[inline]
fn reversed<T>(items: Vec<T>) -> Vec<T> {
    let mut out = vec![];
    for i in items.into_iter().rev() {
        out.push(i);
    }
    out
}

fn main() {
    println!("{}", largest(vec![3_i64, 9_i64, 4_i64]));
    println!("{}", largest(vec!["a".to_string(), "z".to_string(), "m".to_string()]));
    println!("{:?}", reversed(vec![1_i64, 2_i64, 3_i64]));
}


#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]

struct Item {
    id: i64,
    name: String,
}

fn main() {
    let a = Item { id: 1_i64, name: String::from("pen") };
    let b = a.clone();
    let c = Item { id: 2_i64, name: String::from("pen") };
    println!("{:?}", a);
    println!("{}", a == b);
    println!("{}", a == c);
}


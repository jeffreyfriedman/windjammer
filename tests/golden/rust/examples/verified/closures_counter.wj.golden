fn main() {
    let mut count = 0_i64;
    let mut inc = || {
        count += 1;
        count
    };
    println!("{}", inc());
    println!("{}", inc());
    println!("{}", inc());
    let mut total = 0_i64;
    for x in [1_i64, 2_i64, 3_i64] {
        total += x;
    }
    println!("total {}", total);
}


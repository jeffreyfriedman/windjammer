#[inline]
fn bubble_sort(v: Vec<i64>) -> Vec<i64> {
    let mut a: Vec<i64> = v;
    let n = a.len();
    for i in 0_usize..n {
        for j in 0_usize..n - 1_usize - i {
            if a[j] > a[j + 1] {
                let _ = a.swap(j, (j + 1) as usize);
            }
        }
    }
    a
}

fn main() {
    let sorted: Vec<i64> = bubble_sort(vec![64_i64, 34_i64, 25_i64, 12_i64, 22_i64, 11_i64, 90_i64]);
    println!("{:?}", sorted);
}


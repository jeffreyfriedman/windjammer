#[inline]
fn matmul(a: &Vec<Vec<i64>>, b: &Vec<Vec<i64>>) -> Vec<Vec<i64>> {
    let n = a.len();
    let mut out: Vec<Vec<i64>> = vec![];
    for i in 0_usize..n {
        let mut row: Vec<i64> = vec![];
        for j in 0_usize..n {
            let mut s = 0_i64;
            for k in 0_usize..n {
                s += a[i][k] * b[k][j];
            }
            row.push(s);
        }
        out.push(row);
    }
    out
}

fn main() {
    let c: Vec<Vec<i64>> = matmul(&vec![vec![1_i32, 2_i32], vec![3_i32, 4_i32]], &vec![vec![5_i32, 6_i32], vec![7_i32, 8_i32]]);
    for row in c {
        println!("{:?}", row);
    }
}


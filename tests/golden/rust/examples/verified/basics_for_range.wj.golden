fn main() {
    let mut a = String::new();
    for i in 0_i32..5_i32 {
        a = a + &format!("{} ", i);
    }
    println!("{}", a.trim());
    let mut b = String::new();
    for i in 5_i32..=7_i32 {
        b = b + &format!("{} ", i);
    }
    println!("{}", b.trim());
    let mut c = String::new();
    for i in (1_i32..=5_i32).rev() {
        c = c + &format!("{} ", i * 2_i32);
    }
    println!("{}", c.trim());
    let mut total = 0_i32;
    for i in 1_i32..=100_i32 {
        total += i;
    }
    println!("sum 1..=100 = {}", total);
}


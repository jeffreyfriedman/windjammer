fn main() {
    let mut a = String::new();
    for i in 0_i64..5_i64 {
        a = a + &format!("{} ", i);
    }
    println!("{}", a.trim());
    let mut b = String::new();
    for i in 5_i64..=7_i64 {
        b = b + &format!("{} ", i);
    }
    println!("{}", b.trim());
    let mut c = String::new();
    for i in (1_i64..=5_i64).rev() {
        c = c + &format!("{} ", i * 2_i64);
    }
    println!("{}", c.trim());
    let mut total = 0_i64;
    for i in 1_i64..=100_i64 {
        total += i as i64;
    }
    println!("sum 1..=100 = {}", total);
}


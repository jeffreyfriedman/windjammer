#[derive(Debug, Clone, Copy, PartialEq, Default)]
#[repr(C)]
pub struct Rect {
    pub x: f32,
    pub y: f32,
}
impl Rect {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(8);
        __bytes.extend_from_slice(&self.x.to_ne_bytes());
        __bytes.extend_from_slice(&self.y.to_ne_bytes());
        __bytes
    }
}


#[derive(Debug, Clone, PartialEq, Default)]
#[repr(C)]
pub struct Packer {
    pub rects: Vec<Rect>,
}

impl Packer {
#[inline]
pub fn get(&self, i: u32) -> Option<Rect> {
        if (i as usize) < self.rects.len() {
            return Some(self.rects[i as usize]);
        }
        None
}
}

fn place(packer: &Packer, j: i32, w: f32) -> f32 {
    let found = packer.get(j as u32);
    let mut ox = 0.0_f32;
    let mut oy = 0.0_f32;
    match found {
        Some(r) => {
            ox = r.x;
            oy = r.y;
        },
        None => {
            ox = 0.0_f32;
            oy = 0.0_f32;
        },
    }
    let mut lo = 999999.0_f32;
    let mut k = 0_usize;
    while k < packer.rects.len() {
        let r = packer.rects[k];
        if r.y < lo {
            lo = r.y;
        }
        k = k.wrapping_add(1);
    }
    lo -= 10.0_f32;
    (w + ox + oy) / lo
}

fn main() {
    let p = Packer { rects: vec![Rect { x: 1.0_f32, y: 12.0_f32 }, Rect { x: 3.0_f32, y: 14.0_f32 }] };
    println!("{}", place(&p, 1_i32, 2.0_f32));
}


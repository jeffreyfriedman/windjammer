use std::ops::Add;
use std::ops::Mul;
#[derive(Debug, Clone, Copy, PartialEq, Default)]
#[repr(C)]
pub struct P2 {
    pub x: f32,
    pub y: f32,
}
impl P2 {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(8);
        __bytes.extend_from_slice(&self.x.to_ne_bytes());
        __bytes.extend_from_slice(&self.y.to_ne_bytes());
        __bytes
    }
}


impl Add for P2 {
    type Output = P2;

#[inline]
fn add(self, o: P2) -> P2 {
        P2 { x: self.x + o.x, y: self.y + o.y }
}
}

impl Mul<f32> for P2 {
    type Output = P2;

#[inline]
fn mul(self, s: f32) -> P2 {
        P2 { x: self.x * s, y: self.y * s }
}
}

impl P2 {
#[inline]
pub fn flipped(self) -> P2 {
        P2 { x: self.y, y: self.x }
}
}

#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C)]
pub struct Span {
    pub lo: P2,
    pub hi: P2,
}

#[inline]
fn mid(a: P2, b: P2) -> P2 {
    (a + b) * 0.5_f32
}

#[inline]
fn centre(spans: &Vec<Span>, i: usize) -> P2 {
    let s = spans[i];
    (s.lo + s.hi) * 0.5_f32
}

fn main() {
    let a = P2 { x: 1.0_f32, y: 2.0_f32 };
    let b = P2 { x: 3.0_f32, y: 4.0_f32 };
    let m = mid(a, b);
    let far = a.flipped() * 100.0_f32;
    let spans = vec![Span { lo: a, hi: b }];
    let c = centre(&spans, 0_usize);
    println!("{} {} {} {}", m.x, m.y, far.x, c.y);
}


#[derive(Debug, Clone, Copy, PartialEq, Default)]
#[repr(C)]
pub struct Probe {
    pub level: f32,
    pub hits: i32,
}
impl Probe {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(8);
        __bytes.extend_from_slice(&self.level.to_ne_bytes());
        __bytes.extend_from_slice(&self.hits.to_ne_bytes());
        __bytes
    }
}


impl Probe {
#[inline]
pub fn ratio(&self) -> f32 {
        self.level / 2.0_f32
}
#[inline]
pub fn count(&self) -> i32 {
        self.hits
}
}

fn main() {
    let p = Probe { level: 3.0_f32, hits: 3_i32 };
    assert_eq!(p.level, 3.0_f32);
    assert_eq!(p.ratio(), 1.5_f32);
    assert_eq!(p.count(), 3_i32);
    assert_ne!(p.level, 2.0_f32);
    println!("ok");
}


mod a {
    #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Counter {
    pub n: i64,
}
impl Counter {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(8);
        __bytes.extend_from_slice(&self.n.to_ne_bytes());
        __bytes
    }
}
    impl Counter {
#[inline]
pub fn new() -> Counter {
            Counter { n: 1_i64 }
}
#[inline]
pub fn bump(&mut self) {
            self.n += 10;
}
#[inline]
pub fn get(&self) -> i64 {
            self.n
}
}}

mod b {
    #[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Counter {
    pub s: String,
}    impl Counter {
#[inline]
pub fn new() -> Counter {
            Counter { s: String::new() }
}
#[inline]
pub fn bump(&mut self) {
            self.s = format!("{}{}", self.s, "a");
}
#[inline]
pub fn get(&self) -> i64 {
            self.s.len() as i64
}
}}

fn main() {
    let mut x = a::Counter::new();
    x.bump();
    let mut y = b::Counter::new();
    y.bump();
    y.bump();
    println!("{} {}", x.get(), y.get());
}


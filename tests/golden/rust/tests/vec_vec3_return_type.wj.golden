#[derive(Debug, Clone, Copy, PartialEq, Default)]

struct Vec3 {
    x: f32,
    y: f32,
    z: f32,
}











#[derive(Debug, Clone, PartialEq, Default)]

struct Path {
    waypoints: Vec<Vec3>,
}

#[inline]
fn make_path() -> Vec<Vec3> {
    Vec::<Vec3>::new()
}

#[inline]
fn process_path(waypoints: &Vec<Vec3>) -> i32 {
    waypoints.len() as i32
}

#[inline]
fn funnel_algorithm(_triangle_path: Vec<u32>, _start: Vec3, _goal: Vec3) -> Vec<Vec3> {
    Vec::<Vec3>::new()
}

fn main() {
    let path: Vec<Vec3> = make_path();
    let _result = process_path(&path);
    let v3 = Vec3 { x: 1.0_f32, y: 2.0_f32, z: 3.0_f32 };
    let _waypoints: Vec<Vec3> = funnel_algorithm(Vec::new(), v3, v3);
    println!("✅ Vec<Vec3> in all contexts works!");
}


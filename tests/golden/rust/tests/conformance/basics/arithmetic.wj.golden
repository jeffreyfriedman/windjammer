fn main() {
    let a = 3_i32;
    println!("[add] {}", a);
    let b = 7_i32;
    println!("[sub] {}", b);
    let c = 42_i32;
    println!("[mul] {}", c);
    let d = 5_i32;
    println!("[div] {}", d);
    let e = 1_i32;
    println!("[mod] {}", e);
    let f = -10_i64;
    println!("[neg] {}", f);
    let t = true;
    println!("[bool] {}", t);
    let u = false;
    println!("[bool] {}", u);
    println!("PASSED");
}


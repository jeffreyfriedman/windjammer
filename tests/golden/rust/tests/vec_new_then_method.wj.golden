#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]

struct Item {
    id: u32,
}









#[inline]
fn test_vec_chain() {
    let count = Vec::new().len();
    let items: Vec<Item> = Vec::new();
    let count2 = items.len();
    println!("counts: {}, {}", count, count2);
}

fn main() {
    test_vec_chain();
    println!("✅ Vec operations work!");
}


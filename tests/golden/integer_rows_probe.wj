// Every method of `trait Integer<T>` the portable emitters print today, on every integer type, with a local, a literal and an
// expression operand. tests/golden/integer_rows_probe.{js,go}.txt hold the JavaScript and Go this program emitted before the
// Integer rows moved into std/rust_core.wji (docs/design/table-driven-std-surface.md, stage 2); the output must stay byte-identical.
fn probe_i8(x: i8, y: i8, z: i8, n: u32) {
    println("${x.min(y)}")
    println("${x.min(2)}")
    println("${x.max(y)}")
    println("${x.max(2)}")
    println("${x.clamp(1, y)}")
    println("${x.clamp(z, y)}")
    println("${x.pow(n)}")
    println("${x.pow(2)}")
    println("${x.abs()}")
    println("${x.signum()}")
    println("${x.wrapping_neg()}")
    println("${x.is_negative()}")
    println("${x.is_positive()}")
    println("${x.wrapping_add(y)}")
    println("${x.wrapping_add(3)}")
    println("${(x + z).wrapping_add(y)}")
    println("${x.wrapping_sub(y)}")
    println("${x.wrapping_sub(3)}")
    println("${(x + z).wrapping_sub(y)}")
    println("${x.wrapping_mul(y)}")
    println("${x.wrapping_mul(3)}")
    println("${(x + z).wrapping_mul(y)}")
    println("${x.saturating_add(y)}")
    println("${x.saturating_add(3)}")
    println("${(x + z).saturating_add(y)}")
    println("${x.saturating_sub(y)}")
    println("${x.saturating_sub(3)}")
    println("${(x + z).saturating_sub(y)}")
    println("${x.saturating_mul(y)}")
    println("${x.saturating_mul(3)}")
    println("${(x + z).saturating_mul(y)}")
    println("${x.checked_add(y).unwrap_or(0)}")
    println("${x.checked_add(3).unwrap_or(0)}")
    println("${(x + z).checked_add(y).unwrap_or(0)}")
    println("${x.checked_sub(y).unwrap_or(0)}")
    println("${x.checked_sub(3).unwrap_or(0)}")
    println("${(x + z).checked_sub(y).unwrap_or(0)}")
    println("${x.checked_mul(y).unwrap_or(0)}")
    println("${x.checked_mul(3).unwrap_or(0)}")
    println("${(x + z).checked_mul(y).unwrap_or(0)}")
    println("${x.checked_div(y).unwrap_or(0)}")
    println("${x.checked_div(3).unwrap_or(0)}")
    println("${(x + z).checked_div(y).unwrap_or(0)}")
    println("${x.checked_rem(y).unwrap_or(0)}")
    println("${x.checked_rem(3).unwrap_or(0)}")
    println("${(x + z).checked_rem(y).unwrap_or(0)}")
    println("${x.rem_euclid(y)}")
    println("${x.rem_euclid(3)}")
    println("${(x + z).rem_euclid(y)}")
    println("${x.div_euclid(y)}")
    println("${x.div_euclid(3)}")
    println("${(x + z).div_euclid(y)}")
    println("${x.abs_diff(y)}")
    println("${x.abs_diff(3)}")
    println("${(x + z).abs_diff(y)}")
    println("${x.wrapping_shl(n)}")
    println("${x.wrapping_shl(3)}")
    println("${x.wrapping_shr(n)}")
    println("${x.wrapping_shr(3)}")
    println("${x.rotate_left(n)}")
    println("${x.rotate_left(3)}")
    println("${x.rotate_right(n)}")
    println("${x.rotate_right(3)}")
    println("${x.count_ones()}")
    println("${x.leading_zeros()}")
    println("${x.trailing_zeros()}")
    println("${x.is_power_of_two()}")
    let s = x.to_string()
    println("${s}")
}


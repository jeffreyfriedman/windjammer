// ==== acc.rs ====
#[allow(unused_imports)]
use super::*;

use crate::ops::double;
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Acc {
    pub total: i64,
}
impl Acc {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(8);
        __bytes.extend_from_slice(&self.total.to_ne_bytes());
        __bytes
    }
}


impl Acc {
#[inline]
pub fn double(&self, slot: usize) -> usize {
        slot + 1_usize
}
#[inline]
pub fn run(&mut self, v: i64) -> i64 {
        self.total += double(v);
        self.total
}
}


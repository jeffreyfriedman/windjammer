#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Doc {
    pub a: String,
    pub b: String,
}

#[inline]
fn draft(a: String, b: String) -> Doc {
    Doc { a, b }
}

#[inline]
pub fn make(a: String) -> Doc {
    draft(a, "x".to_string())
}


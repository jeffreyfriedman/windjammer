// ==== main.rs ====
use self::docs::make;
mod docs;
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Pair {
    pub a: i64,
    pub b: i64,
}
impl Pair {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(16);
        __bytes.extend_from_slice(&self.a.to_ne_bytes());
        __bytes.extend_from_slice(&self.b.to_ne_bytes());
        __bytes
    }
}


#[inline]
fn draft(a: i64, b: i64) -> Pair {
    Pair { a, b }
}

fn main() {
    let p = draft(4294967296_i64, -8589934592_i64);
    println!("{} {} {}", p.a, p.b, make("q".to_string()).a);
}


// ==== render.rs ====
#[allow(unused_imports)]
use super::*;

use crate::ledger::Ledger;
#[inline]
pub fn entry_body(entry: Ledger, extra: &str) -> String {
    let mut body = format!("{}{}{}{}", "{\"code\":\"", entry.code, "\",\"name\":\"", entry.name);
    body = body + "\",\"cents\":" + &entry.cents.to_string();
    body = body + &extra;
    body
}

#[inline]
pub fn entry_json(entry: &Ledger) -> String {
    entry_text(entry.clone(), "}")
}

#[inline]
pub fn entry_text(entry: Ledger, extra: &str) -> String {
    entry_body(entry, extra)
}


// ==== list.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Clone, Debug)]
pub enum List {
    Cons(i64, Box<List>),
    Nil,
}

#[inline]
pub fn count_ones(c: List) -> i64 {
    match c {
        List::Cons(_, rest) => 1_i64 + count_ones(*rest),
        List::Nil => 0_i64,
    }
}

// ==== main.rs ====

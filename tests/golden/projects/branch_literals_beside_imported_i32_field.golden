// ==== score.rs ====
#[allow(unused_imports)]
use super::*;

use crate::cell::Cell;
#[inline]
pub fn adjusted(cells: &Vec<Cell>) -> i32 {
    let w = cells[0].weight;
    let d = {
        if w > 3_i32 {
            -1_i32
        } else {
            1_i32
        }
    };
    let t = w + d;
    t
}


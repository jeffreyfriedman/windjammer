// ==== cell.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Cell {
    pub weight: i32,
}
impl Cell {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(4);
        __bytes.extend_from_slice(&self.weight.to_ne_bytes());
        __bytes
    }
}



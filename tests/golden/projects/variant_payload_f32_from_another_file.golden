// ==== shape.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Clone, Debug, PartialEq, Copy)]
pub enum Shape {
    Sphere(f32),
    Cone(f32, f32),
    Point,
}

#[inline]
pub fn size(s: Shape) -> f32 {
    match s {
        Shape::Sphere(r) => r,
        Shape::Cone(a, b) => a + b,
        Shape::Point => 0.0_f32,
    }
}


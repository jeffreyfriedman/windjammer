pub mod shapes;
pub mod zblocks;

// Re-export public items
pub use zblocks::Corner;
// ==== main.rs ====
use self::shapes::Mesh;
mod shapes;
mod zblocks;
#[inline]
fn rebuild(src: &Vec<f32>) -> Mesh {
    let mut out = Mesh::new();
    let mut i: usize = 0_usize;
    while i < src.len() {
        if i + 2_usize < src.len() {
            let _ = out.add(src[i], src[(i + 1) as usize], src[(i + 2) as usize]);
        } else {
            let _ = out.add(0.0_f32, 0.0_f32, 0.0_f32);
        }
        i += 3;
    }
    out
}

fn main() {
    let m = rebuild(&vec![1.0_f32, 2.0_f32, 3.0_f32, 4.0_f32]);
    let mut sum = 0.0_f32;
    for p in &m.pts {
        sum += p;
    }
    let mut s = zblocks::Mesh::new();
    s.add();
    println!("{} {}", m.count, sum as f32 + s.corners.len() as f32 - 1.0_f32);
}


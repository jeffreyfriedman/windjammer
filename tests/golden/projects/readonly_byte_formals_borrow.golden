// ==== main.rs ====
mod keys;
fn main() {
    let entries = vec![keys::Entry { key: vec![1_u8] }, keys::Entry { key: vec![3_u8] }, keys::Entry { key: vec![5_u8] }];
    let probe: Vec<u8> = vec![4_u8];
    let at = keys::first_not_before(&entries, &probe);
    let a = keys::Key { bytes: vec![1_u8, 2_u8] };
    let b = keys::Key { bytes: vec![1_u8, 3_u8] };
    let run = keys::Run { entries: vec![keys::Entry { key: vec![2_u8] }, keys::Entry { key: vec![4_u8] }, keys::Entry { key: vec![6_u8] }] };
    let found = run.find(&vec![5_u8]);
    let x: Vec<u8> = vec![1_u8, 2_u8];
    let y: Vec<u8> = vec![1_u8, 3_u8];
    let rows: Vec<Vec<u8>> = vec![vec![1_u8], vec![2_u8], vec![1_u8]];
    let root: Vec<u8> = vec![1_u8];
    let mixed: Vec<Vec<u8>> = vec![vec![1_u8], vec![7_u8]];
    println!("{} {} {} {} {} {}", at, keys::cmp_keys(&a, &b), found, keys::ordered(&x, &y), keys::count_root(rows, &root), keys::count_root(mixed, &vec![7_u8]));
}


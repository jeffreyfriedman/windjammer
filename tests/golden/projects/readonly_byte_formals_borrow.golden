// ==== keys.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, PartialEq, Eq, Default)]
#[repr(C)]
pub struct Entry {
    pub key: Vec<u8>,
}

#[derive(Debug, Clone, PartialEq, Eq, Default)]
#[repr(C)]
pub struct Key {
    pub bytes: Vec<u8>,
}

#[derive(Debug, Clone, PartialEq, Default)]
#[repr(C)]
pub struct Run {
    pub entries: Vec<Entry>,
}

impl Run {
#[inline]
pub fn cmp_at(&self, idx: usize, key: &Vec<u8>) -> i32 {
        cmp_bytes(&self.entries[idx].key, key)
}
#[inline]
pub fn find(&self, key: &Vec<u8>) -> usize {
        let mut lo: usize = 0_usize;
        let mut hi: usize = self.entries.len();
        while lo < hi {
            let mid = lo + (hi - lo) / 2_usize;
            if self.cmp_at(mid, key) < 0_i32 {
                lo = mid + 1_usize;
            } else {
                hi = mid;
            }
        }
        lo
}
}

#[inline]
pub fn cmp_bytes(a: &Vec<u8>, b: &Vec<u8>) -> i32 {
    let n = {
        if a.len() < b.len() {
            a.len()
        } else {
            b.len()
        }
    };
    let mut i: usize = 0_usize;
    while i < n {
        if a[i] < b[i] {
            return -1_i32;
        }
        if a[i] > b[i] {
            return 1_i32;
        }
        i += 1;
    }
    if a.len() < b.len() {
        return -1_i32;
    }
    if a.len() > b.len() {
        return 1_i32;
    }
    0_i32
}

#[inline]
pub fn cmp_keys(a: &Key, b: &Key) -> i32 {
    let n = {
        if a.bytes.len() < b.bytes.len() {
            a.bytes.len()
        } else {
            b.bytes.len()
        }
    };
    let mut i: usize = 0_usize;
    while i < n {
        if a.bytes[i] < b.bytes[i] {
            return -1_i32;
        }
        if a.bytes[i] > b.bytes[i] {
            return 1_i32;
        }
        i += 1;
    }
    0_i32
}

#[inline]
pub fn ordered(x: &Vec<u8>, y: &Vec<u8>) -> bool {
    let mut before = x < y;
    if x.is_empty() {
        before = true;
    }
    before
}

#[inline]
pub fn count_root(rows: Vec<Vec<u8>>, root: &Vec<u8>) -> i64 {
    let mut n = 0_i64;
    for r in rows {
        if r == *root {
            n += 1;
        }
    }
    n
}

#[inline]
pub fn first_not_before(entries: &Vec<Entry>, key: &Vec<u8>) -> usize {
    let mut lo: usize = 0_usize;
    let mut hi: usize = entries.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2_usize;
        if cmp_bytes(&entries[mid].key, key) < 0_i32 {
            lo = mid + 1_usize;
        } else {
            hi = mid;
        }
    }
    lo
}


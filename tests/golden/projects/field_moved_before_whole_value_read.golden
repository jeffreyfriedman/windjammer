// ==== rec.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, PartialEq, Default)]
#[repr(C)]
pub struct Node {
    pub id: String,
    pub x: f64,
}

#[derive(Debug, Clone, PartialEq, Default)]
#[repr(C)]
pub struct Hit {
    pub id: String,
    pub dist: f64,
}

#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Obj {
    pub kind: String,
    pub key: String,
}

#[derive(Debug, Clone, PartialEq)]
#[repr(C)]
pub struct Request {
    pub obj: Obj,
    pub rel: String,
}

#[inline]
fn distance(node: &Node, q: f64) -> f64 {
    node.x - q
}

#[inline]
pub fn score(node: Node, q: f64) -> Hit {
    Hit { id: node.id.clone(), dist: distance(&node, q) }
}

#[inline]
fn known(kind: String, rel: String) -> bool {
    let mut seen: Vec<String> = Vec::new();
    seen.push(kind);
    seen.push(rel);
    seen.len() == 2_usize
}

#[inline]
pub fn expand(request: Request) -> String {
    if !known(request.obj.kind.clone(), request.rel.clone()) {
        return String::new();
    }
    describe(request.obj, &request.rel)
}

#[inline]
fn describe(obj: Obj, rel: &str) -> String {
    let mut out = obj.kind;
    out.push_str(":");
    out.push_str(&obj.key);
    out.push_str("#");
    out.push_str(rel);
    out
}


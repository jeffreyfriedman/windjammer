// ==== channel.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, Copy, PartialEq, Default)]
#[repr(C)]
pub struct Channel {
    pub volume: f32,
}
impl Channel {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(4);
        __bytes.extend_from_slice(&self.volume.to_ne_bytes());
        __bytes
    }
}


impl Channel {
#[inline]
pub fn new() -> Channel {
        Channel { volume: 1.0_f32 }
}
#[inline]
pub fn set_volume(&mut self, volume: f32) {
        self.volume = volume;
}
}


// ==== geom.rs ====
#[allow(unused_imports)]
use super::*;

use std::ops::Add;
use std::ops::Sub;
use std::ops::Mul;
#[derive(Debug, Clone, Copy, PartialEq, Default)]
#[repr(C)]
pub struct P3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}
impl P3 {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(12);
        __bytes.extend_from_slice(&self.x.to_ne_bytes());
        __bytes.extend_from_slice(&self.y.to_ne_bytes());
        __bytes.extend_from_slice(&self.z.to_ne_bytes());
        __bytes
    }
}


impl Add for P3 {
    type Output = P3;

#[inline]
fn add(self, o: P3) -> P3 {
        P3 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z }
}
}

impl Sub for P3 {
    type Output = P3;

#[inline]
fn sub(self, o: P3) -> P3 {
        P3 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z }
}
}

impl Mul<f32> for P3 {
    type Output = P3;

#[inline]
fn mul(self, s: f32) -> P3 {
        P3 { x: self.x * s, y: self.y * s, z: self.z * s }
}
}

impl P3 {
#[inline]
pub fn length(&self) -> f32 {
        (self.x * self.x + self.y * self.y + self.z * self.z).sqrt()
}
}

#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C)]
pub struct Bounds {
    pub lo: P3,
    pub hi: P3,
}

#[derive(Debug, Clone, Copy, PartialEq, Default)]
#[repr(C)]
pub struct Slot {
    pub w: f32,
}
impl Slot {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(4);
        __bytes.extend_from_slice(&self.w.to_ne_bytes());
        __bytes
    }
}


#[inline]
pub fn find_slot(slots: &Vec<Slot>, i: usize) -> Option<Slot> {
    if i < slots.len() {
        return Some(slots[i]);
    }
    None
}


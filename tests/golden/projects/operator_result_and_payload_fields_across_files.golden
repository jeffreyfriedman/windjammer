// ==== main.rs ====
use self::geom::P3;
use self::geom::Bounds;
use self::geom::Slot;
mod geom;
#[inline]
fn centre(b: Bounds) -> P3 {
    (b.lo + b.hi) * 0.5_f32
}

fn main() {
    let b = Bounds { lo: P3 { x: 0.0_f32, y: 0.0_f32, z: 0.0_f32 }, hi: P3 { x: 2.0_f32, y: 4.0_f32, z: 6.0_f32 } };
    let c = centre(b);
    println!("{} {} {}", c.x, c.y, c.z);
    let p = P3 { x: 4.0_f32, y: 6.0_f32, z: 1.0_f32 };
    let q = P3 { x: 1.0_f32, y: 2.0_f32, z: 1.0_f32 };
    let d = (p - q).length();
    println!("{}", d);
    let slots = vec![Slot { w: 2.5_f32 }];
    println!("{} {}", width_of(&slots, 0_usize), width_of(&vec![Slot { w: 1.0_f32 }], 5_usize));
}

#[inline]
fn width_of(slots: &Vec<Slot>, i: usize) -> f32 {
    let mut w = 0.0_f32;
    match geom::find_slot(slots, i) {
        Some(s) => {
            w = s.w;
        },
        None => {
            w = 0.0_f32;
        },
    }
    w
}


// ==== reader.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, PartialEq, Eq, Default)]
#[repr(C)]
pub struct Reader {
    pub allowed: Vec<String>,
}

impl Reader {
#[inline]
pub fn check(&self, who: &str, relation: &str) -> bool {
        for a in &self.allowed {
            if a == relation && !who.is_empty() {
                return true;
            }
        }
        false
}
}

#[inline]
pub fn allowed(policy: &Reader, who: &str, relation: &str, n: i64) -> i64 {
    let mut hits = 0_i64;
    let mut i = 0_i64;
    while i < n {
        if policy.check(who.clone(), relation.clone()) {
            hits += 1;
        }
        i = i.wrapping_add(1);
    }
    hits
}


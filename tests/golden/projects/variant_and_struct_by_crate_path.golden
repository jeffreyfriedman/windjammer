// ==== main.rs ====
mod shapes;
#[inline]
fn size(s: &crate::shapes::Shape) -> f32 {
    let (a, b, c) = match s {
        crate::shapes::Shape::Cube(e) => (e.x, e.y, e.z),
        crate::shapes::Shape::Ball(r) => (*r * 1.0_f32, 0.0_f32, 0.0_f32),
        crate::shapes::Shape::Pill(r, h) => (*r * 1.0_f32, *h * 1.0_f32, 0.0_f32),
        crate::shapes::Shape::Hull(_) => (1.0_f32, 1.0_f32, 1.0_f32),
    };
    crate::shapes::total(a, b, c)
}

#[inline]
fn heavy(items: &Vec<crate::shapes::Item>) -> i64 {
    let mut n = 0_i64;
    for m in items.iter().copied() {
        if m.weight > 0.5_f32 {
            n += 1;
        }
    }
    n
}

fn main() {
    let pill = crate::shapes::Shape::Pill(1.5_f32, 2.0_f32);
    let ball = crate::shapes::Shape::Ball(0.5_f32);
    let cube = crate::shapes::Shape::Cube(crate::shapes::V3 { x: 1.0_f32, y: 2.0_f32, z: 3.0_f32 });
    println!("{} {} {}", size(&pill), size(&ball), size(&cube));
    let items = vec![crate::shapes::Item { weight: 0.75_f32, kind: 1_i32 }, crate::shapes::Item { weight: 0.25_f32, kind: 2_i32 }];
    println!("{}", heavy(&items));
}


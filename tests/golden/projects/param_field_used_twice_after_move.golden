#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Sim {
    pub left: u32,
    pub addr: String,
}

#[inline]
pub fn advance(sim: Sim) -> (String, Sim) {
    if sim.left > 0_u32 {
        let next = Sim { left: sim.left - 1_u32, addr: sim.addr.clone() };
        return (sim.addr.clone(), next);
    }
    (sim.addr, Sim { left: 0_u32, addr: String::new() })
}


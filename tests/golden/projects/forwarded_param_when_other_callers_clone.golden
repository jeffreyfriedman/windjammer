// ==== user.rs ====
#[allow(unused_imports)]
use super::*;

use crate::enc::Item;
use crate::enc::pack;
use crate::enc::Packed;
#[inline]
pub fn twice() -> usize {
    let items = vec![Item::Flag(true)];
    let a: Vec<u8> = pack(items.clone());
    let b: Vec<u8> = pack(items);
    a.len() + b.len() - 1_usize
}

#[inline]
pub fn once() -> usize {
    Packed::from_items(vec![Item::Flag(true)]).bytes.len()
}


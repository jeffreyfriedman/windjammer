// ==== mem_audit.rs ====
#[allow(unused_imports)]
use super::*;

use crate::ports::AuditSink;
use crate::ports::AuditDraft;
use crate::ports::Posted;
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct MemAudit;

impl AuditSink for MemAudit {
#[inline]
fn append(&self, scope: String, event: AuditDraft) -> Result<Posted, String> {
        Ok(Posted { id: scope.len() as i64 + event.note.len() as i64 })
}
}

// ==== mem_events.rs ====
#[allow(unused_imports)]

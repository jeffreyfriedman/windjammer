// ==== service.rs ====
#[allow(unused_imports)]
use super::*;

use crate::ports::EventDraft;
use crate::ports::EventSink;
use crate::ports::AuditDraft;
use crate::ports::AuditSink;
use crate::mem_events::MemEvents;
use crate::mem_audit::MemAudit;
#[derive(Debug, Clone, Copy)]
#[repr(C)]
pub struct Deps {
    pub audit: MemAudit,
}

#[inline]
pub fn write_event(event: &EventDraft) -> Result<(), String> {
    let writer = MemEvents {  };
    writer.append(event.clone())
}

#[inline]
pub fn record(deps: Deps, note: String) -> i64 {
    match deps.audit.append("demo".to_string(), AuditDraft { note }) {
        Ok(p) => p.id,
        Err(_) => -1_i64,
    }
}


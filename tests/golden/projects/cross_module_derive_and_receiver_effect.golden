// ==== b.rs ====
#[allow(unused_imports)]
use super::*;

use crate::v::V4;
#[derive(Debug, Clone, Copy, PartialEq)]
#[repr(C)]
pub struct Pair {
    pub lo: V4,
    pub hi: V4,
}

impl Pair {
#[inline]
pub fn widen(&self, k: f32) -> V4 {
        V4 { x: self.lo.x * k, w: self.hi.w }
}
#[inline]
pub fn first(&self) -> f32 {
        self.widen(2.0_f32).truncate()
}
}


fn main() {
    let p = b::Pair { lo: v::V4 { x: 1.0_f32, w: 0.0_f32 }, hi: v::V4 { x: 2.0_f32, w: 1.0_f32 } };
    let q = b::Pair { lo: v::V4 { x: 1.0_f32, w: 0.0_f32 }, hi: v::V4 { x: 2.0_f32, w: 1.0_f32 } };
    println!("{} {}", p.first() == 2.0_f32, p == q);
}


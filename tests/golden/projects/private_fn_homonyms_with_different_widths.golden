// ==== parse.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Mapping {
    pub date_col: i64,
    pub amount_col: i64,
}
impl Mapping {
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut __bytes = Vec::with_capacity(16);
        __bytes.extend_from_slice(&self.date_col.to_ne_bytes());
        __bytes.extend_from_slice(&self.amount_col.to_ne_bytes());
        __bytes
    }
}


#[inline]
fn cell(cells: &Vec<String>, idx: i64) -> String {
    if idx < (cells.len() as i64) {
        cells[idx as usize].clone()
    } else {
        String::new()
    }
}

#[inline]
pub fn date_of(cells: &Vec<String>, mapping: Mapping) -> String {
    cell(cells, mapping.date_col)
}

#[inline]
pub fn amount_of(cells: &Vec<String>, mapping: Mapping) -> String {
    cell(cells, mapping.amount_col)
}


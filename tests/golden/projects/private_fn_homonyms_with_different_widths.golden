fn main() {
    let row = vec!["2026-01-02".to_string(), "12".to_string()];
    let m = Mapping { date_col: 0_i64, amount_col: 1_i64 };
    println!("{} {} {}", parse::date_of(&row, m), parse::amount_of(&row, Mapping { date_col: 0_i64, amount_col: 1_i64 }), ledger::first(&row));
}


// ==== ledger.rs ====
#[allow(unused_imports)]
use super::*;
#[inline]
fn cell(row: &Vec<String>, index: usize) -> String {
    if index < row.len() {
        row[index].clone()
    } else {
        String::from("-")
    }
}

#[inline]
pub fn first(row: &Vec<String>) -> String {
    cell(row, 0_usize)
}


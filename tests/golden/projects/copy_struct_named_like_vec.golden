// ==== main.rs ====
use crate::vec3::Vec3;
use crate::grid::Grid;
use crate::camera::Camera;
mod vec3;
mod grid;
mod camera;
fn main() {
    let g = Grid { cells: vec![0_u8, 0_u8, 1_u8, 0_u8], size: 4_i64 };
    let mut c = Camera { pos: Vec3::new(0.0_f32, 0.0_f32, 0.0_f32), scale: 1_i64 };
    c.update(1.0_f32, &g);
    c.update(1.0_f32, &g);
    println!("{} {}", c.pos.x, g.size / 2_i64);
}


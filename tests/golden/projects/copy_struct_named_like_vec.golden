// ==== camera.rs ====
#[allow(unused_imports)]
use super::*;

use crate::vec3::Vec3;
use crate::grid::Grid;
#[derive(Debug, Clone, Copy)]
#[repr(C)]
pub struct Camera {
    pub pos: Vec3,
    pub scale: i64,
}

impl Camera {
#[inline]
pub fn collides(grid: &Grid, pos: Vec3, scale: i64) -> bool {
        let ix = (pos.x as f32 * scale as f32) as i64;
        grid.get(ix) != 0_u8
}
#[inline]
pub fn update(&mut self, dx: f32, grid: &Grid) {
        let test_x = Vec3::new(self.pos.x + dx, self.pos.y, self.pos.z);
        if !Camera::collides(grid, test_x, self.scale) {
            self.pos = test_x;
        }
}
}

// ==== grid.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, PartialEq, Eq, Default)]
#[repr(C)]
pub struct Grid {
    pub cells: Vec<u8>,
    pub size: i64,
}

impl Grid {
#[inline]
pub fn get(&self, x: i64) -> u8 {
        if x < 0_i64 || x >= self.size {
            return 0_u8;
        }
        self.cells[x as usize]
}
}


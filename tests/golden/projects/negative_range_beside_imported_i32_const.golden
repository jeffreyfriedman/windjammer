// ==== build.rs ====
#[allow(unused_imports)]
use super::*;

use crate::grid::SIZE;
#[inline]
fn put(x: i32) -> i32 {
    x
}

#[inline]
pub fn total() -> i32 {
    let cx = SIZE / 2_i32;
    let mut sum = 0_i32;
    for dx in -1_i32..1_i32 {
        sum += put(cx + dx);
    }
    sum
}


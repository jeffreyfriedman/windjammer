// ==== codec.rs ====
#[allow(unused_imports)]
use super::*;
#[inline]
pub fn encode(n: i64) -> Vec<i64> {
    let mut out: Vec<i64> = Vec::new();
    for i in 0_i64..n {
        out.push(i);
    }
    out
}

#[inline]
pub fn frame_len(buf: Vec<i64>) -> i64 {
    buf.len() as i64
}


#[inline]
fn lookup(tenant_slug: &str, wanted: &str) -> Result<bool, String> {
    let slug = tenant_slug;
    let code = wanted;
    let r = ListReader { n: 0_i64 };
    let items = r.list(slug.to_string());
    if items.is_empty() {
        return Err(String::from("none"));
    }
    for item in items {
        if item == code {
            return Ok(true);
        }
    }
    Ok(false)
}

#[inline]
fn validate(tenant_slug: &str, lines: Vec<Line>) -> Result<(), String> {
    let slug = tenant_slug;

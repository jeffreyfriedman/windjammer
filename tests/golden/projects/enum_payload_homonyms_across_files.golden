// ==== a.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Clone, Debug, PartialEq, Copy)]
pub enum Shape {
    Circle(f64),
    Dot,
}

#[inline]
pub fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => r * r,
        Shape::Dot => 0.0_f64,
    }
}

// ==== b.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Clone, Debug, PartialEq, Copy)]
pub enum Shape {
    Circle(i64),
    Square(i64),
}

#[inline]
pub fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => r * 3_i64,
        Shape::Square(k) => k * k,
    }
}


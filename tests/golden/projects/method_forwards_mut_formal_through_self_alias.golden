pub mod graph;

// Re-export public items
pub use graph::*;
// ==== main.rs ====
mod graph;
fn main() {
    let mut csr = graph::Csr { ids: vec![1_i64, 2_i64], visits: 0_u64 };
    let h = graph::Host { runs: 0_u64 }.run_joined(String::from("walk"), &mut csr, 0_i64);
    let mut csr2 = graph::Csr { ids: vec![3_i64], visits: 0_u64 };
    let h2 = graph::Host { runs: 0_u64 }.run_joined(String::from("walk"), &mut csr2, 5_i64);
    println!("{} {}", h.runs, h2.runs);
}


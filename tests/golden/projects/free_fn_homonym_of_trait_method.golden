// ==== shelf.rs ====
#[allow(unused_imports)]
use super::*;

use crate::ports::Inventory;
#[derive(Debug, Clone, PartialEq, Eq, Default)]
#[repr(C)]
pub struct Shelf {
    pub items: Vec<String>,
}

impl Inventory for Shelf {
#[inline]
fn list_items(&self, tenant_id: String) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for it in &self.items {
            if *it == tenant_id {
                out.push(it.to_string());
            }
        }
        out
}
}

// ==== usecases.rs ====
#[allow(unused_imports)]
use super::*;

use crate::shelf::Shelf;
#[derive(Debug, Clone, PartialEq)]
#[repr(C)]
pub struct Deps {
    pub shelf: Shelf,
    pub tag: String,
}

#[inline]
pub fn list_items(deps: Deps, tenant_slug: String) -> Vec<String> {
    let mut out: Vec<String> = deps.shelf.items;
    out.push(tenant_slug);
    out
}


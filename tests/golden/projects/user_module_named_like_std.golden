// ==== http.rs ====
#[allow(unused_imports)]
use super::*;
#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Reply {
    pub status: i64,
    pub body: String,
}

#[inline]
pub fn to_response(reply: Reply) -> String {
    base_response(reply.status, &reply.body)
}

#[inline]
pub fn base_response(status: i64, body: &str) -> String {
    format!("{}:{}", status, body)
}


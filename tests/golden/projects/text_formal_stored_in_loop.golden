#[derive(Debug, Clone, PartialEq, Eq, Hash, Default)]
#[repr(C)]
pub struct Entry {
    pub id: u32,
    pub owner: String,
}

#[derive(Debug, Clone, PartialEq, Default)]
#[repr(C)]
pub struct Table {
    pub entries: Vec<Entry>,
}

impl Table {
#[inline]
pub fn set_owner(&self, id: u32, owner: String) -> Table {
        let mut entries: Vec<Entry> = Vec::new();
        let mut i = 0_usize;
        while i < self.entries.len() {
            let entry = self.entries[i].clone();
            if entry.id == id {
                let _ = entries.push(Entry { id: entry.id, owner: owner.clone() });
            } else {
                let _ = entries.push(entry);
            }
            i += 1;
        }
        Table { entries }
}

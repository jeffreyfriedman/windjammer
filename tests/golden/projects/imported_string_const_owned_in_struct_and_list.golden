pub mod grants;
pub mod names;

// Re-export public items
pub use grants::*;
pub use names::*;
// ==== main.rs ====
mod names;
mod grants;
fn main() {
    let g = grants::default_grant();
    println!("{} {} {}", g.scope, &g.extra[0], g.extra.len());
    let w = grants::widened(g);
    println!("{} {}", w.scope, grants::label_count());
}


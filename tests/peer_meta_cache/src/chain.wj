// Peer: declares a free function named like a method the probe calls.
enum Chain {
    Link(int, Box<Chain>),
    End,
}

fn len(c: Chain) -> int {
    match c {
        Chain::Link(_, rest) => 1 + len(*rest),
        Chain::End => 0,
    }
}

fn main() {
    println("${len(Chain::Link(1, Box::new(Chain::End)))}")
}

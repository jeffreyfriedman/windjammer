use std::sync
use std::time
fn main() {
    let (tx, rx) = sync::channel()
    scope {
        for i in 0..3 {
            let t = tx
            spawn {
                time::sleep_millis((3 - i) * 10)
                t.send(i)
            }
        }
    }
    for _ in 0..3 { println("${rx.recv()}") }
}

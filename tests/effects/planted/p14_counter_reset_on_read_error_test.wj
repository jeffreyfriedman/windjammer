// bug: a failed read of the counter file is treated as "no counter yet", which silently resets it
// faults: 0.15
use std::fs

fn next_id() -> int {
    let current = match fs::read_to_string("counter.txt") {
        Ok(s) => s.trim().parse::<int>().unwrap_or(0),
        Err(_) => 0,
    }
    let _ = fs::write("counter.txt", "${current + 1}")
    current + 1
}

@test
fn ids_keep_increasing() {
    let _ = fs::remove_file("counter.txt")
    let a = next_id()
    let b = next_id()
    let c = next_id()
    assert(a < b && b < c)
}

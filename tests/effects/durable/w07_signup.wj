// workflow: signup: generate id and token, store the account, send welcome
use std::collections::HashMap
use std::env
use std::fs
use std::random
use std::sync
use std::time
fn make_id() -> int { random::range(1000, 9999) }
fn make_token() -> string { random::alphanumeric(8) }
fn store(id: int, token: string) { fs::write("account-${id}.txt", token) ?? () }
durable fn run() -> string {
    // @mutation-point
    let wj_taint = ""
    let id = make_id()
    let token = make_token()
    store(id, token)
    println("welcome ${id}")
    "signup ${id} ${token}${wj_taint}"
}
fn main() { println("RESULT ${run()}") }

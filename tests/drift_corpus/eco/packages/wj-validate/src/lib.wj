use std::strings

/// Trim and require a non-empty string.
pub fn require_nonempty(field: string, value: string) -> Result<string, string> {
    let trimmed = strings.trim(value)
    if strings.len(trimmed) == 0 {
        return Err("${field} is required")
    }
    Ok(trimmed)
}

/// Require `value` length >= `min` (after trim).
pub fn require_min_len(field: string, value: string, min: int) -> Result<string, string> {
    let trimmed = strings.trim(value)
    if strings.len(trimmed) < min {
        return Err("${field} must be at least ${min} characters")
    }
    Ok(trimmed)
}

/// Require `min <= len(trim(value)) <= max`.
pub fn require_len_range(field: string, value: string, min: int, max: int) -> Result<string, string> {
    match require_min_len(field, value, min) {
        Ok(v) => require_max_len(field, v, max),
        Err(e) => Err(e),
    }
}

/// Require `value` length <= `max` (after trim).
pub fn require_max_len(field: string, value: string, max: int) -> Result<string, string> {
    let trimmed = strings.trim(value)
    if strings.len(trimmed) > max {
        return Err("${field} must be at most ${max} characters")
    }
    Ok(trimmed)
}

/// Lightweight email shape: non-empty local@domain with a dot in the domain.
pub fn require_email(field: string, value: string) -> Result<string, string> {
    let trimmed = strings.trim(value)
    if strings.len(trimmed) == 0 {
        return Err("${field} is required")
    }
    let parts = strings.split(trimmed, "@")
    if parts.len() != 2 {
        return Err("${field} must be a valid email")
    }
    let local = parts[0]
    let domain = parts[1]
    if strings.len(local) == 0 {
        return Err("${field} must be a valid email")
    }
    if strings.len(domain) == 0 {
        return Err("${field} must be a valid email")
    }
    if !strings.contains(domain, ".") {
        return Err("${field} must be a valid email")
    }
    if strings.starts_with(domain, ".") {
        return Err("${field} must be a valid email")
    }
    if strings.ends_with(domain, ".") {
        return Err("${field} must be a valid email")
    }
    Ok(trimmed)
}

/// Require `min <= value <= max`.
pub fn require_int_range(field: string, value: int, min: int, max: int) -> Result<int, string> {
    if value < min || value > max {
        return Err("${field} must be between ${min} and ${max}")
    }
    Ok(value)
}

/// Require `value` is one of `allowed`.
pub fn require_one_of(field: string, value: string, allowed: Vec<string>) -> Result<string, string> {
    let trimmed = strings.trim(value)
    let mut i = 0
    while i < allowed.len() {
        if allowed[i] == trimmed {
            return Ok(trimmed)
        }
        i = i + 1
    }
    Err("${field} must be one of the allowed values")
}

/// Ok if `errors` is empty; otherwise Err with errors joined by `"; "`.
pub fn all_ok(errors: Vec<string>) -> Result<(), string> {
    if errors.len() == 0 {
        return Ok(())
    }
    let mut out = ""
    let mut i = 0
    while i < errors.len() {
        if i == 0 {
            out = errors[i]
        } else {
            out = "${out}; ${errors[i]}"
        }
        i = i + 1
    }
    Err(out)
}

/// True when `errors` is non-empty.
pub fn has_errors(errors: Vec<string>) -> bool {
    errors.len() > 0
}

pub fn error_count(errors: Vec<string>) -> int {
    let mut n = 0
    for _ in errors {
        n = n + 1
    }
    n
}

/// True when there are no validation errors.
pub fn is_valid(errors: Vec<string>) -> bool {
    !has_errors(errors)
}

/// First error message, or `None` when the list is empty.
pub fn first_error(errors: Vec<string>) -> Option<string> {
    if errors.len() == 0 {
        return None
    }
    Some(errors[0])
}

/// Last error message, or `None` when the list is empty.
pub fn last_error(errors: Vec<string>) -> Option<string> {
    let n = errors.len()
    if n == 0 {
        return None
    }
    Some(errors[n - 1])
}

/// Ok when there are no errors; otherwise Err with the first message.
pub fn require_clean(errors: Vec<string>) -> Result<(), string> {
    match first_error(errors) {
        Some(msg) => Err(msg),
        None => Ok(()),
    }
}

/// The only error when the list has exactly one entry.
pub fn only_error(errors: Vec<string>) -> Option<string> {
    if errors.len() == 1 {
        Some(errors[0])
    } else {
        None
    }
}

/// Predicate form of `require_email` (no field name).
pub fn is_email(value: string) -> bool {
    match require_email("email", value) {
        Ok(_) => true,
        Err(_) => false,
    }
}

/// Require `value > 0`.
pub fn require_positive(field: string, value: int) -> Result<int, string> {
    if value <= 0 {
        return Err("${field} must be positive")
    }
    Ok(value)
}

/// Require `value >= 0`.
pub fn require_nonneg(field: string, value: int) -> Result<int, string> {
    if value < 0 {
        return Err("${field} must be non-negative")
    }
    Ok(value)
}

/// Require an absolute `http://` or `https://` URL with a non-empty host.
pub fn require_url(field: string, value: string) -> Result<string, string> {
    let trimmed = strings.trim(value)
    if strings.len(trimmed) == 0 {
        return Err("${field} is required")
    }
    let mut rest = ""
    if strings.starts_with(trimmed, "https://") {
        rest = strip_prefix(trimmed, 8)
    } else if strings.starts_with(trimmed, "http://") {
        rest = strip_prefix(trimmed, 7)
    } else {
        return Err("${field} must be an http or https URL")
    }
    if strings.len(rest) == 0 {
        return Err("${field} must be an http or https URL")
    }
    if strings.starts_with(rest, "/") {
        return Err("${field} must be an http or https URL")
    }
    Ok(trimmed)
}

/// Require an absolute `https://` URL with a non-empty host.
pub fn require_https(field: string, value: string) -> Result<string, string> {
    match require_url(field, value) {
        Ok(url) => {
            if strings.starts_with(url, "https://") {
                return Ok(url)
            }
            Err("${field} must be https")
        },
        Err(e) => Err(e),
    }
}

/// Require a canonical UUID v1, v4, v5, or v7 (`8-4-4-4-12`, RFC variant).
pub fn require_uuid(field: string, value: string) -> Result<string, string> {
    let trimmed = strings.trim(value)
    let parts = strings.split(trimmed, "-")
    if parts.len() != 5 {
        return Err("${field} must be a UUID")
    }
    if strings.len(parts[0]) != 8 {
        return Err("${field} must be a UUID")
    }
    if strings.len(parts[1]) != 4 {
        return Err("${field} must be a UUID")
    }
    if strings.len(parts[2]) != 4 {
        return Err("${field} must be a UUID")
    }
    if strings.len(parts[3]) != 4 {
        return Err("${field} must be a UUID")
    }
    if strings.len(parts[4]) != 12 {
        return Err("${field} must be a UUID")
    }
    let mut i = 0
    while i < parts.len() {
        if !is_hex(parts[i]) {
            return Err("${field} must be a UUID")
        }
        i = i + 1
    }
    let id = strings.to_lower(trimmed)
    if strings.len(id) != 36 {
        return Err("${field} must be a UUID")
    }
    let ver = strings.substring(id, 14, 15)
    if ver != "1" && ver != "4" && ver != "5" && ver != "7" {
        return Err("${field} must be a UUID")
    }
    let variant = strings.substring(id, 19, 20)
    if variant != "8" && variant != "9" && variant != "a" && variant != "b" {
        return Err("${field} must be a UUID")
    }
    Ok(trimmed)
}

fn strip_prefix(s: string, n: int) -> string {
    let mut out = ""
    let mut i = 0
    for ch in strings.chars(s) {
        if i >= n {
            out = "${out}${ch}"
        }
        i = i + 1
    }
    out
}

fn is_hex(s: string) -> bool {
    if strings.len(s) == 0 {
        return false
    }
    for ch in strings.chars(s) {
        if !is_hex_char(ch) {
            return false
        }
    }
    true
}

fn is_hex_char(ch: char) -> bool {
    if ch == '0' { return true }
    if ch == '1' { return true }
    if ch == '2' { return true }
    if ch == '3' { return true }
    if ch == '4' { return true }
    if ch == '5' { return true }
    if ch == '6' { return true }
    if ch == '7' { return true }
    if ch == '8' { return true }
    if ch == '9' { return true }
    if ch == 'a' { return true }
    if ch == 'b' { return true }
    if ch == 'c' { return true }
    if ch == 'd' { return true }
    if ch == 'e' { return true }
    if ch == 'f' { return true }
    if ch == 'A' { return true }
    if ch == 'B' { return true }
    if ch == 'C' { return true }
    if ch == 'D' { return true }
    if ch == 'E' { return true }
    if ch == 'F' { return true }
    false
}

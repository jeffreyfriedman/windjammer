@test
fn test_require_one_of_ok() {
    let mut allowed = Vec::new()
    allowed.push("red")
    allowed.push("blue")
    match require_one_of("color", "blue", allowed) {
        Ok(v) => assert_eq(v, "blue"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_one_of_err() {
    let mut allowed = Vec::new()
    allowed.push("red")
    allowed.push("blue")
    match require_one_of("color", "green", allowed) {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "not allowed"),
    }
}

@test
fn test_all_ok_empty() {
    let errors = Vec::new()
    match all_ok(errors) {
        Ok(_) => assert(true, "ok"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_all_ok_with_errors() {
    let mut errors = Vec::new()
    errors.push("name is required")
    errors.push("age out of range")
    match all_ok(errors) {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => {
            assert(strings.contains(msg, "name is required"), "first err")
            assert(strings.contains(msg, "age out of range"), "second err")
        },
    }
}

@test
fn test_require_url_https_ok() {
    match require_url("home", "https://example.com/path") {
        Ok(v) => assert_eq(v, "https://example.com/path"),
        Err(_) => assert(false, "expected Ok"),
    }
}


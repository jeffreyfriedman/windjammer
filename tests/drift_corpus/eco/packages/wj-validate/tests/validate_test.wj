use std::strings

@test
fn test_require_nonempty_ok() {
    match require_nonempty("name", "Ada") {
        Ok(v) => assert_eq(v, "Ada"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_nonempty_trims() {
    match require_nonempty("name", "  Ada  ") {
        Ok(v) => assert_eq(v, "Ada"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_nonempty_blank_err() {
    match require_nonempty("name", "   ") {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => assert(strings.contains(msg, "name"), "field in error"),
    }
}

@test
fn test_require_min_len_ok() {
    match require_min_len("password", "secret", 6) {
        Ok(v) => assert_eq(v, "secret"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_min_len_err() {
    match require_min_len("password", "hi", 6) {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "too short"),
    }
}


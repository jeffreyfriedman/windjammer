use crate::get_bool
use crate::get_bool_or
use crate::get_int
use crate::get_int_or
use crate::get_str
use crate::get_str_or
use crate::has_path
use crate::is_empty
use crate::require_empty
use crate::is_valid
use crate::require_bool
use crate::require_false
use crate::require_true
use crate::require_int
use crate::require_str
use crate::to_json
use std::strings

@test
fn test_to_json_flat_scalars() {
    let yaml = "name: alice\nage: 30\nactive: true\n"
    match to_json(yaml) {
        Ok(json) => {
            assert_str_contains(json, "\"name\"")
            assert_str_contains(json, "\"alice\"")
            assert_str_contains(json, "\"age\"")
            assert_str_contains(json, "30")
            assert_str_contains(json, "\"active\"")
            assert_str_contains(json, "true")
        },
        Err(_) => assert(false, "parse failed"),
    }
}

@test
fn test_to_json_quoted_string() {
    let yaml = "msg: \"hello: world\"\n"
    match to_json(yaml) {
        Ok(json) => assert_str_contains(json, "hello: world"),
        Err(_) => assert(false, "parse failed"),
    }
}

@test
fn test_get_str_flat() {
    match get_str("name: bob\n", "name") {
        Some(v) => assert_eq(v, "bob"),
        None => assert(false, "expected name"),
    }
}

@test
fn test_get_int_flat() {
    match get_int("port: 8080\n", "port") {
        Some(v) => assert_eq(v, 8080),
        None => assert(false, "expected port"),
    }
}

@test
fn test_get_bool_flat() {
    match get_bool("ok: true\n", "ok") {
        Some(v) => assert(v, "expected true"),
        None => assert(false, "expected ok"),
    }
}

@test
fn test_nested_map_get_str() {
    let yaml = "server:\n  host: localhost\n  port: 8080\n"
    match get_str(yaml, "server.host") {
        Some(v) => assert_eq(v, "localhost"),
        None => assert(false, "expected host"),
    }
}

@test
fn test_nested_map_get_int() {
    let yaml = "server:\n  host: localhost\n  port: 8080\n"
    match get_int(yaml, "server.port") {
        Some(v) => assert_eq(v, 8080),
        None => assert(false, "expected port"),
    }
}

@test
fn test_list_to_json() {
    let yaml = "tags:\n  - red\n  - blue\n"
    match to_json(yaml) {
        Ok(json) => {
            assert_str_contains(json, "\"tags\"")
            assert_str_contains(json, "red")
            assert_str_contains(json, "blue")
        },
        Err(_) => assert(false, "parse failed"),
    }
}

@test
fn test_comments_ignored() {
    let yaml = "# ignore me\nname: carol\n"
    match get_str(yaml, "name") {
        Some(v) => assert_eq(v, "carol"),
        None => assert(false, "expected name"),
    }
}

@test
fn test_null_scalar() {
    let yaml = "x: null\n"
    match to_json(yaml) {
        Ok(json) => assert_str_contains(json, "null"),
        Err(_) => assert(false, "parse failed"),
    }
}

@test
fn test_missing_path() {
    match get_str("a: 1\n", "b") {
        Some(_) => assert(false, "should be missing"),
        None => assert(true, "ok"),
    }
}

@test
fn test_empty_rejected() {
    match to_json("") {
        Ok(_) => assert(false, "empty should fail"),
        Err(_) => assert(true, "ok"),
    }
}

@test
fn test_literal_block_scalar() {
    let yaml = "body: |\n  line one\n  line two\n"
    match get_str(yaml, "body") {
        Some(v) => assert_eq(v, "line one\nline two\n"),
        None => assert(false, "expected body"),
    }
}

@test
fn test_literal_block_preserves_relative_indent() {
    let yaml = "body: |\n  hello\n    world\n"
    match get_str(yaml, "body") {
        Some(v) => assert_eq(v, "hello\n  world\n"),
        None => assert(false, "expected body"),
    }
}

@test
fn test_folded_block_scalar() {
    let yaml = "msg: >\n  hello\n  world\n"
    match get_str(yaml, "msg") {
        Some(v) => assert_eq(v, "hello world\n"),
        None => assert(false, "expected msg"),
    }
}

@test
fn test_literal_block_in_nested_map() {
    let yaml = "doc:\n  note: |\n    alpha\n    beta\n"
    match get_str(yaml, "doc.note") {
        Some(v) => assert_eq(v, "alpha\nbeta\n"),
        None => assert(false, "expected note"),
    }
}

@test
fn test_get_str_or_default() {
    assert_eq(get_str_or("name: bob\n", "name", "anon"), "bob")
    assert_eq(get_str_or("name: bob\n", "missing", "anon"), "anon")
}

@test
fn test_has_path() {
    assert(has_path("server:\n  host: localhost\n", "server.host"), "nested")
    assert(!has_path("server:\n  host: localhost\n", "server.port"), "missing")
    assert(has_path("ok: true\n", "ok"), "flat")
}

@test
fn test_get_int_or_and_get_bool_or() {
    assert_eq(get_int_or("port: 8080\n", "port", 0), 8080)
    assert_eq(get_int_or("port: 8080\n", "missing", 9), 9)
    assert(get_bool_or("ok: true\n", "ok", false), "true")
    assert(!get_bool_or("ok: true\n", "missing", false), "default false")
    assert(get_bool_or("ok: false\n", "missing", true), "default true")
}

@test
fn test_is_valid() {
    assert(is_valid("name: bob\n"), "valid yaml")
    assert(!is_valid(""), "empty rejected")
}

@test
fn test_is_empty_and_require_str() {
    assert(is_empty(""), "empty string")
    assert(is_empty("   \n"), "whitespace only")
    assert(!is_empty("name: bob\n"), "non-empty")
    match require_str("name: bob\n", "name") {
        Ok(v) => assert_eq(v, "bob"),
        Err(_) => assert(false, "require name"),
    }
    match require_str("name: bob\n", "missing") {
        Ok(_) => assert(false, "missing must Err"),
        Err(msg) => assert(strings.contains(msg, "missing"), "mentions path"),
    }
}

@test
fn test_require_int_and_require_bool() {
    let text = "port: 8080\nenabled: true\n"
    match require_int(text, "port") {
        Ok(n) => assert_eq(n, 8080),
        Err(_) => assert(false, "require port"),
    }
    match require_int(text, "missing") {
        Ok(_) => assert(false, "missing int must Err"),
        Err(msg) => assert(strings.contains(msg, "missing"), "mentions path"),
    }
    match require_bool(text, "enabled") {
        Ok(b) => assert(b, "enabled true"),
        Err(_) => assert(false, "require enabled"),
    }
    match require_bool(text, "missing") {
        Ok(_) => assert(false, "missing bool must Err"),
        Err(msg) => assert(strings.contains(msg, "missing"), "mentions path"),
    }
}

@test
fn test_require_valid() {
    use crate::require_valid
    match require_valid("name: bob\n") {
        Ok(text) => assert(strings.contains(text, "bob"), "keeps body"),
        Err(_) => assert(false, "valid"),
    }
    match require_valid("") {
        Ok(_) => assert(false, "empty must Err"),
        Err(msg) => assert(strings.contains(msg, "yaml"), "mentions yaml"),
    }
    match require_valid("   \n") {
        Ok(_) => assert(false, "blank must Err"),
        Err(msg) => assert(strings.contains(msg, "yaml"), "mentions yaml"),
    }
}

@test
fn test_require_true() {
    match require_true("active: true\n", "active") {
        Ok(v) => assert(v, "true"),
        Err(_) => assert(false, "true ok"),
    }
    match require_true("active: false\n", "active") {
        Ok(_) => assert(false, "false must Err"),
        Err(msg) => assert(strings.contains(msg, "true"), "mentions true"),
    }
}

@test
fn test_require_false() {
    match require_false("active: false\n", "active") {
        Ok(v) => assert(!v, "false"),
        Err(_) => assert(false, "false ok"),
    }
    match require_false("active: true\n", "active") {
        Ok(_) => assert(false, "true must Err"),
        Err(msg) => assert(strings.contains(msg, "false"), "mentions false"),
    }
}

@test
fn test_require_empty() {
    match require_empty("   \n") {
        Ok(text) => assert(is_empty(text), "blank"),
        Err(_) => assert(false, "whitespace"),
    }
    match require_empty("name: bob\n") {
        Ok(_) => assert(false, "document must Err"),
        Err(msg) => assert(strings.contains(msg, "empty"), "mentions empty"),
    }
}

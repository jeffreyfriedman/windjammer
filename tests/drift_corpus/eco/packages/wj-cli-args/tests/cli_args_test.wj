use crate::read_argv
use crate::tail
use crate::arg_count
use crate::first_positional
use crate::has_any_long_flag
use crate::has_help_flag
use crate::has_version_flag
use crate::last_positional
use crate::long_flag_count
use crate::nth_positional
use crate::only_program_name
use crate::program_name
use crate::require_first_positional
use crate::require_program
use crate::require_version
use crate::require_long_flag_value
use crate::require_positional_count
use crate::require_argc
use crate::require_long_flags
use crate::require_last_positional
use crate::require_nth
use crate::require_tail
use crate::has_long_flag
use crate::long_flag_value
use crate::long_flag_value_or
use crate::positional_count
use crate::positionals
use std::strings
use std::strings

fn sample_args() -> Vec<string> {
    let mut args = Vec::new()
    args.push("my-app")
    args.push("--verbose")
    args.push("https://example.com")
    args.push("--port=9090")
    args
}

fn test_tail_skips_program_name() {
    let args = sample_args()
    let rest = tail(args)
    assert_eq(rest.len(), 3)
    assert_eq(rest[0], "--verbose")
}

fn test_first_positional_skips_flags() {
    let args = sample_args()
    match first_positional(args) {
        Some(url) => assert_eq(url, "https://example.com"),
        None => assert(false, "expected positional url"),
    }
}

fn test_require_first_positional_errors_with_usage() {
    let mut args = Vec::new()
    args.push("my-app")
    args.push("--verbose")
    match require_first_positional(args, "usage: my-app <url>") {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => assert(msg.len() > 0, "usage message required"),
    }
}

fn test_has_long_flag_detects_bare_flag() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("--verbose")
    assert(has_long_flag(args, "verbose"), "bare --verbose")
}

fn test_long_flag_value_from_equals_form() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("--port=9090")
    match long_flag_value(args, "port") {
        Some(v) => assert_eq(v, "9090"),
        None => assert(false, "expected port value"),
    }
}

fn test_long_flag_value_from_space_form() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("--port")
    args.push("3000")
    match long_flag_value(args, "port") {
        Some(v) => assert_eq(v, "3000"),
        None => assert(false, "expected port after --port"),
    }
}

fn test_positionals_collects_non_flags() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("alpha")
    args.push("--verbose")
    args.push("beta")
    let pos = positionals(args)
    assert_eq(pos.len(), 2)
    assert_eq(pos[0], "alpha")
    assert_eq(pos[1], "beta")
}

fn test_read_argv_includes_program_name() {
    let args = read_argv()
    assert(args.len() > 0, "argv should not be empty")
}

fn test_long_flag_value_or_uses_flag_when_present() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("--host=localhost")
    assert_eq(long_flag_value_or(args, "host", "127.0.0.1"), "localhost")
}

fn test_long_flag_value_or_falls_back_to_default() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("--verbose")
    assert_eq(long_flag_value_or(args, "host", "127.0.0.1"), "127.0.0.1")
}

fn test_positional_count() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("alpha")
    args.push("--verbose")
    args.push("beta")
    assert_eq(positional_count(args), 2)
    let mut empty = Vec::new()
    empty.push("tool")
    empty.push("--verbose")
    assert_eq(positional_count(empty), 0)
}

fn test_nth_positional() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("alpha")
    args.push("--verbose")
    args.push("beta")
    match nth_positional(args, 0) {
        Some(v) => assert_eq(v, "alpha"),
        None => assert(false, "0th"),
    }
    let mut again = Vec::new()
    again.push("tool")
    again.push("alpha")
    again.push("--verbose")
    again.push("beta")
    match nth_positional(again, 1) {
        Some(v) => assert_eq(v, "beta"),
        None => assert(false, "1st"),
    }
    let mut miss = Vec::new()
    miss.push("tool")
    miss.push("alpha")
    match nth_positional(miss, 5) {
        Some(_) => assert(false, "oob"),
        None => {},
    }
}

fn test_require_long_flag_value() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("--port=9090")
    match require_long_flag_value(args, "port", "usage: --port <n>") {
        Ok(v) => assert_eq(v, "9090"),
        Err(_) => assert(false, "port present"),
    }
    let mut missing = Vec::new()
    missing.push("tool")
    missing.push("--verbose")
    match require_long_flag_value(missing, "port", "usage: --port <n>") {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => assert(strings.contains(msg, "port"), "usage mentions port"),
    }
}

fn test_last_positional_and_has_any_long_flag() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("alpha")
    args.push("--verbose")
    args.push("beta")
    match last_positional(args) {
        Some(v) => assert_eq(v, "beta"),
        None => assert(false, "last"),
    }
    let mut flags = Vec::new()
    flags.push("tool")
    flags.push("--verbose")
    flags.push("--port=1")
    assert(has_any_long_flag(flags), "has flags")
    let mut bare = Vec::new()
    bare.push("tool")
    bare.push("only")
    assert(!has_any_long_flag(bare), "no flags")
}

fn test_has_positionals_and_long_flag_count() {
    let mut args = Vec::new()
    args.push("tool")
    args.push("alpha")
    args.push("--verbose")
    args.push("--port=1")
    assert_eq(long_flag_count(args), 2)
    let mut flags_only = Vec::new()
    flags_only.push("tool")
    flags_only.push("--verbose")
    assert_eq(long_flag_count(flags_only), 1)
}

fn test_arg_count_empty_and_only_program() {
    assert_eq(arg_count(Vec::new()), 0)
    let mut prog = Vec::new()
    prog.push("tool")
    assert(only_program_name(prog), "only prog")
    assert_eq(arg_count(sample_args()), 4)
    assert(!only_program_name(sample_args()), "has more")
}

fn test_help_version_and_require_positional_count() {
    let mut help_args = Vec::new()
    help_args.push("tool")
    help_args.push("--help")
    assert(has_help_flag(help_args), "help")
    assert(!has_version_flag(help_args), "not version")
    let mut ver_args = Vec::new()
    ver_args.push("tool")
    ver_args.push("--version")
    assert(has_version_flag(ver_args), "version")
    assert(!has_help_flag(ver_args), "not help")
    match require_positional_count(sample_args(), 1) {
        Ok(n) => assert_eq(n, 1),
        Err(_) => assert(false, "enough positionals"),
    }
    match require_positional_count(sample_args(), 2) {
        Ok(_) => assert(false, "too few must Err"),
        Err(msg) => assert(strings.contains(msg, "positional"), "mentions positional"),
    }
}

fn test_require_program() {
    match require_program(sample_args()) {
        Ok(name) => assert_eq(name, "my-app"),
        Err(_) => assert(false, "program present"),
    }
    match require_program(Vec::new()) {
        Ok(_) => assert(false, "empty must Err"),
        Err(msg) => assert(strings.contains(msg, "program"), "mentions program"),
    }
}

fn test_require_version() {
    let mut ver_args = Vec::new()
    ver_args.push("my-app")
    ver_args.push("--version")
    match require_version(ver_args) {
        Ok(n) => assert_eq(n, 2),
        Err(_) => assert(false, "version flag"),
    }
    match require_version(sample_args()) {
        Ok(_) => assert(false, "no version must Err"),
        Err(msg) => assert(strings.contains(msg, "version"), "mentions version"),
    }
}

fn test_require_argc() {
    match require_argc(sample_args(), 4) {
        Ok(n) => assert_eq(n, 4),
        Err(_) => assert(false, "four args"),
    }
    match require_argc(sample_args(), 1) {
        Ok(_) => assert(false, "four must Err"),
        Err(msg) => assert(strings.contains(msg, "argc"), "mentions argc"),
    }
}

fn test_require_long_flags() {
    match require_long_flags(sample_args(), 2) {
        Ok(n) => assert_eq(n, 2),
        Err(_) => assert(false, "two long flags"),
    }
    match require_long_flags(sample_args(), 0) {
        Ok(_) => assert(false, "flags must Err"),
        Err(msg) => assert(strings.contains(msg, "long"), "mentions long"),
    }
}

fn test_require_last_positional() {
    match require_last_positional(sample_args()) {
        Ok(url) => assert_eq(url, "https://example.com"),
        Err(_) => assert(false, "url"),
    }
    let mut bare = Vec::new()
    bare.push("tool")
    match require_last_positional(bare) {
        Ok(_) => assert(false, "program only must Err"),
        Err(msg) => assert(strings.contains(msg, "last"), "mentions last"),
    }
}

fn test_require_nth() {
    match require_nth(sample_args(), 0) {
        Ok(url) => assert_eq(url, "https://example.com"),
        Err(_) => assert(false, "first positional"),
    }
    match require_nth(sample_args(), 3) {
        Ok(_) => assert(false, "missing must Err"),
        Err(msg) => assert(strings.contains(msg, "nth"), "mentions nth"),
    }
}

fn test_require_tail() {
    match require_tail(sample_args(), 3) {
        Ok(n) => assert_eq(n, 3),
        Err(_) => assert(false, "three tail tokens"),
    }
    match require_tail(sample_args(), 0) {
        Ok(_) => assert(false, "tail must Err"),
        Err(msg) => assert(strings.contains(msg, "tail"), "mentions tail"),
    }
}

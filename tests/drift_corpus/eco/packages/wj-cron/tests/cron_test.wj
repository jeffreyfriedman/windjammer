fn test_parse_alias_annually_same_as_yearly() {
    match parse_cron("@annually") {
        Ok(expr) => {
            assert_eq(expr.minute, "0")
            assert_eq(expr.hour, "0")
            assert_eq(expr.day_of_month, "1")
            assert_eq(expr.month, "1")

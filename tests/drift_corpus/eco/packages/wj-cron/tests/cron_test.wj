fn test_parse_unknown_alias_fails() {
    let result = parse_cron("@reboot")
    assert(result.is_err(), "@reboot is not a schedule expression")
}

// --- range with step ---

fn test_matches_range_with_step() {
    assert(matches_field("1-10/2", 1), "1-10/2 matches 1")
    assert(matches_field("1-10/2", 3), "1-10/2 matches 3")
    assert(matches_field("1-10/2", 9), "1-10/2 matches 9")
    assert(!matches_field("1-10/2", 2), "1-10/2 does not match 2")
    assert(!matches_field("1-10/2", 10), "1-10/2 does not match 10 (out of step)")
    assert(!matches_field("1-10/2", 0), "1-10/2 does not match 0")
    assert(!matches_field("1-10/2", 11), "1-10/2 does not match 11")
}

fn test_matches_cron_range_step_minutes() {
    match parse_cron("10-20/5 * * * *") {
        Ok(expr) => {
            assert(matches_cron(expr, 10, 0, 1, 1, 0), "minute 10")
            assert(matches_cron(expr, 15, 0, 1, 1, 0), "minute 15")
            assert(matches_cron(expr, 20, 0, 1, 1, 0), "minute 20")
            assert(!matches_cron(expr, 12, 0, 1, 1, 0), "minute 12 off step")
        },
        Err(_e) => assert(false, "should parse range/step cron"),
    }
}

fn test_every_minute_format_and_wildcard() {
    assert(is_wildcard_field("*"), "star")
    assert(!is_wildcard_field("*/5"), "step not pure wildcard")
    let expr = every_minute()
    assert_eq(format_cron(expr), "* * * * *")
    assert(matches_cron(expr, 0, 0, 1, 1, 0), "any minute")
    assert(matches_cron(expr, 59, 23, 31, 12, 6), "any time")
}

fn test_every_hour_and_is_every_minute() {
    let hourly = every_hour()
    assert_eq(format_cron(hourly), "0 * * * *")
    assert(matches_cron(hourly, 0, 5, 1, 1, 0), "top of hour")
    assert(!matches_cron(hourly, 1, 5, 1, 1, 0), "not minute 1")
}

fn test_is_every_hour_and_source_of() {
    let hourly = every_hour()
    assert_eq(source_of(hourly), "0 * * * *")
    match parse_cron("@daily") {
        Ok(expr) => assert_eq(source_of(expr), "@daily"),
        Err(_) => assert(false, "parse @daily"),
    }
}

fn test_every_day_and_require_cron() {
    let daily = every_day()
    assert_eq(format_cron(daily), "0 0 * * *")
    match require_cron("*/5 * * * *") {
        Ok(expr) => assert_eq(format_cron(expr), "*/5 * * * *"),
        Err(_) => assert(false, "valid cron"),
    }
    match require_cron("not a cron") {
        Ok(_) => assert(false, "invalid must Err"),
        Err(msg) => assert(strings.contains(msg, "cron"), "mentions cron"),
    }
}

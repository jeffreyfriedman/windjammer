use crate::Sender
use crate::Receiver
use crate::unbounded_int
use crate::send_int
use crate::recv
use crate::clone_sender
use crate::try_recv

@test
fn test_generic_int_roundtrip() {
    let pair = unbounded_int()
    let _ = send_int(pair.0, 7)
    let got = recv(pair.1)
    match got.1 {
        Some(v) => assert_eq(v, 7),
        None => assert(false, "missing value"),
    }
}

@test
fn test_generic_clone_sender_fanout() {
    let pair = unbounded_int()
    let txs = clone_sender(pair.0)
    let _ = send_int(txs.0, 1)
    let _ = send_int(txs.1, 2)
    let a = recv(pair.1)
    let b = recv(a.0)
    let mut sum = 0
    match a.1 {
        Some(v) => sum = sum + v,
        None => {}
    }
    match b.1 {
        Some(v) => sum = sum + v,
        None => {}
    }
    assert_eq(sum, 3)
}

@test
fn test_generic_try_recv_empty() {
    let pair = unbounded_int()
    let got = try_recv(pair.1)
    assert_eq(got.1, false)
}

use crate::Shared
use crate::SharedMap
use crate::shared_new
use crate::shared_set
use crate::shared_int
use crate::shared_int_add
use crate::shared_int_get
use crate::shared_map_new
use crate::shared_map_insert
use crate::shared_map_get
use crate::shared_map_has
use crate::shared_map_len

@test
fn test_shared_new_set_int() {
    assert_eq(shared_int_get(shared_set(shared_new(10), 20)), 20)
}

@test
fn test_shared_int_alias_add() {
    let s = shared_int_add(shared_int_add(shared_int(0), 3), 4)
    assert_eq(shared_int_get(s), 7)
}

@test
fn test_shared_map_generic_surface() {
    let m = shared_map_insert(shared_map_insert(shared_map_new(), "a", 1), "b", 2)
    assert_eq(shared_map_len(m), 2)
    assert(shared_map_has(m, "a"), "has a")
    let got = shared_map_get(m, "b")
    assert(got.1, "present")
    assert_eq(got.2, 2)
}

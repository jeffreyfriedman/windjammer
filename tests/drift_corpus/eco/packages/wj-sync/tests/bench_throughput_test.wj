use crate::channel_sum_range
use crate::counter_get
use crate::counter_inc
use crate::counter_new
use crate::pool_shared_inbox_sum
use crate::shared_int
use crate::shared_int_add
use crate::shared_int_get
use std::time

/// Larger wall-clock benches (vs `benches/rust_baseline`). Soft ceiling only —
/// fair ≤1.2× ratios require `benches/run_release.sh` (release+LTO).
/// Annotate `n: int` so void/`@test` i32-coord demotion does not mix with i64 APIs.
@test
fn test_bench_channel_sum_100k() {
    let n: int = 100_000
    let start = time.utc_now().timestamp_millis()
    let out = channel_sum_range(n)
    let end = time.utc_now().timestamp_millis()
    let elapsed = end - start
    assert_eq(out.0, n)
    assert_eq(out.1, n * (n - 1) / 2)
    assert(elapsed < 30_000, "channel_sum_range(100k) too slow")
    println("wj_channel_sum n={} elapsed_ms={}", n, elapsed)
}

@test
fn test_bench_shared_incs_100k() {
    let n: int = 100_000
    let start = time.utc_now().timestamp_millis()
    let mut s = shared_int(0)
    let mut i: int = 0
    while i < n {
        s = shared_int_add(s, 1)
        i = i + 1
    }
    let end = time.utc_now().timestamp_millis()
    let elapsed = end - start
    assert_eq(shared_int_get(s), n)
    assert(elapsed < 30_000, "shared_int 100k incs too slow")
    println("wj_shared_incs n={} elapsed_ms={}", n, elapsed)
}

@test
fn test_bench_counter_incs_100k() {
    let n: int = 100_000
    let start = time.utc_now().timestamp_millis()
    let c = counter_new(0)
    let mut i: int = 0
    while i < n {
        counter_inc(c)
        i = i + 1
    }
    let end = time.utc_now().timestamp_millis()
    let elapsed = end - start
    assert_eq(counter_get(c), n)
    assert(elapsed < 30_000, "counter 100k incs too slow")
    println("wj_counter_incs n={} elapsed_ms={}", n, elapsed)
}

@test
fn test_bench_pool_shared_inbox_5k() {
    let n: int = 5_000
    let start = time.utc_now().timestamp_millis()
    let out = pool_shared_inbox_sum(4, n)
    let end = time.utc_now().timestamp_millis()
    let elapsed = end - start
    assert_eq(out.0, n)
    assert_eq(out.1, n * (n - 1))
    assert(elapsed < 30_000, "pool_shared_inbox_sum(5k) too slow")
    println("wj_pool_shared_inbox n={} workers=4 elapsed_ms={}", n, elapsed)
}

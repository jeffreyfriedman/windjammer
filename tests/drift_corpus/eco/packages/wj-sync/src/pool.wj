// Worker pool — Channel + parallel workers (int-specialized jobs).
// Shared-inbox uses Arc+Mutex around the job receiver (same boundary as Shared*).

use std::sync::mpsc

use crate::shared::SharedInt
use crate::shared::shared_int
use crate::shared::shared_int_get

/// Fixed-size int worker pool.
pub struct Pool {
    workers: int,
    alive: SharedInt,
}

/// Create a pool with `workers` OS threads.
pub fn pool_new(workers: int) -> Pool {
    let n = if workers < 1 { 1 } else { workers }
    Pool {
        workers: n,
        alive: shared_int(1),
    }
}

/// Run jobs `0..n`, each doubled on a worker; returns results (unordered OK for sum).
pub fn pool_run_double(pool: Pool, n: int) -> Vec<int> {
    let _ = pool.workers
    let results = mpsc::channel()
    let res_tx = results.0
    let res_rx = results.1

    let mut i: int = 0
    while i < n {
        let tx = res_tx.clone()
        let v = i
        std::thread::spawn(|| {
            match tx.send(v * 2) {
                Ok(_) => {}
                Err(_) => {}
            }
        })
        i = i + 1
    }

    let mut out: Vec<int> = Vec::new()
    let mut got: int = 0
    while got < n {
        match res_rx.recv() {
            Ok(v) => {
                out.push(v)
                got = got + 1
            }
            Err(_) => {
                break
            }
        }
    }
    out
}

/// Shared-inbox: `workers` OS threads each own a job receiver (round-robin fan-out).
/// Matches the Rust baseline shape without Mutex-serializing `recv`. Returns `(n, sum of doubles)`.
pub fn pool_shared_inbox_sum(workers: int, n: int) -> (int, int) {
    let n_workers = if workers < 1 { 1 } else { workers }
    let results = mpsc::channel()
    let res_tx = results.0
    let res_rx = results.1

    let mut job_txs: Vec<mpsc::Sender<int>> = Vec::new()
    let mut w: int = 0
    while w < n_workers {
        let jobs = mpsc::channel()
        let job_tx = jobs.0
        let job_rx = jobs.1
        job_txs.push(job_tx)
        let tx = res_tx.clone()
        std::thread::spawn(move || {
            while true {
                match job_rx.recv() {
                    Ok(v) => {
                        if v < 0 {
                            break
                        }
                        match tx.send(v * 2) {
                            Ok(_) => {}
                            Err(_) => {
                                break
                            },
                        }
                    },
                    Err(_) => {
                        break
                    },
                }
            }
        })
        w = w + 1
    }
    drop(res_tx)

    let mut i: int = 0
    while i < n {
        let idx = (i % n_workers) as int
        match job_txs.get(idx) {
            Some(tx) => {
                match tx.send(i) {
                    Ok(_) => {}
                    Err(_) => {}
                }
            }
            None => {}
        }
        i = i + 1
    }
    let mut w2: int = 0
    while w2 < n_workers {
        match job_txs.get(w2) {
            Some(tx) => {
                match tx.send(-1) {
                    Ok(_) => {}
                    Err(_) => {}
                }
            }
            None => {}
        }
        w2 = w2 + 1
    }
    drop(job_txs)

    let mut sum: int = 0
    let mut got: int = 0
    while got < n {
        match res_rx.recv() {
            Ok(v) => {
                sum = sum + v
                got = got + 1
            }
            Err(_) => {
                break
            }
        }
    }
    (n, sum)
}

/// Create a pool, double `0..n` on workers, return `(count, sum)`.
pub fn pool_sum_double(workers: int, n: int) -> (int, int) {
    let pool = pool_new(workers)
    let results = pool_run_double(pool, n)
    let mut sum: int = 0
    for v in results {
        sum = sum + v
    }
    (n, sum)
}

/// Mark pool shut down (idempotent).
pub fn pool_shutdown(pool: Pool) -> Pool {
    Pool {
        workers: pool.workers,
        alive: shared_int(0),
    }
}

/// Returns `(pool, alive)` — alive is false after shutdown.
pub fn pool_is_alive(pool: Pool) -> (Pool, bool) {
    let n = shared_int_get(pool.alive)
    let alive = n != 0
    let restored = Pool {
        workers: pool.workers,
        alive: shared_int(if alive { 1 } else { 0 }),
    }
    (restored, alive)
}

@test
fn test_get_or_and_has() {
    let text = "host = \"localhost\"\n"
    assert_eq(get_or(text, "host", "127.0.0.1"), "localhost")
    assert_eq(get_or(text, "port", "8080"), "8080")
    assert(has(text, "host"), "has host")
    assert(!has(text, "port"), "no port")
}

@test
fn test_is_empty_and_key_count() {
    assert(is_empty(""), "empty text")
    assert(is_empty("# only comment\n"), "comments only")
    let text = "host = \"localhost\"\nport = 8080\n"
    assert(!is_empty(text), "nonempty")
    assert_eq(key_count(text), 2)
    assert_eq(key_count(""), 0)
}

@test
fn test_keys_contains_parsed_names() {
    let text = "host = \"localhost\"\nport = 8080\n"
    let ks = keys(text)
    assert_eq(ks.len(), 2)
    let mut saw_host = false
    let mut saw_port = false
    let mut i = 0
    while i < ks.len() {
        if ks[i] == "host" {
            saw_host = true
        }
        if ks[i] == "port" {
            saw_port = true
        }
        i = i + 1
    }
    assert(saw_host, "host key")
    assert(saw_port, "port key")
}

@test
fn test_require_and_values() {
    let text = "host = \"localhost\"\nport = 8080\n"
    match require(text, "host") {
        Ok(v) => assert_eq(v, "localhost"),
        Err(_) => assert(false, "require host"),
    }
    match require(text, "missing") {
        Ok(_) => assert(false, "missing"),
        Err(msg) => assert(strings.contains(msg, "missing"), "err"),
    }
    let vals = values(text)
    assert_eq(vals.len(), 2)
}

@test
fn test_merge_overlay_wins() {
    let base = "host = \"localhost\"\nport = 8080\n"
    let overlay = "port = 9090\ndebug = true\n"
    let merged = merge(base, overlay)
    assert_eq(get_or(merged, "host", ""), "localhost")
    assert_eq(get_or(merged, "port", ""), "9090")
    assert_eq(get_or(merged, "debug", ""), "true")
    assert_eq(key_count(merged), 3)
}

@test
fn test_has_keys_and_first_key() {
    assert(has_keys("host = \"localhost\"\n"), "has")
    assert(!has_keys(""), "empty")
    match first_key("host = \"localhost\"\n") {
        Some(k) => assert_eq(k, "host"),
        None => assert(false, "first"),
    }
    match first_key("") {
        Some(_) => assert(false, "none"),
        None => {},
    }
}

@test
fn test_last_key_value_count_and_singleton() {
    let text = "host = \"localhost\"\nport = 8080\n"
    match last_key("solo = \"x\"\n") {
        Some(k) => assert_eq(k, "solo"),
        None => assert(false, "last solo"),
    }
    match last_key("") {
        Some(_) => assert(false, "empty"),
        None => {},
    }
    match last_key(text) {
        Some(k) => assert(k == "host" || k == "port", "one of keys"),
        None => assert(false, "last multi"),
    }
    assert_eq(value_count(text), 2)
    assert(is_singleton("host = \"localhost\"\n"), "one")
    assert(!is_singleton(text), "two")
    assert(!is_singleton(""), "empty")
}

@test
fn test_require_singleton_and_require_keys() {
    match require_singleton("host = \"localhost\"\n") {
        Ok(k) => assert_eq(k, "host"),
        Err(_) => assert(false, "singleton"),
    }
    match require_singleton("host = \"localhost\"\nport = 8080\n") {
        Ok(_) => assert(false, "two must Err"),
        Err(msg) => assert(strings.contains(msg, "singleton"), "mentions singleton"),
    }
    match require_keys("host = \"localhost\"\nport = 8080\n") {
        Ok(n) => assert_eq(n, 2),
        Err(_) => assert(false, "two keys"),
    }
    match require_keys("") {
        Ok(_) => assert(false, "empty must Err"),
        Err(msg) => assert(strings.contains(msg, "keys"), "mentions keys"),
    }
}

@test
fn test_require_nonblank() {
    use crate::require_nonblank
    match require_nonblank("host = \"localhost\"\n", "host") {
        Ok(v) => assert_eq(v, "localhost"),
        Err(_) => assert(false, "host"),
    }
    match require_nonblank("host = \"\"\n", "host") {
        Ok(_) => assert(false, "blank must Err"),
        Err(msg) => assert(strings.contains(msg, "blank"), "mentions blank"),
    }
    match require_nonblank("host = \"localhost\"\n", "port") {
        Ok(_) => assert(false, "missing must Err"),
        Err(msg) => assert(strings.contains(msg, "port"), "mentions key"),
    }
}

@test
fn test_require_empty() {
    match require_empty("") {
        Ok(n) => assert_eq(n, 0),
        Err(_) => assert(false, "empty"),
    }
    match require_empty("host = \"localhost\"\n") {
        Ok(_) => assert(false, "keys must Err"),
        Err(msg) => assert(strings.contains(msg, "empty"), "mentions empty"),
    }
}

@test
fn test_require_first_key() {
    match require_first_key("host = \"localhost\"\n") {
        Ok(k) => assert_eq(k, "host"),
        Err(_) => assert(false, "first key"),
    }
    match require_first_key("") {
        Ok(_) => assert(false, "empty must Err"),
        Err(msg) => assert(strings.contains(msg, "first"), "mentions first"),
    }
}

@test
fn test_require_last_key() {
    match require_last_key("host = \"localhost\"\n") {
        Ok(k) => assert_eq(k, "host"),
        Err(_) => assert(false, "last key"),
    }
    match require_last_key("") {

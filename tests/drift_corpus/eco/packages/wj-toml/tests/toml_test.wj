@test
fn test_require_values() {
    match require_values("host = \"localhost\"\n", 1) {
        Ok(n) => assert_eq(n, 1),
        Err(_) => assert(false, "one value"),
    }
    match require_values("host = \"localhost\"\n", 2) {
        Ok(_) => assert(false, "one must Err"),
        Err(msg) => assert(strings.contains(msg, "values"), "mentions values"),
    }
}

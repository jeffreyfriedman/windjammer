fn test_require_empty_tree() {
    let empty_root = "/tmp/wj-fs-walk-empty-require-tree"
    match fs.create_dir_all(empty_root) {
        Ok(_) => {},
        Err(_) => assert(false, "create empty"),
    }
    match require_empty_tree(empty_root) {
        Ok(n) => assert_eq(n, 0),
        Err(e) => assert(false, "empty tree: ${e}"),
    }
    teardown_tree(empty_root)
    let root = "/tmp/wj-fs-walk-tree-require-empty"
    match setup_tree(root) {
        Ok(_) => {},
        Err(e) => assert(false, "setup failed: ${e}"),
    }
    match require_empty_tree(root) {
        Ok(_) => assert(false, "tree must Err"),
        Err(msg) => assert(strings.contains(msg, "empty"), "mentions empty"),
    }
    teardown_tree(root)
}

fn test_require_hidden() {
    match require_hidden(".git") {
        Ok(name) => assert(is_hidden_name(name), "hidden"),
        Err(_) => assert(false, "dotfile"),
    }
    match require_hidden("git") {
        Ok(_) => assert(false, "plain must Err"),
        Err(msg) => assert(strings.contains(msg, "hidden"), "mentions hidden"),
    }
}


use crate::domain::AuthApp
use crate::domain::AuthConfig
use crate::domain::format_access_log
use crate::domain::gzip_decode_body
use std::strings

fn default_config() -> AuthConfig {
    AuthConfig {
        jwt_secret: "test-secret",
        jwt_ttl_secs: 3600,
        tenant_slug: "default",
        allowed_origins: allowed_one(),
        rate_limit: 0,
        window_ms: 60_000,
        max_username_len: 64,
        min_password_len: 8,
        max_password_len: 128,
        log_level: "info",
    }
}

fn config_with_tenant(tenant: string) -> AuthConfig {
    AuthConfig {
        jwt_secret: "test-secret",
        jwt_ttl_secs: 3600,
        tenant_slug: tenant,
        allowed_origins: allowed_one(),
        rate_limit: 0,
        window_ms: 60_000,
        max_username_len: 64,
        min_password_len: 8,
        max_password_len: 128,
        log_level: "info",
    }
}

fn allowed_one() -> Vec<string> {
    let mut out = Vec::new()
    out.push("https://app.example.com")
    out
}

fn token_from_body(body: string) -> string {
    json_string_field(body, "token")
}

fn json_string_field(body: string, key: string) -> string {
    let marker = "\"${key}\":\""
    let mut i = 0
    let n = strings.len(body)
    let marker_len = strings.len(marker)
    while i + marker_len <= n {
        if strings.substring(body, i, i + marker_len) == marker {
            let start = i + marker_len
            let mut out = ""
            let mut j = start
            while j < n {
                let ch = strings.substring(body, j, j + 1)
                if ch == "\"" {
                    return out
                }
                out = "${out}${ch}"
                j = j + 1
            }
            return ""
        }
        i = i + 1
    }
    ""
}

fn test_health_returns_ok() {
    let app = AuthApp::new(default_config())
    let reply = app.handle("GET", "/health", "", "", "", "", "", 0, "")
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "ok")
    assert_str_contains(reply.content_type, "application/json")
}

fn test_health_accepts_path_without_leading_slash() {
    let app = AuthApp::new(default_config())
    let reply = app.handle("GET", "health", "", "", "", "", "", 0, "")
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "ok")
}

fn test_register_accepts_trailing_slash_via_router() {
    let mut app = AuthApp::new(default_config())
    let reply = app.handle(
        "POST",
        "/register/",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"slashuser\",\"password\":\"password1\"}",
    )
    assert_eq(reply.status, 201)
    assert_str_contains(reply.body, "slashuser")
    assert_str_contains(reply.content_type, "application/json")
}

fn test_welcome_page_uses_html_content_type() {
    let app = AuthApp::new(default_config())
    let reply = app.handle("GET", "/", "", "", "", "", "", 0, "")
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "<html")
    assert_str_contains(reply.content_type, "text/html")
}

fn test_format_access_log_line() {
    let line = format_access_log("GET", "/health", 200)
    assert_eq(line, "[auth] GET /health -> 200")
    let err_line = format_access_log("POST", "/login", 401)
    assert_eq(err_line, "[auth] POST /login -> 401")
}

fn test_register_rejects_empty_username() {
    let mut app = AuthApp::new(default_config())
    let reply = app.handle(
        "POST",
        "/register",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"\",\"password\":\"password1\"}",
    )
    assert_eq(reply.status, 400)
    assert_str_contains(reply.body, "username")
}

fn test_register_slugifies_username() {
    let mut app = AuthApp::new(default_config())
    let reply = app.handle(
        "POST",
        "/register",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"Carl User\",\"password\":\"password1\"}",
    )
    assert_eq(reply.status, 201)
    assert_str_contains(reply.body, "\"username\":\"carl-user\"")
    assert(!strings.contains(reply.body, "Carl User"), "raw display name not stored")
}

fn test_login_accepts_display_name_matching_slug() {
    let mut app = AuthApp::new(default_config())
    let reg = app.handle(
        "POST",
        "/register",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"Hello World\",\"password\":\"password1\"}",
    )
    assert_eq(reg.status, 201)
    assert_str_contains(reg.body, "hello-world")
    let login = app.handle(
        "POST",
        "/login",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"Hello World\",\"password\":\"password1\"}",
    )
    assert_eq(login.status, 200)
    assert(strings.len(token_from_body(login.body)) > 0, "token")
}


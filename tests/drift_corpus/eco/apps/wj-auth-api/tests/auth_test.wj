fn test_security_headers_on_json_response() {
    let app = AuthApp::new(default_config())
    let reply = app.handle("GET", "/health", "", "", "", "", "", 0, "")
    assert_eq(reply.status, 200)
    assert_str_contains(reply.extra_headers, "X-Frame-Options")
    assert_str_contains(reply.extra_headers, "X-Content-Type-Options")
    assert_str_contains(reply.extra_headers, "Referrer-Policy")
}

fn test_security_headers_on_options_preflight() {
    let app = AuthApp::new(default_config())
    let reply = app.handle(
        "OPTIONS",
        "/login",
        "https://app.example.com",
        "",
        "",
        "",
        "",
        0,
        "",
    )
    assert_eq(reply.status, 204)
    assert_str_contains(reply.extra_headers, "X-Frame-Options")
    assert_str_contains(reply.extra_headers, "X-Content-Type-Options")
}

fn test_rate_limit_includes_security_headers() {
    let mut config = default_config()
    config.rate_limit = 1
    config.window_ms = 60_000
    let mut app = AuthApp::new(config)
    let _ = app.handle(
        "POST",
        "/register",
        "",
        "",
        "",
        "",
        "ip-sec",
        1000,
        "{\"username\":\"secuser\",\"password\":\"password1\"}",
    )
    let _ = app.handle(
        "POST",
        "/login",
        "",
        "",
        "",
        "",
        "ip-sec",
        1000,
        "{\"username\":\"secuser\",\"password\":\"password1\"}",
    )
    let blocked = app.handle(
        "POST",
        "/login",
        "",
        "",
        "",
        "",
        "ip-sec",
        1000,
        "{\"username\":\"secuser\",\"password\":\"password1\"}",
    )
    assert_eq(blocked.status, 429)
    assert_str_contains(blocked.extra_headers, "Retry-After")
    assert_str_contains(blocked.extra_headers, "X-Frame-Options")
}

fn test_register_and_login_returns_jwt() {
    let mut app = AuthApp::new(default_config())
    let reg = app.handle(
        "POST",
        "/register",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"ada\",\"password\":\"secret123\"}",
    )
    assert_eq(reg.status, 201)
    assert_str_contains(reg.body, "\"id\"")
    assert_str_contains(reg.body, "ada")
    let login = app.handle(
        "POST",
        "/login",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"ada\",\"password\":\"secret123\"}",
    )
    assert_eq(login.status, 200)
    assert_str_contains(login.body, "token")
}

fn test_register_assigns_uuid_v7_id() {
    let mut app = AuthApp::new(default_config())
    let reg = app.handle(
        "POST",
        "/register",
        "",
        "",
        "",
        "",
        "",
        0,
        "{\"username\":\"v7user\",\"password\":\"secret123\"}",
    )
    assert_eq(reg.status, 201)
    let id = json_string_field(reg.body, "id")
    assert(strings.len(id) == 36, "uuid length")
    assert(strings.substring(id, 14, 15) == "7", "version nibble must be 7")
    let variant = strings.substring(id, 19, 20)
    let ok = variant == "8" || variant == "9" || variant == "a" || variant == "b"
    assert(ok, "RFC variant nibble")
}


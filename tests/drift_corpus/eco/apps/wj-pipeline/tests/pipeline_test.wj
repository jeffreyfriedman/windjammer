use std::strings
use crate::adapters::run::run_int_pipeline
use crate::adapters::run::run_pool_pipeline
use crate::domain::pipeline::Job
use crate::domain::pipeline::JobResult
use crate::domain::pipeline::find_result_by_id
use crate::domain::pipeline::max_result_value
use crate::domain::pipeline::min_result_value
use crate::domain::pipeline::require_by_id
use crate::domain::pipeline::require_only_result
use crate::domain::pipeline::result_count
use crate::domain::pipeline::sum_results
use crate::domain::pipeline::transform

@test
fn test_transform_doubles() {
    let r = transform(Job { id: 1, payload: 5 })
    assert_eq(r.id, 1)
    assert_eq(r.value, 10)
}

@test
fn test_sum_results() {
    let mut rs: Vec<JobResult> = Vec::new()
    rs.push(transform(Job { id: 0, payload: 2 }))
    rs.push(transform(Job { id: 1, payload: 3 }))
    assert_eq(sum_results(rs), 10)
}

fn sample_results() -> Vec<JobResult> {
    let mut rs: Vec<JobResult> = Vec::new()
    rs.push(transform(Job { id: 0, payload: 2 }))
    rs.push(transform(Job { id: 1, payload: 3 }))
    rs.push(transform(Job { id: 2, payload: 1 }))
    rs
}

@test
fn test_result_helpers() {
    assert_eq(result_count(sample_results()), 3)
    assert_eq(max_result_value(sample_results()), 6)
    assert_eq(max_result_value(Vec::new()), 0)
    match find_result_by_id(sample_results(), 1) {
        Some(r) => assert_eq(r.value, 6),
        None => assert(false, "find 1"),
    }
    match find_result_by_id(sample_results(), 9) {
        Some(_) => assert(false, "missing"),
        None => {},
    }
}

@test
fn test_min_result_and_has_results() {
    assert_eq(min_result_value(sample_results()), 2)
    assert_eq(min_result_value(Vec::new()), 0)
}

@test
fn test_run_int_pipeline() {
    let out = run_int_pipeline(5)
    assert_eq(out.0, 5)
    // payloads 0..4 doubled → 0+2+4+6+8 = 20
    assert_eq(out.1, 20)
}

@test
fn test_only_result_and_require_results() {
    use crate::domain::pipeline::only_result
    use crate::domain::pipeline::require_results
    let empty: Vec<JobResult> = Vec::new()
    match require_results(empty) {
        Ok(_) => assert(false, "empty must Err"),
        Err(msg) => assert(strings.contains(msg, "results"), "mentions results"),
    }
    match require_results(sample_results()) {
        Ok(n) => assert_eq(n, 3),
        Err(_) => assert(false, "sample results"),
    }
    let one = transform(Job { id: 7, payload: 4 })
    let mut solo: Vec<JobResult> = Vec::new()
    solo.push(one)
    match only_result(solo) {
        Some(r) => assert_eq(r.value, 8),
        None => assert(false, "one result"),
    }
    match only_result(sample_results()) {
        Some(_) => assert(false, "three is not only"),
        None => {},
    }
}

fn test_require_only_result() {
    let one = transform(Job { id: 7, payload: 4 })
    let mut solo: Vec<JobResult> = Vec::new()
    solo.push(one)
    match require_only_result(solo) {
        Ok(r) => assert_eq(r.value, 8),
        Err(_) => assert(false, "one result"),
    }
    match require_only_result(sample_results()) {
        Ok(_) => assert(false, "three must Err"),
        Err(msg) => assert(strings.contains(msg, "one"), "mentions one"),
    }
}

fn test_require_by_id() {
    match require_by_id(sample_results(), 1) {
        Ok(r) => assert_eq(r.value, 6),
        Err(_) => assert(false, "id 1"),
    }
    match require_by_id(sample_results(), 9) {
        Ok(_) => assert(false, "missing must Err"),
        Err(msg) => assert(strings.contains(msg, "result"), "mentions result"),
    }
}

@test
fn test_run_pool_pipeline() {
    let out = run_pool_pipeline(5)
    assert_eq(out.0, 5)
    // pool doubles 0..4 → sum 20
    assert_eq(out.1, 20)
}

fn test_url_from_argv_timeout_overrides_config() {
    let mut argv = Vec::new()
    argv.push("wj-fetch")
    argv.push("--timeout=2")
    argv.push("https://example.com/api")
    let mut config = FetchConfig::defaults()
    config.timeout_secs = 30
    match url_from_argv(argv, config) {
        Ok(req) => assert_eq(req.timeout_secs, 2),
        Err(_) => assert(false, "expected Ok"),
    }
}

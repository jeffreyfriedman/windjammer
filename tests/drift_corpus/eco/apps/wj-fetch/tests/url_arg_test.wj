use crate::domain::FetchConfig
use crate::domain::url_from_argv

fn test_url_from_argv_reads_positional() {
    let mut argv = Vec::new()
    argv.push("wj-fetch")
    argv.push("https://example.com/api")
    let config = FetchConfig::defaults()
    match url_from_argv(argv, config) {
        Ok(req) => assert_eq(req.url, "https://example.com/api"),
        Err(_) => assert(false, "expected Ok"),
    }
}

fn test_url_from_argv_errors_when_missing() {
    let mut argv = Vec::new()
    argv.push("wj-fetch")
    let config = FetchConfig::defaults()
    match url_from_argv(argv, config) {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => assert(msg.len() > 0, "error message required"),
    }
}

fn test_url_from_argv_fail_flag() {
    let mut argv = Vec::new()
    argv.push("wj-fetch")
    argv.push("--fail")
    argv.push("https://example.com/api")
    let config = FetchConfig::defaults()
    match url_from_argv(argv, config) {
        Ok(req) => assert(req.fail_on_error, "fail flag should be set"),
        Err(_) => assert(false, "expected Ok"),
    }
}

fn test_url_from_argv_retries_flag() {
    let mut argv = Vec::new()

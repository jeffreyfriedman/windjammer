use std::http

use crate::domain::ForwardResult

/// Forward a GET to `url`.
pub fn forward_get(url: string) -> Result<ForwardResult, string> {
    match http.get(url) {
        Ok(response) => {
            let status = response.status_code()
            match response.text() {
                Ok(body) => Ok(ForwardResult { status: status, body: body }),
                Err(e) => Err(e),
            }
        },
        Err(e) => Err(e),
    }
}

/// Forward a POST with body to `url`.
pub fn forward_post(url: string, body: string) -> Result<ForwardResult, string> {
    match http.post(url, body) {
        Ok(response) => {
            let status = response.status_code()
            match response.text() {
                Ok(text) => Ok(ForwardResult { status: status, body: text }),
                Err(e) => Err(e),
            }
        },
        Err(e) => Err(e),
    }
}


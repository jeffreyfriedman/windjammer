use std::strings

/// Parsed CLI intent (struct instead of enum for stable codegen).
pub struct Command {
    pub kind: string,
    pub title: string,
    pub id: int,
    pub json: bool,
    pub filter: string,
    pub out_path: string,
}

const LIST_USAGE: string = "usage: list [--json] [--pending|--done]"
const CLEAR_USAGE: string = "usage: clear [--done]"

const EXPORT_USAGE: string = "usage: export [--pending|--done] [--out <path>]"

const IMPORT_USAGE: string = "usage: import [--merge] <file.json>"

const STATS_USAGE: string = "usage: stats [--json]"

/// Parse argv tokens after the program name (`add …`, `list`, `done N`, `rm N`, `clear`, `export`, `import`, `stats`).
pub fn parse_command(args: Vec<string>) -> Result<Command, string> {
    if args.len() == 0 {
        return Err("usage: add|list|done|rm|edit|clear|export|import|stats …")
    }
    let verb = args[0]
    if verb == "add" {
        if args.len() < 2 {
            return Err("usage: add <title>")
        }
        let mut title = ""
        let mut i = 1
        while i < args.len() {
            if i > 1 {
                title = "${title} "
            }
            title = "${title}${args[i]}"
            i = i + 1
        }
        return Ok(Command {
            kind: "add",
            title: title,
            id: 0,
            json: false,
            filter: "",
            out_path: "",
        })
    }
    if verb == "list" {
        let mut json = false
        let mut filter = ""
        let mut i = 1
        while i < args.len() {
            let token = args[i]
            if token == "--json" {
                json = true
            } else if token == "--pending" {
                if strings.len(filter) > 0 {
                    return Err(LIST_USAGE)
                }
                filter = "pending"
            } else if token == "--done" {
                if strings.len(filter) > 0 {
                    return Err(LIST_USAGE)
                }
                filter = "done"
            } else {
                return Err(LIST_USAGE)
            }
            i = i + 1
        }
        return Ok(Command {
            kind: "list",
            title: "",
            id: 0,
            json: json,
            filter: filter,
            out_path: "",
        })
    }
    if verb == "clear" {
        let mut filter = ""
        let mut i = 1
        while i < args.len() {
            let token = args[i]
            if token == "--done" {
                if strings.len(filter) > 0 {
                    return Err(CLEAR_USAGE)
                }
                filter = "done"
            } else {
                return Err(CLEAR_USAGE)
            }
            i = i + 1
        }
        return Ok(Command {
            kind: "clear",
            title: "",
            id: 0,
            json: false,
            filter: filter,
            out_path: "",
        })
    }
    if verb == "export" {
        let mut filter = ""
        let mut out_path = ""
        let mut i = 1
        while i < args.len() {
            let token = args[i]
            if token == "--pending" {
                if strings.len(filter) > 0 {
                    return Err(EXPORT_USAGE)
                }
                filter = "pending"
                i = i + 1
            } else if token == "--done" {
                if strings.len(filter) > 0 {
                    return Err(EXPORT_USAGE)
                }
                filter = "done"
                i = i + 1
            } else if token == "--out" {
                if i + 1 >= args.len() {
                    return Err(EXPORT_USAGE)
                }
                out_path = args[i + 1]
                i = i + 2
            } else {
                return Err(EXPORT_USAGE)
            }
        }
        return Ok(Command {
            kind: "export",
            title: "",
            id: 0,
            json: false,
            filter: filter,
            out_path: out_path,
        })
    }
    if verb == "import" {
        let mut filter = ""
        let mut file_path = ""
        let mut i = 1
        while i < args.len() {
            let token = args[i]
            if token == "--merge" {
                if strings.len(filter) > 0 {
                    return Err(IMPORT_USAGE)
                }
                filter = "merge"
                i = i + 1
            } else {
                if strings.len(file_path) > 0 {
                    return Err(IMPORT_USAGE)
                }
                file_path = token
                i = i + 1
            }
        }
        if strings.len(file_path) == 0 {
            return Err(IMPORT_USAGE)
        }
        return Ok(Command {
            kind: "import",
            title: file_path,
            id: 0,
            json: false,
            filter: filter,
            out_path: "",
        })
    }
    if verb == "stats" {
        let mut json = false
        let mut i = 1
        while i < args.len() {
            let token = args[i]
            if token == "--json" {
                json = true
            } else {
                return Err(STATS_USAGE)
            }
            i = i + 1
        }
        return Ok(Command {
            kind: "stats",
            title: "",
            id: 0,
            json: json,
            filter: "",
            out_path: "",
        })
    }
    if verb == "edit" {
        if args.len() < 3 {
            return Err("usage: edit <id> <title>")
        }
        match parse_id(args[1]) {
            Ok(id) => {
                let mut title = ""
                let mut i = 2
                while i < args.len() {
                    if i > 2 {
                        title = "${title} "
                    }
                    title = "${title}${args[i]}"
                    i = i + 1
                }
                return Ok(Command {
                    kind: "edit",
                    title: title,
                    id: id,
                    json: false,
                    filter: "",
                    out_path: "",
                })
            },
            Err(e) => return Err(e),
        }
    }
    if verb == "done" {
        if args.len() != 2 {
            return Err("usage: done <id>")
        }
        match parse_id(args[1]) {
            Ok(id) => Ok(Command {
                kind: "done",
                title: "",
                id: id,
                json: false,
                filter: "",
                out_path: "",
            }),
            Err(e) => Err(e),
        }
    } else if verb == "rm" {
        if args.len() != 2 {
            return Err("usage: rm <id>")
        }
        match parse_id(args[1]) {
            Ok(id) => Ok(Command {
                kind: "rm",
                title: "",
                id: id,
                json: false,
                filter: "",
                out_path: "",
            }),
            Err(e) => Err(e),
        }
    } else {
        Err("unknown command: ${verb}")
    }
}

fn parse_id(text: string) -> Result<int, string> {
    let t = strings.trim(text)
    if strings.len(t) == 0 {
        return Err("id required")
    }
    let mut i = 0
    while i < strings.len(t) {
        let ch = strings.substring(t, i, i + 1)
        if !is_digit(ch) {
            return Err("id must be a positive integer")
        }
        i = i + 1
    }
    Ok(strings.parse_i32(t) as int)
}

fn is_digit(ch: string) -> bool {
    ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"
}

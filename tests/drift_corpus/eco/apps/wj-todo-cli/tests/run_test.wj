fn test_run_edit_message() {
    let store = TodoStore::new()
    let config = TodoConfig::defaults()
    let mut add_args = Vec::new()
    add_args.push("add")
    add_args.push("old name")
    match run_args(store, add_args, config) {
        Ok(r1) => {
            let mut edit_args = Vec::new()
            edit_args.push("edit")
            edit_args.push("1")
            edit_args.push("new name")
            match run_args(r1.0, edit_args, config) {
                Ok(r2) => {
                    assert_str_contains(r2.1, "edited")
                    assert_str_contains(r2.1, "new name")
                    let mut list_args = Vec::new()
                    list_args.push("list")
                    match run_args(r2.0, list_args, config) {
                        Ok(r3) => assert_str_contains(r3.1, "new name"),
                        Err(_) => assert(false, "list after edit failed"),
                    }
                },
                Err(_) => assert(false, "edit failed"),
            }
        },
        Err(_) => assert(false, "add failed"),
    }
}

fn test_parse_edit() {
    let mut args = Vec::new()
    args.push("edit")
    args.push("2")
    args.push("buy")
    args.push("oat milk")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "edit")
            assert_eq(cmd.id, 2)
            assert_eq(cmd.title, "buy oat milk")
        },
        Err(_) => assert(false, "parse edit"),
    }
}

fn test_parse_edit_requires_title() {
    let mut args = Vec::new()
    args.push("edit")
    args.push("1")
    match parse_command(args) {
        Ok(_) => assert(false, "edit without title must fail"),
        Err(msg) => assert_str_contains(msg, "edit"),
    }
}

fn test_parse_stats() {
    let mut args = Vec::new()
    args.push("stats")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "stats")
            assert(!cmd.json, "plain stats")
        },
        Err(_) => assert(false, "parse stats"),
    }
}

fn test_parse_stats_json() {
    let mut args = Vec::new()
    args.push("stats")
    args.push("--json")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "stats")
            assert(cmd.json, "stats --json")
        },
        Err(_) => assert(false, "parse stats --json"),
    }
}

@test
fn test_parse_unknown() {
    let mut args = Vec::new()
    args.push("nope")
    match parse_command(args) {
        Ok(_) => assert(false, "should fail"),
        Err(_) => assert(true, "ok"),
    }
}

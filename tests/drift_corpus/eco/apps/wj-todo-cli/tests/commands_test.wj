fn test_parse_list_json() {
    let mut args = Vec::new()
    args.push("list")
    args.push("--json")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "list")
            assert(cmd.json, "list --json sets json flag")
            assert_eq(cmd.filter, "")
        },
        Err(_) => assert(false, "parse list --json"),
    }
}

fn test_parse_list_pending() {
    let mut args = Vec::new()
    args.push("list")
    args.push("--pending")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "list")
            assert_eq(cmd.filter, "pending")
        },
        Err(_) => assert(false, "parse list --pending"),
    }
}

fn test_parse_list_done_json() {
    let mut args = Vec::new()
    args.push("list")
    args.push("--done")
    args.push("--json")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.filter, "done")
            assert(cmd.json, "json flag")
        },
        Err(_) => assert(false, "parse list --done --json"),
    }
}

fn test_parse_list_rejects_conflicting_filters() {
    let mut args = Vec::new()
    args.push("list")
    args.push("--pending")
    args.push("--done")
    match parse_command(args) {
        Ok(_) => assert(false, "conflicting filters must fail"),
        Err(_) => assert(true, "ok"),
    }
}

fn test_parse_list_rejects_extra_args() {
    let mut args = Vec::new()
    args.push("list")
    args.push("extra")
    match parse_command(args) {
        Ok(_) => assert(false, "list with unknown arg must fail"),
        Err(_) => assert(true, "ok"),
    }
}


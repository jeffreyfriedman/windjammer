use crate::domain::parse_command

@test
fn test_parse_add() {
    let mut args = Vec::new()
    args.push("add")
    args.push("buy milk")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "add")
            assert_eq(cmd.title, "buy milk")
        },
        Err(_) => assert(false, "parse add"),
    }
}

@test
fn test_parse_list() {
    let mut args = Vec::new()
    args.push("list")
    match parse_command(args) {
        Ok(cmd) => assert_eq(cmd.kind, "list"),
        Err(_) => assert(false, "parse list"),
    }
}

@test
fn test_parse_done() {
    let mut args = Vec::new()
    args.push("done")
    args.push("3")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "done")
            assert_eq(cmd.id, 3)
        },
        Err(_) => assert(false, "parse done"),
    }
}

@test
fn test_parse_remove() {
    let mut args = Vec::new()
    args.push("rm")
    args.push("2")
    match parse_command(args) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "rm")
            assert_eq(cmd.id, 2)
        },
        Err(_) => assert(false, "parse rm"),

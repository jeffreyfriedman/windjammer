}

fn test_parse_import_merge() {
    let mut args = Vec::new()
    args.push("import")
    args.push("--merge")
    args.push("backup.json")
    match parse_command(args) {
        Ok(cmd) => assert_eq(cmd.filter, "merge"),
        Err(_) => assert(false, "parse import --merge"),

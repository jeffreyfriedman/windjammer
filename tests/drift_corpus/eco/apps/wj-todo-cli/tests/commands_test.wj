fn test_parse_export_out() {
    let mut args = Vec::new()
    args.push("export")
    args.push("--out")
    args.push("backup.json")
    match parse_command(args) {
        Ok(cmd) => assert_eq(cmd.out_path, "backup.json"),
        Err(_) => assert(false, "parse export --out"),
    }
}


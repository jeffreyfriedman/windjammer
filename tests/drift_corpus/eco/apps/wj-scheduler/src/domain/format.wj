use wj_cron::CronDateTime
use crate::domain::ExplainResult

pub fn format_check(matched: bool) -> string {
    if matched {
        return "match"
    }
    "no-match"
}

pub fn format_next(when: Option<CronDateTime>) -> string {
    match when {
        Some(dt) => {
            let month = pad2(dt.month)
            let day = pad2(dt.day_of_month)
            let hour = pad2(dt.hour)
            let minute = pad2(dt.minute)
            "${dt.year}-${month}-${day}T${hour}:${minute}"
        },
        None => "none",
    }
}

pub fn format_explain(exp: ExplainResult) -> string {
    "minute=${exp.minute} hour=${exp.hour} day_of_month=${exp.day_of_month} month=${exp.month} day_of_week=${exp.day_of_week}"
}

pub fn format_list(exprs: Vec<string>) -> string {
    if exprs.len() == 0 {
        return "(none)"
    }
    let mut out = ""
    let mut i = 0
    while i < exprs.len() {
        if i > 0 {
            out = "${out}\n"
        }
        out = "${out}${exprs[i]}"
        i = i + 1
    }
    out
}

pub fn format_due(exprs: Vec<string>) -> string {
    format_list(exprs)
}

fn pad2(n: int) -> string {
    if n < 10 {
        return "0${n}"
    }
    "${n}"
}

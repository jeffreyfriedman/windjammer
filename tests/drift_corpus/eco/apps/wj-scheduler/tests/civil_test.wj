use crate::domain::parse_civil
use crate::domain::day_of_week

fn test_parse_civil_basic() {
    match parse_civil("2026-01-01T12:30") {
        Ok(t) => {
            assert_eq(t.year, 2026)
            assert_eq(t.month, 1)
            assert_eq(t.day, 1)
            assert_eq(t.hour, 12)
            assert_eq(t.minute, 30)
        },
        Err(_e) => assert(false, "should parse civil time"),
    }
}

fn test_parse_civil_rejects_bad_shape() {
    assert(parse_civil("2026-01-01").is_err(), "missing time")
    assert(parse_civil("not-a-date").is_err(), "garbage")
    assert(parse_civil("").is_err(), "empty")
}

fn test_day_of_week_known_dates() {
    // 2026-01-01 was Thursday → 4 (0=Sunday)
    assert_eq(day_of_week(2026, 1, 1), 4)
    // 2026-01-03 was Saturday → 6
    assert_eq(day_of_week(2026, 1, 3), 6)
    // 2026-01-04 was Sunday → 0
    assert_eq(day_of_week(2026, 1, 4), 0)
    // 2026-01-05 was Monday → 1
    assert_eq(day_of_week(2026, 1, 5), 1)
}

fn test_parse_civil_fills_day_of_week() {
    match parse_civil("2026-01-01T08:00") {
        Ok(t) => assert_eq(t.day_of_week, 4),
        Err(_e) => assert(false, "should parse"),
    }
}

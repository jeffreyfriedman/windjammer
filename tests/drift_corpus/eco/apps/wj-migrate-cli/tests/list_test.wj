use crate::adapters::run_list
use std::fs

fn test_run_list_reads_migration_dir() {
    let root = "/tmp/wj-migrate-cli-list"
    match setup_migration_dir(root) {
        Ok(_) => {},
        Err(e) => {
            assert(false, e)
            return
        },
    }
    match run_list(root) {
        Ok(lines) => {
            assert_eq(lines.len(), 2)
            assert_eq(lines[0].version, 1)
            assert_eq(lines[0].name, "create_items")
            assert_eq(lines[1].version, 2)
            assert_eq(lines[1].name, "add_note")
        },
        Err(e) => assert(false, e),
    }
    teardown_dir("/tmp/wj-migrate-cli-list")
}

fn setup_migration_dir(root: string) -> Result<(), string> {
    match fs.remove_dir_all(root) {
        Ok(_) => {},
        Err(_) => {},
    }
    match fs.create_dir_all(root) {
        Ok(_) => {},
        Err(e) => return Err(e),
    }
    match fs.write("${root}/001_create_items.sql", "CREATE TABLE items (id INTEGER PRIMARY KEY)") {
        Ok(_) => {},
        Err(e) => return Err(e),
    }
    match fs.write("${root}/002_add_note.sql", "ALTER TABLE items ADD COLUMN note TEXT") {
        Ok(_) => {},
        Err(e) => return Err(e),
    }
    Ok(())
}

fn teardown_dir(root: string) {
    match fs.remove_dir_all(root) {
        Ok(_) => {},
        Err(_) => {},
    }
}

        Err(e) => assert(false, e),
    }
}

fn test_parse_apply_requires_url_when_unset() {
    let mut args = Vec::new()
    args.push("wj-migrate-cli")
    args.push("apply")
    args.push("--dir")
    args.push("./migrations")
    let config = MigrateConfig::defaults()
    match parse_apply(args, config) {
        Ok(_) => assert(false, "expected missing url error"),
        Err(e) => assert_str_contains(e, "url"),
    }
}

fn test_parse_status_subcommand() {
    let mut args = Vec::new()
    args.push("wj-migrate-cli")
    args.push("status")
    args.push("--url")
    args.push(":memory:")
    args.push("--dir")
    args.push("./migrations")
    let config = MigrateConfig::defaults()
    match parse_command(args, config) {
        Ok(cmd) => {
            assert_eq(cmd.kind, "status")
            assert_eq(cmd.url, ":memory:")
            assert_eq(cmd.dir, "./migrations")
        },
        Err(e) => assert(false, e),
    }
}

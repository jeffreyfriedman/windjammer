// `seen.contains(&i)` with a local `i`: the generated call loses the `&` (rustc E0308, expected `&i64`, found `i64`).
fn has_duplicate(items: Vec<int>) -> bool {
    let mut seen: Vec<int> = Vec::new()
    for i in items {
        if seen.contains(&i) {
            return true
        }
        seen.push(i)
    }
    false
}

fn main() {
    println("${has_duplicate([1, 2, 1])} ${has_duplicate([1, 2, 3])}")
}

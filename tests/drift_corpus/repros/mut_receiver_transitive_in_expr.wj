// A method that mutates only by calling another mutating method inside an expression (`1 + self.step()`): the caller's
// binding is declared `let mut g` (ADR-0002; without it `wj check` reports WJ0051).
struct Gen { state: int }
impl Gen {
    fn step(self) -> int {
        self.state = self.state + 1
        self.state
    }
    fn plus_one(self) -> int {
        1 + self.step()
    }
}
fn main() {
    let mut g = Gen { state: 0 }
    let r = g.plus_one()
    println("${r}")
}

// A by-value receiver whose result is bound, then the receiver used again (ADR-0030 class a).
struct Node {
    label: string,
    next: int,
}

impl Node {
    fn advance(self) -> Node {
        Node { label: self.label, next: self.next + 1 }
    }

    fn peek(self) -> int {
        self.next
    }
}

fn main() {
    let n = Node { label: "a", next: 4 }
    let moved = n.advance()
    println("${moved.label} ${n.peek()}")
}

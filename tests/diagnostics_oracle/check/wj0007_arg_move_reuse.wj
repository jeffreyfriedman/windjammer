// expect: WJ0007
// Class b (ADR-0030): a bare variable passed to a parameter that takes ownership, then used again: rustc E0382.
struct Bag {
    items: Vec<int>,
}

fn wrap(items: Vec<int>) -> Bag {
    Bag { items: items }
}

fn main() {
    let xs = [1, 2, 3]
    let b = wrap(xs)
//~@13+4 ERROR WJ0007 `xs` is used after the call to `wrap` moved it
    println("${b.items.len()} ${xs.len()}")
}

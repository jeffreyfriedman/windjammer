// Closures whose bodies read the same text but capture different locals (and live at different spans, in loops,
// recursion and a second file) must each see their own environment: the interpreter finds the names a body uses
// from its source text, which must stay exact without the source path in it.
use two_files::bump_by

fn make_adder(k: int) -> fn(int) -> int {
    |x: int| x + k
}

fn rec(n: int, k: int) -> int {
    if n == 0 {
        return 0
    }
    let f = |x: int| x + k
    f(n) + rec(n - 1, k + 1)
}

fn main() {
    let a: int = 1
    let b: int = 100
    let f = |x: int| x + a
    let g = |x: int| x + b
    println("${f(1)} ${g(1)}")
    let h = |x: int| x + a
    let a2: int = 5
    let i = |x: int| x + a2
    println("${h(1)} ${i(1)}")
    let mut fs: Vec<fn(int) -> int> = Vec::new()
    for k in 0..4 {
        let m: int = (k as int) * 10
        fs.push(|x: int| x + m)
    }
    let mut out = ""
    for c in fs {
        out = out + "${c(1)} "
    }
    println(out)
    println("${make_adder(3)(1)} ${make_adder(30)(1)}")
    println("${rec(3, 0)}")
    let k: int = 7
    println("${bump_by(1)} ${(|x: int| x + k)(1)}")
    let mut total: int = 0
    let mut j = 0
    while j < 3 {
        let step: int = j + 1
        let add = |x: int| x + step
        total = add(total)
        j += 1
    }
    println("${total}")
}

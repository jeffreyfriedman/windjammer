// generated by gen500.sh: structs, Vec, HashMap, closures, small functions
use std::collections::HashMap

struct Rec1 {
    id: int,
    label: string,
    score: int,
}

fn make_1(n: int) -> Vec<Rec1> {
    let mut out: Vec<Rec1> = Vec::new()
    let mut i = 0
    while i < n {
        out.push(Rec1 { id: i, label: "r${i}", score: (i * 4) % 17 })
        i += 1
    }
    out
}

fn tally_1(recs: Vec<Rec1>) -> HashMap<int, int> {
    let mut m: HashMap<int, int> = HashMap::new()
    for r in recs {
        let key = r.score % 5
        let now = m.get(&key).copied().unwrap_or(0)
        m.insert(key, now + r.id)
    }
    m
}

fn weight_1(recs: Vec<Rec1>) -> int {
    let w: int = recs.map(|r| r.score * 3).filter(|x| x % 3 == 0).sum()
    w
}

fn describe_1(r: Rec1) -> string {
    let tag = if r.score > 8 { "high" } else { "low" }
    "1:${r.label}:${tag}"
}

fn clamp_1(v: int) -> int {
    if v > 160 { 160 } else { v }
}


// Repro (Phase 18 / graph_bfs_engine): HashMap<i64,i64> get/insert in BFS distance loop.
use std::collections::HashMap

pub fn bfs_visit_count(source: i64, neighbors: Vec<i64>) -> i32 {
    let mut distances = HashMap::new()
    let mut queue = Vec::new()
    queue.push(source)
    distances.insert(source, 0)
    let mut head = 0
    while head < queue.len() {
        let v = queue[head]
        head = head + 1
        for n in neighbors {
            if !distances.contains_key(n) {
                distances.insert(n, 1)
                queue.push(n)
            }
        }
    }
    distances.len() as i32
}

pub fn test_hashmap_i64_bfs_style_get_insert() {
    let count = bfs_visit_count(0, vec![1, 2])
    assert_eq(count, 3)
}

// Repro: loop over queries must borrow graph for &T callee (non-Copy Graph).
struct Graph {
    count: i32,
    label: string,
}

fn run_query(graph: Graph, query_id: u32) -> i32 {
    graph.count + query_id as i32 + graph.label.len() as i32
}

pub fn run_all_queries(graph: Graph) -> i32 {
    let mut total = 0
    let mut q = 1
    while q <= 3 {
        total = total + run_query(graph, q as u32)
        q = q + 1
    }
    total
}

pub fn test_loop_reuses_graph_with_borrowed_callee() {
    let g = Graph { count: 10, label: "x" }
    // 10+1+1 + 10+2+1 + 10+3+1 = 12+13+14 = 39
    assert_eq(run_all_queries(g), 39)
}

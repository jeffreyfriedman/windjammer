pub struct LsqbTypedGraph {
    pub n: int,
}

pub fn out_neighbors(graph: LsqbTypedGraph, vertex: int) -> Vec<int> {
    let _ = graph.n
    let _ = vertex
    Vec::new()
}

pub fn query(graph: LsqbTypedGraph) -> int {
    // Product: demotes to &mut LsqbTypedGraph then forwards into owned out_neighbors.
    let mut total = 0
    let mut i = 0
    while i < 2 {
        let _ = out_neighbors(graph, i)
        total = total + 1
        i = i + 1
    }
    total
}

use crate::ports::{InvoiceRepository, InvoiceCreateDraft}

pub struct SeedInvoiceRepository {}
impl InvoiceRepository for SeedInvoiceRepository {
    fn create(self, tenant_id: string, draft: InvoiceCreateDraft) -> Result<string, string> {
        // Product seed adapters discard unused tenant_id this way; must not demote
        // the trait formal to shared-ref (callers would emit `&_temp0` into String).
        let _ = tenant_id
        Ok(draft.note + "")
    }
    fn get(self, tenant_id: string, invoice_id: string) -> Result<string, string> {
        let _ = tenant_id
        Ok(invoice_id + "")
    }
    fn list(self, tenant_id: string) -> Vec<string> {
        let _ = tenant_id
        vec![]
    }
}

pub struct WeightedGraphEdge {
    pub src_id: i64,
    pub dst_id: i64,
    pub weight: f64,
}

pub struct GraphAdjacencyView {
    pub vertex_count: u32,
    pub edge_count: u32,
    pub build_nanos: u64,
    pub undirected: bool,
    pub vertex_ids: Vec<i64>,
    pub offsets: Vec<u32>,
    pub neighbors: Vec<i64>,
    pub weights: Vec<f64>,
}

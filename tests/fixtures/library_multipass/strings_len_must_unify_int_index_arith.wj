// FAILING REPRO — strings.len() usize must unify with int index arithmetic.
// Product: domain/string_contains.wj while i + n_len <= h_len (without `as int`).

use std::strings

pub fn scan(h: string, n: string) -> bool {
    let haystack = h
    let needle = n
    let h_len = strings.len(haystack)
    let n_len = strings.len(needle)
    if n_len == 0 {
        return false
    }
    if n_len > h_len {
        return false
    }
    let mut i = 0
    while i + n_len <= h_len {
        let mut matched = true
        let mut j = 0
        while j < n_len {
            let hs = strings.substring(haystack, i + j, i + j + 1)
            let ns = strings.substring(needle, j, j + 1)
            if hs != ns {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    false
}

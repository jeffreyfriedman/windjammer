// after tip int_inference churn (HEAD tip binary). Pin/dogfood tip may still GREEN.

pub fn days_in_feb(year: int) -> int {
    if year % 400 == 0 {
        return 29
    }
    if year % 100 == 0 {
        return 28
    }
    if year % 4 == 0 {
        return 29
    }
    28
}

pub fn bump_month(mut y: int, mut m: int) -> int {
    m = m + 1
    if m > 12 {
        m = 1
        y = y + 1
    }
    y * 100 + m
}

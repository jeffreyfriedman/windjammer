pub fn decode_store(text: string) -> Result<int, string> {
    if text == "" {
        return Err("empty")
    }
    Ok(1)
}

fn read_file(path: string) -> Result<string, string> {
    Ok(path)
}

/// `wj-todo-cli` `import` branch class: `Ok(body) => decode_store(body)` must move, not borrow.
pub fn load_snapshot(raw_path: string) -> Result<int, string> {
    match read_file(raw_path) {
        Ok(body) => decode_store(body),
        Err(e) => Err(e),
    }
}

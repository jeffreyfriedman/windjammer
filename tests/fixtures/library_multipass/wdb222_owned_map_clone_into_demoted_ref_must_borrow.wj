pub struct GraphVertexI64Map {
    pub n: int,
}

pub fn get(map: GraphVertexI64Map, vertex: int) -> int {
    let _ = map.n
    vertex
}

/// Multi-use owned map: auto-clone would emit `get(map.clone(), …)` into demoted
/// `&GraphVertexI64Map` — must peel to `get(&map, …)` (WDB-222 / tip WCC/SSSP).
pub fn read_twice(map: GraphVertexI64Map, vertex: int) -> int {
    let a = get(map, vertex)
    let b = get(map, vertex)
    a + b
}

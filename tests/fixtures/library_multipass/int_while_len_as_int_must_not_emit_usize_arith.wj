// REPRO — typed int + `len() as int` while must not emit usize into i64 (LedgerKit product).
// Tip HEAD after nested-counter / WAL usize work: isolate increment may GREEN, but product
// `let mut idx: int = 0` + `let _len = x.len() as int; while idx < _len; idx = idx + 1`
// emits `+= 1_usize` / usize vs i64 → tip api-check E0277 (~100+).

use std::strings

pub fn count_items(items: Vec<string>) -> int {
    let mut idx: int = 0
    let _len = items.len() as int
    while idx < _len {
        idx = idx + 1
    }
    idx
}

pub fn haystack_contains_shaped(haystack: string, needle: string) -> bool {
    let h = haystack
    let n = needle
    let h_len = strings.len(h) as int
    let n_len = strings.len(n) as int
    if n_len == 0 {
        return false
    }
    if n_len > h_len {
        return false
    }
    let mut i: int = 0
    while i + n_len <= h_len {
        let mut matched = true
        let mut j: int = 0
        while j < n_len {
            let hs = strings.substring(h, i + j, i + j + 1)
            let ns = strings.substring(n, j, j + 1)
            if hs != ns {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    false
}

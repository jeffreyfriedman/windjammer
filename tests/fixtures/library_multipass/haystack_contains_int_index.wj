use std::strings

/// LedgerKit `domain/string_contains.wj` class without empty-concat workarounds.
/// Substring start/end with `int` counters must unify to usize without mixing
/// i64 operands and a usize-suffixed literal in the same binary expression.
pub fn haystack_contains(haystack: string, needle: string) -> bool {
    let h = haystack
    let n = needle
    let h_len = strings.len(h)
    let n_len = strings.len(n)
    if n_len == 0 {
        return false
    }
    if n_len > h_len {
        return false
    }
    let mut i = 0
    while i + n_len <= h_len {
        let mut matched = true
        let mut j = 0
        while j < n_len {
            let hs = strings.substring(h, i + j, i + j + 1)
            let ns = strings.substring(n, j, j + 1)
            if hs != ns {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    false
}

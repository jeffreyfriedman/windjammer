use std::net::Request

/// `wj-fetch` simple GET class — `Request::get` must resolve to native client, not `http::Request`.
pub fn simple_get(url: string) -> Result<string, string> {
    let req = Request::get(url)
    match req.send() {
        Ok(response) => Ok(response.body),
        Err(e) => Err(e),
    }
}

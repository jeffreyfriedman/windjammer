// REPRO — product while + Custom field + len (LedgerKit postgres invoice lines).
// Tip GREEN after int-width follow-ups: `idx += 1` (not `1 as i32`) under --module-file.

pub struct Line {
    pub total_cents: int
}

pub fn sum(lines: Vec<Line>) -> int {
    let mut idx = 0
    let mut subtotal = 0
    while idx < lines.len() {
        subtotal = subtotal + lines[idx].total_cents
        idx = idx + 1
    }
    subtotal
}

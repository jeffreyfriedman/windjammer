pub struct Reader {
    pub allowed: Vec<string>,
}

impl Reader {
    pub fn check(self, who: string, relation: string) -> bool {
        for a in self.allowed {
            if a == relation && who.len() > 0 {
                return true
            }
        }
        false
    }
}

pub fn allowed(policy: Reader, who: string, relation: string, n: int) -> int {
    let mut hits = 0
    let mut i = 0
    while i < n {
        if policy.check(who, relation) {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

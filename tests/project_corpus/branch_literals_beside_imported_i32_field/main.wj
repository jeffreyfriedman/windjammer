// A field declared `i32` in another file: the `if` branch literals added to it are `i32` too (the field's declared
// type crosses the module boundary). Expected by hand: 4 + (-1) = 3, then 2 + 1 = 3.
// expect: 3 3
mod cell
mod score

fn main() {
    let a = score::adjusted([cell::Cell { weight: 4 }])
    let b = score::adjusted([cell::Cell { weight: 2 }])
    println("${a} ${b}")
}

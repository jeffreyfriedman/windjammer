pub enum Val {
    Flag(bool),
    Num(i64),
}

fn cmp_i64(a: i64, b: i64) -> i32 {
    if a < b { -1 } else if a > b { 1 } else { 0 }
}

pub fn val_cmp(a: Val, b: Val) -> i32 {
    match a {
        Val::Flag(x) => {
            match b {
                Val::Flag(y) => if x == y { 0 } else { 1 },
                _ => 2,
            }
        }
        Val::Num(x) => {
            match b {
                Val::Num(y) => cmp_i64(x, y),
                _ => 2,
            }
        }
    }
}

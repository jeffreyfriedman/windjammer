// `main.wj` defines `fn draft(int, int)`; the module `docs` has a private `fn draft(string, string)`. A bare call
// in this file names this file's function (lexical scope beats every other module), so its int arguments stay
// ints. Expected by hand: the two numbers, then the docs field "q".
// expect: 4294967296 -8589934592 q
mod docs
use docs::make

pub struct Pair { pub a: int, pub b: int }

fn draft(a: int, b: int) -> Pair {
    Pair { a: a, b: b }
}

fn main() {
    let p = draft(4294967296, -8589934592)
    println("${p.a} ${p.b} ${make("q").a}")
}

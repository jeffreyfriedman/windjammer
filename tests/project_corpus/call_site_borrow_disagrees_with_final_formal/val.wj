pub enum Val {
    Null,
    Flag(bool),
    Num(i64),
}

fn rank(v: Val) -> i32 {
    match v {
        Val::Null => 0,
        Val::Flag(_) => 1,
        Val::Num(_) => 2,
    }
}

fn cmp_i64(a: i64, b: i64) -> i32 {
    if a < b { -1 } else if a > b { 1 } else { 0 }
}

pub fn val_cmp(a: Val, b: Val) -> i32 {
    let ra = rank(a.clone())
    let rb = rank(b.clone())
    if ra != rb {
        if ra < rb {
            return -1
        }
        return 1
    }
    match a {
        Val::Null => 0,
        Val::Flag(x) => {
            match b {
                Val::Flag(y) => {
                    if x == y {
                        0
                    } else if !x {
                        -1
                    } else {
                        1
                    }
                }
                _ => 0,
            }
        }
        Val::Num(x) => {
            match b {
                Val::Num(y) => cmp_i64(x, y),
                _ => 0,
            }
        }
    }
}

use std::collections::HashMap

fn main() {
    let mut counts: HashMap<string, int> = HashMap::new()
    for w in ["a", "b", "a"] {
        counts.entry(w).and_modify(|c| *c += 1).or_insert(1)
    }
    let mut keys: Vec<string> = counts.keys().collect()
    keys.sort()
    for k in keys {
        println("${k}=${counts[k]}")
    }
}

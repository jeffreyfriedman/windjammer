use std::collections::BTreeMap

fn main() {
    let words: Vec<string> = ["apple", "avocado", "banana", "blueberry", "cherry"]
    let mut groups: BTreeMap<string, string> = BTreeMap::new()
    for w in words {
        let first = w[0..1].to_string()
        let so_far = groups.get(first).unwrap_or("")
        if so_far == "" {
            groups.insert(first, w)
        } else {
            groups.insert(first, so_far + ", " + w)
        }
    }
    for (letter, list) in groups {
        println("${letter}: ${list}")
    }
}

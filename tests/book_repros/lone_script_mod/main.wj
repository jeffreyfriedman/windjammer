// A lone script (no wj.toml) whose `main.wj` declares a sibling file module. `wj build main.wj` emits only main.rs:
// `mod counter;` with no counter.rs, and the argument of the module's method typed `2_i32`. `wj run --interpret` prints 2.
mod counter

use counter::Counter

fn main() {
    let c = Counter::new()
    let r = c.bump(2)
    println("${r}")
}

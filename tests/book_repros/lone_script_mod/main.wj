// A lone script (no wj.toml) whose `main.wj` declares a sibling file module. `wj build main.wj` generates counter.rs
// beside main.rs (as a project build does); `wj run --interpret` prints 2.
mod counter

use counter::Counter

fn main() {
    let mut c = Counter::new()
    let r = c.bump(2)
    println("${r}")
}

mod outer {
    pub const LIMIT: int = 10

    fn secret() -> int {
        LIMIT * 2
    }

    pub fn reveal() -> int {
        secret() + 1
    }

    pub mod inner {
        pub fn up() -> int {
            super::secret()
        }
    }
}

use outer::reveal as show
use outer::inner::up

fn main() {
    println("${show()} ${up()} ${outer::LIMIT}")
}

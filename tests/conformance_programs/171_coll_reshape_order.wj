// expect: 3 1 5
// expect: 5 0 3
// expect: 2 11 22
// expect: at 1
// expect: true
// expect: 123 3
// expect: bac
// expect: 9 2
// expect: 4
fn main() {
    let s = [1, 2, 3, 4, 5].each_slice(2)
    println("${s.len()} ${s[2].len()} ${s[2][0]}")
    let v = [1, 2, 3].intersperse(0)
    println("${v.len()} ${v[1]} ${v[4]}")
    let z = [1, 2, 3].zip_with([10, 20], |a, b| a + b)
    println("${z.len()} ${z[0]} ${z[1]}")
    let xs: Vec<int> = [5, 7, 9, 7]
    match xs.index_of(7) {
        Some(i) => println("at ${i}"),
        None => println("absent"),
    }
    println("${xs.index_of(4).is_none()}")
    let ys = [3, 1, 2]
    let sorted = ys.sorted()
    println("${sorted[0]}${sorted[1]}${sorted[2]} ${ys[0]}")
    let pairs = [(1, "a"), (2, "b"), (1, "c")]
    let d = pairs.sorted_by_key_desc(|p| p.0)
    println("${d[0].1}${d[1].1}${d[2].1}")
    let mut m = [2, 9, 4]
    m.sort_by_key_desc(|x| *x)
    println("${m[0]} ${m[2]}")
    let t = [3, 1, 3, 3].tally()
    println("${t[&3] + t[&1]}")
}

// expect: 12502500
// expect: 55
// expect: 6765
fn sum_to(n: i64) -> i64 {
    if n == 0 {
        0
    } else {
        n + sum_to(n - 1)
    }
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn main() {
    println("{}", sum_to(5000))
    println("{}", fib(10))
    println("{}", fib(20))
}

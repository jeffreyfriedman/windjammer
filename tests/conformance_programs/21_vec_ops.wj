// expect: 3
// expect: 10
// expect: 60
// expect: 20
fn main() {
    let mut v: Vec<i32> = Vec::new()
    v.push(10)
    v.push(20)
    v.push(30)
    println("{}", v.len())
    println("{}", v[0])
    let mut s = 0
    for x in v {
        s += x
    }
    println("{}", s)
    println("{}", v[1])
}

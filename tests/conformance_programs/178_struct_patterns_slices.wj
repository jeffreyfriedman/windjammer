// Struct patterns (`P { x, y: 2, .. }`, guards, `let`/`for` destructuring, tuple structs) and range
// slicing of Vec and string. Expected output from rustc on a Rust transliteration.
// expect: x is zero
// expect: x=4 y is two
// expect: big z 8
// expect: other
// expect: 7 8 9
// expect: 3w
// expect: 27
// expect: 3 2 2 2
// expect: el he lo
struct P {
    x: int,
    y: int,
    z: int,
}

struct W(int, string)

fn classify(p: P) -> string {
    match p {
        P { x: 0, .. } => "x is zero".to_string(),
        P { x, y: 2, .. } => "x=${x} y is two",
        P { z, .. } if z > 5 => "big z ${z}",
        _ => "other".to_string(),
    }
}

fn main() {
    println(classify(P { x: 0, y: 9, z: 9 }))
    println(classify(P { x: 4, y: 2, z: 0 }))
    println(classify(P { x: 4, y: 3, z: 8 }))
    println(classify(P { x: 4, y: 3, z: 1 }))
    let P { x, y, z } = P { x: 7, y: 8, z: 9 }
    println("${x} ${y} ${z}")
    match W(3, "w".to_string()) {
        W(n, s) => println("${n}${s}"),
    }
    let ps = vec![P { x: 1, y: 2, z: 3 }, P { x: 4, y: 5, z: 6 }]
    let mut t = 0
    for P { x, z, .. } in ps {
        t += x * z
    }
    println("${t}")
    let v = vec![1, 2, 3, 4, 5]
    let mid = v[1..4]
    println("${mid.len()} ${mid[0]} ${v[..2].len()} ${v[3..].len()}")
    let text = "hello"
    println("${text[1..3]} ${text[..2]} ${text[3..]}")
}

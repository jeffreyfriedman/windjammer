// Sieve of Eratosthenes; limit depends on the seed.
fn main() {
    let limit: usize = 1000 + (__SEED__ as usize) * 137
    let mut composite: Vec<bool> = Vec::new()
    let mut i: usize = 0
    while i <= limit {
        composite.push(false)
        i += 1
    }
    let mut p: usize = 2
    while p * p <= limit {
        if !composite[p] {
            let mut q = p * p
            while q <= limit {
                composite[q] = true
                q += p
            }
        }
        p += 1
    }
    let mut count: i64 = 0
    let mut sum: i64 = 0
    let mut k: usize = 2
    while k <= limit {
        if !composite[k] {
            count += 1
            sum += k as i64
        }
        k += 1
    }
    println("{} {} {}", limit, count, sum)
}

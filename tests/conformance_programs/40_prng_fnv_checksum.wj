// Anti-faking: 20000-step xorshift64 stream; FNV-1a-64 over EVERY output; checkpoints every 5000.
// The expected output is derived by 40_prng_fnv_checksum.ref.py (an independent Python model).
fn xorshift(state: u64) -> u64 {
    let mut x = state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    x
}

fn fnv_step(h: u64, v: u64) -> u64 {
    (h ^ (v & 255)).wrapping_mul(1099511628211)
}

fn fnv_word(h: u64, v: u64) -> u64 {
    let mut acc = h
    let mut i = 0
    let mut w = v
    while i < 8 {
        acc = fnv_step(acc, w)
        w = w >> 8
        i += 1
    }
    acc
}

fn main() {
    let mut s: u64 = __SEED__
    let mut h: u64 = (3421674724 << 32) | 2216829733
    let mut i = 1
    while i <= 20000 {
        s = xorshift(s)
        h = fnv_word(h, s)
        if i % 5000 == 0 {
            println("{} {} {}", i, s, h)
        }
        i += 1
    }
}

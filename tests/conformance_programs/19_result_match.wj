// expect: 5
// expect: err: div by zero
fn div(a: i32, b: i32) -> Result<i32, string> {
    if b == 0 {
        return Err("div by zero")
    }
    Ok(a / b)
}

fn main() {
    match div(10, 2) {
        Ok(v) => println("{}", v),
        Err(e) => println("err: {}", e),
    }
    match div(1, 0) {
        Ok(v) => println("{}", v),
        Err(e) => println("err: {}", e),
    }
}

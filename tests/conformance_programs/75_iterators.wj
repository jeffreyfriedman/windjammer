// expect: 2 4 6
// expect: 21
// expect: 0:a 1:b 2:c
// expect: 3
// expect: 1 2 3
// expect: 4 3 2
// expect: true false
// expect: some 4
// expect: 5
fn main() {
    let v = vec![1, 2, 3]
    let doubled: Vec<i64> = v.iter().map(|x| x * 2).collect()
    println("{} {} {}", doubled[0], doubled[1], doubled[2])
    let total: i64 = vec![1, 2, 3, 4, 5, 6].iter().sum()
    println("{}", total)
    let names = vec!["a", "b", "c"]
    let mut out = ""
    for (i, n) in names.iter().enumerate() {
        if i > 0 {
            out = out + " "
        }
        out = out + i.to_string() + ":" + n
    }
    println("{}", out)
    let pairs = vec![1, 2, 3].iter().zip(vec![10, 20, 30].iter()).count()
    println("{}", pairs)
    let t: Vec<i64> = vec![1, 2, 3, 4, 5].iter().take(3).cloned().collect()
    println("{} {} {}", t[0], t[1], t[2])
    let r: Vec<i64> = vec![1, 2, 3, 4].iter().rev().skip(0).take(3).cloned().collect()
    println("{} {} {}", r[0], r[1], r[2])
    println("{} {}", v.iter().any(|x| x > 2), v.iter().all(|x| x > 2))
    match v.iter().map(|x| x + 1).max() {
        Some(m) => println("some {}", m),
        None => println("none"),
    }
    let c: Vec<i64> = vec![1, 2].iter().chain(vec![3, 4, 5].iter()).cloned().collect()
    println("{}", c.len())
}

// expect: 45
// expect: 55
// expect: 24
// expect: 5
fn main() {
    let mut s = 0
    for i in 0..10 {
        s += i
    }
    println("{}", s)
    let mut t = 0
    for i in 1..=10 {
        t += i
    }
    println("{}", t)
    let mut f = 1
    let mut i = 1
    while i <= 4 {
        f *= i
        i += 1
    }
    println("{}", f)
    let mut n = 0
    loop {
        n += 1
        if n == 5 {
            break
        }
    }
    println("{}", n)
}

// Float formatting spec: shortest round-trip digits, never an exponent, "-0", NaN, inf.
// expect: 0.30000000000000004
// expect: 1
// expect: 1000000000000000000000
// expect: 0.00000015
// expect: -0
// expect: NaN
// expect: inf
// expect: -inf
// expect: 123456789012345680000
// expect: 0.1
// expect: 100
// expect: 2.5
fn main() {
    let a = 0.1 + 0.2
    println("${a}")
    let c = 1.0
    println("${c}")
    let d = 1e21
    println("${d}")
    let e = 1.5e-7
    println("${e}")
    let z = 0.0 * -1.0
    println("${z}")
    let n = 0.0 / 0.0
    println("${n}")
    let i = 1.0 / 0.0
    println("${i}")
    let ni = -1.0 / 0.0
    println("${ni}")
    let big = 123456789012345680000.0
    println("${big}")
    let t = 0.1
    println("${t}")
    let h = 100.0
    println("${h}")
    let q = 5.0 / 2.0
    println("${q}")
}

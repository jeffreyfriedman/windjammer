use std::math

fn main() {
    println("{}", math::sqrt(16.0))
    println("{}", math::pow(2.0, 10.0))
    println("{}", math::floor(2.9))
    println("{}", math::abs_i64(-5))
    println("{}", math::min_i64(3, 9))
    println("{}", math::clamp_f64(7.5, 0.0, 5.0))
    println("{}", math::hypot(3.0, 4.0))
    let zero: f64 = 0.0
    println("{}", math::is_nan(zero / zero))
}

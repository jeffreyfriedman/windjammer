// expect: 2
// A borrowed text piece (substring) pushed WITHOUT a user .clone() into a Vec whose element type is fixed only
// by where the Vec flows (struct field / return / map value) must become an owned String (`&str.clone()` stays `&str`).
fn pieces(text: string) -> Vec<string> {
    let parts: Vec<string> = text.split("{").collect()
    let mut names = []
    let mut i = 1
    while i < parts.len() {
        let seg = parts[i]
        match seg.find("}") {
            None => {},
            Some(at) => {
                let name = seg.substring(0, at)
                names.push(name)
            },
        }
        i += 1
    }
    names
}

fn main() {
    println("${pieces("a{b}c{d}").len()}")
}

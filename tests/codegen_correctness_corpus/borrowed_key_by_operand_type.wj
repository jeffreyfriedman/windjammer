// expect: 2 true -1
// expect: 7 true 7
// A written `&` on a map key is kept when the key is a value (`&0`, `&(q % 3)`) and dropped when the key is already a
// reference (`&"b"` is `&&str`; a `String`-keyed map takes `&str`): decided by the operand's Rust type (rustc E0277
// `String: Borrow<&str>` when it was kept).
use std::collections::HashMap

fn main() {
    let mut m: HashMap<string, int> = HashMap::new()
    m.insert("a", 1)
    m.insert("b", 2)
    let b = match m.get(&"b") {
        Some(v) => *v,
        None => 0,
    }
    let z = match m.get(&"z") {
        Some(v) => *v,
        None => -1,
    }
    println("${b} ${m.contains_key(&"a")} ${z}")
    let mut w: HashMap<int, int> = HashMap::new()
    w.insert(0, 7)
    w.insert(1, 8)
    let q = 3
    let zero = match w.get(&0) {
        Some(v) => *v,
        None => -1,
    }
    let again = match w.get(&(q % 3)) {
        Some(v) => *v,
        None => -1,
    }
    println("${zero} ${w.contains_key(&(q % 3))} ${again}")
}

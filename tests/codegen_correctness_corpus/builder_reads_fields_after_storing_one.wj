// expect: INSERT INTO t (a, b) VALUES (?, ?) | 2
// expect: none
// A builder method that passes one field of `self` to a function, loops over another and then reads it again, and
// stores a third in its result keeps borrowing `self` (rustc E0382 borrow of moved `self.columns` after the loop
// when the receiver was made by-value; reduced from the ecosystem SQL builder's `Insert::build`).
pub struct Query {
    pub sql: string,
    pub params: Vec<string>,
}

pub struct Insert {
    table: string,
    columns: Vec<string>,
    values: Vec<string>,
    errors: Vec<string>,
}

fn first_error(errors: Vec<string>) -> string {
    if errors.len() == 0 { "" } else { errors[0] }
}

impl Insert {
    pub fn build(self) -> Result<Query, string> {
        let err = first_error(self.errors)
        if err.len() > 0 {
            return Err(err)
        }
        let mut marks = Vec::new()
        for c in self.columns {
            marks.push("?")
        }
        let sql = "INSERT INTO " + self.table + " (" + self.columns.join(", ") + ") VALUES (" + marks.join(", ") + ")"
        Ok(Query { sql: sql, params: self.values })
    }
}

fn main() {
    let ins = Insert { table: "t", columns: ["a", "b"], values: ["x", "y"], errors: [] }
    match ins.build() {
        Ok(q) => println("${q.sql} | ${q.params.len()}"),
        Err(e) => println("error ${e}"),
    }
    let again = ins.build()
    match again {
        Ok(_) => println("none"),
        Err(_) => println("err"),
    }
}

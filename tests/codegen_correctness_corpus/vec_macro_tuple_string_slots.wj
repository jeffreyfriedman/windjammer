// String literals in a tuple inside `vec![..]` take the declared element type: owned strings for a formal and a return type.
// expect: 2 1 1 1
fn count(pairs: Vec<(string, string)>) -> int {
    pairs.len() as int
}
fn mk() -> Vec<(string, string)> {
    vec![("a", "b")]
}
fn mk2() -> Vec<(string, string)> {
    [("a", "b")]
}
fn main() {
    println("${count([("a", "b"), ("c", "d")])} ${count(vec![("a", "b")])} ${mk().len()} ${mk2().len()}")
}

// Shape D: build incrementally and pass each step: the caller pushes a literal between calls.
fn peek(v: Vec<float>, i: int) -> float {
    v[i as usize]
}

fn main() {
    let mut v: Vec<float> = []
    let mut k = 0
    while k < 100000 {
        v.push(1.5)
        k += 1
    }
    let mut s = 0.0
    let mut c = 0
    while c < 20 {
        s += peek(v, c)
        v.push(2.5)
        c += 1
    }
    println("${s} ${v.len()}")
}

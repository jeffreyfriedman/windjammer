// A local Vec<float> filled with float literals passed to a Vec<f64> parameter: the caller's vector keeps its values
// and later uses, whatever the callee does with its parameter (docs/design/interp-soundness/vecretag.md).
struct Holder {
    data: Vec<float>,
}

struct Rows {
    rows: Vec<Vec<float>>,
}

fn get(v: Vec<float>, i: int) -> float {
    v[i as usize]
}

fn total(v: Vec<float>) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < v.len() as int {
        s += v[i as usize]
        i += 1
    }
    s
}

fn pushed(v: Vec<float>) -> float {
    v.push(9.5)
    v[v.len() - 1]
}

fn stored(v: Vec<float>) -> float {
    v[0] = 100.25
    v[0]
}

fn give_back(v: Vec<float>) -> Vec<float> {
    v
}

fn wrap(v: Vec<float>) -> Holder {
    Holder { data: v }
}

fn pair(a: Vec<float>, b: Vec<float>) -> float {
    a[0] + b[1]
}

fn depth(v: Vec<float>, n: int) -> float {
    if n == 0 {
        v[0]
    } else {
        v[n as usize] + depth(v, n - 1)
    }
}

fn narrow(v: Vec<f32>) -> f32 {
    v[0]
}

fn nested(vv: Vec<Vec<float>>) -> float {
    vv[1][0]
}

impl Holder {
    fn take(self, v: Vec<float>) -> float {
        v[0] + self.data[1]
    }
}

fn filled(n: int) -> Vec<float> {
    let mut v: Vec<float> = []
    let mut i = 0
    while i < n {
        v.push(0.5)
        i += 1
    }
    v
}

fn main() {
    // read-only callee, the caller keeps using the vector (and pushes to it) between calls
    let mut v: Vec<float> = []
    let mut i_v = 0
    while i_v < 6 {
        v.push(0.5)
        i_v += 1
    }
    let mut s = 0.0
    let mut k = 0
    while k < 40 {
        s += get(v, k % 6)
        if k % 10 == 9 {
            v.push(1.0)
        }
        k += 1
    }
    println("loop ${s} len ${v.len()} sum ${total(v)}")
    // the callee mutates its parameter: inferred `&mut`, the caller sees the change
    let mut w: Vec<float> = []
    let mut i_w = 0
    while i_w < 4 {
        w.push(0.5)
        i_w += 1
    }
    println("push ${pushed(w)} ${w.len()}")
    println("store ${stored(w)} ${w[0]} ${total(w)}")
    // returned, stored in a struct, passed twice, recursion
    let mut x: Vec<float> = []
    let mut i_x = 0
    while i_x < 5 {
        x.push(0.5)
        i_x += 1
    }
    let y = give_back(x)
    println("back ${y.len()} ${total(y)} ${total(x)}")
    let h = wrap(x)
    println("held ${h.data.len()} ${get(h.data, 2)} ${total(x)}")
    println("twice ${pair(x, x)}")
    println("deep ${depth(x, 4)}")
    // a method with a vector argument
    println("method ${h.take(x)}")
    // f32 parameter: not served by the retag
    let z: Vec<f32> = [0.1, 0.2]
    println("f32 ${narrow(z)} ${z[0]}")
    // nested vectors
    let n = Rows { rows: [[1.5, 2.5], [3.5, 4.5]] }
    println("nested ${nested(n.rows)} ${n.rows[1][1]}")
    // closure capturing the vector
    let c = || get(x, 1) + total(x)
    println("closure ${c()} ${c()}")
    // a literal-tagged vector next to a typed float: the arithmetic is the same after a call
    let mut u: Vec<float> = []
    let mut i_u = 0
    while i_u < 3 {
        u.push(0.5)
        i_u += 1
    }
    let a = get(u, 0) + 0.25
    let b = u[1] * 3.0
    println("mixed ${a} ${b} ${get(u, 2)}")
}

// `sum` adds as the chain produces: empty input with and without a declared type, a result type wider than the
// items, literals, a chain whose filter rejects everything, and a sum that stays in range.
fn main() {
    let e: Vec<int> = Vec::new()
    let none: int = e.map(|x| x + 1).sum()
    println("${none}")
    let small: Vec<i32> = [5, 6, 7]
    let a: i32 = small.map(|x| x * 2).sum()
    println("${a}")
    let rejected: int = [1, 2, 3].map(|x| x + 1).filter(|x| x > 100).sum()
    println("${rejected}")
    let big: Vec<i32> = [2000000000, 2000000000, 0, 1]
    let h: i32 = big.map(|x| x / 2).sum()
    println("${h}")
    let neg: Vec<int> = [-5, 5, -7, 9]
    let n: int = neg.map(|x| x * 3).filter(|x| x != 0).sum()
    println("${n}")
}

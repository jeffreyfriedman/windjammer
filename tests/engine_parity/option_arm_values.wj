// Arms of a `match` over an `Option` whose results are used as values and returned, on hits and on
// misses: `None => None` (a bare `None` pattern is the unit variant, not a binding, so the body's
// `None` is the variant too), `Some(v) => Some(v)`, a unit variant of the program's own enum as a
// bare pattern and as the arm's value, and the same matches over a map local in a loop.
use std::collections::HashMap

enum Mode {
    Off,
    On,
}

fn lookup(map: HashMap<string, string>, name: string) -> Option<string> {
    match map.get(name) {
        Some(v) => Some(v),
        None => None,
    }
}

fn first_even(xs: Vec<int>) -> Option<int> {
    let mut i = 0
    while i < xs.len() {
        if xs[i] % 2 == 0 {
            return Some(xs[i])
        }
        i += 1
    }
    None
}

fn flip(m: Mode) -> Mode {
    match m {
        Off => Mode::On,
        On => Mode::Off,
    }
}

fn mode_name(m: Mode) -> string {
    match m {
        Mode::Off => "off",
        Mode::On => "on",
    }
}

fn main() {
    let mut m = HashMap::new()
    m.insert("a", "1")
    let hit = lookup(m, "a")
    let miss = lookup(m, "zz")
    println("${hit.is_some()} ${miss.is_some()} ${hit.unwrap_or("-")} ${miss.unwrap_or("-")}")
    let odd = match first_even([1, 3, 5]) {
        Some(x) => Some(x * 10),
        None => None,
    }
    let even = match first_even([1, 4, 5]) {
        Some(x) => Some(x * 10),
        None => None,
    }
    println("${odd.is_none()} ${even.unwrap_or(-1)}")
    println("${mode_name(flip(Mode::Off))} ${mode_name(flip(Mode::On))}")
    let mut counts: HashMap<int, int> = HashMap::new()
    let mut found = 0
    let mut missing = 0
    let mut i = 0
    while i < 300 {
        let k = i % 17
        let got = match counts.get(&k) {
            Some(v) => Some(*v + 1),
            None => None,
        }
        match got {
            Some(n) => {
                found += n
                counts.insert(k, n)
            }
            None => {
                missing += 1
                counts.insert(k, 1)
            }
        }
        i += 1
    }
    println("${found} ${missing} ${counts.len()}")
}

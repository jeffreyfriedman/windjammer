// A hot loop over a typed integer array (`kmap.rs` IntDense, machine-code lean helpers): a million keys counted in a
// scattered order, read back in key order, then removed from and refilled while the loop keeps running. The checksums
// are those the ordinary (64-byte entry) store printed.
use std::collections::HashMap

fn main() {
    let mut m: HashMap<int, int> = HashMap::new()
    let mut i = 0
    while i < 3000000 {
        let k = (i * 7919) % 1000003
        let c = match m.get(&k) {
            Some(v) => *v,
            None => 0,
        }
        m.insert(k, c + 1)
        i += 1
    }
    let mut best = 0
    let mut sum = 0
    let mut j = 0
    while j < 1000003 {
        match m.get(&j) {
            Some(v) => {
                sum = (sum * 31 + *v) % 1000000007
                if *v > best {
                    best = *v
                }
            }
            None => {}
        }
        j += 1
    }
    println("sweep ${m.len()} ${best} ${sum}")
    let mut gone = 0
    let mut r = 0
    while r < 1000003 {
        if r % 3 == 0 {
            match m.remove(&r) {
                Some(v) => { gone += v }
                None => {}
            }
        }
        r += 1
    }
    let mut back = 0
    let mut q = 0
    while q < 500000 {
        let k = (q * 3) % 1000003
        let c = match m.get(&k) {
            Some(v) => *v,
            None => -1,
        }
        back += c
        m.insert(k, c + 10)
        q += 1
    }
    println("after ${m.len()} ${gone} ${back}")
}

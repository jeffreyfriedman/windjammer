// A usize dividend with a literal zero divisor late in a hot loop (see jit_constdiv_u64_zero.wj).
fn main() {
    let mut t: usize = 0
    let mut i: usize = 0
    while i < 6000 {
        let a: usize = i * 2 + 1
        t += a / 5 + a % 5
        if i == 4500 {
            t += a / 0
        }
        i += 1
    }
    println("${t}")
}

// `match` lowered by the resolved engine: computed scrutinees, bindings, guards (false, true,
// failing), nested patterns, values of arms, and the no-arm panic.
use std::collections::HashMap

enum Shape {
    Circle(int),
    Rect { w: int, h: int },
    Empty,
}

fn area(s: Shape) -> int {
    match s {
        Shape::Circle(r) if r > 100 => 0,
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Empty => -1,
    }
}

fn lookup(m: HashMap<int, int>, k: int) -> int {
    match m.get(&k) {
        Some(v) if *v > 5 => *v * 10,
        Some(v) => *v,
        None => 0,
    }
}

fn classify(n: int) -> string {
    match n % 4 {
        0 => "zero",
        1 | 2 => "small",
        x => "other ${x}".to_string(),
    }
}

fn pick(n: int) -> int {
    match (n, n * 2) {
        (0, _) => 100,
        (a, b) if a + b > 10 => a * b,
        (a, _) => a,
    }
}

fn main() {
    let mut m: HashMap<int, int> = HashMap::new()
    let mut i = 0
    while i < 10 {
        m.insert(i, i * 2)
        i += 1
    }
    let mut total = 0
    let mut k = 0
    while k < 12 {
        total += lookup(m, k)
        k += 1
    }
    println("${total} ${area(Shape::Circle(3))} ${area(Shape::Rect { w: 4, h: 5 })} ${area(Shape::Empty)} ${area(Shape::Circle(101))}")
    println("${classify(4)} ${classify(5)} ${classify(7)} ${pick(0)} ${pick(2)} ${pick(7)}")
    let r = match pick(3) {
        6 => "six",
        _ => "not six",
    }
    println(r)
    let v = 7
    let s = match v / 2 {
        1 => "one",
        2 => "two",
    }
    println(s)
}

// Typed integer arrays (`kmap.rs` IntDense): a HashMap<int, int> whose keys fit an array part and whose values are all
// one 64-bit int is held as values + presence bits. Every case below is one way the typed store must answer exactly as
// the ordinary store does: promotion at the power-of-two lengths, sparse-then-dense growth, negative keys, a stored 0
// against an absent key, remove then reinsert, clear then reuse, clone then mutate (both directions), a map behind
// `&mut`, a non-int value forcing the map back, other widths (i32, u64) which stay ordinary, order-sensitive iteration
// checksums and a sweep that mixes everything. The expected lines are what the ordinary store printed.
use std::collections::HashMap

// order-sensitive digest of a map: keys in iteration order, then the values in iteration order
fn digest(m: &HashMap<int, int>) -> int {
    let mut h = 7
    for k in m.keys() {
        h = (h * 31 + k + 1) % 1000000007
    }
    for v in m.values() {
        h = (h * 37 + v % 1000003 + 1000008) % 1000000007
    }
    for (k, v) in m.iter() {
        h = (h * 41 + k * 3 + v % 1000003 + 1000003) % 1000000007
    }
    h
}

fn get_or(m: &HashMap<int, int>, k: int, d: int) -> int {
    match m.get(&k) {
        Some(v) => *v,
        None => d,
    }
}

fn fill(m: &mut HashMap<int, int>, from: int, to: int) {
    let mut i = from
    while i < to {
        m.insert(i, i * i - 7)
        i += 1
    }
}

fn bump_all(m: &mut HashMap<int, int>, n: int) {
    let mut i = 0
    while i < n {
        let k = (i * 5) % 40
        let c = get_or(m, k, 0)
        m.insert(k, c + 1)
        i += 1
    }
}

fn main() {
    // 1. ascending fill across every power-of-two length (8, 16, 32, ...): the digest after each doubling
    let mut a: HashMap<int, int> = HashMap::new()
    let mut n = 0
    let mut lens = 0
    while n < 300 {
        a.insert(n, n * 3 - 100)
        n += 1
        if n == 7 || n == 8 || n == 9 || n == 16 || n == 32 || n == 64 || n == 128 || n == 256 {
            lens = (lens * 131 + digest(&a) + a.len()) % 1000000007
        }
    }
    println("ascending ${a.len()} ${lens} ${digest(&a)}")

    // 2. scattered keys (the hashmap kernel's order): a table first, an array at a power of two
    let mut s: HashMap<int, int> = HashMap::new()
    let mut i = 0
    while i < 5000 {
        let k = (i * 7919) % 1009
        s.insert(k, get_or(&s, k, 0) + 1)
        i += 1
    }
    println("scattered ${s.len()} ${digest(&s)}")

    // 3. sparse keys, then enough keys to be dense; then a far key
    let mut sp: HashMap<int, int> = HashMap::new()
    let mut j = 0
    while j < 40 {
        sp.insert(j * 1000, j)
        j += 1
    }
    let sparse_len = sp.len()
    let mut d = 0
    while d < 200 {
        sp.insert(d, d + 1)
        d += 1
    }
    sp.insert(1000000, 5)
    println("sparse ${sparse_len} ${sp.len()} ${digest(&sp)}")

    // 4. negative keys: an array holds none, so the map must answer for them through the ordinary store
    let mut ng: HashMap<int, int> = HashMap::new()
    fill(&mut ng, 0, 64)
    ng.insert(-1, 11)
    ng.insert(-100, 12)
    println("negative ${ng.len()} ${get_or(&ng, -1, 0)} ${get_or(&ng, -100, 0)} ${get_or(&ng, 5, 0)} ${get_or(&ng, -5, -9)} ${digest(&ng)}")
    let mut ng2: HashMap<int, int> = HashMap::new()
    ng2.insert(-3, 1)
    fill(&mut ng2, 0, 70)
    println("negative2 ${ng2.len()} ${get_or(&ng2, -3, 0)} ${digest(&ng2)}")

    // 5. a stored 0 is present; an absent key is not; the same for negative values
    let mut z: HashMap<int, int> = HashMap::new()
    let mut q = 0
    while q < 64 {
        if q % 3 == 0 {
            z.insert(q, 0)
        }
        if q % 3 == 1 {
            z.insert(q, -q)
        }
        q += 1
    }
    let mut present = 0
    let mut zero = 0
    let mut r = 0
    while r < 70 {
        if z.contains_key(&r) {
            present += 1
        }
        match z.get(&r) {
            Some(v) => {
                if *v == 0 {
                    zero += 1
                }
            }
            None => {}
        }
        r += 1
    }
    println("zero ${z.len()} ${present} ${zero} ${digest(&z)}")

    // 6. remove then reinsert; remove of an absent key; remove everything; reuse
    let mut rm: HashMap<int, int> = HashMap::new()
    fill(&mut rm, 0, 100)
    let mut gone = 0
    let mut t = 0
    while t < 100 {
        if t % 4 != 0 {
            match rm.remove(&t) {
                Some(v) => { gone += v }
                None => { gone -= 1000000 }
            }
        }
        t += 1
    }
    let again = match rm.remove(&1) {
        Some(_) => 1,
        None => 0,
    }
    println("removed ${rm.len()} ${gone} ${again} ${digest(&rm)}")
    fill(&mut rm, 50, 120)
    println("reinserted ${rm.len()} ${digest(&rm)} ${rm.contains_key(&3)} ${rm.contains_key(&4)}")
    let mut all = 0
    while all < 130 {
        rm.remove(&all)
        all += 1
    }
    println("emptied ${rm.len()} ${rm.is_empty()} ${digest(&rm)}")
    fill(&mut rm, 0, 20)
    println("reused ${rm.len()} ${digest(&rm)}")

    // 7. clear then reuse (same type, then another value type)
    let mut c: HashMap<int, int> = HashMap::new()
    fill(&mut c, 0, 80)
    c.clear()
    println("cleared ${c.len()} ${c.is_empty()} ${get_or(&c, 3, -1)}")
    fill(&mut c, 10, 90)
    println("refilled ${c.len()} ${digest(&c)}")

    // 8. clone then mutate, in both directions
    let mut o: HashMap<int, int> = HashMap::new()
    fill(&mut o, 0, 64)
    let mut cl = o.clone()
    cl.insert(3, 999)
    cl.remove(&4)
    cl.insert(500, 1)
    o.insert(5, -5)
    println("cow ${o.len()} ${cl.len()} ${get_or(&o, 3, 0)} ${get_or(&cl, 3, 0)} ${get_or(&o, 4, 0)} ${get_or(&cl, 4, 0)} ${get_or(&o, 5, 0)} ${get_or(&cl, 5, 0)} ${digest(&o)} ${digest(&cl)}")
    let mut cl2 = o.clone()
    o.clear()
    cl2.insert(70, 70)
    println("cow2 ${o.len()} ${cl2.len()} ${digest(&cl2)}")

    // 9. a map passed by &mut to functions that read, fill and bump it
    let mut pm: HashMap<int, int> = HashMap::new()
    bump_all(&mut pm, 400)
    fill(&mut pm, 100, 164)
    bump_all(&mut pm, 400)
    println("param ${pm.len()} ${digest(&pm)}")

    // 10. an in-place update through the entry API and through get_mut (a mutable reference into the map)
    let mut em: HashMap<int, int> = HashMap::new()
    fill(&mut em, 0, 32)
    let mut x = 0
    while x < 100 {
        let e = em.entry(x % 40).or_insert(0)
        *e += 2
        x += 1
    }
    match em.get_mut(&7) {
        Some(v) => { *v = *v * 2 }
        None => {}
    }
    println("entry ${em.len()} ${digest(&em)}")

    // 11. a value that is not an int: only the ordinary store can hold it (here a map of the same shape built
    // with float values, and an int map gone back by a negative-key insert and a far key)
    let mut fm: HashMap<int, float> = HashMap::new()
    let mut f = 0
    while f < 40 {
        fm.insert(f, 0.5 * (f as float))
        f += 1
    }
    println("float ${fm.len()} ${fm.get(&9).unwrap()}")

    // 12. i32 and u64 values stay on the ordinary store: same answers, wide values exact
    let mut m32: HashMap<int, i32> = HashMap::new()
    let mut m64: HashMap<int, u64> = HashMap::new()
    let big: u64 = 18446744073709551000
    let mut w = 0
    while w < 70 {
        m32.insert(w, (w as i32) * 7 - 3)
        m64.insert(w, big + (w as u64) % 500)
        w += 1
    }
    let mut s32 = 0
    let mut s64: u64 = 0
    for v in m32.values() {
        s32 += *v as int
    }
    for v in m64.values() {
        s64 = (s64 + *v % 1000003) % 1000003
    }
    println("widths ${m32.len()} ${m64.len()} ${s32} ${s64} ${m64.get(&69).unwrap()}")

    // 13. extremes: values at the i64 limits, a key past the dense range, key 0
    let mut ex: HashMap<int, int> = HashMap::new()
    let mut e2 = 0
    while e2 < 16 {
        ex.insert(e2, 9223372036854775807 - e2)
        e2 += 1
    }
    ex.insert(0, -9223372036854775807 - 1)
    ex.insert(4294967295, 1)
    println("extremes ${ex.len()} ${get_or(&ex, 0, 5)} ${get_or(&ex, 15, 5)} ${get_or(&ex, 4294967295, 5)} ${digest(&ex)}")

    // 14. retain and extend over a typed array
    let mut rt: HashMap<int, int> = HashMap::new()
    fill(&mut rt, 0, 50)
    rt.retain(|k, v| k % 2 == 0 && v > 0)
    let mut ext: HashMap<int, int> = HashMap::new()
    ext.insert(1000, 1)
    rt.extend(ext)
    println("retain ${rt.len()} ${digest(&rt)}")
}

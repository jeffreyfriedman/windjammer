// An unsigned 64-bit dividend with a literal zero divisor late in a hot loop (machine code armed long before): the
// zero guard of the unsigned path must still exit to the closure engine: same panic, location and iteration.
fn main() {
    let mut t: u64 = 0
    let mut i: u64 = 0
    while i < 6000 {
        let a: u64 = i * 3 + 11
        t += a / 7 + a % 7
        if i == 4500 {
            t += a / 0
        }
        i += 1
    }
    println("${t}")
}

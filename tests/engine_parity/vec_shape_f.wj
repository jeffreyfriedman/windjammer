// Shape F: element writes of literals into a vec between calls.
fn at(v: Vec<float>, i: int) -> float {
    v[i as usize]
}

fn main() {
    let mut v: Vec<float> = vec![0.0; 100000]
    let mut s = 0.0
    let mut i = 0
    while i < 20 {
        v[i] = 1.5
        s += at(v, i)
        i += 1
    }
    println("${s}")
}

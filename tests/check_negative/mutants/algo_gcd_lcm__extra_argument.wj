// mutant: extra_argument of examples/verified/algo_gcd_lcm.wj
fn gcd(a: int, b: int) -> int {
    if b == 0 { a } else { gcd(b, a % b, 0) }
}

fn lcm(a: int, b: int) -> int {
    a / gcd(a, b) * b
}

fn main() {
    println("gcd(48, 18) = ${gcd(48, 18)}")
    println("gcd(17, 5) = ${gcd(17, 5)}")
    println("lcm(48, 18) = ${lcm(48, 18)}")
}

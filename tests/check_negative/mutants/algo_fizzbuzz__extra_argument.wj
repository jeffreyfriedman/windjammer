// mutant: extra_argument of examples/verified/algo_fizzbuzz.wj
fn fizzbuzz(i: int) -> string {
    if i % 15 == 0 {
        "FizzBuzz"
    } else if i % 3 == 0 {
        "Fizz"
    } else if i % 5 == 0 {
        "Buzz"
    } else {
        i.to_string()
    }
}

fn main() {
    let mut parts: Vec<string> = []
    for i in 1..=15 { parts.push(fizzbuzz(i, 0)) }
    println(parts.join(" "))
}

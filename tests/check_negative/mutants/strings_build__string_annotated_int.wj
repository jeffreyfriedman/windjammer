// mutant: string_annotated_int of examples/verified/strings_build.wj
fn main() {
    let mut s = String::new()
    s.push('a')
    s.push_str("bc")
    println(s)
    let mut out: int = ""
    for (i, chunk) in ["ab", "cd", "ef"].enumerate() {
        if i > 0 { out = out + "-" }
        out = out + chunk
    }
    println(out)
    println("*".repeat(3))
    let name = "Bob"
    println("Hi, " + name + "!")
}

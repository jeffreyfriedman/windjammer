// mutant: string_annotated_int of examples/verified/algo_caesar_cipher.wj
fn shift(s: string, k: int) -> string {
    let mut out: int = ""
    for c in s.chars() {
        if c >= 'a' && c <= 'z' {
            let base = 'a' as int
            let moved = ((c as int - base + k) % 26 + 26) % 26 + base
            out.push(moved as u8 as char)
        } else {
            out.push(c)
        }
    }
    out
}

fn main() {
    let enc = shift("hello, world", 3)
    println(enc)
    println(shift(enc, -3))
}

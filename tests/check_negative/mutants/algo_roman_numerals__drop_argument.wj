// mutant: drop_argument of examples/verified/algo_roman_numerals.wj
fn roman(n: int) -> string {
    let table = [
        (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
        (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
        (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I"),
    ]
    let mut left = n
    let mut out = ""
    for (value, symbol) in table {
        while left >= value {
            out = out + symbol
            left -= value
        }
    }
    out
}

fn main() {
    for n in [4, 9, 14, 1994, 2024] {
        println("${n} = ${roman()}")
    }
}

// mutant: drop_argument of examples/verified/algo_fibonacci.wj
fn fib(n: int) -> u64 {
    let mut a: u64 = 0
    let mut b: u64 = 1
    for _ in 0..n {
        let t = a + b
        a = b
        b = t
    }
    a
}

fn main() {
    let mut parts: Vec<string> = []
    for i in 0..15 { parts.push(fib().to_string()) }
    println(parts.join(" "))
    println("fib(50) = ${fib(50)}")
}

mkdir -p scripts && git -C $REPO show $ORIG:scripts/spec_check.sh > scripts/spec_check.sh && export LC_ALL=C && mkdir -p docs tests && cp -R $REPO/docs/spec docs/spec && cp -R $REPO/tests/spec tests/spec && bash scripts/spec_check.sh --write; cmp docs/spec/CONFORMANCE_MATRIX.md $REPO/docs/spec/CONFORMANCE_MATRIX.md && echo MATRIX-IDENTICAL; rm -rf docs tests; rc=$?; rm -rf scripts; exit $rc

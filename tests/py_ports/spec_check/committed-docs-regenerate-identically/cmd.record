mkdir -p scripts && git -C $REPO show $ORIG:scripts/spec_check.sh > scripts/spec_check.sh && export LC_ALL=C && mkdir -p docs tests && cp -R $REPO/docs/spec docs/spec && cp -R $REPO/tests/spec tests/spec && bash scripts/spec_check.sh --write; tail -n +2 docs/spec/CONFORMANCE_MATRIX.md > m1; tail -n +2 $REPO/docs/spec/CONFORMANCE_MATRIX.md > m2; cmp m1 m2 && echo MATRIX-IDENTICAL; rm -rf docs tests m1 m2; rc=$?; rm -rf scripts; exit $rc

mkdir -p examples && cp -R $REPO/examples/verified examples/verified && mkdir -p scripts && git -C $REPO show $ORIG:scripts/gen-check-mutants.py > scripts/gen-check-mutants.py && python3 scripts/gen-check-mutants.py && diff -r tests/check_negative/mutants $REPO/tests/check_negative/mutants && echo IDENTICAL; rc=$?; rm -rf tests examples scripts; exit $rc

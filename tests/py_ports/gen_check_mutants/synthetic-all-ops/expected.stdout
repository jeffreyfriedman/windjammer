// mutant: argument_wrong_type of examples/verified/a_unicode.wj
struct Counter {
    count: int,
    label: string,
}

fn add(a: int, b: int) -> int {
    a + b
}

fn greet(name: string) -> string {
    let msg: string = "héllo wörld — ${name}"
    msg
}

fn main() {
    let total: int = 5
    let name = "ünï"
    let n = 42
    let c = Counter { count: add("oops", 2), label: greet(name) }
    println("${c.count} ${total} ${n}")
    println("${c.label.len()}")
}

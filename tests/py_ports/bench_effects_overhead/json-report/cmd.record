mkdir -p scripts && git -C $REPO show $ORIG:scripts/bench_effects_overhead.py > scripts/bench_effects_overhead.py && (cd . && python3 scripts/bench_effects_overhead.py --wj $W/bin/fakewj --runs 2 --max-load 100000 --json out.json); sed -E "s/[0-9]+\.[0-9]+/#/g" out.json; rm -f out.json; rc=$?; rm -rf scripts; exit $rc

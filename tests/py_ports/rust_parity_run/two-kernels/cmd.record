mkdir -p benchmarks/rust_parity && git -C $REPO show $ORIG:benchmarks/rust_parity/run.py > benchmarks/rust_parity/run.py && PATH="$W/bin:$PATH" python3 benchmarks/rust_parity/run.py --optimize-rs $W/bin/optimize_rs --runs 2 --kernels sieve fib; rc=$?; sed -E "s/[0-9]+\.[0-9]+/#/g" benchmarks/rust_parity/results.json | head -60; rm -f benchmarks/rust_parity/results.json benchmarks/rust_parity/run.py; exit $rc

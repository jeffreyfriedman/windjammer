git -C $REPO show $ORIG:scripts/coverage_report.py > /tmp/orig-cov-$$.py; CR="python3 /tmp/orig-cov-$$.py"; D0=$(pwd -P); sed "s#@W@#$D0#g" export.in.json > export.json; sed "s#@W@#$D0#g" export2.in.json > export2.json; $CR --check export.json fresh/dir/base.json cli; cat fresh/dir/base.json | head -c 400; rc=$?; rm -f export.json export2.json /tmp/orig-cov-$$.py; exit $rc

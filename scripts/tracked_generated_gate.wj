// Fails when a git repository tracks generated files that belong in the cache: anything under a `.wj-cache/`
// directory, or a Rust crate surface generated into the cache (first line `// @generated by `wj rust-surface``,
// ADR-0026). Cache surfaces are regenerated on demand; a pinned `wj rust-surface --write` copy has a
// different header, is source and may be committed.
// Usage: wj run --interpret --allow process=git --allow 'fs.read=**' scripts/tracked_generated_gate.wj [repo-dir]
// Exit: 0 clean, 1 generated files are tracked, 2 the repository could not be listed (never a vacuous pass).
use std::process
use std::env
use std::fs
use std::strings

const MARKER: string = "// @generated by `wj rust-surface`"

fn main() {
    let args = env::args()
    let repo = if args.len() > 1 { args[1] } else { "." }
    let listing = match process.run_with_output("git", ["-C", repo, "ls-files"]) {
        Ok(o) => o.stdout,
        Err(e) => {
            println("gate: cannot list the tracked files of ${repo}: ${e}")
            process.exit(2)
            ""
        },
    }
    let mut seen = 0
    let mut bad = 0
    for path in strings.split_lines(listing) {
        if path.len() == 0 {
            continue
        }
        seen = seen + 1
        let in_cache = path.starts_with(".wj-cache/") || strings.contains(path, "/.wj-cache/")
        let generated = path.ends_with(".wji") && (fs.read_to_string(repo + "/" + path) ?? "").starts_with(MARKER)
        if in_cache || generated {
            println("tracked generated file: ${path}")
            bad = bad + 1
        }
    }
    if seen == 0 {
        println("gate: git listed no tracked files in ${repo}")
        process.exit(2)
    }
    if bad > 0 {
        println("gate: ${bad} generated file(s) are tracked; `git rm --cached` them (.wj-cache/ is regenerated on demand)")
        process.exit(1)
    }
    println("gate: ${seen} tracked files, none generated")
}

// Runs the samples extracted from the book (`wj-docs book-extract DIR` / tests/book_test.rs).
//
//   wj run scripts/book/book_samples.wj -- SAMPLES_DIR WJ_BIN SCRATCH_DIR [--compiled] [--wasm RUNNER [--wasm-known FILE]]
//                                    [--ts-playground RUNNER] [--only SUBSTR]
//
// Interpreted pass: every NAME.wj runs with `wj run --interpret`; exit status 0 and, when NAME.expect exists,
// stdout lines equal to it. NAME_test.wj files run with `wj test --interpret` and must pass.
// Compiled pass (--compiled): the same programs run through `wj run --compiled`, one project each, and their
// stdout must equal the interpreted stdout, so a sample cannot mean one thing to `wj run` and another to `wj build`.
// Multi-file projects under SAMPLES_DIR/projects run from their .root with `wj run`; output must equal their .expect lines.
// A sample with NAME.interp (a fence marked `interpreter_only` in the book) is not compiled.
// Playground pass (--wasm RUNNER, ADR-0034): every single-file program also runs through the browser playground's
// WebAssembly interpreter (`node RUNNER FILE`, docs/book/playground/run-node.mjs), and its exit status and stdout must
// equal the native `wj run --interpret` under the playground's own conditions: no grants (--sandbox), the seeded
// world (--simulate --seed 0) and the same fuel and output limits. --wasm-known FILE lists sample ids (`ID  reason`) the
// playground cannot run yet: they may differ, and a listed sample that agrees fails the run until its line is deleted.
// TypeScript playground pass (--ts-playground RUNNER): every `ts,run` companion also runs through the playground's
// type stripping and sandbox program (`node RUNNER FILE`, docs/book/playground/run-ts-node.mjs) and must print what
// `node --experimental-strip-types` prints.
// Exit status 1 when any sample fails; the report names the page and line of each.
use std::env
use std::fs
use std::process
use std::strings

fn quote(s: string) -> string {
    "'" + strings.replace(s, "'", "'\\''") + "'"
}

fn lines_of(text: string) -> Vec<string> {
    let mut out: Vec<string> = Vec::new()
    for l in strings.split(text, "\n") {
        out.push(strings.trim_end(l))
    }
    while out.len() > 0 && out[out.len() - 1] == "" {
        out.pop()
    }
    out
}

struct Ran {
    status: int,
    stdout: string,
    stderr: string,
}

fn sh(command: string) -> Ran {
    match process.run_with_output("sh", ["-c", command]) {
        Ok(o) => Ran { status: o.status as int, stdout: o.stdout, stderr: o.stderr },
        Err(e) => Ran { status: 127, stdout: "", stderr: e },
    }
}

fn tail(text: string, n: int) -> string {
    let ls = lines_of(text)
    let mut from = 0
    if ls.len() > n {
        from = ls.len() - n
    }
    let mut out: Vec<string> = Vec::new()
    let mut i = from
    while i < ls.len() {
        out.push(ls[i])
        i += 1
    }
    out.join("\n")
}

// name -> "page.md:line", from INDEX.tsv
fn origin(index: string, name: string) -> string {
    for l in strings.split(index, "\n") {
        let parts = strings.split(l, "\t")
        if parts.len() == 2 && parts[0] == name {
            return parts[1]
        }
    }
    "?"
}

// Test hook (tests/book_test.rs): with BOOK_PLANT_COMPILED_DIFF=SUBSTR set, the compiled output of every sample whose id
// contains SUBSTR gets an extra line, so the gate's own failure path can be exercised without any real compiler gap.
fn planted_extra(name: string) -> string {
    let want = env::var("BOOK_PLANT_COMPILED_DIFF").unwrap_or("")
    if want != "" && name.contains(want) {
        return "\nplanted difference"
    }
    ""
}

// Lines trimmed, blanks dropped: how generated code is compared with the excerpt a page shows.
fn norm(text: string) -> string {
    let mut out: Vec<string> = Vec::new()
    for l in strings.split(text, "\n") {
        let t = strings.trim(l)
        if t != "" {
            out.push(t)
        }
    }
    out.join("\n")
}

// Companion fences of a program (`go,run`, `ts,run`, `rust,generated`): "" when they agree, else the failure.
fn companions(dir: string, scratch: string, wj: string, name: string, at: string, want: Vec<string>, ts_runner: string) -> Vec<string> {
    let mut bad: Vec<string> = Vec::new()
    let work = scratch + "/companions"
    sh("mkdir -p " + quote(work))
    let go = dir + "/" + name + ".go"
    if fs::exists(go) {
        let r = sh("cd " + quote(work) + " && go run " + quote(go))
        if r.status != 0 {
            bad.push("${at} [${name}]: the Go version exited ${r.status}\n${tail(r.stdout + r.stderr, 12)}")
        } else if lines_of(r.stdout) != want {
            bad.push("${at} [${name}]: the Go version prints different output\n  windjammer: ${want:?}\n  go:         ${lines_of(r.stdout):?}")
        }
    }
    let ts = dir + "/" + name + ".ts"
    if fs::exists(ts) {
        let r = sh("cd " + quote(work) + " && node --experimental-strip-types " + quote(ts))
        if r.status != 0 {
            bad.push("${at} [${name}]: the TypeScript version exited ${r.status}\n${tail(r.stdout + r.stderr, 12)}")
        } else if lines_of(r.stdout) != want {
            bad.push("${at} [${name}]: the TypeScript version prints different output\n  windjammer: ${want:?}\n  typescript: ${lines_of(r.stdout):?}")
        }
        if ts_runner != "" {
            let p = sh("cd " + quote(work) + " && node " + quote(ts_runner) + " " + quote(ts))
            if p.status != r.status || lines_of(p.stdout) != lines_of(r.stdout) {
                bad.push("${at} [${name}]: the TypeScript playground differs from node (exit ${p.status} vs ${r.status})\n  node:       ${lines_of(r.stdout):?}\n  playground: ${lines_of(p.stdout):?}\n${tail(p.stderr, 8)}")
            }
        }
    }
    let rs = dir + "/" + name + ".rs.expect"
    if fs::exists(rs) {
        let out = work + "/" + name + "_gen"
        let r = sh(quote(wj) + " build --no-cargo " + quote(dir + "/" + name + ".wj") + " -o " + quote(out))
        let generated = fs::read_to_string(out + "/" + name + ".rs").unwrap_or("")
        if r.status != 0 || generated == "" {
            bad.push("${at} [${name}]: wj build --no-cargo produced no Rust (exit ${r.status})\n${tail(r.stdout + r.stderr, 12)}")
        } else if !norm(generated).contains(norm(fs::read_to_string(rs).unwrap_or(""))) {
            bad.push("${at} [${name}]: the Rust shown is not what the compiler generates (refresh the fence: wj-docs book-regen)\n  shown:\n${fs::read_to_string(rs).unwrap_or("")}\n  generated:\n${tail(generated, 60)}")
        }
    }
    bad
}

// The reason a sample is listed in the --wasm-known text (`ID  reason` lines, `#` comments), "" when it is not.
fn known_gap(list: string, name: string) -> string {
    for l in strings.split(list, "\n") {
        let t = strings.trim(l)
        if t != "" && !t.starts_with("#") {
            let parts = strings.split(t, " ")
            if parts.len() > 0 && parts[0] == name {
                let reason = strings.trim(t.substring(name.len(), t.len()))
                if reason == "" {
                    return "listed"
                }
                return reason
            }
        }
    }
    ""
}

// The playground's limits (docs/book/playground/wj-wasm.mjs DEFAULTS, crates/windjammer-playground Options).
fn playground_limits() -> string {
    "fuel=10000000,output=1048576"
}

// Playground pass: "" when the wasm interpreter agrees with the native one under the playground's conditions.
fn playground(wj: string, runner: string, src: string, cwd: string, at: string, name: string) -> string {
    let native = sh("cd " + quote(cwd) + " && " + quote(wj) + " run --interpret --sandbox --simulate --seed 0 --limits " + playground_limits() + " " + quote(src))
    let wasm = sh("cd " + quote(cwd) + " && node " + quote(runner) + " " + quote(src))
    if wasm.status != native.status {
        return "${at} [${name}]: playground exit ${wasm.status}, native exit ${native.status}\n  playground: ${tail(wasm.stdout + wasm.stderr, 8)}\n  native:     ${tail(native.stdout + native.stderr, 8)}"
    }
    if lines_of(wasm.stdout) != lines_of(native.stdout) {
        return "${at} [${name}]: playground output differs from native\n  native:     ${lines_of(native.stdout):?}\n  playground: ${lines_of(wasm.stdout):?}"
    }
    ""
}

fn main() {
    let args: Vec<string> = env::args().collect()
    if args.len() < 4 {
        println("usage: book_samples.wj SAMPLES_DIR WJ_BIN SCRATCH_DIR [--compiled] [--wasm RUNNER] [--only SUBSTR]")
        process.exit(2)
    }
    let dir = args[1]
    let wj = args[2]
    let scratch = args[3]
    let mut compiled = false
    let mut only = ""
    let mut wasm_runner = ""
    let mut wasm_known = ""
    let mut ts_runner = ""
    let mut i = 4
    while i < args.len() {
        if args[i] == "--compiled" {
            compiled = true
        } else if args[i] == "--ts-playground" && i + 1 < args.len() {
            ts_runner = args[i + 1]
            i += 1
        } else if args[i] == "--wasm-known" && i + 1 < args.len() {
            wasm_known = fs::read_to_string(args[i + 1]).unwrap_or("")
            i += 1
        } else if args[i] == "--wasm" && i + 1 < args.len() {
            wasm_runner = args[i + 1]
            i += 1
        } else if args[i] == "--only" && i + 1 < args.len() {
            only = args[i + 1]
            i += 1
        }
        i += 1
    }
    let index = fs::read_to_string(strings.replace(dir, "//", "/") + "/INDEX.tsv").unwrap_or("")
    let mut names: Vec<string> = Vec::new()
    match fs::read_dir(dir) {
        Ok(entries) => {
            for e in entries {
                let n = e.name()
                if n.ends_with(".wj") && (only == "" || n.contains(only)) {
                    names.push(strings.replace(n, ".wj", ""))
                }
            }
        },
        Err(e) => {
            println("cannot read ${dir}: ${e}")
            process.exit(2)
        },
    }
    names.sort()
    sh("rm -rf " + quote(scratch) + " && mkdir -p " + quote(scratch) + "/run " + quote(scratch) + "/proj")
    let mut failures: Vec<string> = Vec::new()
    let mut passed = 0
    let mut interpreted_out: Vec<string> = Vec::new()
    let mut programs: Vec<string> = Vec::new()
    let mut wasm_checked = 0
    let mut wasm_known_gaps = 0
    for name in names {
        let src = dir + "/" + name + ".wj"
        let at = origin(index, name)
        if name.ends_with("_test") {
            let tdir = scratch + "/run/" + name
            sh("mkdir -p " + quote(tdir) + " && cp " + quote(src) + " " + quote(tdir) + "/")
            let r = sh("cd " + quote(tdir) + " && " + quote(wj) + " test --interpret .")
            if r.status == 0 {
                passed += 1
            } else {
                failures.push("${at}: tests failed (exit ${r.status})\n${tail(r.stdout + r.stderr, 12)}")
            }
            continue
        }
        let r = sh("cd " + quote(scratch + "/run") + " && " + quote(wj) + " run --interpret " + quote(src))
        let mut ok = true
        if r.status != 0 {
            ok = false
            failures.push("${at} [${name}]: interpreter exit ${r.status}\n${tail(r.stdout + r.stderr, 12)}")
        } else {
            let exp_path = dir + "/" + name + ".expect"
            if fs::exists(exp_path) {
                let want = lines_of(fs::read_to_string(exp_path).unwrap_or(""))
                let got = lines_of(r.stdout)
                if want != got {
                    ok = false
                    failures.push("${at} [${name}]: interpreted output differs\n  expected: ${want:?}\n  got:      ${got:?}")
                }
            }
        }
        if ok {
            passed += 1
            for b in companions(dir, scratch, wj, name, at, lines_of(r.stdout), ts_runner) {
                failures.push(b)
            }
            if wasm_runner != "" {
                let w = playground(wj, wasm_runner, src, scratch + "/run", at, name)
                let gap = known_gap(wasm_known, name)
                if w == "" && gap == "" {
                    wasm_checked += 1
                } else if w == "" {
                    failures.push("${at} [${name}]: the playground now agrees with native: delete its line from the --wasm-known list (${gap})")
                } else if gap == "" {
                    failures.push(w)
                } else {
                    wasm_known_gaps += 1
                }
            }
            if !fs::exists(dir + "/" + name + ".interp") {
                programs.push(name)
                interpreted_out.push(r.stdout)
            }
        }
    }
    // Multi-file projects (`projects/ID/`, written by tools/docs_truth/book_projects.rs): run in place of a sample.
    let pdir = dir + "/projects"
    let pindex = fs::read_to_string(pdir + "/INDEX.tsv").unwrap_or("")
    let mut project_names: Vec<string> = Vec::new()
    let mut project_roots: Vec<string> = Vec::new()
    let mut project_out: Vec<string> = Vec::new()
    let mut project_passed = 0
    let mut pnames: Vec<string> = Vec::new()
    if fs::exists(pdir) {
        match fs::read_dir(pdir) {
            Ok(entries) => {
                for e in entries {
                    let n = e.name()
                    if fs::is_dir(pdir + "/" + n) && (only == "" || n.contains(only)) {
                        pnames.push(n)
                    }
                }
            },
            Err(_) => {},
        }
    }
    pnames.sort()
    for pname in pnames {
        let at = origin(pindex, pname)
        let copy = scratch + "/projects/" + pname
        sh("mkdir -p " + quote(scratch + "/projects") + " && cp -R " + quote(pdir + "/" + pname) + " " + quote(copy))
        let root = strings.trim(fs::read_to_string(copy + "/.root").unwrap_or(""))
        let want = lines_of(fs::read_to_string(copy + "/.expect").unwrap_or(""))
        let proot = copy + "/" + root
        let r = sh("cd " + quote(proot) + " && " + quote(wj) + " run --interpret")
        if r.status != 0 {
            failures.push("${at} [${pname}]: project exit ${r.status}\n${tail(r.stdout + r.stderr, 12)}")
        } else if lines_of(r.stdout) != want {
            failures.push("${at} [${pname}]: project output differs\n  expected: ${want:?}\n  got:      ${lines_of(r.stdout):?}")
        } else {
            project_passed += 1
            project_names.push(pname)
            project_roots.push(proot)
            project_out.push(r.stdout)
        }
    }
    let mut compiled_checked = 0
    if compiled {
        // One project per sample: bins of one project share function signatures by name, and a sample must not
        // see another sample's `load`.
        let mut k = 0
        while k < programs.len() {
            let name = programs[k]
            let at = origin(index, name)
            let proj = scratch + "/iso/" + name
            sh("mkdir -p " + quote(proj + "/src") + " && cp " + quote(dir + "/" + name + ".wj") + " " + quote(proj + "/src/main.wj"))
            fs::write(proj + "/wj.toml", "[package]\nname = \"sample_" + strings.replace(name, "-", "_") + "\"\nversion = \"0.1.0\"\nedition = \"2025\"\n").unwrap_or(())
            let r = sh("cd " + quote(proj) + " && " + quote(wj) + " run --compiled")
            if r.status != 0 {
                failures.push("${at} [${name}]: compiled run exit ${r.status}\n${tail(r.stdout + r.stderr, 15)}")
            } else if lines_of(r.stdout + planted_extra(name)) != lines_of(interpreted_out[k]) {
                failures.push("${at} [${name}]: compiled output differs from interpreted\n  interpreted: ${lines_of(interpreted_out[k]):?}\n  compiled:    ${lines_of(r.stdout):?}")
            } else {
                compiled_checked += 1
            }
            k += 1
        }
    }
    if compiled {
        let mut q = 0
        while q < project_names.len() {
            let at = origin(pindex, project_names[q])
            let r = sh("cd " + quote(project_roots[q]) + " && " + quote(wj) + " run --compiled")
            if r.status != 0 {
                failures.push("${at} [${pname}]: project compiled run exit ${r.status}\n${tail(r.stdout + r.stderr, 15)}")
            } else if lines_of(r.stdout) != lines_of(project_out[q]) {
                failures.push("${at} [${pname}]: project compiled output differs from interpreted\n  interpreted: ${lines_of(project_out[q]):?}\n  compiled:    ${lines_of(r.stdout):?}")
            } else {
                compiled_checked += 1
            }
            q += 1
        }
    }
    for f in failures {
        println("FAIL ${f}")
    }
    let mut wasm_note = ""
    if wasm_runner != "" {
        wasm_note = ", ${wasm_checked} playground-checked, ${wasm_known_gaps} known playground gaps"
    }
    println("book samples: ${passed} passed interpreted, ${project_passed} projects, ${compiled_checked} compiled-checked${wasm_note}, ${failures.len()} failed")
    if failures.len() > 0 {
        process.exit(1)
    }
}

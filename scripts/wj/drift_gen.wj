// Value-kind x position program generator for the drift gate: seeded programs whose cells put an Option,
// Result, enum or Option<string> value in one value position (match arm result, return, return from a loop,
// closure, struct field, nested match, shadowing, Vec element, if-expression, bool match) on a hit and on a
// miss. Oracles: the tree walker for the resolved engine (stdout and exit status), and rustc for the compiled
// backend (the generated Rust must type-check); `--run-compiled` also runs the compiled program and compares.
//
//   wj run scripts/wj/drift_gen.wj <wj-binary> <outdir> <out.tsv> [--seeds A..B] [--run-compiled] [--only-write]
//
// Rows (id <TAB> walker <TAB> resolved <TAB> compiled), like drift_corpus.wj:
//   gen/seed-N          exit<N>:<bytes>:<checksum> of stdout under each engine (compiled: skip, or with --run-compiled)
//   gen/seed-N#rustc    `typechecks` | `typechecks` | rustc's first error code for the generated Rust
// The seed list is fixed (default 1..40), so rows are stable and the ledger can name them.
use std::env
use std::fs
use std::process
use std::strings
use wj_proc::sh
use wj_proc::quote

const PRELUDE: string = "tests/drift_corpus/gen/prelude.wj"
const KINDS: usize = 5
const POSITIONS: usize = 10
const CELLS: usize = 6

fn next(s: int) -> int {
    (s * 1103515245 + 12345) % 2147483648
}

fn ty(k: int) -> string {
    if k == 0 || k == 4 { "Option<int>" } else if k == 1 { "Result<int, string>" } else if k == 2 { "Shape3" } else { "Option<string>" }
}

fn show(k: int) -> string {
    if k == 0 || k == 4 { "show_opt" } else if k == 1 { "show_res" } else if k == 2 { "show_enm" } else { "show_ostr" }
}

// the hit value; `v` is the payload, `alt` picks the enum variant
fn hit(k: int, v: int, alt: bool) -> string {
    if k == 0 {
        "Some(num(${v}))"
    } else if k == 1 {
        "Ok(num(${v}))"
    } else if k == 2 {
        if alt { "Shape3::C { n: num(${v}) }" } else { "Shape3::B(num(${v}))" }
    } else {
        "Some(\"s${v}\")"
    }
}

fn miss(k: int) -> string {
    if k == 0 { "None" } else if k == 1 { "Err(\"bad\")" } else if k == 2 { "Shape3::A" } else { "None" }
}

// a match over `x` that rebuilds the value; `bare` uses a bare unit-variant name as a pattern for the enum
fn rebuild(k: int, x: string, bare: bool) -> string {
    if k == 0 || k == 4 {
        "match ${x} { Some(a) => Some(a + num(1)), None => None }"
    } else if k == 1 {
        "match ${x} { Ok(a) => Ok(a + num(1)), Err(e) => Err(e) }"
    } else if k == 2 {
        if bare {
            "match ${x} { A => Shape3::A, Shape3::B(a) => Shape3::B(a + num(1)), Shape3::C { n } => Shape3::C { n: n + num(1) } }"
        } else {
            "match ${x} { Shape3::A => Shape3::A, Shape3::B(a) => Shape3::B(a + num(1)), Shape3::C { n } => Shape3::C { n: n + num(1) } }"
        }
    } else {
        "match ${x} { Some(s) => Some(s + \"!\"), None => None }"
    }
}

struct Pick {
    kind: int,
    pos: int,
    v: int,
    alt: bool,
    bare: bool,
}

fn cell(i: int, p: Pick) -> string {
    let t = ty(p.kind)
    let s = show(p.kind)
    let mk = "mk_${i}(h)"
    // a bare unit-variant pattern in a rebuilding `let` match is emitted as a binding (repros/bare_unit_pattern_in_let_match.wj);
    // DRIFT_GEN_BARE=1 turns the style back on
    let bare = p.bare && env::var("DRIFT_GEN_BARE").unwrap_or("") == "1"
    let r = |x: string| rebuild(p.kind, x, bare)
    let mut decls = "fn mk_${i}(h: bool) -> ${t} {\n    if h { ${hit(p.kind, p.v, p.alt)} } else { ${miss(p.kind)} }\n}\n\n"
    if p.kind == 4 {
        // the value comes from a map lookup whose arms yield `Some(..)` / the value `None`
        decls = "fn mk_${i}(h: bool) -> ${t} {\n    let mut m: HashMap<string, int> = HashMap::new()\n    m.insert(\"a\", num(${p.v}))\n    let key = if h { \"a\" } else { \"z\" }\n    match m.get(key) {\n        Some(v) => Some(*v),\n        None => None,\n    }\n}\n\n"
    }
    let mut body = ""
    if p.pos == 0 {
        body = "    let y: ${t} = ${r(mk)}\n    ${s}(y)\n"
    } else if p.pos == 1 {
        decls = decls + "fn step_${i}(x: ${t}) -> ${t} {\n    ${r("x")}\n}\n\n"
        body = "    ${s}(step_${i}(${mk}))\n"
    } else if p.pos == 2 {
        decls = decls + "fn scan_${i}(x: ${t}, n: int) -> ${t} {\n    let mut i: int = 0\n    while i < n {\n        if i == num(2) {\n            return ${r("x")}\n        }\n        i += num(1)\n    }\n    x\n}\n\n"
        body = "    ${s}(scan_${i}(${mk}, num(5))) + \"/\" + ${s}(scan_${i}(${mk}, num(1)))\n"
    } else if p.pos == 3 {
        body = "    let c = || ${r(mk)}\n    ${s}(c())\n"
    } else if p.pos == 4 {
        decls = decls + "struct Holder_${i} {\n    f: ${t},\n}\n\n"
        body = "    let b = Holder_${i} { f: ${mk} }\n    ${s}(${r("b.f")})\n"
    } else if p.pos == 5 {
        body = "    ${s}(${r(r(mk))})\n"
    } else if p.pos == 6 {
        body = "    let x: ${t} = ${mk}\n    let x: ${t} = ${r("x")}\n    let x: ${t} = ${r("x")}\n    ${s}(x)\n"
    } else if p.pos == 7 {
        body = "    let xs: Vec<${t}> = [${mk}, mk_${i}(true), mk_${i}(false)]\n    let mut out = \"\"\n    for e in xs {\n        out = out + ${s}(${r("e")}) + \",\"\n    }\n    out\n"
    } else if p.pos == 8 {
        body = "    let y: ${t} = if h { ${r(mk)} } else { ${mk} }\n    ${s}(y)\n"
    } else {
        body = "    let y: ${t} = match h {\n        true => ${r(mk)},\n        false => ${mk},\n    }\n    ${s}(y)\n"
    }
    decls + "fn cell_${i}(h: bool) -> string {\n" + body + "}\n\n"
}

fn program(seed: int, prelude: string) -> string {
    let mut st = seed * 7919 + 13
    let mut cells = ""
    let mut calls = ""
    let mut i = 0
    while i < CELLS as int {
        st = next(st)
        let kind = (st / 7) % KINDS as int
        st = next(st)
        let pos = (st / 7) % POSITIONS as int
        st = next(st)
        let v = (st / 7) % 90 + 1
        st = next(st)
        let alt = (st / 7) % 2 == 0
        st = next(st)
        let bare = (st / 7) % 2 == 0
        cells = cells + cell(i, Pick { kind: kind, pos: pos, v: v, alt: alt, bare: bare })
        calls = calls + "    println(cell_${i}(true))\n    println(cell_${i}(false))\n"
        i += 1
    }
    prelude + "\n" + cells + "fn main() {\n" + calls + "}\n"
}

fn checksum(s: string) -> string {
    let mut h = 17
    for b in s.as_bytes() {
        h = (h * 31 + (b as int)) % 1000000007
    }
    "${s.len()}:${h}"
}

fn run(wj: string, engine: string, file: string) -> string {
    let cmd = "${quote(wj)} run --interpret --no-lint --deterministic-time --engine ${engine} ${quote(file)} < /dev/null"
    match sh(cmd) {
        Ok(r) => "exit${r.status}:${checksum(r.stdout)}",
        Err(_) => "error",
    }
}

fn run_compiled(wj: string, file: string) -> string {
    let w = env::var("WJ_CARGO_WRAPPER").unwrap_or("")
    match sh("${w} ${quote(wj)} run --compiled --no-lint ${quote(file)}") {
        Ok(r) => "exit${r.status}:${checksum(r.stdout)}",
        Err(_) => "error",
    }
}

// rustc's verdict on the generated Rust: `typechecks` or its first error code
fn rustc_verdict(wj: string, dir: string, file: string) -> string {
    let out = "${dir}/rs_${strings.replace(file, "/", "_")}"
    let cmd = "rm -rf ${quote(out)} && ${quote(wj)} build --no-cargo --no-lint -o ${quote(out)} ${quote(file)} > /dev/null 2>&1; f=$(ls ${quote(out)}/*.rs 2>/dev/null | head -1); if [ -z \"$f\" ]; then echo wj-build-error; else rustc --edition 2021 --emit=metadata -A warnings --out-dir ${quote(out)} \"$f\" 2>&1 | grep -o 'error\\[E[0-9]*\\]' | head -1 | tr -d 'error[]' | sed 's/^$/typechecks/'; fi"
    match sh(cmd) {
        Ok(r) => {
            let v = strings.trim(r.stdout)
            if v == "" { "typechecks" } else { v }
        },
        Err(_) => "error",
    }
}

fn main() {
    let args = env::args()
    let wj = args[1]
    let dir = args[2]
    let out = args[3]
    let mut lo = 1
    let mut hi = 40
    let mut compiled = false
    let mut i = 4
    while i < args.len() {
        if args[i] == "--seeds" {
            let parts = strings.split(args[i + 1], "..")
            lo = parts[0].parse::<int>().unwrap_or(1)
            hi = parts[1].parse::<int>().unwrap_or(40)
            i += 1
        } else if args[i] == "--run-compiled" {
            compiled = true
        }
        i += 1
    }
    let prelude = fs.read_to_string(PRELUDE).unwrap_or("")
    let _ = sh("mkdir -p ${quote(dir)}")
    let mut rows = ""
    let mut seed = lo
    while seed <= hi {
        let file = "${dir}/gen_${seed}.wj"
        let _ = fs.write(file, program(seed, prelude))
        let w = run(wj, "walker", file)
        let r = run(wj, "resolved", file)
        let c = if compiled { run_compiled(wj, file) } else { "skip" }
        let id = "gen/seed-${seed}"
        rows = rows + "${id}\t${w}\t${r}\t${c}\n"
        rows = rows + "${id}#runs\t${if strings.starts_with(w, "exit0:") { "runs" } else { "broken" }}\t${if strings.starts_with(r, "exit0:") { "runs" } else { "broken" }}\truns\n"
        rows = rows + "${id}#rustc\ttypechecks\ttypechecks\t${rustc_verdict(wj, dir, file)}\n"
        seed += 1
    }
    match fs.write(out, rows) {
        Ok(_) => println("  generated ${hi - lo + 1} programs (seeds ${lo}..${hi})"),
        Err(e) => {
            println("cannot write ${out}: ${e}")
            process.exit(2)
        },
    }
}

// Ratcheting test runner: fails only on NEW test failures.
// Known failures are tracked in .config/known-test-failures.txt
//
//   wj run scripts/wj/check_test_ratchet.wj [cargo-test-args...]     (run from the repository root)
//   wj run scripts/wj/check_test_ratchet.wj --release --test all -- specific_test
use std::env
use std::fs
use std::process
use std::strings

const KNOWN: string = ".config/known-test-failures.txt"
const OUTPUT_COPY: string = "/tmp/test-ratchet-output.txt"

// run `cargo test ARGS` with stderr folded into stdout; the output reaches the terminal as it is produced and a copy lands in
// OUTPUT_COPY. Returns cargo's exit status (not tee's).
fn cargo_test_tee(args: Vec<string>) -> int {
    let mut argv = ["-c", "cargo test \"$@\" 2>&1 | tee " + OUTPUT_COPY + "; exit $${PIPESTATUS[0]}", "bash"]
    for a in args {
        argv.push(a)
    }
    match process.run_inherit("bash", argv) {
        Ok(code) => code as int,
        Err(e) => {
            println("cannot run cargo: ${e}")
            127
        },
    }
}

// lines of `a` that are not in `b` (both sorted): `comm -23`, duplicates matched pairwise
fn only_in_first(a: Vec<string>, b: Vec<string>) -> Vec<string> {
    let mut out = Vec::new()
    let mut i = 0
    let mut j = 0
    while i < a.len() {
        if j >= b.len() {
            out.push(a[i])
            i = i + 1
        } else if a[i] == b[j] {
            i = i + 1
            j = j + 1
        } else if a[i] < b[j] {
            out.push(a[i])
            i = i + 1
        } else {
            j = j + 1
        }
    }
    out
}

fn main() {
    let args = env.args()
    let mut cargo_args: Vec<string> = Vec::new()
    let mut k = 1
    while k < args.len() {
        cargo_args.push(args[k])
        k = k + 1
    }
    if !fs.is_file(KNOWN) {
        println("⚠️  No known-failures file at ${KNOWN} — running tests normally")
        let mut plain = ["test"]
        for a in cargo_args {
            plain.push(a)
        }
        let code = match process.run_inherit("cargo", plain) {
            Ok(c) => c,
            Err(e) => {
                println("cannot run cargo: ${e}")
                127
            },
        }
        process.exit(code)
    }
    // strip comments and blank lines so a header-only file stays empty for the ratchet
    let mut known: Vec<string> = Vec::new()
    for line in strings.split_lines(fs.read_to_string(KNOWN) ?? "") {
        let t = strings.trim(line)
        if t.len() == 0 || t.starts_with("#") {
            continue
        }
        known.push(line)
    }
    known.sort()
    println("🔧 Running tests with ratcheting (known failures: ${known.len()})")
    println("")
    let code = cargo_test_tee(cargo_args)
    let lines = strings.split_lines(fs.read_to_string(OUTPUT_COPY) ?? "")
    if code == 0 {
        println("")
        println("✅ All tests passed!")
        process.exit(0)
    }
    let mut actual: Vec<string> = Vec::new()
    for l in lines {
        if l.starts_with("test ") && l.ends_with(" ... FAILED") {
            actual.push(l[5..l.len() - 11].to_string())
        }
    }
    actual.sort()
    if actual.len() == 0 {
        println("❌ Tests failed but couldn't parse failure list")
        process.exit(1)
    }
    let new_failures = only_in_first(actual, known)
    let fixed = only_in_first(known, actual)
    let bar = strings.repeat("━", 42)
    println("")
    println(bar)
    println("📊 Ratchet Report")
    println(bar)
    println("   Known failures: ${known.len()}")
    println("   Actual failures: ${actual.len()}")
    if fixed.len() > 0 {
        println("")
        println("🎉 ${fixed.len()} test(s) now PASSING — remove from known-test-failures.txt:")
        for f in fixed {
            println("   ✓ ${f}")
        }
    }
    if new_failures.len() > 0 {
        println("")
        println("❌ ${new_failures.len()} NEW failure(s) — these must be fixed:")
        for f in new_failures {
            println("   ✗ ${f}")
        }
        println("")
        println("To add to known failures (if intentional): append to ${KNOWN}")
        process.exit(1)
    }
    println("")
    println("✅ No new failures introduced. Ratchet holds.")
    process.exit(0)
}

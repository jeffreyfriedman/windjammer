// Mutation self-test of the drift budget: plants each kind of divergence in a synthetic result file and
// checks that scripts/wj/drift_ledger.wj fails for it, and passes when nothing is wrong.
//
//   wj run scripts/wj/drift_selftest.wj [wj-binary]
use std::env
use std::fs
use std::process
use std::strings
use wj_proc::sh
use wj_proc::quote

const DIR: string = "/tmp/wj-drift-selftest"

fn run_ledger(wj: string, results: string, ledger: string, extra: string, envs: string) -> string {
    let _ = sh("mkdir -p ${DIR}")
    let _ = fs.write("${DIR}/r.tsv", results)
    let _ = fs.write("${DIR}/l.txt", ledger)
    let _ = fs.write("${DIR}/b.txt", "kept | walker=pass resolved=fail compiled=pass | old\n")
    let cmd = "${envs} ${quote(wj)} run --interpret scripts/wj/drift_ledger.wj ${DIR}/r.tsv ${DIR}/l.txt ${extra} 2>&1; echo \"exit=$?\""
    match sh(cmd) {
        Ok(r) => r.stdout,
        Err(e) => "error ${e}",
    }
}

fn run_probe(wj: string, engine: string) -> string {
    let cmd = "cd tests/drift_corpus/engine_probe && WJ_TEST_ENGINE=${engine} ${quote(wj)} test --interpret 2>&1; echo \"exit=$?\""
    match sh(cmd) {
        Ok(r) => r.stdout,
        Err(e) => "error ${e}",
    }
}

struct Check {
    name: string,
    out: string,
    exit: int,
    needle: string,
}

fn verdict(c: Check) -> string {
    let got_exit = if strings.contains(c.out, "exit=0") { 0 } else { 1 }
    if got_exit != c.exit {
        return "${c.name}: expected exit ${c.exit}, got ${got_exit}\n${c.out}"
    }
    if c.needle != "" && !strings.contains(c.out, c.needle) {
        return "${c.name}: output lacks `${c.needle}`\n${c.out}"
    }
    ""
}

fn main() {
    let args = env::args()
    let wj = if args.len() > 1 { args[1] } else { "wj" }
    let agree = "a\tpass\tpass\tpass\nb\texit0:3:7\texit0:3:7\tskip\n"
    let split = "a\tpass\tpass\tpass\nb\tpass\tfail\tpass\n"
    let sig = "b | walker=pass resolved=fail compiled=pass | planted\n"
    let mut checks: Vec<Check> = Vec::new()
    checks.push(Check { name: "agreement passes", out: run_ledger(wj, agree, "", "", ""), exit: 0, needle: "0 divergent" })
    checks.push(Check { name: "skip is not a divergence", out: run_ledger(wj, "a\tpass\tpass\tskip\n", "", "", ""), exit: 0, needle: "" })
    checks.push(Check { name: "a new divergence fails", out: run_ledger(wj, split, "", "", ""), exit: 1, needle: "new       b" })
    checks.push(Check { name: "a ledgered divergence passes", out: run_ledger(wj, split, sig, "", ""), exit: 0, needle: "1 divergent" })
    checks.push(Check { name: "a changed divergence fails", out: run_ledger(wj, "a\tpass\tpass\tpass\nb\tfail\tpass\tpass\n", sig, "", ""), exit: 1, needle: "changed   b" })
    checks.push(Check { name: "a vanished divergence fails", out: run_ledger(wj, agree, sig, "", ""), exit: 1, needle: "stale     b" })
    checks.push(Check { name: "an entry without a case fails", out: run_ledger(wj, agree, "zz | walker=a resolved=b compiled=c | x\n", "", ""), exit: 1, needle: "not in the corpus" })
    checks.push(Check { name: "too few cases fail", out: run_ledger(wj, agree, "", "--min-cases 5", ""), exit: 1, needle: "vacuous" })
    checks.push(Check { name: "an empty run fails", out: run_ledger(wj, "", "", "--min-cases 1", ""), exit: 1, needle: "vacuous" })
    let grown = "kept | walker=pass resolved=fail compiled=pass | old\nb | walker=pass resolved=fail compiled=pass | planted\n"
    let split2 = "kept\tpass\tfail\tpass\nb\tpass\tfail\tpass\n"
    checks.push(Check { name: "ledger growth fails", out: run_ledger(wj, split2, grown, "--base-ledger ${DIR}/b.txt", ""), exit: 1, needle: "grew      b" })
    checks.push(Check { name: "growth can be recorded", out: run_ledger(wj, split2, grown, "--base-ledger ${DIR}/b.txt", "DRIFT_ALLOW_GROWTH=1"), exit: 0, needle: "" })
    // WJ_TEST_ENGINE must really switch engines: the probe passes under the walker and fails under the
    // resolved engine, or the corpus would compare an engine with itself
    checks.push(Check { name: "the walker runs the engine probe", out: run_probe(wj, "walker"), exit: 0, needle: "1 passed" })
    checks.push(Check { name: "the resolved engine runs the engine probe", out: run_probe(wj, "resolved"), exit: 1, needle: "1 failed" })
    let mut bad = 0
    for c in checks {
        let v = verdict(c)
        if v != "" {
            println("FAIL ${v}")
            bad += 1
        }
    }
    println("drift selftest: ${checks.len() - bad}/${checks.len()} checks")
    if bad > 0 {
        process.exit(1)
    }
}

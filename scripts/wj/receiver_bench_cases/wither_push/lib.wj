pub struct Graph {
    pub n: i32,
}

pub struct Builder {
    pub graph: Graph,
    pub items: Vec<i32>,
    pub label: string,
}

impl Builder {
    pub fn push(self, x: i32) -> Builder {
        let mut items = self.items
        items.push(x)
        Builder {
            graph: self.graph,
            items: items,
            label: self.label,
        }
    }
}

struct Binding {
    name: string,
}

struct PassDef {
    bindings: Vec<Binding>,
    dispatch_x: u32,
}

struct Builder {
    bindings: Vec<Binding>,
    dispatch_x: u32,
    passes: Vec<PassDef>,
}

impl Builder {
    pub fn build(self) -> Vec<PassDef> {
        let pass = PassDef { bindings: self.bindings, dispatch_x: self.dispatch_x }
        let mut passes = self.passes
        passes.push(pass)
        passes
    }
}

// Sync the version number across the README files and crate manifests.
//
//   wj run scripts/wj/sync_version.wj [VERSION]     (run from the repository root; default: the workspace version)
use std::env
use std::fs
use std::process
use std::regex
use std::strings

fn version_re() -> string {
    "[0-9]+\\.[0-9]+\\.[0-9]+"
}

// `sed 's/PATTERN/REPLACEMENT/'` on every line: the first match per line is replaced
fn replace_per_line(text: string, pattern: string, replacement: string) -> string {
    let re = regex.compile(pattern) ?? regex.compile("^$") ?? panic("bad pattern")
    let mut out = Vec::new()
    for line in text.split("\n") {
        out.push(re.replace(line, replacement))
    }
    out.join("\n")
}

fn read(path: string) -> string {
    fs.read_to_string(path) ?? ""
}

fn detect_version() -> string {
    let lines = strings.split_lines(read("Cargo.toml"))
    let mut i = 0
    while i < lines.len() {
        if lines[i].starts_with("[workspace.package]") && i + 1 < lines.len() && lines[i + 1].starts_with("version") {
            let rest = lines[i + 1]
            match rest.find("version = \"") {
                Some(p) => {
                    let after = rest[p + 11..rest.len()].to_string()
                    return match after.rfind("\"") {
                        Some(q) => after[0..q].to_string(),
                        None => after,
                    }
                },
                None => return rest,
            }
        }
        i = i + 1
    }
    ""
}

fn crate_dirs() -> Vec<string> {
    let mut dirs: Vec<string> = Vec::new()
    match fs.read_dir("crates") {
        Ok(entries) => {
            for e in entries {
                if e.is_dir() {
                    dirs.push(e.path())
                }
            }
        },
        Err(_) => {},
    }
    dirs.sort()
    dirs
}

fn main() {
    let args = env.args()
    let mut version = if args.len() >= 2 { args[1] } else { "" }
    if version.len() == 0 {
        version = detect_version()
        println("📦 Detected version from Cargo.toml: ${version}")
    } else {
        println("📦 Using provided version: ${version}")
    }
    if version.len() == 0 {
        println("❌ Error: Could not determine version")
        println("Usage: sync_version.wj [version]")
        process.exit(1)
    }
    println("🔄 Syncing version ${version} across project files...")

    let readme = read("README.md")
    if readme.contains("Current Version:") {
        let _ = fs.write("README.md", replace_per_line(readme, "Current Version:\\*\\* " + version_re(), "Current Version:** " + version))
        println("✅ Updated README.md")
    } else {
        println("⚠️  Warning: Could not find version in README.md")
    }

    if fs.is_file("ROADMAP.md") && read("ROADMAP.md").contains("Current Version") {
        let _ = fs.write("ROADMAP.md", replace_per_line(read("ROADMAP.md"), "Current Version: " + version_re(), "Current Version: " + version))
        println("✅ Updated ROADMAP.md")
    }

    let readme_now = read("README.md")
    if readme_now.contains("cargo install windjammer --version") {
        let _ = fs.write("README.md", replace_per_line(readme_now, "cargo install windjammer --version " + version_re(), "cargo install windjammer --version " + version))
        println("✅ Updated installation command in README.md")
    }

    let dirs = crate_dirs()
    for d in dirs {
        let toml = d + "/Cargo.toml"
        if fs.is_file(toml) {
            let text = read(toml)
            let mut explicit = false
            for line in text.split("\n") {
                if line.starts_with("version = \"") && line.len() > 11 && line[11..12].to_string() >= "0" && line[11..12].to_string() <= "9" {
                    explicit = true
                }
            }
            if explicit {
                let _ = fs.write(toml, replace_per_line(text, "^version = \"" + version_re() + "\"", "version = \"" + version + "\""))
                println("✅ Updated ${toml}")
            }
        }
    }
    for d in dirs {
        let rd = d + "/README.md"
        if fs.is_file(rd) {
            let text = read(rd)
            if regex.is_match("Windjammer v[0-9]", text) ?? false {
                let _ = fs.write(rd, replace_per_line(text, "Windjammer v" + version_re(), "Windjammer v" + version))
                println("✅ Updated ${rd}")
            }
        }
    }

    println("")
    println("✨ Version sync complete!")
    println("")
    println("📝 Files updated:")
    let changed = wj_proc::git_changed(".") ?? Vec::new()
    let mut shown = 0
    for f in changed {
        if f.ends_with(".md") || f.ends_with(".toml") {
            println(f)
            shown = shown + 1
        }
    }
    if shown == 0 {
        println("  (no changes detected)")
    }
    println("")
    println("🔍 Review changes with: git diff")
    println("💾 Commit with: git add -A && git commit -m 'chore: Sync version to ${version}'")
}

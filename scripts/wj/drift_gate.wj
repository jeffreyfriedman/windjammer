// The drift gate: one command that fails when the interpreter and the compiled output disagree.
//
//   wj run scripts/wj/drift_gate.wj [--wj BIN] [--fast] [--compiled recorded|live|skip]
//
// Steps (docs/testing/DRIFT.md):
//   selftest   the ledger comparer and the corpus tokens, against planted divergences
//   parity     engine_parity: walker == resolved on every corpus program (and the machine-code loop tier)
//   fast-paths every fast path fires on its programs (a silent fallback is invisible to parity)
//   jit-loops  generated loop programs: walker == resolved == no-jit
//   packed-vec packed vectors == boxed vectors
//   corpus     (plus 40 generated value-kind x position programs, drift_gen.wj) ecosystem tests + value-position programs: walker, resolved and compiled agree, or the
//              divergence is in tests/drift_corpus/known_divergences.txt (a shrink-only ledger)
// `--fast` skips the cargo steps (selftest and corpus only). WJ_CARGO_WRAPPER prefixes every cargo and
// compiled run (a build-slot gate); DRIFT_BASE_REF (default next/v0.50.0) names the ref the ledger may only
// shrink against. Exit status 1 when any step fails.
use std::env
use std::process
use std::strings
use wj_proc::sh
use wj_table::new
use wj_table::add_row
use wj_table::plain

const LEDGER: string = "tests/drift_corpus/known_divergences.txt"
const RESULTS: string = "/tmp/wj-drift-results.tsv"
const GEN_RESULTS: string = "/tmp/wj-drift-gen.tsv"
const BASE_COPY: string = "/tmp/wj-drift-base-ledger.txt"
const MIN_CASES: string = "1300"

struct Step {
    name: string,
    cases: string,
    verdict: string,
    secs: int,
    detail: string,
}

fn now() -> int {
    match sh("date +%s") {
        Ok(r) => strings.trim(r.stdout).parse::<int>().unwrap_or(0),
        Err(_) => 0,
    }
}

fn wrapper() -> string {
    env::var("WJ_CARGO_WRAPPER").unwrap_or("")
}

// "N passed" from a cargo test summary, or -1
fn passed_count(text: string) -> int {
    let mut n = -1
    for line in strings.split_lines(text) {
        if strings.contains(line, "test result:") {
            let words = strings.split_whitespace(line)
            let mut i = 0
            while i + 1 < words.len() {
                if words[i + 1] == "passed;" {
                    n = words[i].parse::<int>().unwrap_or(-1)
                }
                i += 1
            }
        }
    }
    n
}

fn tail_lines(text: string, n: int) -> string {
    let lines = strings.split_lines(text)
    let mut start = 0
    if lines.len() > n {
        start = lines.len() - n
    }
    let mut out = ""
    let mut i = start
    while i < lines.len() {
        out = out + "    " + lines[i] + "\n"
        i += 1
    }
    out
}

fn cargo_step(name: string, filter: string) -> Step {
    let t0 = now()
    let cmd = "${wrapper()} cargo test --release --test all -q -- ${filter} 2>&1"
    match sh(cmd) {
        Ok(r) => {
            let n = passed_count(r.stdout)
            // a gate that ran zero tests proves nothing
            let ok = r.status == 0 && n > 0
            let detail = if ok { "" } else { tail_lines(r.stdout, 25) }
            Step { name: name, cases: if n >= 0 { "${n}" } else { "?" }, verdict: if ok { "pass" } else if r.status == 0 { "FAIL (0 tests ran)" } else { "FAIL" }, secs: now() - t0, detail: detail }
        },
        Err(e) => Step { name: name, cases: "?", verdict: "FAIL", secs: now() - t0, detail: e },
    }
}

fn wj_step(name: string, wj: string, args: string) -> Step {
    let t0 = now()
    match sh("${wj} run --interpret ${args} 2>&1") {
        Ok(r) => {
            let last = strings.split_lines(strings.trim(r.stdout))
            let summary = if last.len() > 0 { last[0] } else { "" }
            Step { name: name, cases: "", verdict: if r.status == 0 { "pass" } else { "FAIL" }, secs: now() - t0, detail: if r.status == 0 { "" } else { r.stdout } }
        },
        Err(e) => Step { name: name, cases: "?", verdict: "FAIL", secs: now() - t0, detail: e },
    }
}

fn corpus_step(wj: string, compiled: string) -> Step {
    let t0 = now()
    let run = sh("${wj} run --interpret scripts/wj/drift_corpus.wj ${wj} ${RESULTS} --compiled ${compiled} 2>&1")
    let mut detail = ""
    let mut ok = true
    match run {
        Ok(r) => {
            if r.status != 0 {
                ok = false
                detail = r.stdout
            }
        },
        Err(e) => {
            ok = false
            detail = e
        },
    }
    // generated value-kind x position programs: rows appended to the corpus rows
    if ok {
        let live = if compiled == "live" { "--run-compiled" } else { "" }
        match sh("${wj} run --interpret scripts/wj/drift_gen.wj ${wj} /tmp/wj-drift-gen ${GEN_RESULTS} ${live} 2>&1 && cat ${GEN_RESULTS} >> ${RESULTS}") {
            Ok(r) => {
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    // the ledger may only shrink against the base ref's copy (absent there: the ledger is being introduced)
    let base_ref = env::var("DRIFT_BASE_REF").unwrap_or("next/v0.50.0")
    let mut base_arg = ""
    match sh("git show ${base_ref}:${LEDGER} > ${BASE_COPY} 2>/dev/null") {
        Ok(r) => {
            if r.status == 0 {
                base_arg = "--base-ledger ${BASE_COPY}"
            }
        },
        Err(_) => {},
    }
    let mut cases = ""
    if ok {
        match sh("${wj} run --interpret scripts/wj/drift_ledger.wj ${RESULTS} ${LEDGER} --min-cases ${MIN_CASES} ${base_arg} 2>&1") {
            Ok(r) => {
                let first = strings.split_lines(r.stdout)
                if first.len() > 0 {
                    cases = first[0]
                }
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    Step { name: "corpus (compiled: ${compiled})", cases: cases, verdict: if ok { "pass" } else { "FAIL" }, secs: now() - t0, detail: detail }
}

fn main() {
    let args = env::args()
    let mut wj = env::var("WJ").unwrap_or("target/release/wj")
    let mut fast = false
    let mut compiled = "recorded"
    let mut i = 1
    while i < args.len() {
        if args[i] == "--wj" {
            wj = args[i + 1]
            i += 1
        } else if args[i] == "--fast" {
            fast = true
        } else if args[i] == "--compiled" {
            compiled = args[i + 1]
            i += 1
        }
        i += 1
    }
    let mut steps: Vec<Step> = Vec::new()
    steps.push(wj_step("selftest", wj, "scripts/wj/drift_selftest.wj ${wj}"))
    if !fast {
        steps.push(cargo_step("parity (engine_parity)", "interpreter_engine_parity_test::"))
        steps.push(cargo_step("fast-paths", "interpreter_fast_paths_test::"))
        steps.push(cargo_step("jit-loops", "interpreter_jit_loops_test::"))
        steps.push(cargo_step("packed-vec", "interpreter_packed_vec_test::"))
    }
    steps.push(corpus_step(wj, compiled))
    let mut t = new(["step", "cases", "verdict", "seconds"])
    let mut failed = 0
    for s in steps {
        t = add_row(t, [s.name, s.cases, s.verdict, "${s.secs}"])
        if s.verdict != "pass" {
            failed += 1
        }
    }
    println(plain(t, "  "))
    for s in steps {
        if s.detail != "" {
            println("--- ${s.name}")
            println(s.detail)
        }
    }
    if failed > 0 {
        println("drift gate: FAIL (${failed} step(s))")
        process.exit(1)
    }
    println("drift gate: PASS")
}

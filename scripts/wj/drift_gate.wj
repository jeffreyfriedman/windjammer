// The drift gate: one command that fails when the interpreter and the compiled output disagree.
//
//   wj run scripts/wj/drift_gate.wj [--wj BIN] [--fast] [--check-env] [--prune] [--compiled recorded|live|skip]
//
// Steps (docs/testing/DRIFT.md):
//   selftest   the ledger comparer and the corpus tokens, against planted divergences
//   parity     engine_parity: walker == resolved on every corpus program (and the machine-code loop tier)
//   fast-paths every fast path fires on its programs (a silent fallback is invisible to parity)
//   jit-loops  generated loop programs: walker == resolved == no-jit
//   packed-vec packed vectors == boxed vectors
//   crate-host Rust crate calls (ADR-0031): interpreted == compiled on the interop projects, panics, replay, grants
//   spec       the language spec as an oracle: tests/spec cases under walker, resolved and compiled (spec_oracle.wj)
//   corpus     (plus 40 generated value-kind x position programs, drift_gen.wj) ecosystem tests + value-position programs: walker, resolved and compiled agree, or the
//              divergence is in tests/drift_corpus/known_divergences.txt (a shrink-only ledger)
// `--fast` skips the cargo steps (selftest and corpus only). WJ_CARGO_WRAPPER prefixes every cargo and
// compiled run (a build-slot gate); DRIFT_BASE_REF (default: the current branch's upstream, else the merge-base with origin/HEAD) names the ref the ledger may only
// shrink against. Exit status 1 when any step fails.
use std::env
use std::fs
use std::process
use std::strings
use wj_proc::sh
use wj_proc::quote
use wj_table::new
use wj_table::add_row
use wj_table::plain

const PROBE_BASELINE: string = "tests/drift_corpus/probe_baseline.tsv"
const STDSHAPE_BASELINE: string = "tests/drift_corpus/stdshape_baseline.txt"
const LEDGER: string = "tests/drift_corpus/known_divergences.txt"
const MIN_CASES: string = "1300"
const SPEC_MIN_CASES: string = "200"

struct Step {
    name: string,
    cases: string,
    verdict: string,
    secs: int,
    detail: string,
}

fn now() -> int {
    match sh("date +%s") {
        Ok(r) => strings.trim(r.stdout).parse::<int>().unwrap_or(0),
        Err(_) => 0,
    }
}

fn wrapper() -> string {
    env::var("WJ_CARGO_WRAPPER").unwrap_or("")
}

// "N passed" from a cargo test summary, or -1
fn passed_count(text: string) -> int {
    let mut n = -1
    for line in strings.split_lines(text) {
        if strings.contains(line, "test result:") {
            let words = strings.split_whitespace(line)
            let mut i = 0
            while i + 1 < words.len() {
                if words[i + 1] == "passed;" {
                    n = words[i].parse::<int>().unwrap_or(-1)
                }
                i += 1
            }
        }
    }
    n
}

// " (ran 42.3s)" from cargo's "finished in 42.3s": the seconds column also counts waiting for a build slot and
// the build-directory lock, so a long step with a short run time was queueing, not slow
fn ran_text(text: string) -> string {
    for line in strings.split_lines(text) {
        match line.find("finished in ") {
            Some(i) => {
                let rest = line[i + 12..]
                return " (ran ${strings.trim(rest)})"
            },
            None => {},
        }
    }
    ""
}

fn tail_lines(text: string, n: int) -> string {
    let lines = strings.split_lines(text)
    let mut start = 0
    if lines.len() > n {
        start = lines.len() - n
    }
    let mut out = ""
    let mut i = start
    while i < lines.len() {
        out = out + "    " + lines[i] + "\n"
        i += 1
    }
    out
}

fn cargo_step(name: string, filter: string) -> Step {
    let t0 = now()
    let cmd = "${wrapper()} cargo test --release --test all -q -- ${filter} 2>&1"
    match sh(cmd) {
        Ok(r) => {
            let n = passed_count(r.stdout)
            // a gate that ran zero tests proves nothing
            let ok = r.status == 0 && n > 0
            let detail = if ok { "" } else { tail_lines(r.stdout, 25) }
            Step { name: name, cases: if n >= 0 { "${n}${ran_text(r.stdout)}" } else { "?" }, verdict: if ok { "pass" } else if r.status == 0 { "FAIL (0 tests ran)" } else { "FAIL" }, secs: now() - t0, detail: detail }
        },
        Err(e) => Step { name: name, cases: "?", verdict: "FAIL", secs: now() - t0, detail: e },
    }
}

fn wj_step(name: string, wj: string, args: string) -> Step {
    let t0 = now()
    match sh("${wj} run --interpret ${args} 2>&1") {
        Ok(r) => {
            let last = strings.split_lines(strings.trim(r.stdout))
            let summary = if last.len() > 0 { last[0] } else { "" }
            Step { name: name, cases: "", verdict: if r.status == 0 { "pass" } else { "FAIL" }, secs: now() - t0, detail: if r.status == 0 { "" } else { r.stdout } }
        },
        Err(e) => Step { name: name, cases: "?", verdict: "FAIL", secs: now() - t0, detail: e },
    }
}

fn corpus_step(wj: string, compiled: string, prune: bool, adopt: string) -> Step {
    // every file of a run lives in a directory of its own, so concurrent gate runs cannot touch each other
    let run_dir = env.get_or("TMPDIR", "/tmp") + "/wj-drift-gate-${process.pid()}"
    let _ = fs.create_dir_all(run_dir)
    let results = "${run_dir}/results.tsv"
    let gen_results = "${run_dir}/gen.tsv"
    let base_copy = "${run_dir}/base-ledger.txt"
    let t0 = now()
    let run = sh("${wj} run --interpret scripts/wj/drift_corpus.wj ${wj} ${results} --compiled ${compiled} 2>&1")
    let mut detail = ""
    let mut ok = true
    match run {
        Ok(r) => {
            if r.status != 0 {
                ok = false
                detail = r.stdout
            }
        },
        Err(e) => {
            ok = false
            detail = e
        },
    }
    // generated value-kind x position programs: rows appended to the corpus rows
    if ok {
        let live = if compiled == "live" { "--run-compiled" } else { "" }
        match sh("${wj} run --interpret scripts/wj/drift_gen.wj ${wj} ${run_dir}/gen ${gen_results} ${live} 2>&1 && cat ${gen_results} >> ${results}") {
            Ok(r) => {
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    // semantic probe families (integer wrapping, casts, float formatting, panics, evaluation order, drop order...)
    if ok {
        let live = if compiled == "live" { "--run-compiled" } else { "" }
        match sh("${wj} run --interpret scripts/wj/drift_probes.wj ${wj} ${run_dir}/probes ${run_dir}/probes.tsv ${live} --baseline ${PROBE_BASELINE} 2>&1 && cat ${run_dir}/probes.tsv >> ${results}") {
            Ok(r) => {
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    // return shapes of the standard library: interpreter builtins against the runtime crate's signatures
    if ok {
        let live = if compiled == "live" { "--run-compiled" } else { "" }
        match sh("${wj} run --interpret scripts/wj/drift_stdshape.wj ${wj} ${run_dir}/stdshape ${run_dir}/stdshape.tsv ${live} --baseline ${STDSHAPE_BASELINE} 2>&1 && cat ${run_dir}/stdshape.tsv >> ${results}") {
            Ok(r) => {
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    // the ledger may only shrink against the base ref's copy (absent there: the ledger is being introduced)
    let base_ref = base_ref_default()
    let mut base_arg = ""
    match sh("git show ${base_ref}:${LEDGER} > ${base_copy} 2>/dev/null") {
        Ok(r) => {
            if r.status == 0 {
                base_arg = "--base-ledger ${base_copy}"
            }
        },
        Err(_) => {},
    }
    let mut cases = ""
    let adopt_arg = if adopt != "" { "--adopt '${adopt}'" } else { "" }
    if ok {
        match sh("${wj} run --interpret scripts/wj/drift_ledger.wj ${results} ${LEDGER} --min-cases ${MIN_CASES} ${base_arg} ${if prune { "--prune" } else { "" }} ${adopt_arg} 2>&1") {
            Ok(r) => {
                let first = strings.split_lines(r.stdout)
                if first.len() > 0 {
                    cases = first[0]
                }
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    let _ = sh("rm -rf ${run_dir}")
    Step { name: "corpus (compiled: ${compiled})", cases: cases, verdict: if ok { "pass" } else { "FAIL" }, secs: now() - t0, detail: detail }
}

// The gate runs programs from scratch and probe directories, so the binary must be named absolutely: a
// relative path is resolved against the repository root (where the gate runs), a bare name through PATH.
// Err(message) when it names no executable.
fn absolute_wj(wj: string) -> Result<string, string> {
    let cmd = "case ${quote(wj)} in /*) p=${quote(wj)};; */*) p=\"$PWD/${wj}\";; *) p=$(command -v ${quote(wj)});; esac; if [ -n \"$p\" ] && [ -x \"$p\" ] && [ ! -d \"$p\" ]; then echo \"$p\"; else echo; fi"
    match sh(cmd) {
        Ok(r) => {
            let p = strings.trim(r.stdout)
            if p == "" { Err("wj binary `${wj}` is not an executable file (build it, or pass --wj /absolute/path/to/wj)") } else { Ok(p) }
        },
        Err(e) => Err(e),
    }
}

// The ref the ledger may only shrink against: DRIFT_BASE_REF, else the current branch's upstream, else the
// merge-base with origin's default branch, else HEAD (so a clone without either still has a base that exists).
fn base_ref_default() -> string {
    match env::var("DRIFT_BASE_REF") {
        Some(v) => {
            if v != "" {
                return v
            }
        },
        None => {},
    }
    let cmd = "git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || git merge-base HEAD origin/HEAD 2>/dev/null || echo HEAD"
    match sh(cmd) {
        Ok(r) => {
            let v = strings.trim(r.stdout)
            if v == "" { "HEAD" } else { v }
        },
        Err(_) => "HEAD",
    }
}

// The scripts import the ecosystem packages through scripts/wj/wj.toml, which reads WJ_ECOSYSTEM (a checkout of
// windjammer-ecosystem) or falls back to `windjammer-ecosystem/` at the repository root (without them `wj check`
// reports WJ0044 on the externs). No sibling directory is assumed. Err(message) when neither resolves.
fn ensure_ecosystem() -> Result<string, string> {
    let link = env::var("DRIFT_ECO_LINK").unwrap_or("windjammer-ecosystem")
    let cmd = "if [ -n \"$WJ_ECOSYSTEM\" ]; then if [ -d \"$WJ_ECOSYSTEM/packages\" ]; then echo \"WJ_ECOSYSTEM\"; else echo missing-env; fi; elif [ -d ${quote(link)}/packages ]; then echo present; else echo missing; fi"
    match sh(cmd) {
        Ok(r) => {
            let v = strings.trim(r.stdout)
            if v == "missing-env" {
                Err("WJ_ECOSYSTEM is set but has no packages/ directory: point it at a windjammer-ecosystem checkout")
            } else if v == "missing" || v == "" {
                Err("the ecosystem packages were not found: set WJ_ECOSYSTEM to a windjammer-ecosystem checkout, or put (or symlink) one at ${link}/")
            } else {
                Ok(v)
            }
        },
        Err(e) => Err(e),
    }
}

// The language spec as an oracle (docs/testing/DRIFT.md, scripts/wj/spec_oracle.wj): every tests/spec case with an
// expected output runs under the walker, the resolved engine and the compiled backend; the divergences are listed
// in tests/spec_oracle/known_divergences.txt, a shrink-only ledger judged by drift_ledger.wj like the corpus one.
fn spec_step(wj: string, compiled: string) -> Step {
    let run_dir = env.get_or("TMPDIR", "/tmp") + "/wj-drift-spec-${process.pid()}"
    let _ = fs.create_dir_all(run_dir)
    let t0 = now()
    let rows = "${run_dir}/spec.tsv"
    let ledger = "tests/spec_oracle/known_divergences.txt"
    let mut ok = true
    let mut detail = ""
    let mut cases = ""
    match sh("${wj} run --interpret scripts/wj/spec_oracle.wj --selftest 2>&1") {
        Ok(r) => {
            if r.status != 0 {
                ok = false
                detail = r.stdout
            }
        },
        Err(e) => {
            ok = false
            detail = e
        },
    }
    if ok {
        match sh("${wj} run --interpret scripts/wj/spec_oracle.wj ${wj} ${rows} --compiled ${compiled} 2>&1") {
            Ok(r) => {
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    if ok {
        let base_ref = base_ref_default()
        let mut base_arg = ""
        match sh("git show ${base_ref}:${ledger} > ${run_dir}/base-ledger.txt 2>/dev/null") {
            Ok(r) => {
                if r.status == 0 {
                    base_arg = "--base-ledger ${run_dir}/base-ledger.txt"
                }
            },
            Err(_) => {},
        }
        match sh("${wj} run --interpret scripts/wj/drift_ledger.wj ${rows} ${ledger} --min-cases ${SPEC_MIN_CASES} ${base_arg} 2>&1") {
            Ok(r) => {
                let first = strings.split_lines(r.stdout)
                if first.len() > 0 {
                    cases = first[0]
                }
                if r.status != 0 {
                    ok = false
                    detail = r.stdout
                }
            },
            Err(e) => {
                ok = false
                detail = e
            },
        }
    }
    let _ = sh("rm -rf ${run_dir}")
    Step { name: "spec oracle (compiled: ${compiled})", cases: cases, verdict: if ok { "pass" } else { "FAIL" }, secs: now() - t0, detail: detail }
}

fn main() {
    let args = env::args()
    let mut wj = env::var("WJ").unwrap_or("target/release/wj")
    let mut check_env = false
    let mut prune = false
    let mut adopt = ""
    let mut fast = false
    let mut compiled = "recorded"
    let mut i = 1
    while i < args.len() {
        if args[i] == "--wj" {
            wj = args[i + 1]
            i += 1
        } else if args[i] == "--prune" {
            prune = true
        } else if args[i] == "--adopt" {
            adopt = args[i + 1]
            i += 1
        } else if args[i] == "--check-env" {
            check_env = true
        } else if args[i] == "--fast" {
            fast = true
        } else if args[i] == "--compiled" {
            compiled = args[i + 1]
            i += 1
        }
        i += 1
    }
    match absolute_wj(wj) {
        Ok(p) => wj = p,
        Err(m) => {
            println("drift gate: ${m}")
            process.exit(2)
        },
    }
    match ensure_ecosystem() {
        Ok(v) => {
            if check_env {
                println("ecosystem: ${v}")
            }
        },
        Err(m) => {
            println("drift gate: ${m}")
            process.exit(2)
        },
    }
    if check_env {
        println("wj: ${wj}")
        return
    }
    let mut steps: Vec<Step> = Vec::new()
    steps.push(wj_step("selftest", wj, "scripts/wj/drift_selftest.wj ${wj}"))
    if !fast {
        steps.push(cargo_step("parity (engine_parity)", "interpreter_engine_parity_test::"))
        steps.push(cargo_step("fast-paths", "interpreter_fast_paths_test::"))
        steps.push(cargo_step("jit-loops", "interpreter_jit_loops_test::"))
        steps.push(cargo_step("packed-vec", "interpreter_packed_vec_test::"))
        steps.push(cargo_step("crate-host", "interpreter_rust_crates_test::"))
    }
    steps.push(corpus_step(wj, compiled, prune, adopt))
    steps.push(spec_step(wj, compiled))
    let mut t = new(["step", "cases", "verdict", "seconds"])
    let mut failed = 0
    for s in steps {
        t = add_row(t, [s.name, s.cases, s.verdict, "${s.secs}"])
        if s.verdict != "pass" {
            failed += 1
        }
    }
    println(plain(t, "  "))
    for s in steps {
        if s.detail != "" {
            println("--- ${s.name}")
            println(s.detail)
        }
    }
    if failed > 0 {
        println("drift gate: FAIL (${failed} step(s))")
        process.exit(1)
    }
    println("drift gate: PASS")
}

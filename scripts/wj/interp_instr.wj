// Instruction-count ratchet of the interpreter (ADR-0038): startup and the bench/interp kernels, counted in
// instructions (not seconds), so a loaded machine cannot move the number.
//
//   wj run scripts/wj/interp_instr.wj -- WJ_BIN                print the table (JSON on stdout)
//   wj run scripts/wj/interp_instr.wj -- WJ_BIN --refs         also count the twins under qjs, lua, python3 and node
//   wj run scripts/wj/interp_instr.wj -- WJ_BIN --check        fail when a kernel counts more than its recorded
//                                                              instructions + 3% (bench/interp/instr_baseline.json)
//   wj run scripts/wj/interp_instr.wj -- WJ_BIN --write        record the counts (lower only; --allow-raise to raise,
//                                                              --raise K1,K2 to raise only those kernels)
//
// The counter: callgrind (`valgrind --tool=callgrind`) when valgrind is installed, else the hardware counter of
// `/usr/bin/time -l` ("instructions retired", macOS). Counts from different counters are never compared: the
// baseline keeps one table per counter, and `--check` with no table for this counter says so and passes.
// Every run must exit 0 and print the kernel's recorded output (bench/interp/expected/<kernel>.out), so a faster
// interpreter that prints something else fails here before any count is compared. A count is the smallest of
// --runs N runs (default 3; startup N + 2): the counter's noise only ever adds. Run from the repository root.
//
// Two tables per counter. The ratchet rows (`<counter>`) are COLD: every run starts from a fresh cache root holding
// only the scanned stdlib layer (`WJ_CARGO_TARGET_ROOT`, seeded once), so the stored check of a program
// (`check/run_cache.rs`) never answers and an interpreter regression cannot hide behind a cache hit. The WARM rows
// (`<counter>:warm`) are the repeat run of the unchanged program: the same root after one uncounted run, so the
// check and the solver's literal widths come from the store. Both tables have their own ratchet.
use std::env
use std::fs
use std::process
use std::strings
use wj_proc::sh
use wj_proc::quote
use wj_json_doc::Json
use wj_json_doc::parse
use wj_json_doc::get
use wj_json_doc::members
use wj_json_doc::as_i64
use wj_json_doc::object
use wj_json_doc::with
use wj_json_doc::from_int
use wj_json_doc::from_str
use wj_json_doc::from_float
use wj_json_doc::dumps

const BENCH: string = "bench/interp"
const BASELINE: string = "bench/interp/instr_baseline.json"
const STARTUP: string = "bench/interp/startup/hello.wj"
const AGENT_LOOP: string = "bench/interp/startup/agent_loop.wj"
const SLACK_PCT: int = 3

struct Count {
    instr: int,
    stdout: string,
    status: int,
}

fn has(tool: string) -> bool {
    match sh("command -v " + tool + " >/dev/null 2>&1") {
        Ok(o) => o.status == 0,
        Err(_) => false,
    }
}

// "callgrind" or "retired" (macOS hardware counter), "" when neither works here.
fn counter() -> string {
    if has("valgrind") {
        return "callgrind"
    }
    match sh("/usr/bin/time -l true 2>&1 >/dev/null") {
        Ok(o) => {
            if o.stdout.contains("instructions retired") {
                return "retired"
            }
        },
        Err(_) => {},
    }
    ""
}

fn platform_key(c: string) -> string {
    let arch = match sh("uname -sm") {
        Ok(o) => strings.replace(strings.trim(o.stdout), " ", "-"),
        Err(_) => "unknown",
    }
    "${c}:${arch}"
}

// The instruction count of one run of `cmd` (a shell command line), with its stdout and exit status.
// What follows a run's own stdout in `count_once`'s output: the counter's report.
const MARK: string = "\n@@wj-interp-instr counter@@\n"

// The instruction count of one run of `cmd` (a shell command line), with its stdout and exit status. The counter
// writes to stderr; the shell keeps that in a file of the system temp dir (`mktemp`) that it deletes itself, so
// nothing outlives the run, and appends it to stdout after `MARK`.
fn count_once(c: string, cmd: string, root: string) -> Count {
    let counter = if c == "callgrind" { "valgrind --tool=callgrind --callgrind-out-file=/dev/null" } else { "/usr/bin/time -l" }
    // the staleness warnings are off: inside the checkout they cost a `stat` per compiler source, which is not the interpreter
    let (setup, cleanup, envp) = root_env(root)
    let line = "export WJ_NO_STALE_WARN=1; f=$(mktemp) || exit 99; ${setup}trap 'rm -f \"$f\"${cleanup}' EXIT; ${envp}${counter} ${cmd} 2>\"$f\"; s=$?; printf '%s' " + quote(MARK) + "; cat \"$f\"; exit $s"
    let out = match sh(line) {
        Ok(o) => o,
        Err(e) => {
            eprintln("cannot run ${cmd}: ${e}")
            process.exit(1)
        },
    }
    let (stdout, err) = match out.stdout.find(MARK) {
        Some(i) => (out.stdout[0..i].to_string(), out.stdout[i + MARK.len()..].to_string()),
        None => (out.stdout, ""),
    }
    let mut instr = 0
    for l in strings.split_lines(err) {
        let words = strings.split_whitespace(l)
        if c == "callgrind" && l.contains("Collected :") && words.len() > 0 {
            instr = words[words.len() - 1].parse::<int>() ?? 0
        } else if c == "retired" && l.contains("instructions retired") && words.len() > 0 {
            instr = words[0].parse::<int>() ?? 0
        }
    }
    Count { instr: instr, stdout: stdout, status: out.status }
}

// The shell setup, trap cleanup and environment prefix of a run in `root`: "" (the caller's cache root),
// "cold:SEED" (a fresh copy of the seeded root per run) or "warm:DIR" (that root, already holding the program's entry).
fn root_env(root: string) -> (string, string, string) {
    if root.starts_with("cold:") {
        let seed = quote(root[5..].to_string())
        return ("r=$(mktemp -d) || exit 99; cp -R ${seed}/. \"$r\"/; ", "; rm -rf \"$r\"", "WJ_CARGO_TARGET_ROOT=\"$r\" ")
    }
    if root.starts_with("warm:") {
        return ("", "", "WJ_CARGO_TARGET_ROOT=" + quote(root[5..].to_string()) + " ")
    }
    ("", "", "")
}

fn min_int(xs: Vec<int>) -> int {
    let mut best = 0
    for x in xs {
        if best == 0 || x < best {
            best = x
        }
    }
    best
}

// Smallest count of `runs` runs; exits when a run fails or prints other than `expected` ("" = not checked).
fn measure(c: string, cmd: string, runs: int, expected: string, what: string, root: string) -> int {
    let mut xs: Vec<int> = Vec::new()
    let mut i = 0
    while i < runs {
        let r = count_once(c, cmd, root)
        if r.status != 0 {
            eprintln("${what}: exit ${r.status}")
            process.exit(1)
        }
        if expected != "" && r.stdout != expected {
            eprintln("${what}: output differs from ${BENCH}/expected\n  expected: ${expected}\n  got:      ${r.stdout}")
            process.exit(1)
        }
        if r.instr <= 0 {
            eprintln("${what}: no instruction count in the counter's report")
            process.exit(1)
        }
        xs.push(r.instr)
        i += 1
    }
    min_int(xs)
}

fn sh_out(line: string) -> string {
    match sh(line) {
        Ok(o) => strings.trim(o.stdout),
        Err(e) => {
            eprintln("cannot run ${line}: ${e}")
            process.exit(1)
        },
    }
}

// A cache root holding only what a first run of `prog` leaves that is not about `prog` itself: the scanned stdlib
// layer and the stdlib tables (the stored checks are removed), so every cold run starts as a new program would.
fn seed_root(wj: string, prog: string) -> string {
    let d = sh_out("mktemp -d")
    sh_out("WJ_CARGO_TARGET_ROOT=" + quote(d) + " " + quote(wj) + " run --no-lint " + quote(prog) + " >/dev/null 2>&1; rm -rf " + quote(d + "/runs"))
    d
}

// The cold count of `cmd` (a fresh copy of `seed` per run) and the warm one (one root after one uncounted run).
fn cold_warm(c: string, cmd: string, runs: int, expected: string, what: string, seed: string) -> (int, int) {
    let cold = measure(c, cmd, runs, expected, what, "cold:" + seed)
    let w = sh_out("mktemp -d")
    sh_out("cp -R " + quote(seed) + "/. " + quote(w) + "/; WJ_CARGO_TARGET_ROOT=" + quote(w) + " " + cmd + " >/dev/null 2>&1; true")
    let warm = measure(c, cmd, runs, expected, what + " (warm)", "warm:" + w)
    sh_out("rm -rf " + quote(w))
    (cold, warm)
}

fn kernels() -> Vec<string> {
    let mut names: Vec<string> = Vec::new()
    match fs.read_dir(BENCH) {
        Ok(entries) => {
            for e in entries {
                let name = fs.file_name(e.path()) ?? ""
                if name.ends_with(".wj") {
                    names.push(name.replace(".wj", ""))
                }
            }
        },
        Err(_) => {},
    }
    names.sort()
    names
}

fn arg_value(args: Vec<string>, flag: string, default: string) -> string {
    let mut i = 0
    while i + 1 < args.len() {
        if args[i] == flag {
            return args[i + 1]
        }
        i += 1
    }
    default
}

fn millions(n: int) -> f64 {
    ((n as f64) / 100000.0).round() / 10.0
}

fn main() {
    let args = env.args()
    if args.len() < 2 {
        eprintln("usage: interp_instr.wj WJ_BIN [--refs] [--check] [--write [--allow-raise | --raise K1,K2]] [--runs N]")
        process.exit(1)
    }
    let wj = args[1]
    let runs = arg_value(args, "--runs", "3").parse::<int>() ?? 3
    let c = counter()
    if c == "" {
        eprintln("no instruction counter: install valgrind (callgrind), or run on macOS (/usr/bin/time -l)")
        process.exit(1)
    }
    let key = platform_key(c)
    let cwd = env.current_dir() ?? "."
    let mut counts = object()
    let mut warm = object()
    let seed = seed_root(wj, cwd + "/" + STARTUP)
    // startup: the smallest program through the default `wj run` path
    let (hello, hello_warm) = cold_warm(c, quote(wj) + " run --no-lint " + quote(cwd + "/" + STARTUP), runs + 2, "hello\n", "startup", seed)
    counts = with(counts, "startup", from_int(hello as i64))
    warm = with(warm, "startup", from_int(hello_warm as i64))
    // the agent loop (ADR-0038 ladder 3): a typical 200-line program, check and run, as an agent runs it after an edit
    let agent_expected = fs::read_to_string("${BENCH}/expected/agent_loop.out") ?? ""
    let (agent, agent_warm) = cold_warm(c, quote(wj) + " run " + quote(cwd + "/" + AGENT_LOOP), runs, agent_expected, "agent_loop", seed)
    counts = with(counts, "agent_loop", from_int(agent as i64))
    warm = with(warm, "agent_loop", from_int(agent_warm as i64))
    let mut refs = object()
    // each reference tool's own startup (bench/interp/startup/hello.*), subtracted for the net ratios
    let mut ref_start: Vec<(string, string, int)> = Vec::new()
    if args.contains("--refs") {
        for (tool, ext) in [("qjs", "mjs"), ("node", "mjs"), ("python3", "py"), ("lua", "lua")] {
            if has(tool) {
                ref_start.push((tool, ext, measure(c, tool + " " + quote(cwd + "/bench/interp/startup/hello." + ext), runs, "hello\n", "startup (${tool})", "")))
            }
        }
        let mut row = with(object(), "wj", from_float(millions(hello)))
        for (tool, _, n) in ref_start {
            row = with(row, tool, from_float(millions(n)))
        }
        refs = with(refs, "startup", row)
    }
    for k in kernels() {
        let expected = fs::read_to_string("${BENCH}/expected/${k}.out") ?? ""
        if expected == "" {
            eprintln("${k}: no recorded output ${BENCH}/expected/${k}.out")
            process.exit(1)
        }
        let (n, nw) = cold_warm(c, quote(wj) + " run --no-lint " + quote("${cwd}/${BENCH}/${k}.wj"), runs, expected, k, seed)
        counts = with(counts, k, from_int(n as i64))
        warm = with(warm, k, from_int(nw as i64))
        if args.contains("--refs") {
            let mut row = with(object(), "wj", from_float(millions(n)))
            for (tool, ext, start) in ref_start {
                let twin = "${BENCH}/twins/${k}.${ext}"
                if fs.exists(twin) {
                    let t = measure(c, tool + " " + quote(cwd + "/" + twin), runs, expected, "${k} (${tool})", "")
                    row = with(row, tool, from_float(millions(t)))
                    // net of each side's startup: the kernel's own work
                    let net = ((n - hello) as f64) / (((t - start) as f64).max(1.0))
                    row = with(row, "net_wj_over_" + tool, from_float((net * 100.0).round() / 100.0))
                }
            }
            refs = with(refs, k, row)
        }
    }
    sh_out("rm -rf " + quote(seed))
    let claim = "repeat run of an unchanged program costs ${millions(hello_warm)}M instructions (startup; cold ${millions(hello)}M)"
    let mut res = with(with(with(object(), "counter", from_str(key)), "instructions", counts), "warm", warm)
    res = with(res, "claim", from_str(claim))
    if args.contains("--refs") {
        res = with(res, "references_millions", refs)
    }
    println(dumps(res, 1, true))
    let mut doc = parse(fs::read_to_string(BASELINE) ?? "{}") ?? object()
    let bad_cold = ratchet(args, doc, key, counts)
    let bad_warm = ratchet(args, doc, key + ":warm", warm)
    if args.contains("--write") {
        doc = with(doc, key, written(args, get(doc, key) ?? object(), counts))
        doc = with(doc, key + ":warm", written(args, get(doc, key + ":warm") ?? object(), warm))
        let _ = fs.write(BASELINE, dumps(doc, 1, true) + "\n")
    }
    if bad_cold || bad_warm {
        process.exit(1)
    }
}

// `--check` of `counts` against the table `key` of `doc`; true when a row regressed.
fn ratchet(args: Vec<string>, doc: Json, key: string, counts: Json) -> bool {
    if !args.contains("--check") {
        return false
    }
    let base = get(doc, key) ?? object()
    let mut bad: Vec<string> = Vec::new()
    let mut seen = 0
    for m in members(base) {
        let was = as_i64(m.value) ?? 0
        match get(counts, m.key) {
            Some(v) => {
                seen += 1
                let now = as_i64(v) ?? 0
                if now * 100 > was * (100 + SLACK_PCT) {
                    bad.push("${key} ${m.key}: ${now} > ${was} + ${SLACK_PCT}%")
                } else if now * 100 < was * (100 - SLACK_PCT) {
                    eprintln("improved: ${key} ${m.key}: ${now} < ${was} - ${SLACK_PCT}% (record it with --write)")
                }
            },
            None => bad.push("${key} ${m.key}: in the baseline but not measured"),
        }
    }
    if seen == 0 {
        eprintln("no baseline for ${key} in ${BASELINE}: nothing to compare (record one with --write)")
    }
    if bad.len() > 0 {
        eprintln("instruction counts regressed:\n" + bad.join("\n"))
    }
    bad.len() > 0
}

// The table `--write` records: the new counts, lower only unless `--allow-raise` / `--raise K1,K2`.
fn written(args: Vec<string>, base: Json, counts: Json) -> Json {
    let mut next = object()
    let raise: Vec<string> = arg_value(args, "--raise", "").split(",").collect()
    for m in members(counts) {
        let now = as_i64(m.value) ?? 0
        let was = as_i64(get(base, m.key) ?? Json::Null) ?? 0
        let may_raise = args.contains("--allow-raise") || raise.contains(m.key)
        if was > 0 && now > was && !may_raise {
            eprintln("${m.key}: ${now} > recorded ${was}; keeping the recorded count (--allow-raise to raise it)")
            next = with(next, m.key, from_int(was as i64))
        } else {
            next = with(next, m.key, from_int(now as i64))
        }
    }
    next
}

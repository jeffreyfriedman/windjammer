// Record the rustc oracle for the `wj check` negative gate (tests/check_negative_test.rs).
//   wj run scripts/wj/check_negative_oracle.wj [path/to/wj]       (run from the repository root)
// For every program in the negative corpora: transpile with `wj build --no-cargo` and, when that
// succeeds, `cargo check` the generated crate. Writes tests/check_negative/oracle.tsv:
//   <path>  <fnv1a64 of source>  <transpile ok|fail>  <rustc ok|fail|skip>
// Entries whose source hash is unchanged are reused. The test itself never runs cargo; it compares `wj check` against this recorded oracle.
use std::env
use std::fs
use std::process
use std::strings
use wj_proc::capture
use wj_proc::sh_in
use wj_proc::quote

const OUT: string = "tests/check_negative/oracle.tsv"

// FNV-1a over the file's bytes, 16 lowercase hex digits
fn fnv1a64(path: string) -> string {
    let bytes = fs.read(path) ?? Vec::new()
    let mut h: u64 = 14695981039346656037
    for b in bytes {
        h = (h ^ (b as u64)).wrapping_mul(1099511628211)
    }
    let digits = "0123456789abcdef".chars().collect()
    let mut out = ""
    let mut shift: u64 = 60
    loop {
        out = out + digits[((h >> shift) & 15) as usize].to_string()
        if shift == 0 {
            break
        }
        shift = shift - 4
    }
    out
}

fn corpus_files() -> Vec<string> {
    let mut all: Vec<string> = Vec::new()
    for dir in ["tests/check_negative/mutants", "tests/diagnostics/cases", "tests/error_system", "tests/error_system_e2e"] {
        let mut here: Vec<string> = Vec::new()
        for e in fs.read_dir(dir) ?? Vec::new() {
            let p = e.path()
            let name = fs.file_name(p) ?? ""
            if p.ends_with(".wj") && !name.starts_with(".") && e.is_file() {
                here.push(p)
            }
        }
        here.sort()
        for p in here {
            all.push(p)
        }
    }
    all
}

fn main() {
    let args = env.args()
    let wj = if args.len() >= 2 { args[1] } else { "wj" }
    let target = env.get("CARGO_TARGET_DIR") ?? (env.get_or("TMPDIR", "/tmp") + "/wj-negative-target")
    // previous entries by (path, hash)
    let mut previous: Vec<string> = Vec::new()
    for line in strings.split_lines(fs.read_to_string(OUT) ?? "") {
        previous.push(line)
    }
    let mut lines: Vec<string> = Vec::new()
    let mut n = 0
    for f in corpus_files() {
        n = n + 1
        let sha = fnv1a64(f)
        let mut reused = ""
        for line in previous {
            let cols: Vec<string> = line.split("\t").collect()
            if cols.len() >= 2 && cols[0] == f && cols[1] == sha {
                reused = line
                break
            }
        }
        if reused.len() > 0 {
            lines.push(reused)
            continue
        }
        let out = "/tmp/wj-negative-${process.pid()}-${n}"
        let _ = fs.create_dir_all(out)
        let built = capture("env", [wj, "build", f, "-o", out, "--no-cargo"])
        let mut transpile = "fail"
        let mut rustc = "skip"
        match built {
            Ok(o) => {
                if o.status == 0 {
                    transpile = "ok"
                    rustc = "fail"
                    match sh_in(out, "env CARGO_TARGET_DIR=" + quote(target) + " cargo check -q >/dev/null 2>&1") {
                        Ok(c) => {
                            if c.status == 0 {
                                rustc = "ok"
                            }
                        },
                        Err(_) => {},
                    }
                }
            },
            Err(_) => {},
        }
        let _ = fs.remove_dir_all(out)
        let row = f + "\t" + sha + "\t" + transpile + "\t" + rustc
        println(row)
        lines.push(row)
    }
    lines.sort()
    let header = "# path\tfnv1a64\ttranspile\trustc   (generated by scripts/wj/check_negative_oracle.wj)"
    let _ = fs.write(OUT, header + "\n" + lines.join("\n") + "\n")
}

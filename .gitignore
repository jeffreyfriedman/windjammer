# Rust artifacts (all target/ dirs, not just root)
**/target/
**/*.rs.bk
*.pdb

# Test artifacts (prevent pollution)
/*.rlib
/*.rmeta
**/*.rlib
**/*.rs.map
/*.so
/*.dylib
/*.dll

# Integration test scratch output (regenerated at test runtime)
tests/generated/

# Windjammer artifacts (all build/ dirs, not just root)
**/build/
/test_output_*
.wj-cache/
# Analysis sidecars are cache output (docs/metadata-data-model.md); only the hand-authored,
# embedded stdlib_meta/ is tracked.
*.wj.meta
!stdlib_meta/*.wj.meta
.wj-compiler-stamp

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local issue tracking (bd/beads — per-clone, not shared in git)
.beads/

# Agent / CI scratch (not source of truth)
.pr-comments/
.sandbox/

# Coverage reports (regenerated by test runs)
coverage/

# Generated Rust files in stdlib
std/**/*.rs
!std/**/lib.rs

# Parallel cargo target dirs used by agents to avoid lock contention
/target-verify/
/target-agent*/

# Local agent/debug scratch
/tmp_*
.agent-wip/
**/*.wip.rs
/.worktrees/

# Claude plugin runtime state
.claude/autoharness/
.claude/autoharness*/
.claude/skills/*/.ledger.jsonl
.claude/skills/

# Interpreter-readiness scorecard: resumable result cache and the R7 history (nightly CI restores the latter)
.wj-readiness-cache/
.wj-readiness-history.json
scripts/**/__pycache__/
/windjammer-ecosystem
!src/cli/tmp_janitor.rs
# Old local scratch directories (kept untracked, not tests)
/tests/tmp_eco_repro/
/tests/tmp_p335/
/tests/tmp_p335_manual/
/tests/tmp_stdlib_dump_test.rs

# Book playground (ADR-0034): the wasm interpreter is a build output (scripts/book/playground_check.wj); test deps
docs/book/playground/*.wasm
docs/book/playground/tests/node_modules/
crates/windjammer-playground/target/

# release scorecard inputs written by the verification flow (contract: results/README.md)
/results/*.json
/~/

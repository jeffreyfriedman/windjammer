# Rust artifacts (all target/ dirs, not just root)
**/target/
**/*.rs.bk
*.pdb

# Test artifacts (prevent pollution)
/*.rlib
/*.rmeta
**/*.rlib
**/*.rs.map
/*.so
/*.dylib
/*.dll

# Integration test scratch output (regenerated at test runtime)
tests/generated/

# Windjammer artifacts (all build/ dirs, not just root)
**/build/
/test_output_*
.wj-cache/
.wj-compiler-stamp

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local issue tracking (bd/beads — per-clone, not shared in git)
.beads/

# Agent / CI scratch (not source of truth)
.pr-comments/
.sandbox/

# Coverage reports (regenerated by test runs)
coverage/

# Generated Rust files in stdlib
std/**/*.rs
!std/**/lib.rs

# Parallel cargo target dirs used by agents to avoid lock contention
/target-verify/
/target-agent*/

# Local agent/debug scratch
tmp_*
.agent-wip/
**/*.wip.rs

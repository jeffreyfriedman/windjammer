
enum DialogCondition {
    HasItem(string, i32),
}

impl DialogCondition {
    pub fn evaluate(self, gs: GameState) -> bool {
        match self {
            DialogCondition::HasItem(item_id, qty) => {
                gs.inventory.has_item(item_id, qty)
            },
        }
    }
}

struct GameState {
    inventory: Inventory,
}

struct Inventory {
}

impl Inventory {
    pub fn has_item(self, item_id: string, min_qty: i32) -> bool {
        false
    }
}

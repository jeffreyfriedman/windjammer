// tags: algorithm, recursion, math
// rust: ok
// expect: gcd(48, 18) = 6
// expect: gcd(17, 5) = 1
// expect: lcm(48, 18) = 144
fn gcd(a: int, b: int) -> int {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn lcm(a: int, b: int) -> int {
    a / gcd(a, b) * b
}

fn main() {
    println("gcd(48, 18) = ${gcd(48, 18)}")
    println("gcd(17, 5) = ${gcd(17, 5)}")
    println("lcm(48, 18) = ${lcm(48, 18)}")
}

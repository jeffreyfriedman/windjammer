// tags: testing, test, vec, hashmap
// tests-passed: 2
use std::collections::HashMap

fn count_words(text: string) -> HashMap<string, int> {
    let mut m: HashMap<string, int> = HashMap::new()
    for w in text.split_whitespace() {
        m.entry(w.to_string()).and_modify(|c| *c += 1).or_insert(1)
    }
    m
}

@test
fn counts_repeats() {
    let m = count_words("a b a c a")
    assert_eq(m["a"], 3)
    assert_eq(m["b"], 1)
    assert_eq(m.len(), 3)
}

@test
fn sorts_and_dedups() {
    let mut v = [3, 1, 3, 2, 1]
    v.sort()
    v.dedup()
    assert_eq(v, [1, 2, 3])
}

// tags: btreemap, collections, ordered
// rust: ok
// expect: 1:one
// expect: 2:two
// expect: 3:three
// expect: first=1
use std::collections::BTreeMap

fn main() {
    let mut m: BTreeMap<int, string> = BTreeMap::new()
    m.insert(3, "three")
    m.insert(1, "one")
    m.insert(2, "two")
    for (k, v) in m {
        println("${k}:${v}")
    }
    match m.keys().next() {
        Some(first) => println("first=${first}"),
        None => println("empty"),
    }
}

// tags: vec, search, contains
// rust: gap v.position(|x| *x == 15) emits 15_i64 against an i32 array (literal width: numeric solver, convergence C4)
// expect: true
// expect: false
// expect: Some(2)
// expect: None
fn main() {
    let v = [4, 8, 15, 16, 23, 42]
    println("${v.contains(&15)}")
    println("${v.contains(&5)}")
    println("${v.position(|x| *x == 15):?}")
    println("${v.position(|x| *x == 5):?}")
}

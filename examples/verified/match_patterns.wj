// tags: match, patterns, guards, ranges
// rust: ok
// expect: zero
// expect: small even
// expect: small odd
// expect: medium
// expect: large
fn describe(n: int) -> string {
    match n {
        0 => "zero",
        x if x < 10 && x % 2 == 0 => "small even",
        1 | 3 | 5 | 7 | 9 => "small odd",
        x if x >= 10 && x < 100 => "medium",
        _ => "large",
    }
}

fn main() {
    for n in [0, 4, 7, 50, 500] {
        println(describe(n))
    }
}

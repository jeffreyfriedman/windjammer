// tags: algorithm, loops, collatz
// rust: ok
// expect: collatz(27) = 111
// expect: collatz(97) = 118
fn collatz(start: int) -> int {
    let mut n = start
    let mut steps = 0
    while n != 1 {
        if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
        steps += 1
    }
    steps
}

fn main() {
    println("collatz(27) = ${collatz(27)}")
    println("collatz(97) = ${collatz(97)}")
}

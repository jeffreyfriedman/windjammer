// tags: algorithm, sorting, loops, swap
// rust: gap error[E0308]: mismatched types
// expect: [11, 12, 22, 25, 34, 64, 90]
fn bubble_sort(v: Vec<int>) -> Vec<int> {
    let mut a = v
    let n = a.len()
    for i in 0..n {
        for j in 0..n - 1 - i {
            if a[j] > a[j + 1] {
                a.swap(j, j + 1)
            }
        }
    }
    a
}

fn main() {
    let sorted = bubble_sort([64, 34, 25, 12, 22, 11, 90])
    println("${sorted:?}")
}

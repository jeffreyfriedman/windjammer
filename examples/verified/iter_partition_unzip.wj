// tags: iterators, partition, unzip
// rust: gap error[E0599]: no method named 'partition' found for struct 'Vec<i32>' in the cur
// expect: [2, 4, 6] [1, 3, 5]
// expect: [1, 2, 3] [a, b, c]
fn main() {
    let v = [1, 2, 3, 4, 5, 6]
    let (ev, od): (Vec<int>, Vec<int>) = v.partition(|x| *x % 2 == 0)
    println("${ev:?} ${od:?}")
    let pairs = [(1, "a"), (2, "b"), (3, "c")]
    let (ns, ls): (Vec<int>, Vec<string>) = pairs.cloned().unzip()
    println("${ns:?} [${ls.join(", ")}]")
}

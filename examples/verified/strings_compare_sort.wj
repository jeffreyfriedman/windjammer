// tags: strings, sort, compare
// rust: ok
// expect: true
// expect: false
// expect: [apple, banana, cherry]
// expect: [cherry, banana, apple]
fn main() {
    let lt = "apple" < "banana"
    let eq = "abc" == "abd"
    println("${lt}")
    println("${eq}")
    let mut fruits = ["cherry", "apple", "banana"]
    fruits.sort()
    println("[${fruits.join(", ")}]")
    fruits.reverse()
    println("[${fruits.join(", ")}]")
}

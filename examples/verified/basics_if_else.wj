// tags: basics, control-flow, if
// rust: ok
// expect: negative
// expect: zero
// expect: small
// expect: big
fn classify(n: int) -> string {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else if n < 100 {
        "small"
    } else {
        "big"
    }
}

fn main() {
    println(classify(-5))
    println(classify(0))
    println(classify(42))
    println(classify(1000))
}

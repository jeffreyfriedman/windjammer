// tags: algorithm, vec, nested
// rust: ok
// expect: 1
// expect: 1 1
// expect: 1 2 1
// expect: 1 3 3 1
// expect: 1 4 6 4 1
fn main() {
    let mut row: Vec<int> = [1]
    for _ in 0..5 {
        let strs: Vec<string> = row.map(|x| x.to_string()).collect()
        println(strs.join(" "))
        let mut next: Vec<int> = [1]
        for i in 0..row.len() - 1 {
            next.push(row[i] + row[i + 1])
        }
        next.push(1)
        row = next
    }
}

// tags: strings, split, join
// rust: ok
// expect: 3
// expect: a|b|c
// expect: [x, y, z]
// expect: 4
// expect: one two three four
fn main() {
    let parts: Vec<string> = "a,b,c".split(",").map(|p| p.to_string()).collect()
    println("${parts.len()}")
    println(parts.join("|"))
    let letters = ["x", "y", "z"]
    println("[${letters.join(", ")}]")
    let words: Vec<string> = "one two  three   four".split_whitespace().map(|w| w.to_string()).collect()
    println("${words.len()}")
    println(words.join(" "))
}

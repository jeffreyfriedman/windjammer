// tags: algorithm, float, formatting, loops
// rust: ok
// expect: -40C = -40.0F
// expect: 0C = 32.0F
// expect: 37C = 98.6F
// expect: 100C = 212.0F
fn c_to_f(c: float) -> float {
    c * 9.0 / 5.0 + 32.0
}

fn main() {
    for c in [-40, 0, 37, 100] {
        println("${c}C = ${c_to_f(c as float):.1}F")
    }
}

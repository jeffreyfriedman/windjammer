// tags: algorithm, math, loops
// rust: ok
// expect: perfect: 6 28 496
fn is_perfect(n: int) -> bool {
    let mut s = 0
    for d in 1..n {
        if n % d == 0 { s += d }
    }
    s == n
}

fn main() {
    let mut found: Vec<string> = []
    for n in 2..500 {
        if is_perfect(n) { found.push(n.to_string()) }
    }
    println("perfect: ${found.join(" ")}")
}

// tags: basics, loops, break, continue
// rust: ok
// expect: found 7
// expect: odds: 1 3 5 7 9
fn main() {
    let mut n = 0
    loop {
        n += 1
        if n * n > 40 { break }
    }
    println("found ${n}")
    let mut odds = ""
    for i in 1..=10 {
        if i % 2 == 0 { continue }
        odds = odds + "${i} "
    }
    println("odds: ${odds.trim()}")
}

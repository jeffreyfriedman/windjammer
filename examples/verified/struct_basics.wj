// tags: struct, methods, impl
// rust: ok
// expect: Point(3, 4)
// expect: 25
// expect: Point(4, 6)
struct Point { x: int, y: int }

impl Point {
    fn new(x: int, y: int) -> Point {
        Point { x: x, y: y }
    }
    fn dist2(self) -> int {
        self.x * self.x + self.y * self.y
    }
    fn translate(self, dx: int, dy: int) {
        self.x += dx
        self.y += dy
    }
    fn show(self) -> string {
        "Point(${self.x}, ${self.y})"
    }
}

fn main() {
    let mut p = Point::new(3, 4)
    println(p.show())
    println("${p.dist2()}")
    p.translate(1, 2)
    println(p.show())
}

// tags: strings, parse, result, option
// rust: ok
// expect: 42
// expect: parse failed
// expect: 3.5
// expect: -17
fn main() {
    match "42".parse::<int>() {
        Ok(n) => println("${n}"),
        Err(_) => println("parse failed"),
    }
    match "abc".parse::<int>() {
        Ok(v) => println("${v}"),
        Err(_) => println("parse failed"),
    }
    let f = "3.5".parse::<float>().unwrap_or(0.0)
    println("${f}")
    let neg = "-17".parse::<int>().unwrap_or(0)
    println("${neg}")
}

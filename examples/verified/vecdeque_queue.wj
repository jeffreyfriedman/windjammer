// tags: vecdeque, queue, collections
// rust: gap error[E0599]: no method named 'cloned' found for struct 'VecDeque<i64>' in the c
// expect: Some(1)
// expect: Some(0)
// expect: 3
// expect: [0, 2, 3]
use std::collections::VecDeque

fn main() {
    let mut q: VecDeque<int> = VecDeque::new()
    q.push_back(1)
    q.push_back(2)
    q.push_back(3)
    q.push_front(0)
    println("${q.get(1).copied():?}")
    println("${q.pop_front():?}")
    println("${q.len()}")
    q.pop_front()
    q.push_front(0)
    let v: Vec<int> = q.cloned().collect()
    println("${v:?}")
}

// tags: vec, sort, dedup
// rust: ok
// expect: [1, 1, 2, 3, 3, 5, 8]
// expect: [1, 2, 3, 5, 8]
// expect: [8, 5, 3, 2, 1]
fn main() {
    let mut v = [5, 3, 8, 1, 3, 2, 1]
    v.sort()
    println("${v:?}")
    v.dedup()
    println("${v:?}")
    v.sort_by(|a, b| b.cmp(a))
    println("${v:?}")
}

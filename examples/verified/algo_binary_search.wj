// tags: algorithm, search, option
// rust: ok
// expect: Some(4)
// expect: None
// expect: Some(0)
fn binary_search(v: Vec<int>, target: int) -> Option<int> {
    let mut lo = 0
    let mut hi = v.len() as int - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if v[mid] == target {
            return Some(mid)
        } else if v[mid] < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    None
}

fn main() {
    let v = [1, 3, 5, 7, 9, 11, 13]
    println("${binary_search(v, 9):?}")
    println("${binary_search(v, 8):?}")
    println("${binary_search(v, 1):?}")
}

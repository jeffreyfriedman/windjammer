// tags: hashset, collections, set
// rust: gap error[E0308]: mismatched types
// expect: 3
// expect: true
// expect: false
// expect: [1, 2, 3, 4, 5]
// expect: [3]
use std::collections::HashSet

fn main() {
    let mut s: HashSet<int> = HashSet::new()
    s.insert(1)
    s.insert(2)
    s.insert(2)
    s.insert(3)
    println("${s.len()}")
    println("${s.contains(&2)}")
    println("${s.contains(&9)}")
    let other: HashSet<int> = [3, 4, 5].cloned().collect()
    let mut u: Vec<int> = s.union(&other).cloned().collect()
    u.sort()
    println("${u:?}")
    let mut i: Vec<int> = s.intersection(&other).cloned().collect()
    i.sort()
    println("${i:?}")
}

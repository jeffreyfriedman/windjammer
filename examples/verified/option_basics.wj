// tags: option, match, error-handling
// rust: gap error[E0308]: mismatched types
// expect: found 3
// expect: none
// expect: 3
// expect: 0
// expect: true false
fn first_even(xs: Vec<int>) -> Option<int> {
    for x in xs {
        if x % 2 == 0 { return Some(x) }
    }
    None
}

fn main() {
    match first_even([1, 3, 4, 6]) {
        Some(v) => println("found ${v - 1}"),
        None => println("none"),
    }
    match first_even([1, 3]) {
        Some(v) => println("found ${v}"),
        None => println("none"),
    }
    println("${Some(3).unwrap_or(0)}")
    let nothing: Option<int> = None
    println("${nothing.unwrap_or(0)}")
    println("${Some(1).is_some()} ${nothing.is_some()}")
}

// tags: algorithm, loops, fizzbuzz
// rust: ok
// expect: 1 2 Fizz 4 Buzz Fizz 7 8 Fizz Buzz 11 Fizz 13 14 FizzBuzz
fn fizzbuzz(i: int) -> string {
    if i % 15 == 0 {
        "FizzBuzz"
    } else if i % 3 == 0 {
        "Fizz"
    } else if i % 5 == 0 {
        "Buzz"
    } else {
        i.to_string()
    }
}

fn main() {
    let mut parts: Vec<string> = []
    for i in 1..=15 { parts.push(fizzbuzz(i)) }
    println(parts.join(" "))
}

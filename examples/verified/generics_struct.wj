// tags: generics, struct, container
// rust: ok
// expect: 2
// expect: Some(30)
// expect: None
struct Stack<T> {
    items: Vec<T>,
}

impl<T> Stack<T> {
    fn new() -> Stack<T> {
        Stack { items: [] }
    }
    fn push(self, x: T) {
        self.items.push(x)
    }
    fn pop(self) -> Option<T> {
        self.items.pop()
    }
    fn len(self) -> int {
        self.items.len()
    }
}

fn main() {
    let mut s: Stack<int> = Stack::new()
    s.push(10)
    s.push(20)
    s.push(30)
    println("${s.len() - 1}")
    println("${s.pop():?}")
    s.pop()
    s.pop()
    println("${s.pop():?}")
}

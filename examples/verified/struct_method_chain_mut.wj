// tags: struct, mutation, methods, inferred-mut
// rust: ok
// expect: 3
// expect: 30
struct Counter { n: int, step: int }

impl Counter {
    fn tick(self) {
        self.n += self.step
    }
    fn value(self) -> int {
        self.n
    }
}

fn run(c: Counter) -> int {
    c.tick()
    c.tick()
    c.value()
}

fn main() {
    let mut a = Counter { n: 1, step: 1 }
    a.tick()
    a.tick()
    println("${a.value()}")
    let mut b = Counter { n: 0, step: 15 }
    println("${run(b)}")
}

// tags: hashmap, iteration, sort
// rust: ok
// expect: apple=3
// expect: kiwi=7
// expect: pear=5
use std::collections::HashMap

fn main() {
    let mut stock: HashMap<string, int> = HashMap::new()
    stock.insert("pear", 5)
    stock.insert("apple", 3)
    stock.insert("kiwi", 7)
    let mut keys: Vec<string> = stock.keys().cloned().collect()
    keys.sort()
    for k in keys {
        println("${k}=${stock[k]}")
    }
}

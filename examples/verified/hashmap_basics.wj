// tags: hashmap, collections, insert, get
// rust: ok
// expect: 2
// expect: Some(10)
// expect: None
// expect: true
// expect: 20
use std::collections::HashMap

fn main() {
    let mut m: HashMap<string, int> = HashMap::new()
    m.insert("a", 10)
    m.insert("b", 20)
    println("${m.len()}")
    println("${m.get("a"):?}")
    println("${m.get("z"):?}")
    println("${m.contains_key("b")}")
    println("${m["b"]}")
}

// tags: closures, functions
// rust: ok
// expect: 11
// expect: 15
// expect: 7
fn apply(f: fn(int) -> int, x: int) -> int {
    f(x)
}

fn main() {
    let add_one = |x| x + 1
    println("${add_one(10)}")
    let k = 5
    let add_k = |x| x + k
    println("${add_k(10)}")
    println("${apply(|x| x - 1, 8)}")
}

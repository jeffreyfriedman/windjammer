// tags: testing, test, struct, impl
// tests-passed: 2
struct Rect { w: int, h: int }

impl Rect {
    fn area(self) -> int { self.w * self.h }
    fn is_square(self) -> bool { self.w == self.h }
}

@test
fn area_multiplies() {
    let r = Rect { w: 3, h: 4 }
    assert_eq(r.area(), 12)
}

@test
fn square_detection() {
    assert(Rect { w: 2, h: 2 }.is_square())
    assert(!Rect { w: 2, h: 3 }.is_square())
}

// tags: iterators, filter_map, parsing, option
// rust: gap error[E0599]: no method named 'filter_map' found for struct 'Vec<String>' in the
// expect: [1, 3, 5]
// expect: 9
fn main() {
    let raw = ["1", "a", "3", "b", "5"]
    let nums: Vec<int> = raw.filter_map(|s| s.parse::<int>().ok()).collect()
    println("${nums:?}")
    println("${nums.sum::<int>()}")
}

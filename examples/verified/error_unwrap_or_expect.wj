// tags: error-handling, unwrap_or, unwrap_or_default, option, result
// rust: ok
// expect: 42
// expect: 0
// expect: 8
// expect: fallback
fn main() {
    let a: int = "42".parse().unwrap_or(0)
    let b: int = "nope".parse().unwrap_or(0)
    println("${a}")
    println("${b}")
    let c = "8".parse::<int>().unwrap_or_default()
    println("${c}")
    let name: Option<string> = None
    println(name.unwrap_or("fallback"))
}

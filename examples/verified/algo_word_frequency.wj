// tags: algorithm, hashmap, strings, sort
// rust: gap error[E0599]: no method named 'map' found for struct 'HashMap<String, i64>' in t
// expect: the: 3
// expect: and: 2
// expect: cat: 2
use std::collections::HashMap

fn main() {
    let text = "the cat and the dog and the cat"
    let mut freq: HashMap<string, int> = HashMap::new()
    for w in text.split(" ") {
        freq.entry(w.to_string()).and_modify(|c| *c += 1).or_insert(1)
    }
    let mut entries: Vec<(string, int)> = freq.map(|(k, v)| (k, *v)).collect()
    entries.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)))
    for (w, c) in entries.take(3) {
        println("${w}: ${c}")
    }
}

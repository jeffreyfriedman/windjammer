// tags: hashmap, entry, word-count
// rust: ok
// expect: the 3
// expect: cat 2
// expect: sat 1
use std::collections::HashMap

fn main() {
    let text = "the cat and the dog and the cat"
    let mut counts: HashMap<string, int> = HashMap::new()
    for w in text.split_whitespace() {
        *counts.entry(w.to_string()).or_insert(0) += 1
    }
    println("the ${counts["the"]}")
    println("cat ${counts["cat"]}")
    println("sat ${counts.get("sat").copied().unwrap_or(1)}")
}

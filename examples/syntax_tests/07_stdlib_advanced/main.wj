// Advanced Standard Library Example
// Demonstrates time, strings, math, and log modules

use std::time
use std::strings
use std::math
use std::log

// === TIME EXAMPLES ===

fn time_examples() {
    log.info("=== Time Examples ===")
    
    // Current time
    let now = time.now()
    log.info("Current time: ${time.to_rfc3339(&now)}")
    
    // Format time
    let formatted = time.format(&now, "%Y-%m-%d %H:%M:%S")
    log.info("Formatted: ${formatted}")
    
    // Time arithmetic
    let future = time.add(&now, time.hours(24))
    log.info("24 hours from now: ${time.to_rfc3339(&future)}")
    
    // Unix timestamp
    let timestamp = time.timestamp(&now)
    log.info("Unix timestamp: ${timestamp}")
    
    // Duration
    let duration = time.minutes(30)
    log.debug("Duration created: ${duration:?}")
}

// === STRING EXAMPLES ===

fn string_examples() {
    log.info("\n=== string Examples ===")
    
    // Splitting
    let text = "hello,world,rust"
    let parts = strings.split(text, ",")
    log.info("Split: ${parts:?}")
    
    // Joining
    let joined = strings.join(&parts, " | ")
    log.info("Joined: ${joined}")
    
    // Case conversion
    let upper = strings.to_uppercase("hello world")
    let lower = strings.to_lowercase("HELLO WORLD")
    let cap = strings.capitalize("hello")
    log.info("Upper: ${upper}, Lower: ${lower}, Cap: ${cap}")
    
    // Trimming
    let trimmed = strings.trim("  spaces  ")
    log.info("Trimmed: '${trimmed}'")
    
    // Searching
    if strings.contains("hello world", "world") {
        log.info("string contains 'world'")
    }
    
    // Replacement
    let replaced = strings.replace("foo bar foo", "foo", "baz")
    log.info("Replaced: ${replaced}")
    
    // Substring
    let sub = strings.substring("hello world", 0, 5)
    log.info("Substring: ${sub}")
}

// === MATH EXAMPLES ===

fn math_examples() {
    log.info("\n=== Math Examples ===")
    
    // Constants
    log.info("PI = ${math.PI}")
    log.info("E = ${math.E}")
    
    // Basic operations
    let sqrt_result = math.sqrt(16.0)
    let pow_result = math.pow(2.0, 8.0)
    log.info("sqrt(16) = ${sqrt_result}")
    log.info("2^8 = ${pow_result}")
    
    // Rounding
    let x = 3.7
    log.info("round(${x}) = ${math.round(x)}")
    log.info("floor(${x}) = ${math.floor(x)}")
    log.info("ceil(${x}) = ${math.ceil(x)}")
    
    // Trigonometry
    let angle = math.to_radians(45.0)
    let sine = math.sin(angle)
    log.info("sin(45°) = ${sine}")
    
    // Min/Max
    let min_val = math.min_f64(10.0, 20.0)
    let max_val = math.max_f64(10.0, 20.0)
    log.info("min(10, 20) = ${min_val}, max(10, 20) = ${max_val}")
    
    // Random
    let random_num = math.random()
    let random_range = math.random_range(1, 100)
    log.info("Random: ${random_num}, Random range: ${random_range}")
}

// === LOGGING EXAMPLES ===

fn logging_examples() {
    log.info("\n=== Logging Examples ===")
    
    // Different log levels
    log.error("This is an error message")
    log.warn("This is a warning")
    log.info("This is an info message")
    log.debug("This is a debug message")
    log.trace("This is a trace message")
    
    // Structured logging with context
    let mut ctx = log.context()
    ctx.add("user_id", "12345")
       .add("action", "login")
       .info("User logged in")
}

// === DATA PROCESSING EXAMPLE ===

fn process_data() {
    log.info("\n=== Data Processing Example ===")
    
    // Sample CSV data
    let csv_data = "John,30,Engineer\nAlice,25,Designer\nBob,35,Manager"
    
    // Process each line
    let lines = strings.lines(csv_data)
    
    for line in lines {
        let fields = strings.split(line, ",")
        
        if fields.len() == 3 {
            let name = &fields[0]
            let age = &fields[1]
            let role = &fields[2]
            
            log.info("Name: ${name}, Age: ${age}, Role: ${role}")
            
            // Do some processing
            let age_in_months = age.parse::<i64>().unwrap() * 12
            log.debug("${name} is ${age_in_months} months old")
        }
    }
}

// === CALCULATION EXAMPLE ===

fn calculate_statistics(numbers: &[f64]) {
    log.info("\n=== Statistics Calculation ===")
    
    if numbers.is_empty() {
        log.warn("No numbers to calculate")
        return
    }
    
    // Calculate sum
    let sum: f64 = numbers.iter().sum()
    
    // Calculate mean
    let mean = sum / numbers.len() as f64
    
    // Find min and max
    let mut min = numbers[0]
    let mut max = numbers[0]
    
    for &num in numbers {
        min = math.min_f64(min, num)
        max = math.max_f64(max, num)
    }
    
    // Calculate standard deviation
    let variance: f64 = numbers
        .iter()
        .map(|&x| math.pow(x - mean, 2.0))
        .sum::<f64>() / numbers.len() as f64
    
    let std_dev = math.sqrt(variance)
    
    // Log results
    log.info("Count: ${numbers.len()}")
    log.info("Sum: ${sum:.2}")
    log.info("Mean: ${mean:.2}")
    log.info("Min: ${min:.2}, Max: ${max:.2}")
    log.info("Std Dev: ${std_dev:.2}")
}

// === MAIN ===

fn main() {
    // Initialize logging
    log.init()
    
    log.info("🚀 Windjammer Standard Library - Advanced Examples")
    log.info("=" * 50)
    
    // Run all examples
    time_examples()
    string_examples()
    math_examples()
    logging_examples()
    process_data()
    
    // Statistics example
    let numbers = [10.0, 20.0, 30.0, 40.0, 50.0]
    calculate_statistics(&numbers)
    
    log.info("\n✅ All examples completed successfully!")
}
